AMIGA 34 NEWCLI,             d
AMIGA 54 _NEW,               n
AMIGA 24 _OPEN,              o
AMIGA 25 _APPEND,            p
AMIGA 19 _REVERT,            r
AMIGA 50 _CUT,               x
AMIGA 51 _COPY,              c
AMIGA 52 _PASTE,             v
AMIGA 49 _UNDO,              u
KEY 64 _STOP,                    space
KEY 65 _REWIND,                  backspace
SHIFT 65 _REWIND,            shift backspace
CTRL 65 _REWIND,             ctrl backspace
KEY 70 _FASTFORWARD,             del
SHIFT 70 _FASTFORWARD,       shift del
KEY 66 _MUTE,                    tab
AMIGA 66 _UNMUTEALL,         amiga tab
KEY 68 _TGLLOOP,                 return
KEY 69 _QUIT,                    esc
CTRL 80 B=1,_MUTE,B=PB,      F1
CTRL 81 B=2,_MUTE,B=PB,      F2
CTRL 82 B=3,_MUTE,B=PB,      F3
CTRL 83 B=4,_MUTE,B=PB,      F4
CTRL 84 B=5,_MUTE,B=PB,      F5
CTRL 85 B=6,_MUTE,B=PB,      F6
CTRL 86 B=7,_MUTE,B=PB,      F7
CTRL 87 B=8,_MUTE,B=PB,      F8
