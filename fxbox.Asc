Set Buffer 56 : Set Stack 0 : Rem                                    *main 
Request Off : Comp Test Off : Rem                                    *play 
'                                                                    *position 
Data "                         .." : Rem                             *draw
Data "  oec8888E          . uW8'" : Rem                              *zoom 
Data " @888888N  uL   ..  `t888             u.     uL   .." : Rem    *range
Data " 8`*88%  .@88b @88R 8888   .    ...ue888b  .@88b  @88R" : Rem  *file 
Data " 8b.    '`Y888k/`*P  9888.z88N  888R Y888r'`Y888k/`*P" : Rem   *edit
Data "u8888888>  Y888L     9888  888E 888R I888>   Y888L" : Rem      *mix
Data " 8888R      8888     9888  888E 888R I888>    8888" : Rem      *frame
Data " 8888P      `888N    9888  888E 888R I888>    `888N" : Rem     *volume
Data " *888>   .u./`888&   9888  888Eu8888cJ888  .u./`888&" : Rem    *resample 
Data " 4888   d888' Y888*'.8888  888' `*888*P'  d888' Y888*'" : Rem  *convert
Data " '888   ` `Y   Y'    `%888*%'     `Y'     ` `Y   Y'" : Rem     *filter
Data "  88R                   '`" : Rem                              *distort
Data "  88>" : Rem                                                   *effects 
Data "  48" : Rem                                                    *repair 
Data "  '8                 Version 1.25",, : Rem                     *bitwise 
Data "              © 1991-2026 Marc Williams", : Rem                *encoding 
'                                                                    *process
'*********************************************************************utils*** 
'                                                                    *direct 
_M1=7 : _M2=20 : _M3=15 : _AB=13 : _MR=64 : _FL=256 : _PK=64 : Rem   *sequence
_FR=512 : _XC=8 : _RT=15 : _OP=30 : _CH=16 : _AP=_CH : _CM=52 : Rem  *memory 
'                                                                    *help 
'*********************************************************************macro*** 
'                                                                    *sys
Dim MENX(_M1),MENB$(10),MENM$(_M2-2) : Rem                           *mouse 
Dim BUTS$(_AB),BUTX(_AB),BUTY(_AB),BUTG$(_AB) : Rem                  *choice 
Add _AP,4 : Dim PAULA(_AP),CHAIN$(_XC),MUTE(_CH) : Rem               *menu
Dim OFFSET(_CH),LEFTOVER(_CH),ADV#(_CH),ADVPOS#(_CH) : Rem           *windows 
Dim D_START(_CH),D_LENGTH(_CH),TIME(_CH),XP(_CH),XP2(_CH) : Rem      *buttons
'                                                                    *gadgets
Dim DEVS$(5),SETTING$(_OP),FILES$(_FR),FILEL(_FR) : Rem              *network
Dim FB$(_FL),FPATH$(_FL),QUAL(_FL),FMACRO$(_MR) : Rem                *init 
'                                                                    *screen 
Dim CMD$(_CM),CMDG$(_CM),DELTA(15),CHROM$(13) : Rem                  *error
MI=5 : Dim MACROT$(MI),MA(MI),MP(MI),MN(MI) : MI=-1 : Rem            *data 
Dim NAME$(_FL),CPYR$(_FL),AUTH$(_FL),TXT$(_FL),ANNO$(_FL),COMP(_FL)
Dim ROT#(_RT),ROTV#(_RT),_ROT(_RT),ROTX(_RT),ROTY(_RT),ROTX2(_RT),ROTY2(_RT)
Dim PKS(_PK),PKC(_PK),PK$(_PK)
'
_FXBOX$="FxBox" : _UNNAMED$="Unnamed" : _DEFAULT$="Samples"
_NOTAVAILABLE$="not available" : _NOTACTIVE$="not active" : _MUTE$="Mute"
_HZ$="Hz" : _BPM$=" Bpm" : _ABK$=".ABK" : _CAT$=".CAT" : _TOAST$="³^°¬"
_TRUE$="-1" : _FALSE$=Chr$(48) : _OK$="Ok" : _CANCEL$="Cancel"
_CLEAR$="Clear" : _FROM$="From" : _NONE$="None" : _BIT$="bit"
_NDPQ$="_NDPQ" : _AMBK$="AmBk" : _DATA$="data"
_BYTE$=Chr$(66) : _KILO$=Chr$(75) : _MEGA$=Chr$(77) : _GIGA$=Chr$(71)
_KILOBYTE=1024 : _MEGABYTE=1048576 : _GIGABYTE=1073741824
_KILOBYTE#=_KILOBYTE : _MEGABYTE#=_MEGABYTE : _GIGABYTE#=_GIGABYTE
'
CHR_NULL=0 : CHR_SPACE=32 : CHR_HASH=35 : CHR_STAR=42 : CHR_MINUS=45
CHR_DOT=46 : CHR_SLASH=47 : CHR_QUESTIONMARK=63 : CHR_SCORE=95
CHR_OTHERMINUS=173 : CHR_TOPSCORE=175 : CHR_»=187
'
_NULL$=Chr$(CHR_NULL) : _NEWLINE$=Chr$(10) : _SPACE$=Chr$(CHR_SPACE)
_QUOTE$=Chr$(34) : _PERCENT$=Chr$(37) : _COMMA$=Chr$(44)
_SLASH$=Chr$(CHR_SLASH) : _MINUS$=Chr$(CHR_MINUS) : _DOT$=Chr$(CHR_DOT)
_COLON$=Chr$(58) : _SCORE$=Chr$(CHR_SCORE) : _TOPSCORE$=Chr$(CHR_TOPSCORE)
_»$=Chr$(CHR_»)
'
_SPACER$=Space$(2) : _CHUNK$=String$(_NULL$,4) : _$=String$(_NULL$,0)
_DOTS$=String$(_DOT$,3) : _COMMANEWLINE$=_COMMA$+_NEWLINE$
'
_BG=0 : _PANE=1 : _WHITE=2 : _GRAY=3
_BLACK=4 : _SHADOW=5 : _BRIGHT=6 : _HIGHLIGHT=7
'  
SCR_W=640 : SCR_H=256 : SCR_R=Hires : SCR_D=8 : SCR_T=44 : SCR_L=128
SCR_W#=SCR_W : BUT_W=103 : BUT_H=14
'
ZN_START=1 : ZN_RANGE=ZN_START+1
ZN_OK=ZN_RANGE+1 : ZN_CANCEL=ZN_OK+1
ZN_PIANO=ZN_CANCEL+1 : ZN_T0NECANCEL=ZN_PIANO+7
ZN_OPTIONS=ZN_CANCEL+1 : ZN_OPTIONSOK=ZN_OPTIONS+24
ZN_FILESUP=ZN_CANCEL+1 : ZN_FILESDOWN=ZN_CANCEL+2 : ZN_FILESBAR=ZN_CANCEL+3
ZN_FILESTEXT=ZN_CANCEL+4
ZN_FILESOK=ZN_CANCEL+5 : ZN_FILESPARENT=ZN_CANCEL+6
ZN_FILESVOLUMES=ZN_CANCEL+7 : ZN_FILESDEVS=ZN_CANCEL+8
ZN_FILESCANCEL=ZN_FILESVOLUMES+6
ZN_FILESLIST=ZN_FILESCANCEL+1 : ZN_FILESLISTEND=ZN_FILESLIST+14
ZN_PLAY=ZN_FILESLISTEND+1 : ZN_PLAYRANGE=ZN_PLAY+1 : ZN_PLAYDISPLAY=ZN_PLAY+2
ZN_MIX=ZN_PLAY+3 : ZN_REPEAT=ZN_PLAY+4 : ZN_PASTE=ZN_PLAY+11
ZN_LOOP=ZN_PLAY+12 : ZN_MIXLOOP=ZN_PLAY+13
ZN_OSCCLOSE=ZN_MIXLOOP+1 : ZN_OSCMODE=ZN_OSCCLOSE+1
ZN_CALCLOSE=ZN_OSCMODE+1
ZN_AUTO=ZN_CALCLOSE+1
ZN_FXLEFT=ZN_AUTO+1 : ZN_FXRIGHT=ZN_AUTO+2 : ZN_FXBAR=ZN_AUTO+3
ZN_TOAST=ZN_FXBAR+1 : ZN_TIME=ZN_TOAST+1
ZN_LEFTWAND=ZN_TIME+1 : ZN_RIGHTWAND=ZN_LEFTWAND+1 : ZN_MIDDLEWAND=ZN_LEFTWAND+2
ZN_LEFTRANGESPACE=ZN_MIDDLEWAND+1 : ZN_LEFTRANGE=ZN_LEFTRANGESPACE+1
ZN_MIDDLERANGESPACE=ZN_LEFTRANGESPACE+2
ZN_RIGHTRANGE=ZN_LEFTRANGESPACE+3 : ZN_RIGHTRANGESPACE=ZN_LEFTRANGESPACE+4
'
_MODE=1 : _MODEP=_MODE : _M3SEL=_MODE : B=1 : PB=B : LB=0 : UB=B : JB=7
UBANK=2 : CBANK=6 : CCBANK=32766 : WBANK=7 : PBANK=B+JB : QBANK=65535 : QQBANK=65534 : KMUL=0 : TBANK=32767
_CHANNEL=1 : _CHANNELS=1 : PASS=0 : MFREQ=96000 : TFREQ=20000
H_BUF=4096 : Q_BUF=1024 : FX_BUF=20480 : M_BUF=1152*2
'
REXX=False : SOCKSYNC=-1 : SOCKVST=-1
_CHAIN=1 : _REC=False : _LP=True : _LPMIX=True
_DIRECT=0 : _TEXT=False : _SPIN=0 : _GRAB=1
'
REALTIME=False : RENDERING=False : PIANO=False : POLY=False
MACRO=False : SEQUENCE=False : ACTION=False : _UNMOVED=True
PLYING=False : STPPED=True : RNGEPLY=False : DISPPLY=False
OSCILLO=False : ABOUT=False : PLYTIME=0 : STPTIME=0 : CALC=False : POS=1
_DITHER=1 : _INTERPOLATE=0 : _AMP#=1 : _BYPS=1
'
_2PI#=Pi#*2.0 : _PI2#=2.0/Pi#
'
PROGDIR$=Dir$ : PPROGDIR$=PROGDIR$ : AUTOEXEC$="autoexec"
MACRODIR$="macros" : SEQDIR$="sequences" : CFGFILE$="fxbox.cfg"
FXBOX_REXX$="FXBOX_REXX" : OCTAMED_REXX$="OCTAMED_REXX"
'  
MC_ROL_B=$E3384E75
MC_ROR_B=$E2384E75
MC_ASL_B=$E3204E75
MC_ASR_B=$E2204E75
MC_ASL_L=$E3A04E75
MC_ASR_L=$E2A04E75
MC_LSR_B=$E2284E75
MC_AND_L=$C0814E75
'
Dreg(1)=Doscall(-60) : Rem _LVOOutput 
If Dreg(1)
   Repeat 
      Read T$
      T$=Space$(4)+T$+_NEWLINE$
      Dreg(2)=Varptr(T$) : Dreg(3)=Len(T$) : N=Doscall(-48) : Rem _LVOWrite
      Inc I
   Until I>18
End If 
On Error Proc TR4P
'
Def Fn ROT_FREQ_SET=(((FREQ-500)/13.3)/DIALMAX#)+8.5
Def Fn ROT_VOL_SET=(VOL/13.3334)+8.5
Def Fn ROT_TFREQ_SET=(((T0NEV#)*4.8)/TFREQ)+8.5
Def Fn ROT_TAMP_SET=((T0NEA*4.8)/127)+8.5
Def Fn T0NE#=(_2PI#*T0NEV#)/FREQ
Def Fn DIALZONE=CX>ROTX(_DIAL)-14 and CX<ROTX2(_DIAL) and CY>ROTY(_DIAL)-9 and CY<ROTY2(_DIAL)
Def Fn KEY_PRESS=C>0
Def Fn KEY_SPACE=C=64
Def Fn KEY_BACKSPACE=C=65
Def Fn KEY_RETURN=C=68
Def Fn KEY_ESC=C=69
Def Fn KEY_DEL=C=70
Def Fn KEY_UP=C=76
Def Fn KEY_DOWN=C=77
Def Fn KEY_RIGHT=C=78
Def Fn KEY_LEFT=C=79
Def Fn KEY_CURSOR=C>75 and C<80
Def Fn KEY_CAPSLOCK=S=4
Def Fn KEY_SHIFT=S=1 or S=2 or S=5 or S=6
Def Fn KEY_CTRL=S=8 or S=12
Def Fn KEY_SHIFTCTRL=S=9 or S=13
Def Fn KEY_LEFTAMIGA=S=64 or S=68
Def Fn KEY_ALT=S=16 or S=20
Def Fn KEY_RIGHTAMIGA=S=128 or S=132
Def Fn KEY_LEFTAMIGAALT=S=80 or S=84
Def Fn KEY_RIGHTAMIGAALT=S=160 or S=164
Def Fn KEY_UPPER(C)=C<91 and C>64
Def Fn CHUNKY(I)=(Int(Int(I/_TIMEBEAT#)*_TIMEBEAT#)/_BYPS)*_BYPS
Def Fn BUFFER=Free-5
Def Fn A500=_AMIVER<3
Def Fn A1200=_AMIVER<5
Def Fn WANDZOOM=XD>0 or XD2<SCR_W
Def Fn MONO=_MODE=1
Def Fn STEREO=_MODE=2
Def Fn QUAD=_MODE=3
Def Fn STEREOORQUAD= Fn STEREO or Fn QUAD
Def Fn MONOORSTEREOORQUAD=_MODE<4
Def Fn MULTI=_MODE>3
Def Fn INVIEW=B<=_CH
Def Fn MULTIINVIEW= Fn MULTI and Fn INVIEW
Def Fn MOUSEUP=M=0
Def Fn MOUSEDOWN=M=1
Def Fn MOUSEMENU=M=2
Def Fn MOUSEWHEELUP=C=122
Def Fn MOUSEWHEELDOWN=C=123
Def Fn ODD(C)=C mod 2
Def Fn THREE(C)=C mod 3=0
Def Fn BPSALIGN(C#)=Int(C#/BPS)*BPS
Def Fn BPSPROP$=Str$(QUAL(B)*8)-_SPACE$+_BIT$
Def Fn QPROP$=Str$(_BYPS*8)-_SPACE$+_BIT$
Def Fn QUOTE$(TXT2$)=_QUOTE$+TXT2$+_QUOTE$
'
Dim HBUF(_CH)
Dim BBUF0(_CH),BBUF1(_CH)
Dim LBUF(_CH)
Dim RBUF0#(_CH),RBUF1#(_CH)
Dim SMOBUF(_CH)
Dim ALIBUF(_CH)
Dim PHBUF#(_CH),PHBUF0(_CH),PHBUF1(_CH)
Dim RVBUF0(_CH),RVBUF1(_CH)
Dim DEBUF0(_CH),DEBUF1(_CH)
Dim TBUF(_CH)
Dim RMBUF(_CH)
Dim CBUFENV#(_CH),CBUFSUMM#(_CH)
'
Gosub _INIT
If Prg State=-1 Then Break Off : Rem compiled 
'
DISPATCH$="FBLIT,MACRO autoexec,"
'
'
'
'***************************************************************************** 
'*main************************************************************************ 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .        :    :::.      :::  ::.    :::.
'    ;;,.    ;;;   ;;`;;     ;;;  ;;;;,  `;;;
'    [[[[, ,[[[[, ,[[ '[[,   [[[   [[[[[. '[[
'    $$$$$$$$"$$$c$$$cc$$$c  $$$,  $$$ "Y$c$$
'   888 Y88" 888o 888   888,o88888888    Y88 
'   MM  M'  "MMMM YMM   ""` MMM"MMMM     YM
'
'
'
Do 
   If _SCROLLING Then Gosub WHEELZOOM
   Gosub GVAL
   If Fn KEY_PRESS : Gosub KCHOOSE
   Else If Fn MOUSEDOWN : Gosub BCHOOSE
   Else If Fn MOUSEMENU : _M0=0 : Gosub DRWMENU
   Else If _MENUON : Gosub DRWMENUC : If _CHOICE : Gosub MCHOOSE : End If 
   Else If PZ-Z : Gosub ZCHOOSE
   End If 
   Gosub DISPATCH
   If Not PLYING
      If Not STPPED
         STPPED=True : RNGEPLY=False : DISPPLY=False
         If Not _CONTROLSOFF
            Gosub PLYBTN
            Ink _PANE : Gosub DRWLEV
            Gosub METROC
         End If 
         If _REC : Rem save final buffer
            Add BSIZE,-LEFTOVER(1)
            Gosub REC
            Add BSIZE,LEFTOVER(1)
         End If 
      End If 
   End If 
Loop 
'
'
'
'***************************************************************************** 
'*play************************************************************************ 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   ::::::::.   :::      :::.     -:.     ::-.:    
'   `;;```.;;;  ;;;      ;;`;;    ';;.   ;;;;''    
'   `]]nnn]]'   [[[     ,[[ '[[,     '[[,[[['      
'    $$$""      $$'    c$$$cc$$$c      c$$"        
'    888o     o88oo,.__ 888   888,   ,8P"`         
'    YMMMb    """YUMMMM YMM   ""`   mM"            
'
'  
'
_PLAYRANGE:
If RL=0 and Not Fn KEY_SHIFT Then Goto FLSHSCR
STA=RST : If RL=1 Then FI=P_LENGTH Else FI=P_LENGTH-RFIN
If PLYING
   If DISPPLY
      _COL=_PANE
      BZN=ZN_PLAYDISPLAY : Gosub ZBTN
   Else If Fn KEY_SHIFT
      _COL=_PANE
      BZN=ZN_PLAYRANGE : Gosub ZBTN
      STA=0 : FI=P_LENGTH
      RNGEPLY=False
      Return 
   End If 
End If 
RNGEPLY=True : DISPPLY=False
If STPPED Then Goto PS
Goto P
'
_PLAYDISPLAY:
STA=ST : FI=P_LENGTH-FIN
If STA>0 and FI>0
   If Fn STEREO
      STA=STA/2
      FI=FI/2
   Else If Fn QUAD
      STA=STA/4
      FI=FI/4
   End If 
End If 
If PLYING
   If RNGEPLY
      _COL=_PANE
      BZN=ZN_PLAYRANGE : Gosub ZBTN
   Else If Fn KEY_SHIFT
      _COL=_PANE
      BZN=ZN_PLAYDISPLAY : Gosub ZBTN
      STA=0 : FI=P_LENGTH
      DISPPLY=False
      Return 
   End If 
End If 
DISPPLY=True : RNGEPLY=False
If STPPED Then Goto PS
Goto P
'
_PLAY:
STA=0 : FI=P_LENGTH : SBEAT=1
_COL=_PANE
If RNGEPLY
   RNGEPLY=False
   BZN=ZN_PLAYRANGE : Gosub ZBTN
Else If DISPPLY
   DISPPLY=False
   BZN=ZN_PLAYDISPLAY : Gosub ZBTN
End If 
'
PS:
If Not Fn KEY_SHIFT
   PWC=1
   Repeat 
      OFFSET(PWC)=0
      LEFTOVER(PWC)=0
      Inc PWC
   Until PWC>_CH
End If 
If STPPED Then Gosub CLRPLY
'
P:
If STPPED Then PLYTIME=Timer
STPPED=False
If Not Fn KEY_SHIFT
   If Fn MULTI
      If Fn INVIEW
         OFFSET(B)=STA
      End If 
   Else 
      OFFSET(1)=STA
   End If 
End If 
PWC=1
Repeat 
   TIME(PWC)=0
   Inc PWC
Until PWC>_CH
MBEAT=False
If Fn WANDZOOM
   If Fn MONOORSTEREOORQUAD
      Gosub NUDGEPOS
      Gosub CLRPOS
   End If 
End If 
If Not PLYING
   Gosub CLRPOS
   PLYING=True : TGL=False : _STARTPLAY=True
   Sam Loop On 
   Gosub PLYING
End If 
Gosub POSCAL
If STA+FI=0 Then FI=P_LENGTH
Goto PLYBTN
'
_FASTFORWARD:
If Fn MULTIINVIEW
   If Fn KEY_SHIFT
      OFFSET(B)= Fn BPSALIGN(( Fn CHUNKY(OFFSET(B)/ADV#(B))*ADV#(B))+Int(Length(B+JB)/_TIMEDIV#))
   Else 
      FP=1
      Repeat 
         If ADV#(FP)>0
            OFFSET(FP)= Fn BPSALIGN(( Fn CHUNKY(OFFSET(FP)/ADV#(FP))*ADV#(FP))+Int(Length(FP+JB)/_TIMEDIV#))
         End If 
         Inc FP
      Until FP>_CH
   End If 
Else 
   OFFSET(1)= Fn BPSALIGN(( Fn CHUNKY(OFFSET(1)/CON#)*CON#)+Int(P_LENGTH/_TIMEDIV#))
End If 
Return 
'
_REWIND:
If Fn MULTI
   If Fn INVIEW
      If Fn KEY_SHIFTCTRL
         OFFSET(B)=0 : TIME(B)=0
      Else If Fn KEY_SHIFT
         OFFSET(B)= Fn BPSALIGN(( Fn CHUNKY(OFFSET(B)/ADV#(B))*ADV#(B))-Int(D_LENGTH(B)/_TIMEDIV#))
         If OFFSET(B)<0
            Add OFFSET(B),D_LENGTH(B)
         End If 
      Else 
         FP=1
         Repeat 
            If Fn KEY_CTRL or(MACRO and ACTION=False) or _DIRECT
               OFFSET(FP)=0 : TIME(FP)=0
            Else If ADV#(FP)>0
               OFFSET(FP)= Fn BPSALIGN(( Fn CHUNKY(OFFSET(FP)/ADV#(FP))*ADV#(FP))-Int(D_LENGTH(FP)/_TIMEDIV#))
               If OFFSET(FP)<=0
                  Add OFFSET(FP),D_LENGTH(FP)
               End If 
            End If 
            Inc FP
         Until FP>_CH
      End If 
   End If 
Else 
   If Fn KEY_CTRL or(MACRO and ACTION=False) or _DIRECT
      OFFSET(1)=0 : TIME(1)=0
   Else 
      OFFSET(1)= Fn BPSALIGN(( Fn CHUNKY(OFFSET(1)/CON#)*CON#)-Int(P_LENGTH/_TIMEDIV#))
      If OFFSET(1)<=0
         Add OFFSET(1),P_LENGTH
      End If 
   End If 
End If 
Return 
'
_MUTE:
If Fn MULTIINVIEW
   If MUTE(B)
      MUTE(B)=0
      Volume PAULA(B),VOL
   Else 
      MUTE(B)=-1
      If _8CH or _16CH
         Rem digital mute 
      Else 
         Volume PAULA(B),0
      End If 
      If Not _MUTED
         _TOAST$=_MUTE$
      End If 
   End If 
   If _MUTED=False and _DIRECT=False
      Gosub R4INSET
   End If 
   Gosub CHECKMUTE
Else If Fn MONOORSTEREOORQUAD
   Gosub CHECKMUTE
   If C
      I=1
      Repeat 
         MUTE(I)=0
         Inc I
      Until I>_CH
      Volume PAULA(_AP),VOL
   Else 
      I=1
      Repeat 
         MUTE(I)=-1
         Inc I
      Until I>_CH
      Volume PAULA(_AP),0
      If Not _MUTED
         _TOAST$=_MUTE$
      End If 
   End If 
Else 
   Return 
End If 
If _MUTED Then Return 
_DIAL=1 : _ROT(_DIAL)=C<>0 : Goto DIALHIGH
'
_UNMUTEALL:
I=1
Repeat 
   MUTE(I)=False
   Inc I
Until I>_CH
If Fn MULTI Then Gosub R4INSET
I=1
Repeat 
   Volume PAULA(I),VOL
   Inc I
Until I>4 : Rem hardware channels
_DIAL=1 : _ROT(_DIAL)=0 : Goto DIALHIGH
Return 
'
_STOP:
Every 2 Gosub STPPED
_FULLSTOP:
Sam Loop Off 
If Not RENDERING Then Gosub NUDGEPOS
PLYING=False
STPTIME=Timer
If OCTAMED
   If SETTING$(23)<>_FALSE$ : Rem arexx sync 
      Exec RXDIR$+' "address '+OCTAMED_REXX$+' PL_STOP"'
   End If 
End If 
If NETSYNC
   MSG$="/t_stop"+_NULL$+_COMMA$+String$(_NULL$,23)
   I=1
   Repeat 
      Gosub SOCK_SENDSYNC
      Inc I
   Until I>10
End If 
Return 
'
PLYING:
Comp Test Off 
If TGL
   P_BUF=P_STARTB2 : P_SWP=P_STARTB1 : TGL=False
Else 
   P_BUF=P_STARTB1 : P_SWP=P_STARTB2 : TGL=True
End If 
If _STARTPLAY
   If Not NETVST
      _STARTED=False
      Sam Raw PAULA(_AP),P_SWP,Max(BSIZE,257),FREQ
      Goto PF
   End If 
End If 
If Fn MULTI
   If((RNGEPLY and RL) or DISPPLY)
      If Fn INVIEW and P_LENGTH>0
         BBUFF=P_SWP+(BSIZE*(B-1))
         DID=B
         If OFFSET(B)>=FI or OFFSET(B)<STA
            If _RESTART
               LEFTOVER(B)=0
            Else If _LP
               OFFSET(B)=STA+LEFTOVER(B)
               LEFTOVER(B)=0
               _TOAST$=_TOPSCORE$
            Else 
               Goto _STOP
            End If 
            Goto PB4
         Else 
            If OFFSET(B)+BSIZE>FI and OFFSET(B)-FI
               Copy P_START+OFFSET(B),P_START+FI To BBUFF
               LEFTOVER(B)=BSIZE-(FI-OFFSET(B))
               If _LP
                  Copy P_START+STA,P_START+STA+LEFTOVER(B) To BBUFF+(BSIZE-LEFTOVER(B))
               Else If Not Fn A500 : Rem risk of guru address error. a word or long word access was attempted on an odd address boundary
                  Fill P_SWP+BSIZE-LEFTOVER(1) To P_SWP+BSIZE,0
               End If 
            Else 
               PB4:
               Copy P_START+OFFSET(B),P_START+OFFSET(B)+BSIZE To BBUFF
            End If 
         End If 
      End If 
   End If 
   BBUFF=P_SWP
   SBCOUNT=1
   Repeat 
      B_LENGTH=Length(SBCOUNT+JB)
      If B_LENGTH>0 and SBCOUNT-DID
         B_START=Start(SBCOUNT+JB)
         If OFFSET(SBCOUNT)>=B_LENGTH
            Copy B_START+LEFTOVER(SBCOUNT),B_START+LEFTOVER(SBCOUNT)+BSIZE To BBUFF
            If _RESTART
               LEFTOVER(SBCOUNT)=0
            Else If _LP
               OFFSET(SBCOUNT)=LEFTOVER(SBCOUNT)
               LEFTOVER(SBCOUNT)=0
               _TOAST$=_TOPSCORE$
            Else 
               Goto _STOP
            End If 
         Else 
            If OFFSET(SBCOUNT)+BSIZE>B_LENGTH
               Copy B_START+OFFSET(SBCOUNT),B_START+B_LENGTH To BBUFF
               LEFTOVER(SBCOUNT)=BSIZE-(B_LENGTH-OFFSET(SBCOUNT))
               If _LP
                  Copy B_START,B_START+LEFTOVER(SBCOUNT) To BBUFF+(BSIZE-LEFTOVER(SBCOUNT))
               Else If Not Fn A500 : Rem risk of guru address error. a word or long word access was attempted on an odd address boundary
                  Fill P_SWP+BSIZE-LEFTOVER(SBCOUNT) To P_SWP+BSIZE,0
               End If 
            Else 
               Copy B_START+OFFSET(SBCOUNT),B_START+OFFSET(SBCOUNT)+BSIZE To BBUFF
            End If 
         End If 
      End If 
      Add BBUFF,BSIZE
      Inc SBCOUNT
   Until SBCOUNT>_CH
   DID=0
Else If P_LENGTH>0
   If((RNGEPLY and RL) or DISPPLY)
      If(OFFSET(1)>=FI) or OFFSET(1)<STA
         If _RESTART
            LEFTOVER(1)=0
         Else If _LP
            OFFSET(1)=STA+LEFTOVER(1)
            LEFTOVER(1)=0
            _TOAST$=_TOPSCORE$
         Else 
            Goto _STOP
         End If 
      Else 
         If(OFFSET(1)+BSIZE>FI) and OFFSET(1)-FI
            P_OFFSET=P_START+OFFSET(1)
            Copy P_OFFSET,P_START+FI To P_SWP
            LEFTOVER(1)=BSIZE-(FI-OFFSET(1))
            If _LP
               Copy P_START+STA,P_START+STA+LEFTOVER(1) To P_SWP+(BSIZE-LEFTOVER(1))
            Else If Not Fn A500 : Rem risk of guru address error. a word or long word access was attempted on an odd address boundary
               Fill P_SWP+BSIZE-LEFTOVER(1) To P_SWP+BSIZE,0
            End If 
            If Fn STEREOORQUAD
               Copy P_OFFSET+P_LENGTH,P_START+P_LENGTH+FI To P_SWP+BSIZE
               Copy P_START+STA+P_LENGTH,P_START+STA+P_LENGTH+LEFTOVER(1) To P_SWP+BSIZE+(BSIZE-LEFTOVER(1))
            End If 
            If Fn QUAD
               Copy P_OFFSET+P_LENGTH+P_LENGTH,P_START+P_LENGTH+P_LENGTH+FI To P_SWP+BSIZE+BSIZE
               Copy P_START+STA+P_LENGTH+P_LENGTH,P_START+STA+P_LENGTH+P_LENGTH+LEFTOVER(1) To P_SWP+BSIZE+BSIZE+(BSIZE-LEFTOVER(1))
               Copy P_OFFSET+P_LENGTH+P_LENGTH+P_LENGTH,P_START+P_LENGTH+P_LENGTH+P_LENGTH+FI To P_SWP+BSIZE+BSIZE+BSIZE
               Copy P_START+STA+P_LENGTH+P_LENGTH+P_LENGTH,P_START+STA+P_LENGTH+P_LENGTH+P_LENGTH+LEFTOVER(1) To P_SWP+BSIZE+BSIZE+BSIZE+(BSIZE-LEFTOVER(1))
            End If 
            Goto PF
         End If 
      End If 
   End If 
   If OFFSET(1)>=P_LENGTH
      If _RESTART
         LEFTOVER(1)=0
      Else If _LP
         OFFSET(1)=LEFTOVER(1)
         LEFTOVER(1)=0
         _TOAST$=_TOPSCORE$
      Else 
         Goto _STOP
      End If 
      Goto PB
   Else 
      If(OFFSET(1)+BSIZE>P_LENGTH)
         P_OFFSET=P_START+OFFSET(1)
         Copy P_OFFSET,P_START+P_LENGTH To P_SWP
         LEFTOVER(1)=BSIZE-(P_LENGTH-OFFSET(1))
         If _LP
            Copy P_START,P_START+LEFTOVER(1) To P_SWP+(BSIZE-LEFTOVER(1))
         Else If Not Fn A500 : Rem risk of guru address error. a word or long word access was attempted on an odd address boundary
            Fill P_SWP+BSIZE-LEFTOVER(1) To P_SWP+BSIZE,0
         End If 
         If Fn STEREOORQUAD
            Copy P_OFFSET+P_LENGTH,P_START+P_LENGTH+P_LENGTH+LEFTOVER(1) To P_SWP+BSIZE
            Copy P_START+P_LENGTH,P_START+P_LENGTH+LEFTOVER(1) To P_SWP+BSIZE+(BSIZE-LEFTOVER(1))
         End If 
         If Fn QUAD
            Copy P_OFFSET+P_LENGTH+P_LENGTH,P_START+P_LENGTH+P_LENGTH+P_LENGTH+LEFTOVER(1) To P_SWP+BSIZE+BSIZE
            Copy P_START+P_LENGTH+P_LENGTH,P_START+P_LENGTH+P_LENGTH+LEFTOVER(1) To P_SWP+BSIZE+BSIZE+(BSIZE-LEFTOVER(1))
            Copy P_OFFSET+P_LENGTH+P_LENGTH+P_LENGTH,P_START+P_LENGTH+P_LENGTH+P_LENGTH+P_LENGTH+LEFTOVER(1) To P_SWP+BSIZE+BSIZE+BSIZE
            Copy P_START+P_LENGTH+P_LENGTH+P_LENGTH,P_START+P_LENGTH+P_LENGTH+P_LENGTH+LEFTOVER(1) To P_SWP+BSIZE+BSIZE+BSIZE+(BSIZE-LEFTOVER(1))
         End If 
      Else 
         '
         PB:
         P_OFFSET=P_START+OFFSET(1)
         Copy P_OFFSET,P_OFFSET+BSIZE To P_SWP
         If Fn STEREOORQUAD
            Copy P_OFFSET+P_LENGTH,P_OFFSET+BSIZE+P_LENGTH To P_SWP+BSIZE
         End If 
         If Fn QUAD
            Copy P_OFFSET+P_LENGTH+P_LENGTH+P_LENGTH,P_OFFSET+BSIZE+P_LENGTH+P_LENGTH+P_LENGTH To P_SWP+BSIZE+BSIZE+BSIZE
            Copy P_OFFSET+P_LENGTH+P_LENGTH,P_OFFSET+BSIZE+P_LENGTH+P_LENGTH To P_SWP+BSIZE+BSIZE
         End If 
      End If 
   End If 
End If 
_RESTART=False
'
PF:
If _STARTPLAY
   _STARTPLAY=False
   Every 1 Gosub PLYING
   If NETVST
      Gosub SOCK_SENDVSTUP
   End If 
   If OCTAMED
      If SETTING$(23)<>_FALSE$ : Rem arexx sync 
         Exec RXDIR$+' "address '+OCTAMED_REXX$+' PL_PLAYBLOCK"'
      End If 
   End If 
   If NETSYNC
      NETCOUNT=0
      MSG$="/t_start"+_CHUNK$+",iff"+String$(_NULL$,16)
      Gosub SOCK_SENDSYNC
      Mid$(MSG$,0,8)="/t_pulse"
      Loke Varptr(MSG$)+20,NETCOUNT
   End If 
   If Not NETVST
      BBUFF=0
      If Fn MULTI
         SBCOUNT=1 : SB=_CH
      Else If Fn MONO
         SBCOUNT=_AP : SB=_AP
      Else If Fn STEREO
         SBCOUNT=_AP-3 : SB=_AP-2
      Else If Fn QUAD
         SBCOUNT=1 : SB=4
      End If 
      Repeat 
         Sam Swap PAULA(SBCOUNT) To P_SWP+BBUFF,BSIZE
         Add BBUFF,BSIZE
         Inc SBCOUNT
      Until SBCOUNT>SB
   End If 
   Return 
End If 
If Not NETVST
   BBUFF=0
   If Fn MULTI
      SBCOUNT=1 : SB=_CH
   Else If Fn MONO
      SBCOUNT=_AP : SB=_AP
   Else If Fn STEREO
      SBCOUNT=_AP-3 : SB=_AP-2
   Else If Fn QUAD
      SBCOUNT=1 : SB=4
   End If 
   Repeat 
      Sam Swap PAULA(SBCOUNT) To P_BUF+BBUFF,BSIZE
      Add BBUFF,BSIZE
      Inc SBCOUNT
   Until SBCOUNT>SB
End If 
If _STARTED
   Gosub POS
   '  
   '********************
   If REALTIME
      If _PREVIEW
         If P_LENGTH>0
            SBCOUNT=1
            M_SWP=P_SWP
            _FX_START=FX_START : _FX_LENGTH2=FX_LENGTH2
            _FX=FX : _FXE=FXE
            _CN=CN
            If Fn MULTI and Fn KEY_CAPSLOCK
               _CAPSLOCK=True
            End If 
            While CHAIN$(SBCOUNT)<>_$
               _CHANNEL=0
               If Fn MULTI=False or _CAPSLOCK
                  On _MODE-2 Goto MQ,MM : SB=_MODE : Goto MON
                  MQ: SB=4 : Goto MON
                  MM: SNB=_CH
                  MON:
                  Repeat 
                     Gosub CHAIN$(SBCOUNT)
                     Add P_SWP,BSIZE
                     Inc _CHANNEL
                  Until _CHANNEL=SB
               Else If Fn MULTIINVIEW
                  If Not MUTE(B)
                     Add P_SWP,BSIZE*(B-1)
                     Gosub CHAIN$(SBCOUNT)
                  End If 
               End If 
               P_SWP=M_SWP
               Inc SBCOUNT
            Wend 
            FX_START=_FX_START : FX_LENGTH2=_FX_LENGTH2
            FX=_FX : FXE=_FXE
            CN=_CN
            _CHANNEL=0
         End If 
      End If 
   End If 
   '******************* 
   '
   If TGL
      Gosub LEV
   End If 
   '
   If NETVST or _REC or _8CH or _16CH : Rem digital mute 
      If Fn MULTI
         SBCOUNT=1 : BBUFF=0
         Repeat 
            If MUTE(SBCOUNT) or Length(SBCOUNT+JB)=0
               Fill P_SWP+BBUFF To P_SWP+BBUFF+BSIZE,0
            End If 
            BBUFF=BBUFF+BSIZE
            Inc SBCOUNT
         Until SBCOUNT>_CH
      Else 
         Gosub CHECKMUTE
         If C
            Fill P_SWP To P_SWP+FSIZE,0
         End If 
      End If 
      If _REC
         Gosub REC
      End If 
      If NETVST
         Gosub SOCK_SENDVST
      Else If _PREVIEW : Rem 8bit mixed multi 
         If _16CH
            SB=2
         Else If _8CH
            SB=1
         Else 
            SB=0
         End If 
         NF=P_SWP : NFE=NF+HSIZE : NF2=NFE
         While SB>0
            Repeat 
               XN=Peek(NF)
               XN2=Peek(NF2)
               If XN>127 : Rem SIGN _MIX CHECKCLIP  
                  Add XN,-256
                  If XN2>127
                     Add XN2,-256
                     XN=Min(127,(XN+XN2)-((XN*XN2)/-128))
                  Else 
                     Add XN,XN2
                  End If 
               Else 
                  If XN2<128
                     XN=Max(-128,(XN+XN2)-((XN*XN2)/127))
                  Else 
                     Add XN,XN2-256
                  End If 
               End If 
               If XN<0 : Rem UNSIGN   
                  Poke NF,XN+256
               Else 
                  Poke NF,XN
               End If 
               Inc NF : Inc NF2
            Until NF>NFE
            Dec SB
            If _16CH
               NF=P_SWP : NFE=NF+HSIZE/2 : NF2=NFE
            End If 
         Wend 
         If _16CH
            _CH=16
         End If 
      End If 
   End If 
   Gosub SYNC
   If Not TGL
      Gosub PROBAR
      If Not _CONTROLSOFF
         Gosub SCR0LL
         Gosub LEVC
      End If 
   End If 
   If Fn MULTI
      SB=_CH
   Else 
      SB=1
   End If 
   SBCOUNT=1
   Repeat 
      Add OFFSET(SBCOUNT),BSIZE
      Add TIME(SBCOUNT),BSIZE
      Inc SBCOUNT
   Until SBCOUNT>SB
   If _DEBUG
      If Not NETVST
         SBCOUNT=0
         Repeat 
            If Sam Swapped(SBCOUNT)
               _TOAST$="µ" : Rem buffer underrun
               Exit 
            End If 
            Inc SBCOUNT
         Until SBCOUNT>3
      End If 
   End If 
Else 
   _STARTED=True
End If 
Gosub T0ASTER
Comp Test On 
Every On 
Return 
'
STPPED:
Comp Test Off 
Gosub PROBAR
If Not _CONTROLSOFF Then Gosub SCR0LL
Gosub T0ASTER
Comp Test On 
Every On 
Return 
'
CLRPLY:
Fill P_STARTB1 To P_STARTB1+FSIZE,0
Fill P_STARTB2 To P_STARTB2+FSIZE,0
Return 
'
CLREMPTY:
If Fn INVIEW
   N=1
   Repeat 
      If Length(N+JB)=0
         Fill P_STARTB1+(BSIZE*(N-1)) To P_STARTB1+(BSIZE*N)+BSIZE,0
         Fill P_STARTB2+(BSIZE*(N-1)) To P_STARTB2+(BSIZE*N)+BSIZE,0
      End If 
      Inc N
   Until N>_CH
End If 
Return 
'
CHECKMUTE:
C=0 : K=1
Repeat 
   C=C or MUTE(K)
   Inc K
Until K>_CH
Return 
'
SETMUTE:
I=1
Repeat 
   If MUTE(I)
      Volume PAULA(I),N
   End If 
   Inc I
Until I>4 : Rem hardware channels
Return 
'
'
'
'***************************************************************************** 
'*position******************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   ::::::::.     ...      .::::::.  :::  :::::::::: :::      ...     ::.    :::.
'   `;;```.;;; .;;;;;;;.  ;;;`    `; ;;;  ;;;;;;;''' ;;;   .;;;;;;;.  ;;;;,  `;;;
'   `]]nnn]]' ,[[     \[[,'[==/[[[[, [[[      [[     [[[  ,[[     \[[, [[[[[. '[[
'    $$$""    $$$,     $$$  '''    $ $$$,     $$     $$$, $$$,     $$$ $$$ "Y$c$$
'    888o     "888,_ _,88P,88b    dPo88888    88,   o88888"888,_ _,88P888    Y88 
'    YMMMb      "YMMMMMP"   "YMmMY" MMM"MM    MMM   MMM"MM  "YMMMMMP" MM     YM
'
'
'
POS:
If _MENUDO or _POSITIONOFF or _DIRECT Then Return 
If Fn MULTI
   POS_Y=HDR_H
   Gosub GFXSET
   SBCOUNT=1
   Repeat 
      If ADVPOS#(SBCOUNT)>0
         XP(SBCOUNT)=Int((OFFSET(SBCOUNT)+1)/ADVPOS#(SBCOUNT))-1
         If Fn WANDZOOM
            XP(SBCOUNT)=Int(XP(SBCOUNT)-(ST/ADVPOS#(SBCOUNT)))
         End If 
         If Not RENDERING
            If XP2(SBCOUNT)-XP(SBCOUNT)
               Gr Writing %10
               Draw XP(SBCOUNT),POS_Y To XP(SBCOUNT),POS_Y+POS_H
               Ink WHITE
               If XP2(SBCOUNT)>-1
                  Draw XP2(SBCOUNT),POS_Y To XP2(SBCOUNT),POS_Y+POS_H
               End If 
               XP2(SBCOUNT)=XP(SBCOUNT)
            End If 
         End If 
      End If 
      Add POS_Y,POS_H
      Inc SBCOUNT
   Until SBCOUNT>_CH
   Gosub GFXRESTORE
   If Not RENDERING
      Gr Writing %1
   End If 
Else 
   If ADVPOS#(1)>0 and OFFSET(1)>0
      If STA>0
         XP(1)=Int(OFFSET(1)/ADVPOS#(1))
         If Fn WANDZOOM
            If ST>0
               XP(1)=Int(XP(1)-(ST/ADVPOS#(1)))
            End If 
         Else 
            If STA>0 and RST>0
               XP(1)=Int(XP(1)-(STA/ADVPOS#(1))+(RST/ADVPOS#(1)))
            End If 
         End If 
      Else 
         XP(1)=Int((OFFSET(1)-ST)/ADVPOS#(1))
      End If 
      If Not RENDERING
         If XP(1)-XP2(1)
            If XP(1)>-1
               Gr Writing %10
               Draw XP(1),POS_T To XP(1),POS_B
               Ink _WHITE
               If XP2(1)>-1
                  Draw XP2(1),POS_T To XP2(1),POS_B
               End If 
               Gr Writing %1
            End If 
            XP2(1)=XP(1)
         End If 
      End If 
   End If 
End If 
Return 
'  
SYNC:
If CON#<=0 Then Return 
SBCOUNT=PBANK-7
If SBCOUNT<0
   SBCOUNT=1
Else If SBCOUNT>_MODE
   SBCOUNT=_MODE
End If 
POS#=TIME(SBCOUNT)/CON#
If Q_START<Q_END
   If Not _TEXT
      BEAT=Int(POS#/(SCR_W/_TIMEDIV#))
      If SBEAT-BEAT
         SBEAT=BEAT
         CL=Hunt(Q_START To Q_END,_NEWLINE$)
         If CL>Q_START
            Trap DISPATCH$=DISPATCH$+Peek$(Q_START,CL-Q_START)
            Q_START=CL+1
            If Errtrap
               DISPATCH$="NOSPACE,"
               Return 
            Else If Left$(DISPATCH$,5)=_NDPQ$ : Rem no dispatch queue
               Goto DISPATCH
            End If 
         End If 
      End If 
   End If 
End If 
If NETSYNC
   BEAT=Int(POS#/13.3333)
   If Btst(0,BEAT)
      If NBEAT-BEAT
         Add NETCOUNT,4
         Loke Varptr(MSG$)+20,NETCOUNT
         Gosub SOCK_SENDSYNC
         NBEAT=BEAT
      End If 
   End If 
End If 
If _MENUDO or RENDERING Then Return 
If _METRO
   BEAT=Int(POS#/(SCR_W/(_TIMEDIV#/2)))
   If Btst(0,BEAT)
      If MBEAT
         MBEAT=False : Goto METROC
      End If 
   Else If Not MBEAT
      MBEAT=True : Goto METRO
   End If 
End If 
Return 
'
POSCAL:
P_LENGTH=Length(PBANK)
If P_LENGTH=0 Then Return 
P_START=Start(PBANK)
If Fn MULTI
   PAC=1
   Repeat 
      ADVPOS#(PAC)=(D_LENGTH(PAC)-BSIZE-ST-FIN)/SCR_W#
      Inc PAC
   Until PAC>_CH
Else 
   If Fn STEREO
      P_LENGTH=P_LENGTH/2
   Else If Fn QUAD
      P_LENGTH=P_LENGTH/4
   End If 
   ADVPOS#(1)=(L-BSIZE)/SCR_W#
End If 
Return 
'
NUDGEPOS:
If _POSITIONOFF Then Return 
If STPPED Then Return 
NPCOUNT=1 : C=0
Repeat 
   Add C,XP(NPCOUNT)
   Inc NPCOUNT
Until NPCOUNT>_CH
If C=0 and Fn WANDZOOM=False Then Return 
Gosub GFXSET
If Fn MULTI
   NPY=HDR_H
   NPCOUNT=1
   Repeat 
      If D_LENGTH(NPCOUNT)>0 and XP(NPCOUNT)>0
         Ink _WHITE
         Gr Writing %10
         Draw XP(NPCOUNT),NPY To XP(NPCOUNT),NPY+POS_H
      End If 
      Add NPY,POS_H
      Inc NPCOUNT
   Until NPCOUNT>_CH
Else 
   Gr Writing %10
   Draw XP2(1),POS_T To XP2(1),POS_B
End If 
Gr Writing %1
Goto GFXRESTORE
NUDGEMULTIPOS:
Gr Writing %10
Draw XP2(B),(NPY*B) To XP2(1),(NPY*B)+POS_H
Gr Writing %1
Goto GFXRESTORE
'
CLRPOS:
D=1
Repeat 
   XP(D)=0 : XP2(D)=-1
   Inc D
Until D>_CH
Return 
'
CLRMULTIPOS:
If Fn MULTIINVIEW
   XP(B)=0 : XP2(B)=-1
End If 
Return 
'
'  
'
'***************************************************************************** 
'*draw************************************************************************ 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'  
'   ::::::-.  :::::::..    :::.     .::    .   .:: 
'   ;;,   `';,;;;;``;;;;   ;;`;;    ';;,  ;;  ;;;' 
'   `[[     [[\[[[,/[[['  ,[[ '[[,   '[[, [[, [['  
'    $$,    $$"$$$$$$c   c$$$cc$$$c    Y$c$$$c$P   
'    888_,o8P',888b "88bo 888   888,    "88"888    
'   "MMMMP"`  "MMMM   "W" YMM   ""`      "M "M"    
'
'
'
_DRAWALL:
Gosub CLRPOS
RENDERING=True
Gosub _DRAW
Gosub FRSHSEL
RENDERING=False
Return 
'
_SHOWCOPY:
Gosub CLRPOS
RENDERING=True
Gosub SH0WWAVE
Gosub FRSHSEL
RENDERING=False
Return 
'
BACKCOPY:
If _MENUDO
   If Fn MULTI
      Screen Copy 1,SCRX,SCRY-2,SCRX+SCRW,RNG_T To 0,SCRX,HDR_H+SCRY-2
      If B=1
         SCRT=SCRY-2
      Else 
         SCRT=RNG_T-1
      End If 
      SCRB=RNG_B
   Else 
      SCRT=SCRY-2 : SCRB=SCRY+SCRH-6
   End If 
   SCRM=SCRY+SCRH+3
Else 
   SCRT=SCRY-11 : SCRB=SCRT+SCRH+1
End If 
If XR<=SCRX-1 and XR2>SCRX and XR2>=SCRX+SCRW-1
   Screen Copy 1,SCRX,SCRT,SCRX+SCRW,SCRB To 0,SCRX,HDR_H+SCRT,%110000
Else If XR<=SCRX-1 and XR2>SCRX and XR2<=SCRX+SCRW-1
   Screen Copy 1,SCRX,SCRT,XR2,SCRB To 0,SCRX,HDR_H+SCRT,%110000
   Screen Copy 1,XR2,SCRT,SCRX+SCRW,SCRB To 0,XR2,HDR_H+SCRT
Else If XR>=SCRX-1 and XR2>SCRX and XR2>=SCRX+SCRW-1
   Screen Copy 1,SCRX,SCRT,SCRX+SCRW,SCRB To 0,SCRX,HDR_H+SCRT
   Screen Copy 1,XR,SCRT,SCRX+SCRW,SCRB To 0,XR,HDR_H+SCRT,%110000
Else If XR>=SCRX-1 and XR2>SCRX and XR2<=SCRX+SCRW-1
   Screen Copy 1,SCRX,SCRT,XR,SCRB To 0,SCRX,HDR_H+SCRT
   Screen Copy 1,XR,SCRT,XR2,SCRB To 0,XR,HDR_H+SCRT,%110000
   Screen Copy 1,XR2,SCRT,SCRX+SCRW,SCRB To 0,XR2,HDR_H+SCRT
Else 
   Screen Copy 1,SCRX,SCRT,SCRX+SCRW,SCRB To 0,SCRX,HDR_H+SCRT
End If 
If _MENUDO
   If Fn MULTI
      Screen Copy 1,SCRX,RNG_B,SCRX+SCRW,SCRY+SCRH To 0,SCRX,HDR_H+RNG_B
   End If 
   If RL>0 and Not _TEXT
      Gosub DRWMARKS
   End If 
   If SCRM>CTL_Y
      Gosub SETSELV
      If SCRM<WND_H
         Ink _PANE
         Draw SCRX,CTL_Y To SCRX+SCRW,CTL_Y
         Gosub MAGICWAND
      Else 
         Gosub CONTROLS
      End If 
   End If 
   If CALC
      If SCRX+SCRW>CAL_X and SCRM+HDR_H>CAL_Y
         Gosub CAL_BCK
      End If 
   End If 
End If 
Return 
'
_SHOWALL:
Gosub SETPBANK
XD=0 : XD2=SCR_W : ST=0 : FIN=0 : L=0
Gosub CLRPOS
RENDERING=True
Gosub _DRAW
Gosub MAGICWAND
Gosub FRSHSEL
Gosub HIGHPIANO
RENDERING=False
Gosub HEADER
Goto DRWTIME
'
_DRAW:
If BNK_H<WVE_H
   If _CONTROLSOFF
      Ink _BG
   Else 
      Ink _PANE : Rem 16 channel ntsc
   End If 
   Bar 0,SCR_B To SCR_W,CTL_Y
End If 
DCY=SCR_B
Ink _PANE
Repeat 
   Bar 0,DCY--_DSTEP To SCR_W,DCY
   Add DCY,_DSTEP
Until DCY=<HDR_H
Ink _SHADOW
If _MODE=1
   DCY=HDR_H+(WVE_H/2)
   Draw 0,DCY To SCR_W,DCY
Else 
   DCY=HDR_H+WVE_D
   While DCY<SCR_B
      Draw 0,DCY To SCR_W,DCY
      Add DCY,WVE_D
   Wend 
End If 
If _MODE>2
   DCY=-(BNK_H/(_CH*2))+WVE_D+HDR_H
   While DCY<SCR_B
      Draw 0,DCY To SCR_W,DCY
      Add DCY,WVE_D
   Wend 
End If 
If Fn MONOORSTEREOORQUAD and P_LENGTH=0 Then Goto C0PYWAVE
Ink _WHITE
If SCR_H>200+XTR_H
   If XTR_H
      DRWDIV=272
   Else 
      DRWDIV=370
   End If 
Else 
   If XTR_H
      DRWDIV=356
   Else 
      DRWDIV=542
   End If 
End If 
BPS=QUAL(B)
If BPS=0 Then BPS=1
On _MODE Goto D1,D2,D3,D4
'
D1:
DRWSUB=(127*256)/DRWDIV
DRWSUB2=-(DRWSUB*2)-2
D=HDR_H+(WVE_H/2)
ADV#=(P_LENGTH-ST-FIN)/SCR_W#
ST= Fn BPSALIGN(ST)
D_START(1)=P_START+ST
DN=(Peek(D_START(1))*256)/DRWDIV
If DN>DRWSUB Then Add DN,DRWSUB2
Gr Locate 0,DN+D
DI=0
Repeat 
   DN= Fn BPSALIGN(DI*ADV#)
   DN=(Peek(D_START(1)+DN)*256)/DRWDIV
   If DN>DRWSUB Then Add DN,DRWSUB2
   Draw To DI,DN+D
   Add DI,_STEP
Until DI>WVE_W
Goto C0PYWAVE
'
D2:
DRWDIV=DRWDIV*2
DRWSUB=(127*256)/DRWDIV
DRWSUB2=-(DRWSUB*2)-2
D=WVE_H/2
ADV#=(P_LENGTH-ST-FIN)/SCR_W#
ST= Fn BPSALIGN(ST)
D_START(1)=P_START+ST
D_START(2)=D_START(1)+P_LENGTH
DCY=HDR_H+(D/2)
DC=1
Repeat 
   DN=(Peek(D_START(DC))*256)/DRWDIV
   If DN>DRWSUB Then Add DN,DRWSUB2
   Gr Locate 0,DN+DCY
   DI=1
   Repeat 
      DN= Fn BPSALIGN(DI*ADV#)
      DN=(Peek(D_START(DC)+DN)*256)/DRWDIV
      If DN>DRWSUB Then Add DN,DRWSUB2
      Draw To DI,DN+DCY
      Add DI,_STEP
   Until DI>WVE_W
   Add DCY,D
   Inc DC
Until DC>2
Goto C0PYWAVE
'
D3:
DRWDIV=DRWDIV*4
DRWSUB=(127*256)/DRWDIV
DRWSUB2=-(DRWSUB*2)-2
D=WVE_H/4
ADV#=(P_LENGTH-ST-FIN)/SCR_W#
DI=0
DC=1
ST= Fn BPSALIGN(ST)
Repeat 
   D_START(DC)=P_START+ST+DI
   Add DI,P_LENGTH
   Inc DC
Until DC>4
DCY=HDR_H+(D/2)
DC=1
Repeat 
   DN=(Peek(D_START(DC))*256)/DRWDIV
   If DN>DRWSUB Then Add DN,DRWSUB2
   Gr Locate 0,DN+DCY
   DI=1
   Repeat 
      DN= Fn BPSALIGN(DI*ADV#)
      DN=(Peek(D_START(DC)+DN)*256)/DRWDIV
      If DN>DRWSUB Then Add DN,DRWSUB2
      Draw To DI,DN+DCY
      Add DI,_STEP
   Until DI>WVE_W
   Add DCY,D
   Inc DC
Until DC>4
Goto C0PYWAVE
'
D4:
If _8CH or _16CH
   If XTR_H
      Add DRWDIV,-16
   Else 
      Add DRWDIV,-30
   End If 
End If 
DRWDIV=DRWDIV*_CH
DRWSUB=(127*256)/DRWDIV
DRWSUB2=-(DRWSUB*2)-2
If _CONTROLSOFF and(_8CH or _16CH or Fn STEREOORQUAD) Then Inc DRWSUB2
D=WVE_D
DC=1
ST= Fn BPSALIGN(ST)
Repeat 
   D_LENGTH(DC)=Length(DC+JB)
   BPS=QUAL(DC)
   If BPS=0
      BPS=1
   End If 
   If D_LENGTH(DC)>0
      ADV#(DC)=(D_LENGTH(DC)-ST-FIN)/SCR_W#
      D_START(DC)=Start(DC+JB)+ST
   Else 
      ADV#(DC)=0
   End If 
   Inc DC
Until DC>_CH
DCY=HDR_H+(D/2)
If _8CH or _16CH Then Inc DCY
DC=1
Repeat 
   If ADV#(DC)>0
      DN=(Peek(D_START(DC)+1)*256)/DRWDIV
      If DN>DRWSUB
         Add DN,DRWSUB2
      End If 
      Gr Locate 0,DN+DCY
      DI=1
      Repeat 
         BPS=QUAL(DC)
         If BPS=0
            BPS=1
         End If 
         DN= Fn BPSALIGN(DI*ADV#(DC))
         DN=(Peek(D_START(DC)+DN)*256)/DRWDIV
         If DN>DRWSUB
            Add DN,DRWSUB2
         End If 
         Draw To DI,DN+DCY
         Add DI,_STEP
      Until DI>WVE_W
   End If 
   Add DCY,D
   Inc DC
Until DC>_CH
'
C0PYWAVE:
If Fn MOUSEUP
   Gosub DRWDIV
   DCY=CTL_Y
   Repeat 
      Screen Copy 0,0,DCY--_DSTEP,WVE_W,DCY To 1,0,(DCY--_DSTEP)-HDR_H
      Add DCY,_DSTEP
   Until DCY<0
End If 
Return 
'
SH0WWAVE:
DCY=WVE_H
Repeat 
   Screen Copy 1,0,DCY--_DSTEP,WVE_W,DCY To 0,0,HDR_H+DCY--_DSTEP
   Add DCY,_DSTEP
Until DCY<0
Gosub CAL_BCK
Gosub HIGHPIANO
If SCR_H<256 Then Goto CONTROLS
Return 
'
HIGHDIV:
Ink _BRIGHT
Goto D
DRWDIV:
Ink _SHADOW
D:
DI#=_TIMEBEAT#
If(DI#<=40) Then DI#=DI#-1
DE#=SCR_W-_TIMEBEAT#+1
DRWDIV=WVE_H/_CH : DCY=HDR_H+(DRWDIV*(_CH/2)) : DC=DCY+DRWDIV : DN=HDR_H+(DRWDIV*_CH)+1
D=HDR_H
While D<DN
   INF_H=1
   DI#=_TIMEBEAT#
   Repeat 
      DI=Int(DI#)
      If D<DCY
         Draw DI,D To DI,D+INF_H
      Else If D>DCY+1
         Draw DI,D-INF_H To DI,D
      End If 
      DI#=DI#+_TIMEBEAT#
      If INF_H=1 Then INF_H=2 Else INF_H=1
   Until DI#>=DE#
   Add D,DRWDIV
   If _MODE<4 Then Add D,DRWDIV
Wend 
Return 
'
DRWTIME:
If RENDERING Then Return 
DRWTIMENOW:
Gosub GFXSET
T_LENGTH=P_LENGTH/_BYPS
Gosub TIME_ALL
If DIV#>0
   If DIV#>9
      T$=Str$(DIV#)-_SPACE$+T$
   Else 
      T$=Str$(DIV#)+T$
   End If 
   If Len(T$)<22
      T$=Space$(22-Len(T$))+T$
   End If 
Else 
   T$=Space$(22)
End If 
Ink _SHADOW,_PANE
Text SCR_W-40-Text Length(T$),NFO_Y,T$
If Len(T$)>22 : Rem mix loop button fix  
   _NUDGETIME=True
Else If _NUDGETIME
   _NUDGETIME=False
   Gosub LPMIXBTN
End If 
If _TIMEONLY
   _TIMEONLY=False
   Return 
End If 
DRWHZ:
T$=Str$(FREQ)+_SPACE$ : T$=Space$(7-Len(T$))+T$+_HZ$
Ink _SHADOW,_PANE
Text 102-Text Length(T$),NFO_Y,T$
Gosub CAL_BCK
DRWBITS:
T$= Fn QPROP$
Ink _SHADOW,_PANE
Text 172,NFO_Y,Space$(5)
If _BYPS=1 Then Text 176,NFO_Y,T$ Else Text 172,NFO_Y,T$
Goto GFXRESTORE
'
HEADER:
Gosub MEMORY
If MEMORY<1000000
   MEMORY=MEMORY/1000
   T$=_KILO$
Else 
   MEMORY=MEMORY/_MEGABYTE
   T$=_MEGA$
End If 
T$="Free:"+Str$(MEMORY)-_SPACE$+T$
H=Max(0,10-Len(T$))
Gosub GFXSET
Ink _PANE
Bar 0,0 To SCR_W,HDR_H-1
Ink _SHADOW,_PANE
If Len(F$)<19+H Then Text 6,8,Str$(B)-_SPACE$+_COLON$+F$ Else Text 6,8,Str$(B)-_SPACE$+_COLON$+Left$(F$,17+H)+_DOTS$
H=H*8
Text SCR_W-83+H,8,T$
'
HEADERCORDS:
Ink _SHADOW,_PANE
T$=Str$(P_LENGTH/_BYPS)-_SPACE$ : Text 186+H,8,"Size:"+T$+Space$(10-Len(T$))
T$=Str$(RST/_BYPS)-_SPACE$ : Text 304+H,8,"Start:"+T$+Space$(10-Len(T$))
T$=Str$(RL/_BYPS)-_SPACE$ : Text 430+H,8,"Range:"+T$+Space$(10-Len(T$))
Set Zone ZN_START,304+H,0 To 430+H,HDR_H
Set Zone ZN_RANGE,430+H,0 To SCR_W-83+H,HDR_H
Goto GFXRESTORE
'  
'
'
'***************************************************************************** 
'*zoom*wand******************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   ::::::::     ...         ...      .        :   
'   `````;;;  .;;;;;;;.   .;;;;;;;.   ;;,.    ;;;  
'       .n[[',[[     \[[,,[[     \[[, [[[[, ,[[[[, 
'     ,$$P"  $$$,     $$$$$$,     $$$ $$$$$$$$"$$$ 
'   ,888bo,_ "888,_ _,88P"888,_ _,88P888 Y88" 888o 
'    `""*UMM   "YMMMMMP"   "YMMMMMP" MM  M'  "MMMM 
'
'
'
WHEELZOOM:
If SETTING$(22)=_FALSE$ or P_LENGTH=0 or RENDERING Then Return 
If CY>HDR_H and CY<WND_H
   If Fn MULTIINVIEW
      _MIN=B
   Else 
      _MIN=1
   End If 
   _MIN=Int(ADVPOS#(_MIN)/2)
   _MIN=Min(10,_MIN) : _MIN=Max(1,_MIN)
   _SCROLLING=False
   If Fn MOUSEWHEELUP : Rem zoom in
      If XD<XD2
         If XD2>XD+40
            Add XD,(CX-XD)/_MIN
            If XD2>0
               Add XD2,-((XD2-CX)/_MIN)
            End If 
         Else If XD+2<XD2
            Inc XD
            If XD2>0
               Dec XD2
            End If 
         End If 
      End If 
   Else If Fn MOUSEWHEELDOWN : Rem zoom out 
      If XD2>XD+40
         If CX>XD+40
            Add XD,-(CX-XD)/_MIN
         Else 
            Add XD,-20
         End If 
         If XD2>CX+40
            Add XD2,(XD2-CX)/_MIN
         Else 
            Add XD2,20
         End If 
      Else 
         Dec XD
         Inc XD2
      End If 
      XD=Max(0,XD)
      XD2=Min(SCR_W,XD2)
   End If 
   Gosub KEY
   If C=0 : Rem check if still scrolling 
      Gosub WREFRSH
   Else 
      _SCROLLING=True
   End If 
End If 
Return 
'
MAGICWAND:
If DISPPLY
   If ST+FIN=0
      STA=0 : FI=P_LENGTH
   Else 
      STA=ST : FI=P_LENGTH-FIN
   End If 
End If 
Gosub SETCORDS
Gosub SETZN
WND_L=XD+43 : WND_R=XD2-43
Gosub GFXSET
If WND_L<WND_R
   If XD>0
      Ink _PANE
      Bar 0,WND_Y To XD,WND_H
   End If 
   Ink _BLACK
   Bar WND_L,WND_Y To WND_R,WND_H
   Ink _WHITE
   Bar XD,WND_Y To WND_L,WND_H
   Bar WND_R,WND_Y To XD2,WND_H
   If XD2<SCR_W
      Ink _PANE
      Bar XD2,WND_Y To SCR_W,WND_H
   End If 
   Set Zone ZN_MIDDLEWAND,WND_L,WND_Y To WND_R,WND_H
   Set Zone ZN_LEFTWAND,XD,WND_Y To WND_L,WND_H
   Set Zone ZN_RIGHTWAND,WND_R,WND_Y To XD2,WND_H
   WXD=XD
Else : Rem micro zoom 
   WND_Z=WXD+23 : WND_N=WND_Z+43 : WND_S=WND_N+23
   If XD2<SCR_W and WND_S<SCR_W
      If WXD>0
         Ink _PANE
         Bar 0,WND_Y To WXD,WND_H
      End If 
      Ink _BLACK
      Bar WND_Z,WND_Y To WND_N,WND_H
      Ink _HIGHLIGHT
      Bar WXD,WND_Y To WND_Z,WND_H
      Bar WND_N,WND_Y To WND_S,WND_H
      If WND_S<SCR_W
         Ink _PANE
         Bar WND_S,WND_Y To SCR_W,WND_H
      End If 
      Set Zone ZN_MIDDLEWAND,WND_Z,WND_Y To WND_N,WND_H
      Set Zone ZN_LEFTWAND,WXD,WND_Y To WND_Z,WND_H
      Set Zone ZN_RIGHTWAND,WND_N,WND_Y To WND_S,WND_H
   Else : Rem visual stop at right hand side movement off screen   
      WND_Z=SCR_W-23 : WND_N=WND_Z-43 : WND_S=WND_N-23
      If WND_S>0
         Ink _PANE
         Bar 0,WND_Y To WND_S,WND_H
      End If 
      Ink _BLACK
      Bar WND_N,WND_Y To WND_Z,WND_H
      Ink _HIGHLIGHT
      Bar WND_S,WND_Y To WND_N,WND_H
      If WND_Z<SCR_W
         Bar WND_Z,WND_Y To SCR_W,WND_H
      End If 
      Set Zone ZN_MIDDLEWAND,WND_N,WND_Y To WND_Z,WND_H
      Set Zone ZN_LEFTWAND,WND_S,WND_Y To WND_N,WND_H
      Set Zone ZN_RIGHTWAND,WND_Z,WND_Y To SCR_W,WND_H
   End If 
End If 
Goto GFXRESTORE
'  
LEFTWAND:
RENDERING=True
MX=CX : PXD=XD
_SLOW= Fn KEY_SHIFT
Repeat 
   Gosub TESTMOVE
   Gosub KCHOOSE
   Exit If _SLOW<> Fn KEY_SHIFT
   If PX-CX
      If Fn KEY_SHIFT
         XD=PXD-((MX-CX)/3)
         Gosub SLOW
      Else 
         XD=PXD-(MX-CX)
      End If 
      XD=Max(0,Min(XD2-1,XD))
      Gosub WANDDRAW
   Else If Fn KEY_RIGHT
      Inc XD
      Gosub WANDSET
   Else If Fn KEY_LEFT
      Dec XD
      Gosub WANDSET
   End If 
Until Fn MOUSEUP
Goto AFTERWAND
'
RIGHTWAND:
RENDERING=True
MX=CX : PXD2=XD2
_SLOW= Fn KEY_SHIFT
Repeat 
   Gosub TESTMOVE
   Gosub KCHOOSE
   Exit If _SLOW<> Fn KEY_SHIFT
   If PX-CX
      If Fn KEY_SHIFT
         XD2=PXD2-((MX-CX)/3)
         Gosub SLOW
      Else 
         XD2=PXD2-(MX-CX)
      End If 
      XD2=Min(SCR_W,Max(XD+1,XD2))
      Gosub WANDDRAW
   Else If Fn KEY_RIGHT
      Inc XD2
      Gosub WANDSET
   Else If Fn KEY_LEFT
      Dec XD2
      Gosub WANDSET
   End If 
Until Fn MOUSEUP
Goto AFTERWAND
'
MOVEWAND:
Gosub CLRPOS
RENDERING=True
MX=CX : PXD=XD : PXD2=XD2
_SLOW= Fn KEY_SHIFT
Repeat 
   Gosub TESTMOVE
   Gosub KCHOOSE
   Exit If _SLOW<> Fn KEY_SHIFT
   If PX-CX
      If Fn KEY_SHIFT
         XD=PXD-((MX-CX)/3)
         XD2=PXD2-((MX-CX)/3)
         Gosub SLOW
      Else 
         XD=PXD-(MX-CX)
         XD2=PXD2-(MX-CX)
      End If 
      XD2=Max(1,XD2)
      Gosub WANDSET : WXD=XD
   Else If Fn KEY_RIGHT
      Inc XD : Inc XD2
      Gosub WANDSET : WXD=XD
   Else If Fn KEY_LEFT
      Dec XD : Dec XD2
      Gosub WANDSET : WXD=XD
   End If 
Until Fn MOUSEUP
'
AFTERWAND:
Gosub SETSELV
Gosub SETCORDS
Gosub SETZN
Gosub _DRAW
Gosub FRSHSEL
Gosub CAL_BCK
Gosub HIGHPIANO
RENDERING=False
Goto CLRPOS
'
WANDSET:
XD=Min(SCR_W-2,Max(0,XD))
XD2=Min(SCR_W,XD2)
'
WANDDRAW:
If SETTING$(20)<>_FALSE$ : Rem zoom draw
   Gosub SETSELV
   Gosub SETCORDS
   Gosub _DRAW
   Gosub DRWMARKS
End If 
Goto MAGICWAND
'
WREFRSH:
Gosub MAGICWAND
RENDERING=True
Goto AFTERWAND
'  
SETCORDS:
If CON#>0
   If RL>0 and RST>0
      XR=Int((RST/CON#)-(ST/CON#))
      If RL=1
         XR2=XR
      Else 
         XR2=Int(SCR_W-((RFIN/CON#)-(FIN/CON#)))
      End If 
   Else If RST=0
      XR=0
      If RL>1
         XR2=Int(SCR_W-((RFIN/CON#)-(FIN/CON#)))
      Else 
         XR2=0
      End If 
   End If 
End If 
XR=Min(SCR_W,Max(0,XR))
XR2=Min(SCR_W,Max(0,XR2))
CON#=P_LENGTH/SCR_W#
ST=Int(XD*CON#)
FIN=Int((SCR_W-XD2)*CON#)
L=P_LENGTH-ST-FIN
Goto POSCAL
'
'
'
'***************************************************************************** 
'*range*********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   :::::::..    :::.     ::.    :::. .,-:::::/  .,::::::
'   ;;;;``;;;;   ;;`;;    ;;;;,  `;;;;;-'````'   ;;;;''''
'   \[[[,/[[['  ,[[ '[[,   [[[[[. '[[[[   [[[[[[/ [[cccc 
'   "$$$$$$c   c$$$cc$$$c  $$$ "Y$c$$$$c.    "$$  $$"""" 
'   ,888b "88bo 888   888,888    Y88 `Y8bo,,,o88  888oo,_
'   "MMMM   "W" YMM   ""` MM     YM    `'YMUP"YMM """"YUM
'
'
'
_RANGEALL:
If P_LENGTH=0 Then Goto FLSHSCR
REQ=True
Gosub PBANKLEN
STA=0 : ST=0 : XR=0 : XR2=SCR_W : RST=0 : RL=FI : RFIN=0
If MACRO Then Return 
If Fn MONOORSTEREOORQUAD or Fn MULTIINVIEW Then Goto RNG
Goto HEADERCORDS
'
_RANGEDISPLAY:
If P_LENGTH=0 or( Fn MONOORSTEREOORQUAD=False and Fn MULTIINVIEW=False) Then Goto FLSHSCR
REQ=True
XR=0 : XR2=SCR_W
Gosub SETSELCORDS
STA=RST : FI=RST+RL
If MACRO Then Return 
'
RNG:
If Fn MULTI Then Gosub CLRMULTIPOS Else Gosub CLRPOS
RENDERING=True
Gosub FRSHSEL
RENDERING=False
Gosub SETZN
Gosub CAL_BCK
Gosub HIGHPIANO
Goto HEADERCORDS
'
_RANGENONE:
If RL=0 Then Return 
Gosub NUDGEPOS
If RNGEPLY
   STA=0 : ST=0 : FI=P_LENGTH
End If 
Gosub CLRRNG
XR=0 : XR2=0 : LXR=0 : LXR2=0
Gosub RNGC
If MACRO Then Return 
REQ=True
Gosub SETZN
Gosub NUDGEPOS
Gosub CAL_BCK
Gosub HIGHPIANO
Goto HEADERCORDS
'
_SHOWRANGE:
If P_LENGTH=0 or RL<2 Then Goto FLSHSCR
ST=RST : FIN=RFIN
XD=ST/CON# : Inc XD : XD2=(P_LENGTH-FIN)/CON# : WXD=XD
Gosub MAGICWAND
RENDERING=True
Goto AFTERWAND
'
_START: Rem header 
If P_LENGTH=0 Then Goto FLSHSCR
S$="Start"
Gosub _OPENFXTEXTWIN
TXT1$=_$
T$=Str$(RST/_BYPS)-_SPACE$ : Gosub _RUNFXTEXTWIN
If T$=_$ Then REQ=False
If REQ
   T$=T$+Str$(RL/_BYPS)
   MACRO=True
   Gosub ¯RANGE
   MACRO=False
End If 
Return 
'
_RANGE: Rem header 
If P_LENGTH=0 Then Goto FLSHSCR
S$="Range"
Gosub _OPENFXTEXTWIN
TXT1$=_$
T$=Str$(RL/_BYPS)-_SPACE$ : Gosub _RUNFXTEXTWIN
If T$=_$ Then REQ=False
If REQ
   T$=Str$(RST/_BYPS)-_SPACE$+_SPACE$+T$
   MACRO=True
   Gosub ¯RANGE
   MACRO=False
End If 
Return 
'
RANGE:
_PLP=_LP : _LP=True : _RANGE=True
If Fn MULTI
   If P_LENGTH>0
      Gosub NUDGEPOS
      Gosub CLRRNG
      If Fn INVIEW
         If XP(B)>XR and XP(B)<XR2
            Gosub NUDGEMULTIPOS
         End If 
      End If 
      Gosub CLRPOS
   End If 
   B=Min(_CH,((CY-HDR_H)/WVE_D)+1) : Gosub SETBANK
Else 
   Gosub NUDGEPOS
   Gosub CLRRNG
   Gosub CLRPOS
End If 
Gosub HIGHPIANO
If P_LENGTH=0 Then Return 
If Fn KEY_SHIFT Then MX= Fn CHUNKY(CX) Else MX=CX
PXR=XR : PXR2=XR2
XR=MX : LXR=XR
XR2=XR : LXR2=XR2
Gosub RNGMARKS
Gosub CAL_BCK

Gosub SETSELCORDS
RENDERING=True
Goto SELRIGHTSWAP
'
SELLEFT:
_RANGE=False
Gosub NUDGEPOS
Gosub CLRPOS
Gosub UNR0LLLEFT
PXR=XR : PXR2=XR2
RENDERING=True
'
SELLEFTSWAP:
If XR>XR2 Then Gosub XRSWAP
If Fn KEY_SHIFT Then MX= Fn CHUNKY(CX) Else MX=CX
MXR=XR
LXR=XR
LXR2=XR2
Repeat 
   Gosub TESTMOVE
   If Fn KEY_ESC Then Goto SELCANCEL
   If Fn KEY_SHIFT Then CX= Fn CHUNKY(CX)
   Gosub KCHOOSE
   If PX-CX
      Gosub FRSHLEFT
   Else If Fn KEY_RIGHT
      Inc XR : Inc MXR
      Gosub FRSHLEFTKEY
   Else If Fn KEY_LEFT
      Dec XR : Dec MXR
      Gosub FRSHLEFTKEY
   End If 
   If XR>XR2
      If Fn KEY_SHIFT
         MX= Fn CHUNKY(MX)
      End If 
      Goto SELRIGHTSWAP
   End If 
Until Fn MOUSEUP or Fn KEY_ESC
RENDERING=False
If Z=ZN_LEFTRANGE Then Goto R0LLLEFT
Return 
'  
FRSHLEFT:
XR=MXR-(MX-CX)
'
FRSHLEFTKEY:
XR=Min(SCR_W,Max(0,XR))
Gosub SETLSELCORDS
If Not _RANGE Then Gosub RNGREPLAY
If XR>XR2
   D=RNG_B
   Repeat 
      If LXR<XR2
         Screen Copy 1,LXR,D--_DSTEP,XR2,D To 0,LXR,HDR_H+(D--_DSTEP)
      End If 
      If XR>LXR2
         Screen Copy 1,LXR2,D--_DSTEP,XR,D To 0,LXR2,HDR_H+(D--_DSTEP),%11000
      Else 
         Screen Copy 1,XR,D--_DSTEP,LXR2+1,D To 0,XR,HDR_H+(D--_DSTEP)
      End If 
      Add D,_DSTEP
   Until D<RNG_T
   LXR=XR2
   LXR2=XR
Else 
   D=RNG_B
   Repeat 
      If LXR2>XR2
         Screen Copy 1,XR2,D--_DSTEP,LXR2+1,D To 0,XR2,HDR_H+(D--_DSTEP)
      End If 
      If XR>LXR
         Screen Copy 1,LXR,D--_DSTEP,XR,D To 0,LXR,HDR_H+(D--_DSTEP)
      Else 
         Screen Copy 1,XR,D--_DSTEP,LXR+1,D To 0,XR,HDR_H+(D--_DSTEP),%110000
      End If 
      Add D,_DSTEP
   Until D<RNG_T
   LXR2=XR2
   LXR=XR
End If 
Gosub RNGMARKS
Goto HIGHPIANO
'
SELRIGHT:
_RANGE=False
Gosub NUDGEPOS
Gosub CLRPOS
Gosub UNR0LLRIGHT
PXR=XR : PXR2=XR2
RENDERING=True
'
SELRIGHTSWAP:
If XR>XR2 Then Gosub XRSWAP
If Fn KEY_SHIFT Then MX= Fn CHUNKY(CX) Else MX=CX
MXR2=XR2
LXR=XR
LXR2=XR2
Repeat 
   Gosub TESTMOVE
   If Fn KEY_ESC Then Goto SELCANCEL
   If Fn KEY_SHIFT Then CX= Fn CHUNKY(CX)
   Gosub KCHOOSE
   If PX-CX
      Gosub FRSHRIGHT
   Else If Fn KEY_RIGHT
      Inc XR2 : Inc MXR2
      Gosub FRSHRIGHTKEY
   Else If Fn KEY_LEFT
      Dec XR2 : Dec MXR2
      Gosub FRSHRIGHTKEY
   End If 
   If XR>XR2
      If Fn KEY_SHIFT
         MX= Fn CHUNKY(MX)
      End If 
      Goto SELLEFTSWAP
   End If 
Until Fn MOUSEUP or Fn KEY_ESC
RENDERING=False
If _RANGE=False and Z=ZN_RIGHTRANGE Then Gosub R0LLRIGHT
If XR=XR2
   Gosub SETSELCORDS
   RL=1
   Gosub HEADERCORDS
End If 
If _RANGE
   _LP=_PLP
   Goto SELREPLAY
End If 
Return 
'
FRSHRIGHT:
XR2=MXR2-(MX-CX)
'
FRSHRIGHTKEY:
XR2=Min(SCR_W,Max(0,XR2))
Gosub SETRSELCORDS
Gosub HIGHPIANO
If Not _RANGE Then Gosub RNGREPLAY
If XR>XR2
   D=RNG_B
   Repeat 
      If LXR2>XR
         Screen Copy 1,XR,D--_DSTEP,LXR2+1,D To 0,XR,HDR_H+(D--_DSTEP)
      End If 
      If XR2<LXR
         Screen Copy 1,XR2,D--_DSTEP,LXR+1,D To 0,XR2,HDR_H+(D--_DSTEP),%110000
      Else 
         Screen Copy 1,LXR,D--_DSTEP,XR2,D To 0,LXR,HDR_H+(D--_DSTEP)
      End If 
      Add D,_DSTEP
   Until D<=RNG_T
   LXR2=XR
   LXR=XR2
Else 
   D=RNG_B
   Repeat 
      If LXR<XR
         Screen Copy 1,LXR,D--_DSTEP,XR,D To 0,LXR,HDR_H+(D--_DSTEP)
      End If 
      If XR2>LXR2
         Screen Copy 1,LXR2,D--_DSTEP,XR2,D To 0,LXR2,HDR_H+(D--_DSTEP),%110000
      Else 
         Screen Copy 1,XR2,D--_DSTEP,LXR2+1,D To 0,XR2,HDR_H+(D--_DSTEP)
      End If 
      Add D,_DSTEP
   Until D<=RNG_T
   LXR=XR
   LXR2=XR2
End If 
Gosub RNGMARKS
Goto HIGHPIANO
'
SELCANCEL:
XR=PXR : XR2=PXR2
Gosub SETSELCORDS
Gosub _DRAWALL
Gosub HEADERCORDS
If Fn MONOORSTEREOORQUAD Then Gosub NUDGEPOS
If _RANGE
   Gosub MUP
   Goto SETZN
Else 
   Gosub SETZN
End If 
'
SELREPLAY:
If RNGEPLY
   If Fn MULTI
      OFFSET(B)=RST
   Else 
      OFFSET(1)=RST
   End If 
   _RESTART=True
   STA=RST
   If XR=XR2
      FI=P_LENGTH
   Else 
      FI=STA+RL
   End If 
End If 
Goto MUP
'
RNGREPLAY:
If RNGEPLY
   If RST+RFIN=0
      FI=P_LENGTH
   Else 
      STA=RST
      FI=P_LENGTH-RFIN
   End If 
End If 
Return 
'
R0LLLEFT:
If _MENUDO or RL<2 Then Return 
If XR2>XR+10
   Ink _HIGHLIGHT
   Bar XR+1,RNG_T+HDR_H To XR+10,RNG_B+HDR_H-1
End If 
Return 
'  
UNR0LLLEFT:
If _MENUDO or RL<2 Then Return 
If XR2-XR>12 and XR2>XR Then Screen Copy 1,XR+1,RNG_T-1,XR+HDR_H,RNG_B To 0,XR+1,RNG_T+HDR_H-1,%110000
Goto UNR0LL
'
R0LLRIGHT:
If _MENUDO or RL<2 Then Return 
If XR2>10 and XR2>XR+10
   Ink _HIGHLIGHT
   Bar XR2-10,RNG_T+HDR_H To XR2-1,RNG_B+HDR_H-1
End If 
Return 
'
UNR0LLRIGHT:
If _MENUDO or RL<2 Then Return 
If XR2>12 and XR2>XR+12 Then Screen Copy 1,XR2-11,RNG_T-1,XR2,RNG_B To 0,XR2-11,RNG_T+HDR_H-1,%110000
UNR0LL:
If PXR2>CAL_X or PXR+12>CAL_X Then Gosub CAL_BCK
Goto HIGHPIANO
'
FRSHSEL:
If RL=0 Then Return 
If XR=XR2 or XR+1=XR2 Then Goto DRWMARK
D=RNG_B
Repeat 
   Screen Copy 1,XR,D--_DSTEP,XR2,D To 0,XR,HDR_H+(D--_DSTEP),%110000
   Add D,_DSTEP
Until D<RNG_T
'
DRWMARKS:
Ink _BG
If XR>0 Then Draw XR,RNG_T+HDR_H To XR,RNG_B+HDR_H-1
'
DRWMARK:
Ink _BG
If XR2>0 Then Draw XR2,RNG_T+HDR_H To XR2,RNG_B+HDR_H-1
Return 
'
RNGMARKS:
If P_LENGTH>0 Then Gosub DRWMARKS
Gosub SETZN
If RL>1 and Fn MOUSEUP Then Gosub CAL_BCK
Goto HEADERCORDS
'
CLRRNG:
D=RNG_B
Repeat 
   Screen Copy 1,XR,D--_DSTEP,XR2+2,D To 0,XR,HDR_H+(D--_DSTEP)
   Add D,_DSTEP
Until D<RNG_T
Return 
'
RNGC:
RST=0 : RL=0 : RFIN=0
Return 
'
XRSWAP:
Swap XR,XR2
Goto SETSELCORDS
'
SETSELV:
P_LENGTH=Length(PBANK)
If Fn STEREO
   P_LENGTH=P_LENGTH/2
Else If Fn QUAD
   P_LENGTH=P_LENGTH/4
End If 
If L>0 Then CON#=L/SCR_W# Else CON#=P_LENGTH/SCR_W#
Return 
'
SETSELCORDS:
Gosub SETSELV
RST#=XR*CON#
RFIN#=(SCR_W-XR2)*CON#
CON#=P_LENGTH/SCR_W#
ST#=XD*CON#
FIN#=(SCR_W-XD2)*CON#
RST=Int(ST#+RST#)
ST=Int(ST#)
FIN=Int(FIN#)
L=P_LENGTH-ST-FIN
RFIN=Int(FIN#+RFIN#)
RFIN=Max(0,RFIN)
RL=P_LENGTH-RST-RFIN
'
SELALIGN:
BPS=_BYPS
RST= Fn BPSALIGN(RST)
RL= Fn BPSALIGN(RL)
RFIN= Fn BPSALIGN(RFIN)
Return 
'
SETLSELCORDS:
Gosub SETSELV
RST#=XR*CON#
CON#=P_LENGTH/SCR_W#
ST#=XD*CON#
RST#=ST#+RST#
RST=Int(RST#)
ST=Int(ST#)
L=P_LENGTH-ST-FIN
If XR=0 and XR=XR2
   RL=0
Else 
   RL=P_LENGTH-RST-RFIN
End If 
Goto SELALIGN
'
SETRSELCORDS:
Gosub SETSELV
RFIN#=(SCR_W-XR2)*CON#
CON#=P_LENGTH/SCR_W#
ST#=XD*CON#
FIN#=(SCR_W-XD2)*CON#
FIN=Int(FIN#)
L=P_LENGTH-ST-FIN
RFIN#=FIN#+RFIN#
RFIN=Int(RFIN#)
If RFIN<0 Then RFIN=0
If XR=0 and XR=XR2
   RL=0
Else 
   RL=P_LENGTH-RST-RFIN
End If 
Goto SELALIGN
'
RNGSET:
If Fn MULTI
   If Fn INVIEW
      RNG_T=1+(WVE_D*(B-1)) : RNG_B=WVE_D+(WVE_D*(B-1))
   Else 
      Goto _RANGENONE
   End If 
Else 
   RNG_T=0 : RNG_B=WVE_H
End If 
Return 
'
_RANGESET:
_RST=RST
_RFIN=RFIN
_RL=RL
Return 
'
_RANGERESTORE:
RST=_RST
RFIN=_RFIN
RL=_RL
Return 
'
'
'
'***************************************************************************** 
'*file************************************************************************ 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .-:::::' :::    :::    .,:::::: 
'    ;;;'''', ;;;    ;;;    ;;;;'''' 
'    [[[,,==[ [[[    [[[     [[cccc  
'    `$$$"``" $$$,   $$'     $$""""  
'   _ 888    o88888o88oo,.__ 888oo,_ 
'   MM"MM,   MMM"MM"""YUMMMM """"YUM 
'
'
'
_NEW:
If Not MACRO
   If Not Fn KEY_SHIFT
      BTXT1$="New" : TXT1$="Clear the current" : TXT2$="waveform?" : Gosub _REQUEST
      If Not REQ
         Return 
      End If 
   End If 
End If 
If B=UB Then Gosub _CLEARUNDO
Erase PBANK
If Fn MULTI
   If Fn INVIEW
      ADVPOS#(B)=0
   End If 
   Gosub CLREMPTY
Else 
   Gosub _STOP
End If 
F$=_$ : Gosub SETFILENAME
_BITS=0 : Gosub SETQUAL
Gosub _CLEARMETA
XD=0 : XD2=SCR_W : XR=0 : XR2=0 : ST=0 : FIN=0 : STA=0 : FI=0
Gosub RNGC
CLR:
Gosub SETPBANK
RENDERING=True
Gosub _DRAW
RENDERING=False
Gosub HEADER
Goto MAGICWAND
'
_OPEN:
PB=B
_APPEND=B-1 : Rem always insert
WTXT$="Open"
Goto O
_APPEND:
PB=B
Gosub _FINDEMPTY
If B=-1
   B=PB
   Goto NOEMPTY
End If 
_APPEND=B-1
If PB-B Then Gosub SETBANK
WTXT$="Append"
O:
WTXT$=WTXT$+": raw iff aiff wav mp2 mp3 cat abk med"
PF$=F$ : F$=LF$
Gosub FREQUEST
If Not FRQ
   Swap B,PB
   If B-PB
      Goto SETBANK
   End If 
   F$=PF$
   Return 
End If 
_OPENF:
If Not Exist(F$)
   Gosub CANTFIND
   F$=PF$
   Return 
End If 
If Not MACRO
   RENDERING=True
End If 
_TEXT=True
If B=UB Then Gosub _CLEARUNDO
Gosub RNGC : _RST=0 : _RL=0
_CHANNELS=1 : _RATE=0 : _TAG=0 : _BITS=_BYPS*8 : NN=0
BANKNAME$=_$ : _MULTIPLE=False
_IFF=False : _AIF=False : _WAV=False : _FLOAT=False : _INTERLEAVED=True
_NAME$=_$ : _CPYR$=_$ : _AUTH$=_$ : _TXT$=_$ : _ANNO$=_$ : _UNTY=$10000
F:
Trap Open In 1,F$
If Errtrap Then Goto FILEERROR
LF=Lof(1)
If LF=0
   F$=PF$
   Close 1
   Return 
End If 
FH$=Input$(1,4)
T$=Upper$(Right$(F$,4))
If T$=".MPG" or T$=".MP2" or T$=".MP3"
   Gosub MUTEOPEN
   Gosub MPEGA
   _BITS=16 : Gosub SETQUAL
   _INTERLEAVED=False : _IFF=True
Else If FH$="PP20"
   Gosub POWERPACKER
   If CN=-1
      Return 
   End If 
   Goto F
Else If FH$="PACK" or FH$="SFCD"
   TXT1$=FH$+" format" : TXT2$="not decompressed" : Gosub _NOTICE
   F$=PF$
   Close 1
   Return 
Else If FH$="CAT "
   _MULTIPLE=True
   Gosub OPENCAT
Else If FH$=_AMBK$
   _MULTIPLE=True
   Gosub OPENABK
Else If Mid$(FH$,0,3)="MMD"
   _MULTIPLE=True
   Gosub OPENMMD
Else 
   If FH$="FORM"
      _IFF=True
   Else If FH$="RIFF"
      _WAV=True
   End If 
   Trap Reserve As Work PBANK,H_BUF
   If Errtrap
      Close 1
      F$=_$
      Goto NOMEMORY
   End If 
   Pof(1)=0
   Sload 1 To PBANK,H_BUF
   Gosub PARSEHEADER
   Gosub SETMETA
   If S_START>Start(PBANK)
      S_START=S_START-Start(PBANK)
   End If 
   If S_LENGTH=0
      S_LENGTH=LF-S_START
   End If 
   Trap Reserve As Work PBANK,S_LENGTH
   If Errtrap
      Close 1
      F$=_$
      Goto NOMEMORY
   End If 
   Gosub HEADER
   Pof(1)=S_START
   Sload 1 To PBANK,S_LENGTH
   Close 1
   B=1+_APPEND : PB=1+_APPEND
   Gosub SETQUAL
End If 
Gosub SETFILENAME
If Not MACRO
   If NN>0
      Gosub _NOTICE
   End If 
End If 
PMACRO=MACRO : MACRO=True
If _RATE>0
   If Fn MONOORSTEREOORQUAD or _APPEND=0
      T$=Str$(_RATE)
      Gosub ¯FREQ
   End If 
End If 
If _IFF
   If _BITS>8 or _TAG>0
      Gosub MUTEOPEN
   End If 
   If _BYPS=1
      If _BITS=16
         Gosub _16BITTO8BIT
      Else If _BITS=24
         If _AIF
            Gosub _24BITTO8BITFLIP : Rem convince me i'm wrong
         Else 
            Gosub _24BITTO8BIT
         End If 
      Else If _BITS=32 and _FLOAT
         Gosub _32BITTO8BIT
      End If 
   Else If _BYPS=2 and _TAG=0
      If _BITS=8
         Gosub _8BITTO16BIT
      Else If _BITS=24
         If _AIF
            Gosub _24BITTO16BITFLIP : Rem convince me i'm wrong  
         Else 
            Gosub _24BITTO16BIT
         End If 
      Else If _BITS=32 and _FLOAT
         Gosub _32BITTO16BIT
      End If 
   Else If _BYPS=3 and _TAG=0
      If _BITS=8
         Gosub _8BITTO24BIT
      Else If _BITS=16
         Gosub _16BITTO24BIT
      Else If _BITS=24
         If _AIF
            Gosub _24BITFLIP : Rem convince me i'm wrong
         End If 
      Else If _BITS=32 and _FLOAT
         Gosub _32BITTO24BIT
      End If 
   End If 
Else If _WAV : Rem FLIP 
   Gosub MUTEOPEN
   If _BYPS=1
      If _BITS=8
         Gosub _8BITUNSIGNEDTO8BIT
      Else If _BITS=16
         Gosub _16BITTO8BITFLIP
      Else If _BITS=24
         Gosub _24BITTO8BITFLIP
      Else If _BITS=32 and _FLOAT
         Gosub _32BITTO8BITFLIP
      Else If _TAG=0
         Gosub BADENCODING
         _CHANNELS=1
      End If 
   Else If _BYPS=2
      If _BITS=8
         Gosub _8BITUNSIGNEDTO8BIT
         Gosub _8BITTO16BIT
      Else If _BITS=16
         Gosub _16BITFLIP
      Else If _BITS=24
         Gosub _24BITTO16BITFLIP
      Else If _BITS=32 and _FLOAT
         Gosub _32BITTO16BITFLIP
      Else If _TAG=0
         Gosub BADENCODING
         _CHANNELS=1
      End If 
   Else If _BYPS=3
      If _BITS=8
         Gosub _8BITUNSIGNEDTO8BIT
         Gosub _8BITTO24BIT
      Else If _BITS=16
         Gosub _16BITFLIP
         Gosub _16BITTO24BIT
      Else If _BITS=24
         Gosub _24BITFLIP
      Else If _BITS=32 and _FLOAT
         Gosub _32BITTO24BITFLIP
      Else If _TAG=0
         Gosub BADENCODING
         _CHANNELS=1
      End If 
   End If 
End If 
_MODEP=_MODE
If _CHANNELS>1
   If _INTERLEAVED
      Gosub _DEINTERLEAVE
   End If 
   If _CHANNELS>2
      If _INTERLEAVED
         Gosub _DEINTERLEAVE
      End If 
      If Fn MONOORSTEREOORQUAD
         _MODE=3
      End If 
   Else If Fn MONOORSTEREOORQUAD
      _MODE=2
   End If 
Else If _MULTIPLE and _APPEND=0
   _MODE=4
   Gosub R4INSET
Else If _CHANNELS=1 and Fn MONOORSTEREOORQUAD
   _MODE=1
End If 
MACRO=PMACRO
XD=0 : XD2=SCR_W : XR=0 : XR2=0 : ST=0 : FIN=0
Gosub RNGC
STA=0 : Gosub PBANKLEN
If Not MACRO
   RENDERING=False
End If 
If _MODEP-_MODE
   _M3SEL=_MODE
   _MODE=_MODEP
   Gosub M0DEMENU
   Gosub SETZN
   Gosub HEADER
Else 
   Gosub _SHOWALL
End If 
Gosub SETPBANK
If Fn MULTI
   Gosub SETBANK
   Gosub POSCAL
   _CHANNELS=1
End If 
If _IFF
   If _TAG>0
      Gosub CPROP
      Swap _TOAST$,T$ : Gosub T0AST : Swap _TOAST$,T$ : _TOAST$=_SPACE$+_TOAST$
      MACRO=True
      On _TAG Gosub _DECODEFIBONACCIDELTA,_DECODEEXPONENTIALDELTA
      Gosub UPSAMPLE
      MACRO=PMACRO
      RL=0
      Gosub _SHOWALL
   End If 
   If HI_REPEAT>0
      HI_REPEAT=0
      RST=_RST : RL=_RL
      Gosub _SHOWALL
      Gosub FRSHSEL
   End If 
End If 
COMP(B)=0
If _MUTED
   Gosub _MUTE
   _MUTED=False
End If 
Q:
_TEXT=False
If Not MACRO
   RENDERING=False
End If 
If _PPCOMPRESSED
   _PPCOMPRESSED=False
   Kill D$
   Dir$=PPROGDIR$
   FPATH$(B)=PPROGDIR$
   Gosub HEADER
End If 
Goto MAGICWAND
'  
'***************************************************************************** 
'    ¦   ¦¦ ¦¦¦  ¦  ¦ ¦ ¦¦¦ ¦¦ 
'   ¦ ¦ ¦    ¦  ¦ ¦ ¦¦¦ ¦   ¦ ¦
'   ¦ ¦ ¦    ¦  ¦¦¦ ¦¦¦ ¦¦  ¦ ¦
'   ¦ ¦ ¦    ¦  ¦ ¦ ¦ ¦ ¦   ¦ ¦
'    ¦   ¦¦  ¦  ¦ ¦ ¦ ¦ ¦¦¦ ¦¦   
'  
OPENMMD:
Trap Dim MMD_NAME$(63),MMD_SIZE(63),MMD_REPEAT(63),MMD_REPLEN(63),MMD_VOL(63),MMD_TRANSPOSE(63),MMD_FINETUNE(63),MMD_FLAGS(63),MMD_INST(16),MMD_NOTE(16)
If Errtrap Then Rem clear trap 
_REMAP=True
BANKNAME$=F$ : PB=PBANK
Pof(1)=32 : Rem expdata
S$=Input$(1,4) : P=Leek(Varptr(S$)) : Rem exp pointer
Pof(1)=P+4
S$=Input$(1,4) : P=Leek(Varptr(S$)) : Rem exp_smp pointer
S$=Input$(1,2) : ENTRIES=Deek(Varptr(S$)) : Rem s_ext_entries
S$=Input$(1,2) : ENTSIZE=Deek(Varptr(S$)) : Rem s_ext_entrsz   
Pof(1)=P
For I=1 To ENTRIES
   S$=Input$(1,ENTSIZE)
   CN2=Varptr(S$)
   CN=Peek(CN2+3) : Rem hold, decay, suppress_midi_off, finetune 
   If CN>127 Then CN=CN-256 : Rem SIGN 
   MMD_FINETUNE(I)=CN : Rem finetune 
   If ENTSIZE>4 : Rem saved by >= V5 
      MMD_FLAGS(I)=Peek(CN2+5) : Rem miscellaneous flags
   Else 
      MMD_FLAGS(I)=0
   End If 
   If ENTSIZE>10 : Rem saved by >= V7   
      MMD_REPEAT(I)=Leek(CN2+10) : Rem override allowing long and odd 
      MMD_REPLEN(I)=Leek(CN2+14) : Rem override allowing long and odd 
   Else 
      MMD_REPEAT(I)=0 : MMD_REPLEN(I)=0
   End If 
Next I
If Not MACRO
   BTXT1$=_OK$ : TXT1$="Octamed module music" : TXT2$="as waveforms?" : Gosub _REQUEST
Else 
   REQ=False
End If 
Pof(1)=24
S$=Input$(1,4) : DP=Leek(Varptr(S$)) : Rem pointer to smplarr pointer 
FX_START=0 : FX=0
FX_LENGTH=Lof(1)
For I=1 To ENTRIES
   Pof(1)=DP : S$=Input$(1,4) : DP=Pof(1) : P=Leek(Varptr(S$))
   If P>0
      Pof(1)=P
      S$=Input$(1,4) : MMD_SIZE(I)=Leek(Varptr(S$)) : Rem sample length  
   End If 
Next I
If REQ
   Gosub _COPYCOPY
   Gosub _STOP
   Pof(1)=8 : Rem song pointer 
   S$=Input$(1,4) : P=Leek(Varptr(S$))
   Pof(1)=P
   For I=1 To 63
      S$=Input$(1,8) : CN=Varptr(S$)
      If MMD_REPEAT(I)=0 : Rem check for override 
         Dreg(1)=1 : Dreg(0)=Deek(CN)
         Call(Varptr(MC_ASL_L)) : Rem as in Protracker 
         MMD_REPEAT(I)=Dreg(0)
      End If 
      Add CN,2
      If MMD_REPLEN(I)=0 : Rem check for override 
         Dreg(1)=1 : Dreg(0)=Deek(CN)
         Call(Varptr(MC_ASL_L)) : Rem as in Protracker 
         MMD_REPLEN(I)=Dreg(0)
      End If 
      If MMD_REPEAT(I)+MMD_REPLEN(I)>2 and ENTSIZE=4 : Rem >= V3  
         MMD_FLAGS(I)=1
      End If 
      Add CN,4
      MMD_VOL(I)=Peek(CN) : Rem svol 
      Inc CN
      CN=Peek(CN) : Rem strans 
      If CN>127
         CN=CN-256 : Rem SIGN 
      End If 
      MMD_TRANSPOSE(I)=CN : Rem transpose
   Next I
   Rem P+504  
   S$=Input$(1,2) : NUMBLOCKS=Deek(Varptr(S$))-1
   Pof(1)=P+764
   S$=Input$(1,2) : DEFTEMPO#=Deek(Varptr(S$))
   Pof(1)=P+767
   S$=Input$(1,1) : FLAGS=Peek(Varptr(S$))
   S$=Input$(1,1) : FLAGS2=Peek(Varptr(S$)) : Rem flags2 
   S$=Input$(1,1) : TEMP02#=Peek(Varptr(S$)) : Rem tempo2 TPL timing pulses per line  
   If Btst(7,FLAGS2) : Rem mixing   
      _OCTAVE=0
   Else 
      _OCTAVE=24
   End If 
   LPB=(FLAGS2 and $1F)+1 : Rem lines per beat 
   If Btst(6,FLAGS) : Rem 5-8 channel      
      DEFTEMPO#=27+Int((9-DEFTEMPO#)*3)
   End If 
   If Not Btst(5,FLAGS2) : Rem spd  
      DEFTEMPO#=DEFTEMPO#-(TEMP02#/4.0)
      TEMP02#=(TEMP02#)/2.0
      LPB=8
   End If 
   DEFTEMPO#=((DEFTEMPO#/TEMP02#)*6.0)/(4.0/LPB)
   _REMAP=False
   If NUMBLOCKS>0 and Not MACRO
      S$="Choose Block"
      Gosub _OPENFXTEXTWIN
      TXT1$="0.."+Str$(NUMBLOCKS)-_SPACE$+_COLON$
      T$=_$ : Gosub _RUNFXTEXTWIN
      If Not REQ
         F$=PF$
         Close 1
         Goto Q
      End If 
      If T$=_$
         AC=0
      Else 
         AC=Val(T$)
         If AC<0
            AC=0
         Else If AC>NUMBLOCKS
            AC=NUMBLOCKS
         End If 
      End If 
   Else 
      AC=0
   End If 
   _TXT$=F$ : _ANNO$="Octamed" : Rem SETMETA
   Pof(1)=16
   S$=Input$(1,4) : DP=Leek(Varptr(S$)) : Rem pointer to blockarr pointer
   For I=0 To NUMBLOCKS
      Pof(1)=DP : S$=Input$(1,4) : DP=Pof(1)
      If I=AC : Rem find block 
         P=Leek(Varptr(S$))
         If P>0
            Pof(1)=P
            S$=Input$(1,2) : TRACKS=Deek(Varptr(S$))
            S$=Input$(1,2) : LINES=Deek(Varptr(S$)) : Inc LINES
            S$=Input$(1,4) : Rem blockinfo pointer
            SZ=TRACKS*4*LINES
            S_LENGTH=Int(FREQ/((DEFTEMPO#/4/60)/(Max(16,LINES)/16)))*_BYPS
            DISPATCH$="D="+Str$(LINES)-_SPACE$
            If TRACKS>4 and TRACKS<9
               DISPATCH$=DISPATCH$+",M=5,B=1," : Rem 8 channel
            Else If TRACKS>8 and TRACKS<17
               DISPATCH$=DISPATCH$+",M=6,B=1," : Rem 16 channel 
            Else 
               DISPATCH$=DISPATCH$+",M=4,B=1,"
            End If 
            _TOAST$=Str$(TRACKS)-_SPACE$+" Tracks "
            If B=1
               Repeat 
                  Trap Reserve As Work B+JB,S_LENGTH
                  If Errtrap
                     Close 1
                     PBANK=PB : B=1+_APPEND : PB=B : _CHANNEL=1 : F$=_$
                     Goto NOMEMORY
                  End If 
                  F$="Track"+Str$(B) : Gosub SETFILENAME
                  _NAME$="Block"+Str$(AC)+_SPACE$+F$ : Gosub SETMETA
                  QUAL(B)=_BYPS
                  Inc B
               Until B>TRACKS
               _APPEND=_APPEND+TRACKS
               B=1+_APPEND
            End If 
            If SZ>0
               Q_BUF=SZ*9
               Trap Reserve As Work QBANK,Q_BUF : Q_POS=Start(QBANK)
               If Errtrap
                  Close 1
                  PBANK=PB : B=1+_APPEND : PB=B : _CHANNEL=1 : F$=_$
                  Goto NOMEMORY
               End If 
               Sload 1 To Q_POS,SZ : Add Q_POS,SZ
               Gosub MEDTOSEQUENCE
            End If 
         End If 
      End If 
   Next I
   T$="B=1,_SHOWALL,_COPYCOPY,"+_NEWLINE$ : Gosub BUILDSTRING
   Q_START=Start(QBANK)+SZ
   Q_LENGTH=Q_POS-Start(QBANK)-SZ
   Q_END=Q_START+Q_LENGTH
End If 
NN=0 : N=B
Pof(1)=32 : Rem expdata
S$=Input$(1,4) : P=Leek(Varptr(S$)) : Rem exp pointer
Pof(1)=P+20
S$=Input$(1,4) : P=Leek(Varptr(S$)) : Rem iinfo pointer  
S$=Input$(1,2) : ENTRIES=Deek(Varptr(S$)) : Rem entries
S$=Input$(1,2) : ENTSIZE=Deek(Varptr(S$)) : Rem entrsz   
Pof(1)=P
For I=1 To ENTRIES
   S$=Input$(1,ENTSIZE)
   P=Peek(Varptr(S$))
   If P>0
      For I2=1 To Len(S$)
         CN=Peek(Varptr(S$)+I2)
         Exit If CN=0
      Next I2
      MMD_NAME$(I)=Mid$(S$,0,I2)
   Else 
      MMD_NAME$(I)=_$
   End If 
Next I
Pof(1)=24
S$=Input$(1,4) : DP=Leek(Varptr(S$)) : Rem pointer to smplarr pointer 
FX_START=0 : FX=0
FX_LENGTH=Lof(1)
For I=1 To ENTRIES
   Pof(1)=DP : S$=Input$(1,4) : DP=Pof(1) : P=Leek(Varptr(S$))
   If P>0
      Pof(1)=P
      S$=Input$(1,4) : SZ=Leek(Varptr(S$)) : Rem sample length        
      If SZ>0
         S$=Input$(1,2) : _BITS=Deek(Varptr(S$)) : Rem sample type            
         If _BITS=16 : Rem 16bit mono 
         Else If _BITS=32 : Rem 8bit stereo  
            If Not REQ
               Add SZ,SZ
            End If 
            _BITS=8
         Else If _BITS=48 : Rem 16bit stereo 
            If Not REQ
               Add SZ,SZ
            End If 
            _BITS=16
         Else : Rem 8bit mono
            _BITS=8
         End If 
         If REQ and(MMD_FLAGS(I) and 1) and SZ<S_LENGTH : Rem looping
            If _BITS=16
               Add S_LENGTH,S_LENGTH
            End If 
            Trap Reserve As Work N+JB,S_LENGTH
         Else 
            Trap Reserve As Work N+JB,SZ
         End If 
         If Errtrap
            Close 1
            PBANK=PB : B=1+_APPEND : PB=B : _CHANNEL=1 : F$=_$
            Goto NOMEMORY
         End If 
         Gosub HEADER
         AC=Start(N+JB)
         Sload 1 To AC,SZ
         MACRO=True
         If _BYPS=1
            If _BITS=16
               PBANK=N+JB
               Gosub RNGC
               Gosub SETPBANK
               Gosub _16BITTO8BIT
               RST=RST/2 : RL=RL/2
            End If 
         Else If _BYPS=2
            If _BITS=8
               PBANK=N+JB
               Gosub RNGC
               Gosub SETPBANK
               Gosub _8BITTO16BIT
               RST=RST*2 : RL=RL*2
            End If 
         Else If _BYPS=3
            If _BITS=8
               PBANK=N+JB
               Gosub RNGC
               Gosub SETPBANK
               Gosub _8BITTO24BIT
            Else If _BITS=16
               PBANK=N+JB
               Gosub RNGC
               Gosub SETPBANK
               Gosub _16BITTO24BIT
            End If 
            RST=RST*3 : RL=RL*3
         End If 
         If REQ and(MMD_FLAGS(I) and 1) and SZ<S_LENGTH : Rem looping
            If MMD_FLAGS(I) and 8 : Rem ping pong
               _PPMIX=True
            Else 
               _PPMIX=False
            End If 
            PBANK=N+JB
            RST=MMD_REPEAT(I)*_BYPS : RL=MMD_REPLEN(I)*_BYPS
            Gosub SETPBANK
            Gosub _COPY
            RST=RST+RL : RL=S_LENGTH-SZ
            If RST<S_LENGTH
               Gosub _MIX
            End If 
            Gosub RNGC
         End If 
         MACRO=False
         FX=FX+SZ
         B=N
         F$=MMD_NAME$(I) : Gosub SETFILENAME
         Gosub SETQUAL
         _NAME$=F$ : Gosub SETMETA
         If _REMAP
            Inc N
         End If 
         Inc NN
      End If 
   End If 
   If Not _REMAP
      Inc N
   End If 
Next I
FX=FXE
Close 1
PBANK=PB : B=1+_APPEND : PB=B : _CHANNEL=1 : F$=FB$(B)
_TXT$=_$ : _ANNO$=_$ : Rem SETMETA
Gosub RNGC
Gosub DISPATCH
If Not MACRO
   TXT1$="Octamed module loaded" : TXT2$="with"+Str$(NN)+" samples" : Rem _NOTICE  
End If 
_TEXT=True
Return 
'
MEDTOSEQUENCE:
NN=0 : _I=0
For I=0 To SZ-1 Step 4
   If NN=0 or NN=TRACKS
      T$=_NDPQ$+_COMMA$ : Gosub BUILDSTRING : Rem no dispatch queue
      _CHANNEL=0
      NN=0
   End If 
   Inc _CHANNEL
   CN=Start(QBANK) : Add CN,I
   'xnnnnnnn xxiiiiii cccccccc dddddddd 
   _NOTE=Peek(CN) : Inc CN : Rem 0 - $7F
   _INST=Peek(CN) : Inc CN : Rem 0 - $3F
   _CMND=Peek(CN) : Inc CN : Rem 0 - $FF
   _DATA=Peek(CN) : Rem 0 - $FF
   If _INST=0 Then _INST=MMD_INST(_CHANNEL)
   If _NOTE>0
      MMD_NOTE(_CHANNEL)=_NOTE
      If(_I<>_INST and _INST>0) or MMD_INST(_CHANNEL)=0
         T$="B="+Str$(_INST+_APPEND)-_SPACE$+",_COPY," : Gosub BUILDSTRING
         MMD_INST(_CHANNEL)=_INST
         _I=_INST
      End If 
      _AMP#=MMD_VOL(_INST)/64.0
      T$="B="+Str$(_CHANNEL)-_SPACE$ : Gosub BUILDSTRING
      If _CMND=$C or _CMND=$D
         _AMP#=(_DATA/64.0)
         T$=",A="+Str$(_AMP#)-_SPACE$ : Gosub BUILDSTRING
      Else If _AMP#<1
         T$=",A="+Str$(_AMP#)-_SPACE$ : Gosub BUILDSTRING
      End If 
      If MMD_FINETUNE(_INST)<>0
         T$=",F="+Str$(MMD_FINETUNE(_INST))-_SPACE$ : Gosub BUILDSTRING : Rem finetune 
      End If 
      _NOTE=_NOTE+MMD_TRANSPOSE(_INST) : Rem transpose  
      T$=",N="+Str$(_NOTE-1+_OCTAVE)-_SPACE$ : Gosub BUILDSTRING
      If _CMND=$20 : Rem reverse sample / relative sample offset
         T$=",_COPYSWAP,_REVERSE,_COPYSWAP" : Gosub BUILDSTRING
         If _DATA>0
            _CMND=$19
         End If 
      End If 
      If _CMND=$19 : Rem sample start offset
         MMD_INST(_CHANNEL)=0
         T$=",_COPYSWAP,RANGE "+Str$((_DATA*_BYPS)*256)-_SPACE$+" 0,_CROP,_COPYSWAP" : Gosub BUILDSTRING : Rem B+JB 
      End If 
      T$=",_RENDER," : Gosub BUILDSTRING
   Else If(_CMND=$C and _DATA=0) or(_CMND=$F and _DATA=$FF)
      T$="B="+Str$(MMD_INST(_CHANNEL)+_APPEND)-_SPACE$+",_COPY," : Gosub BUILDSTRING
      T$="B="+Str$(_CHANNEL)-_SPACE$ : Gosub BUILDSTRING
      T$=",A=0,N="+Str$(MMD_NOTE(_CHANNEL))-_SPACE$+",_RENDER," : Gosub BUILDSTRING
   End If 
   Inc NN
   If NN=TRACKS
      T$=_NEWLINE$ : Gosub BUILDSTRING
   End If 
Next I
Return 
'
'***************************************************************************** 
'    ¦  ¦ ¦  ¦   ¦¦    ¦¦   ¦  ¦¦¦ ¦ ¦ 
'   ¦ ¦ ¦¦¦ ¦ ¦ ¦      ¦ ¦ ¦ ¦ ¦ ¦ ¦ ¦ 
'   ¦¦¦ ¦¦¦ ¦ ¦  ¦     ¦¦  ¦¦¦ ¦ ¦ ¦¦
'   ¦ ¦ ¦ ¦ ¦ ¦   ¦    ¦ ¦ ¦ ¦ ¦ ¦ ¦ ¦ 
'   ¦ ¦ ¦ ¦  ¦  ¦¦     ¦¦  ¦ ¦ ¦ ¦ ¦ ¦ 
'
OPENABK:
BANKNAME$=F$
If LF<22
   Close 1
   F$=PF$
   TXT1$="Amos bank invalid" : TXT2$=_$ : Goto _ERROR
End If 
S$=Input$(1,4) : Rem (1,2) 5 (1,2) 0
S$=Input$(1,4)
Gosub MEMORY
If MEMORY<(Leek(Varptr(S$)) xor $80000000)
   Close 1
   F$=PF$
   Goto NOMEMORY
End If 
S$=Input$(1,8)
If Left$(S$,7)<>_DEFAULT$
   Close 1
   F$=PF$
   TXT1$="Not a sample bank" : TXT2$= Fn QUOTE$(S$-_SPACE$) : Goto _ERROR
End If 
S$=Input$(1,2) : NN=Deek(Varptr(S$))
If Eof(1)
   Close 1
   F$=PF$
   TXT1$="Empty sample bank" : TXT2$=_$ : Goto _NOTICE
End If 
_TXT$=F$ : _ANNO$="AMOS" : Rem SETMETA
SF$=Input$(1,4) : SL=Leek(Varptr(SF$)) : If SL>6 : SF$=SF$+Input$(1,SL-6) : End If 
FX=0 : FX_START=0 : FX_LENGTH=Lof(1) : FXE=FX_LENGTH
For N=1 To NN
   If Leek(Varptr(SF$)+(N-1)*4)
      If Eof(1)
         TXT1$="Error loading"+Str$(N)+Str$(NN) : TXT2$="bank, continuing..." : Gosub _ERROR
         _TEXT=True
         Exit 
      End If 
      S$=Input$(1,14)
      For CHR=1 To 7
         If Peek(Varptr(S$)+CHR)=0
            Exit 
         End If 
      Next CHR
      F$=Left$(S$,CHR)
      B=N+_APPEND : Gosub SETFILENAME
      _BITS=8 : Gosub SETQUAL
      _NAME$=F$ : Gosub SETMETA
      _RATE=Deek(Varptr(S$)+8)
      SZ=Leek(Varptr(S$)+10)
      If Fn ODD(SZ)
         SZ=SZ+1
      End If 
      If SZ>0
         Trap Reserve As Work N+JB+_APPEND,SZ
         If Errtrap
            Close 1
            B=1+_APPEND : PB=B : F$=_$
            Goto NOMEMORY
         End If 
         Gosub HEADER
         AC=Start(N+JB+_APPEND)
         P=0
         Sload 1 To AC,SZ
         PBANK=B+JB
         Gosub SETPBANK
         Gosub UPSAMPLE
         FX=FX+SZ
      End If 
   End If 
Next 
FX=FXE
Close 1
B=1+_APPEND : PB=B : F$=FB$(B)
_TXT$=_$ : _ANNO$=_$ : Rem SETMETA
If Not MACRO
   TXT1$="Amos Bank loaded" : TXT2$="with"+Str$(NN)+" samples" : Rem _NOTICE  
End If 
_TEXT=True
Return 
'
'***************************************************************************** 
'   ¦¦¦ ¦¦¦ ¦¦¦     ¦¦  ¦  ¦¦¦ 
'    ¦  ¦   ¦      ¦   ¦ ¦  ¦
'    ¦  ¦¦  ¦¦     ¦   ¦¦¦  ¦
'    ¦  ¦   ¦      ¦   ¦ ¦  ¦
'   ¦¦¦ ¦   ¦       ¦¦ ¦ ¦  ¦
'
OPENCAT:
BANKNAME$=F$
N=B : PB=PBANK : NN=0
S$=Input$(1,4)
SL=Leek(Varptr(S$))
If SL<0 or SL>Lof(1)
   Close 1
   PBANK=PB : B=1+_APPEND : PB=1+_APPEND : F$=_$
   TXT1$="Iff corrupted" : TXT2$=_$ : Goto _NOTICE
End If 
SZ=12
Repeat 
   PBANK=N+JB
   If B>_FL
      Close 1
      PBANK=PB : B=1+_APPEND : PB=1+_APPEND : F$=_$
      Goto NOEMPTY
   End If 
   Trap Reserve As Work PBANK,H_BUF
   If Errtrap
      Close 1
      PBANK=PB : B=1+_APPEND : PB=1+_APPEND : F$=_$
      Goto NOMEMORY
   End If 
   Pof(1)=SZ
   Sload 1 To PBANK,H_BUF
   _IFF=True
   Gosub PARSEHEADER
   If _IFF
      S_START=S_START-Start(PBANK)
      Trap Reserve As Work PBANK,S_LENGTH
      If Errtrap
         Close 1
         PBANK=PB : B=1+_APPEND : PB=1+_APPEND : F$=_$
         Goto NOMEMORY
      End If 
      Gosub HEADER
      Gosub T0AST
      Pof(1)=S_START+SZ
      Sload 1 To PBANK,S_LENGTH
      B=N : F$=_NAME$ : Gosub SETFILENAME
      Gosub SETQUAL
      Gosub SETMETA
      If _TAG>0
         If _CHANNELS>1
            _MODE=2
         End If 
         Gosub SETPBANK
         On _TAG Gosub _DECODEFIBONACCIDELTA,_DECODEEXPONENTIALDELTA
         RL=0
         _TAG=0
      End If 
      Gosub UPSAMPLE
      _IFF=False
      Inc N : Inc NN
   Else 
      Erase PBANK
   End If 
   SZ=SZ+F_LENGTH
Until SZ>=SL or F_LENGTH=0
Close 1
PBANK=PB : B=1+_APPEND : PB=1+_APPEND : F$=FB$(1+_APPEND)
If Not MACRO
   TXT1$="Iff Cat loaded" : TXT2$="with"+Str$(NN)+" samples" : Rem _NOTICE  
End If 
_TEXT=True
Return 
'
'***************************************************************************** 
'
_OPENASRAW:
WTXT$="Open As: raw"
PF$=F$ : F$=LF$
Gosub FREQUEST
If Not FRQ
   F$=PF$
   Return 
Else If Not Exist(F$)
   Gosub CANTFIND
   F$=PF$
   Return 
End If 
Gosub SETFILENAME
Gosub _CLEARMETA
If Fn MONOORSTEREOORQUAD or Fn MULTIINVIEW
   Gosub _STOP
End If 
If B=UB Then Gosub _CLEARUNDO
R:
Trap Open In 1,F$
If Errtrap Then Goto FILEERROR
LF=Lof(1)
If LF=0
   Close 1
   Return 
End If 
XD=0 : XD2=SCR_W : XR=0 : XR2=0 : ST=0 : FIN=0 : STA=0 : FI=0
Gosub RNGC
FH$=Input$(1,4)
_BITS=0 : _FLOAT=False
If FH$="PP20"
   Gosub POWERPACKER
   If CN=-1
      Return 
   End If 
   Goto R
Else If FH$="FORM"
   _IFF=True : _WAV=False
Else If FH$="RIFF"
   _WAV=True : _IFF=False
Else 
   _WAV=False : _IFF=False
End If 
Trap Reserve As Work PBANK,H_BUF
If Errtrap
   Close 1
   F$=_$
   Goto NOMEMORY
End If 
_TEXT=True
Pof(1)=0
Sload 1 To PBANK,H_BUF
Gosub PARSEHEADER
If _IFF
   Gosub SETMETA
Else 
   COMP(B)=0
End If 
If S_START>Start(PBANK)
   S_START=S_START-Start(PBANK)
End If 
If S_LENGTH=0 or LF-S_START>=S_LENGTH+S_LENGTH
   S_LENGTH=LF-S_START
End If 
Trap Reserve As Work PBANK,S_LENGTH
If Errtrap
   Close 1
   F$=_$
   Goto NOMEMORY
End If 
Gosub HEADER
Pof(1)=S_START
Sload 1 To PBANK,S_LENGTH
Close 1
TXT1$=_TOAST$
If _CHANNELS=1
   TXT2$="Mono"
Else If _CHANNELS=2
   TXT2$="Stereo"
Else If _CHANNELS=4
   TXT2$="Quad"
End If 
If COMP(B)
   Gosub CPROP
   TXT2$=TXT2$+_SPACE$+T$
End If 
_CHANNELS=1
If _BITS>0
   _TOAST$="Header Removed "
   Gosub _NOTICE
Else 
   _BITS=_BYPS*8
End If 
Gosub SETQUAL
If Fn STEREOORQUAD
   _M3SEL=1
   Gosub M0DEMENU
End If 
Gosub _SHOWALL
_TEXT=False
If _PPCOMPRESSED
   _PPCOMPRESSED=False
   Kill D$
   Dir$=PPROGDIR$
   FPATH$(B)=PPROGDIR$
   Goto HEADER
End If 
Return 
'  
_REVERT:
If F$=_$ and BANKNAME$=_$ Then Goto FLSHSCR
BTXT1$=_OK$ : TXT1$="Are you sure?" : TXT2$="You will loose edits" : Gosub _REQUEST
If Not REQ Then Return 
If FB$(B)=_UNNAMED$ or FPATH$(B)=_$ Then Goto FLSHSCR
If Fn A500 Then Gosub _STOP
If BANKNAME$<>_$ Then F$=BANKNAME$
PPROGDIR$=Dir$
Dir$=FPATH$(B)
_APPEND=B-1
Gosub _OPENF
Dir$=PPROGDIR$
Goto SETPBANK
'
_SAVEASIFF:
_ASIFF=True
WTXT$="iff"
Goto _SAVE
_SAVEAS:
_ASIFF=False
WTXT$="raw"
_SAVE:
If Length(PBANK)=0 Then Goto FLSHSCR
_TEXT=True
PF$=F$
WTXT$="Save As: "+WTXT$
Gosub FREQUEST
If Not FRQ
   F$=PF$
   Return 
End If 
Gosub CLEANFILENAME
If Exist(F$)
   Gosub OVERWRITE
   If Not REQ
      F$=PF$
      Return 
   End If 
End If 
Trap Open Out 1,F$
If Errtrap
   F$=PF$
   Goto FILEERROR
End If 
S_START=Start(PBANK) : S_LENGTH=Length(PBANK)
If _ASIFF
   Gosub _IFFHEADER
   Ssave 1,Varptr(T$) To Varptr(T$)+Len(T$)
End If 
Ssave 1,S_START To S_START+S_LENGTH
If _PAD : Rem odd sizes have a pad byte
   Ssave 1,Varptr(_NULL$) To Varptr(_NULL$)+1
   Inc S_LENGTH
End If 
Close 1
Gosub SETFILEPOS
Gosub SETFILENAME
_TEXT=False
Goto HEADER
'
_SAVEASCAT:
_TEXT=True
PF$=F$
If BANKNAME$<>_$ Then F$=BANKNAME$ Else F$=_DEFAULT$+Lower$(_CAT$)
WTXT$="Save As: cat"
If Right$(Upper$(F$),4)=_ABK$ Then Right$(F$,4)=Lower$(_CAT$)
Gosub FREQUEST
If Not FRQ
   F$=PF$
   Return 
End If 
Gosub CLEANFILENAME
If Right$(Upper$(F$),4)<>_CAT$ Then F$=F$+Lower$(_CAT$)
If Exist(F$)
   Gosub OVERWRITE
   If Not REQ
      F$=PF$
      Return 
   End If 
End If 
BANKNAME$=F$
PB=B : B=1 : NN=0
Trap Open Out 1,F$
If Errtrap Then Goto FILEERROR
T$="CAT     8SVX"
Ssave 1,Varptr(T$) To Varptr(T$)+12
F_LENGTH=0
Repeat 
   S_LENGTH=Length(B+JB)
   Exit If S_LENGTH=0
   S_START=Start(B+JB)
   Gosub _IFFHEADER
   Ssave 1,Varptr(T$) To Varptr(T$)+Len(T$)
   Ssave 1,S_START To S_START+S_LENGTH
   If _PAD : Rem odd sizes have a pad byte
      Ssave 1,Varptr(_NULL$) To Varptr(_NULL$)+1
   End If 
   F_LENGTH=F_LENGTH+S_LENGTH+Len(T$)
   Inc B : Inc NN
Until B>_FL
Add F_LENGTH,4
Pof(1)=4
Ssave 1,Varptr(F_LENGTH) To Varptr(F_LENGTH)+4
Close 1
S_LENGTH=F_LENGTH
Gosub SETFILEPOS
F$=PF$ : B=PB
TXT1$="Iff Cat saved" : TXT2$="with"+Str$(NN)+" samples" : Goto _NOTICE
'
_SAVEASBANK:
_TEXT=True
PF$=F$
If BANKNAME$<>_$ Then F$=BANKNAME$ Else F$=_DEFAULT$+Lower$(_ABK$)
WTXT$="Save As: abk"
If Right$(Upper$(F$),4)=_CAT$ Then Right$(F$,4)=Lower$(_ABK$)
Gosub FREQUEST
If Not FRQ
   F$=PF$
   Return 
End If 
Gosub CLEANFILENAME
If Exist(F$)
   Gosub OVERWRITE
   If Not REQ
      F$=PF$
      Return 
   End If 
End If 
PB=B : B=1
N=1
Repeat 
   S_LENGTH=Length(N+JB)
   Exit If S_LENGTH=0
   If Fn ODD(S_LENGTH)
      BTXT1$=_OK$ : TXT1$="Ignore automatic change" : TXT2$="for odd size?" : Gosub _REQUEST
      If REQ
         Exit 
      Else 
         F$=PF$
         Return 
      End If 
   End If 
   Inc N
Until N>_FL
SZ=0 : ENTRIES=0
N=1
Repeat 
   S_LENGTH=Length(N+JB)
   Exit If S_LENGTH=0
   Add SZ,S_LENGTH+4+14
   If Fn ODD(S_LENGTH)
      Inc SZ
   End If 
   Inc ENTRIES
   Inc N
Until N>_FL
S_LENGTH=SZ+22
FX_LENGTH2=S_LENGTH : Gosub _WORKSET
CN=Start(WBANK)
Poke$ CN,_AMBK$ : Add CN,4
Doke CN,5 : Add CN,2
Doke CN,0 : Add CN,2
Loke CN,(SZ+8) or $80000000 : Add CN,4
Poke$ CN,_DEFAULT$ : Add CN,7
Poke$ CN,_SPACE$ : Add CN,1
CN3=CN
Doke CN,ENTRIES : Add CN,2
CN2=CN
CN=CN2+ENTRIES*4
NN=0 : N=1
Repeat 
   FX_START2=Start(N+JB) : FX_LENGTH2=Length(N+JB)
   Inc NN
   Loke CN2,CN-CN3 : Add CN2,4
   If FB$(N)=_$ Then T$=Left$(_UNNAMED$,8) Else T$=Left$(FB$(N),8)
   Poke$ CN,T$ : Add CN,8
   Doke CN,FREQ : Add CN,2
   Loke CN,FX_LENGTH2 : Add CN,4
   Copy FX_START2,FX_START2+FX_LENGTH2 To CN
   Add CN,FX_LENGTH2
   If Fn ODD(CN) Then Inc CN
   Inc N
Until N>ENTRIES
If Right$(Upper$(F$),4)<>_ABK$ Then F$=F$+Lower$(_ABK$)
BANKNAME$=F$
Trap Open Out 1,F$
If Errtrap
   F$=PF$
   Goto FILEERROR
End If 
Ssave 1,Start(WBANK) To Start(WBANK)+S_LENGTH
Close 1
Gosub SETFILEPOS
F$=PF$ : B=PB
Gosub _CLEARWORK
Gosub SETBANK
TXT1$="Amos Bank saved" : TXT2$="with"+Str$(NN)+" samples" : Goto _NOTICE
'
_PROPERTIES:
_TEXT=True
WTXT$=S$ : WX=149 : WY=28 : WX2=490 : WY2=146 : _COL=_WHITE : Gosub WIN
Ink _GRAY,_WHITE
Text WX+72,56,"Name: "
Text WX+88,64,"(c) "
Text WX+56,72,"Author: "
Text WX+48,80,"Comment: "
Text WX+24,88,"Annotation: "
Text WX+40,96,"Channels:"
Text WX+16,104,"Compression:"
Text WX+48,112,"Quality:"
Text WX+72,120,"Size: "
If P_LENGTH>0
   Ink _BLACK,_WHITE
   Text WX+120,56,NAME$(B)
   Text WX+120,64,CPYR$(B)
   Text WX+120,72,AUTH$(B)
   Text WX+120,80,TXT$(B)
   Text WX+120,88,ANNO$(B)
   Text WX+120,96,Str$(_CHANNELS)-_SPACE$
   Gosub CPROP : Text WX+120,104,T$
   Text WX+120,112, Fn BPSPROP$
   SZ=P_LENGTH : Gosub SETSIZE : Text WX+120,120,S$
End If 
Goto WINWAITC
'
CPROP:
If COMP(B)=0
   T$=_NONE$
Else If COMP(B)=1
   T$="Fibonacci Delta"
Else If COMP(B)=2
   T$="Exponential Delta"
End If 
Return 
'
_QUIT:
If _REPEAT$<>"_QUIT"
   If OSCILLO
      Goto _TGLOSCILLOSCOPE
   Else If CALC
      Goto _TGLCALCULATOR
   End If 
End If 
BTXT1$="Quit" : TXT1$="Are you sure" : TXT2$="you want to quit?" : Gosub _REQUEST
If Not REQ Then Return 
'
QUIT: Rem command
Gosub _FULLSTOP
Every Off 
If _REC Then Gosub _TGLRECORD
If REXX Then Arexx Close 
Gosub _FLUSHLIBS
If BSD
   If NETSYNC
      Gosub SOCK_CLOSESYNC
   End If 
   If NETVST
      Gosub SOCK_CLOSEVST
   End If 
   Lib Close 2 : Rem bsd
End If 
Erase Temp 
If Prg State>-1 Then Dir$=PROGDIR$ : Rem interpreted
End 
'
_IFFHEADER:
If QUAL(B)=1
   T$="8SVX"
Else If QUAL(B)=2
   T$="16SV"
Else If QUAL(B)=3
   T$="24SV"
Else If QUAL(B)=4
   T$="FLSV"
End If 
T$="FORM"+_CHUNK$+T$
T$=T$+"VHDR"+String$(_NULL$,24)
CN=Varptr(T$)+16
Loke CN,20 : Add CN,4
If COMP(B)>0
   If _CHANNELS=1
      FF_LENGTH=(S_LENGTH-2)*2
   Else If _CHANNELS=2
      FF_LENGTH=S_LENGTH-4
   Else If _CHANNELS=4
      FF_LENGTH=(S_LENGTH-8)/2
   End If 
Else 
   If _CHANNELS=2
      FF_LENGTH=S_LENGTH/2
   Else If _CHANNELS=4
      FF_LENGTH=S_LENGTH/4
   Else 
      FF_LENGTH=S_LENGTH
   End If 
End If 
Loke CN,FF_LENGTH : Add CN,4 : Rem oneShotHiSamples   
Loke CN,0 : Add CN,4 : Rem repeatHiSamples
Loke CN,32 : Add CN,4 : Rem samplesPerHiCycle
Doke CN,FREQ : Add CN,2 : Rem samplesPerSec
Poke CN,1 : Inc CN : Rem octave 
Poke CN,COMP(B) : Inc CN : Rem compression
Loke CN,VOL*1024 : Rem unity $00000400 $00010000 $0000FFFF  
If NAME$(B)=_$
   If FB$(B)=_UNNAMED$
      S$=F$
   Else 
      S$=FB$(B)
   End If 
Else 
   S$=NAME$(B)
End If 
Gosub PROPLEN
_NAME$="NAME"+_CHUNK$+S$+_CHUNK$
Loke Varptr(_NAME$)+4,Len(_NAME$)-8
If CPYR$(B)<>_$
   S$=CPYR$(B)
   Gosub PROPLEN
   _CPYR$="(c) "+_CHUNK$+S$+_CHUNK$
   Loke Varptr(_CPYR$)+4,Len(_CPYR$)-8
Else 
   _CPYR$=_$
End If 
If AUTH$(B)<>_$
   S$=AUTH$(B)
   Gosub PROPLEN
   _AUTH$="AUTH"+_CHUNK$+S$+_CHUNK$
   Loke Varptr(_AUTH$)+4,Len(_AUTH$)-8
Else 
   _AUTH$=_$
End If 
If TXT$(B)<>_$
   S$=TXT$(B)
   Gosub PROPLEN
   _TXT$="TEXT"+_CHUNK$+S$+_CHUNK$
   Loke Varptr(_TXT$)+4,Len(_TXT$)-8
Else 
   _TXT$=_$
End If 
If ANNO$(B)<>_$
   S$=ANNO$(B)
Else 
   S$=_FXBOX$
End If 
Gosub PROPLEN
_ANNO$="ANNO"+_CHUNK$+S$+_CHUNK$
Loke Varptr(_ANNO$)+4,Len(_ANNO$)-8
If Fn STEREOORQUAD
   _CHAN$="CHAN"+_CHUNK$+_CHUNK$
   Loke Varptr(_CHAN$)+4,4
   If Fn STEREO
      Loke Varptr(_CHAN$)+8,6 : Rem STEREO 6L  
   Else If Fn QUAD
      Loke Varptr(_CHAN$)+8,30 : Rem QUAD 30L ea-iff-85.CHAN does not define quad     
   End If 
Else 
   _CHAN$=_$
End If 
_BODY$="BODY"+_CHUNK$
If _BITS=8 and Fn ODD(S_LENGTH) Then _PAD=1 Else _PAD=0 : Rem odd sizes have a pad byte  
Loke Varptr(_BODY$)+4,S_LENGTH+_PAD
T$=T$+_NAME$+_CPYR$+_AUTH$+_TXT$+_ANNO$+_CHAN$+_BODY$
Loke Varptr(T$)+4,S_LENGTH+_PAD+Len(T$)
Return 
'
PROPLEN:
H_LENGTH=Len(S$)
If Fn ODD(H_LENGTH)
   S$=S$+Chr$(0)
End If 
Return 
'
PARSEHEADER:
_CHANNELS=1
S_START=Start(PBANK) : S_LENGTH=0 : H_LENGTH=Start(PBANK)+Length(PBANK)
H_START=S_START
If _IFF
   H_POS=S_START
   S_START=Hunt(S_START To H_LENGTH,"FORM")
   If S_START=0
      S_START=H_POS
      _IFF=False
      Return 
   End If 
   Add S_START,4 : F_LENGTH=Leek(S_START) : Add S_START,4
   If F_LENGTH<Length(PBANK)
      H_LENGTH=S_START+F_LENGTH
   End If 
   H_POS=S_START
   S_START=Hunt(S_START To H_LENGTH,"8SVX")
   If S_START=0
      S_START=H_POS
      S_START=Hunt(S_START To H_LENGTH,"16SV")
      If S_START=0
         S_START=H_POS
         S_START=Hunt(S_START To H_LENGTH,"24SV")
         If S_START=0
            S_START=H_POS
            S_START=Hunt(S_START To H_LENGTH,"IESV")
            If S_START
               _BITS=32
               _FLOAT=True
            End If 
         Else 
            _BITS=24
         End If 
      Else 
         _BITS=16
      End If 
   Else 
      _BITS=8
   End If 
   If S_START
      T$="VHDR" : _FULLCHUNK=True : Gosub PARSECHUNK
      CN=Varptr(T$)
      HI_LENGTH=Leek(CN) : Rem oneShotHiSamples 
      Add CN,4
      HI_REPEAT=Leek(CN) : Add CN,8 : Rem repeatHiSamples
      _RATE=Deek(CN) : Add CN,2
      If _RATE=30464 or _RATE=22664 : Rem 96000 or 88200 hack
         Add _RATE,65536
         _DIAL=0 : _ROT(_DIAL)=False : Gosub DIALHIGH
         _AMIHZ=False
      End If 
      _OCTAVE=Peek(CN) : Inc CN
      _TAG=Peek(CN) : Inc CN
      _UNTY=Leek(CN)
      T$="NAME" : Gosub PARSECHUNK : _NAME$=T$
      T$="(c) " : Gosub PARSECHUNK : _CPYR$=T$
      T$="AUTH" : Gosub PARSECHUNK : _AUTH$=T$
      T$="TEXT" : Gosub PARSECHUNK : _TXT$=T$
      T$="ANNO" : Gosub PARSECHUNK : _ANNO$=T$
      T$="CHAN" : _FULLCHUNK=True : Gosub PARSECHUNK
      If T$<>_$
         _CHANNELS=Leek(Varptr(T$))
         If _CHANNELS=4 or _CHANNELS=2 : Rem RIGHT 4L LEFT 2L 
            _CHANNELS=1
         Else If _CHANNELS=6 : Rem STEREO 6L  
            _CHANNELS=2
            _INTERLEAVED=False
         Else If _CHANNELS=30 : Rem QUAD 30L 
            _CHANNELS=4
            _INTERLEAVED=False
         End If 
      Else 
         S_START=H_POS
      End If 
      H_POS=S_START
      S_START=Hunt(S_START To H_LENGTH,"BODY") : Add S_START,4
      If _OCTAVE>3
         S_START=S_START+((HI_LENGTH+HI_REPEAT)*3)
         _RST=HI_LENGTH*4
         HI_LENGTH=(HI_LENGTH+HI_REPEAT)*4
         _RL=HI_LENGTH-_RST
      Else If _OCTAVE>1
         S_START=S_START+HI_LENGTH+HI_REPEAT
         _RST=HI_LENGTH*2
         HI_LENGTH=(HI_LENGTH+HI_REPEAT)*2
         _RL=HI_LENGTH-_RST
      Else 
         _RST=HI_LENGTH
         HI_LENGTH=HI_LENGTH+HI_REPEAT
         _RL=HI_LENGTH-_RST
      End If 
      If _TAG>0
         If _CHANNELS=1
            HI_LENGTH=(HI_LENGTH/2)+2
         Else If _CHANNELS=2
            HI_LENGTH=HI_LENGTH+4
         Else If _CHANNELS=4
            HI_LENGTH=(HI_LENGTH*2)+8
         End If 
      Else If _CHANNELS=2
         HI_LENGTH=HI_LENGTH*2
      Else If _CHANNELS=4
         HI_LENGTH=HI_LENGTH*4
      End If 
      If HI_LENGTH>0
         S_LENGTH=HI_LENGTH
      Else 
         S_LENGTH=Leek(S_START)
      End If 
      Add S_START,4
      _TOAST$=_TOAST$+"Iff"
   Else 
      S_START=H_POS
      S_START=Hunt(S_START To H_LENGTH,"AIFF")
      If S_START=0
         S_START=H_POS
         S_START=Hunt(S_START To H_LENGTH,"AIFC")
         If S_START=0
            Add H_START,4
            S_START=H_START
            H_LENGTH=Leek(S_START)
            Add H_LENGTH,8
            S_LENGTH=H_LENGTH
            _IFF=False
            Return 
         End If 
      End If 
      T$="COMM" : _FULLCHUNK=True : Gosub PARSECHUNK
      _CHANNELS=Deek(Varptr(T$))
      _BITS=Deek(Varptr(T$)+6)
      _RATE=Deek(Varptr(T$)+10)
      H_POS=S_START
      S_START=Hunt(H_POS To H_LENGTH,"FL32")
      If S_START=0
         S_START=Hunt(H_POS To H_LENGTH,"fl32")
         If S_START=0
            S_START=H_POS
         End If 
      End If 
      If H_POS-S_START
         _FLOAT=True
      End If 
      T$="ANNO" : Gosub PARSECHUNK : _ANNO$=T$
      S_START=Hunt(S_START To H_LENGTH,"SSND")
      Add S_START,4 : S_LENGTH=Leek(S_START) : Add S_START,4
      _TOAST$=_TOAST$+"Aif"
      _AIF=True
   End If 
Else If _WAV
   S_START=Hunt(S_START To H_LENGTH,"fmt ")
   Add S_START,8 : _TAG=Peek(S_START)
   If _TAG=3 or _TAG=254
      _FLOAT=True
   Else If _TAG-1
      _TOAST$="("+Str$(_TAG)-_SPACE$+") "
      _TAG=0
   End If 
   Add S_START,2 : _CHANNELS=Peek(S_START) : Add S_START,2
   Poke Varptr(_RATE)+3,Peek(S_START) : Inc S_START
   Poke Varptr(_RATE)+2,Peek(S_START) : Inc S_START
   Poke Varptr(_RATE)+1,Peek(S_START) : Inc S_START
   Poke Varptr(_RATE),Peek(S_START) : Inc S_START
   Add S_START,6 : _BITS=Peek(S_START)
   H_POS=S_START
   S_START=Hunt(H_POS To H_LENGTH,_DATA$)
   If S_START
      Add S_START,4
      Poke Varptr(S_LENGTH)+3,Peek(S_START) : Inc S_START
      Poke Varptr(S_LENGTH)+2,Peek(S_START) : Inc S_START
      Poke Varptr(S_LENGTH)+1,Peek(S_START) : Inc S_START
      Poke Varptr(S_LENGTH),Peek(S_START) : Inc S_START
   Else 
      S_START=H_LENGTH
      S_LENGTH=0
   End If 
   _TOAST$=_TOAST$+"Wav"
Else 
   _BITS=8
   _TOAST$=_TOAST$+"Raw PCM "
   S_START=0
End If 
If _FLOAT
   _TOAST$=_TOAST$+" Float"
End If 
If _BITS>0
   _TOAST$=_TOAST$+Str$(_BITS)+_BIT$
End If 
If _RATE>0
   _TOAST$=_TOAST$+Str$(_RATE)+_HZ$+_SPACE$
End If 
Return 
'
PARSECHUNK:
H_POS=S_START
G:
S_START=Hunt(S_START To H_LENGTH,T$)
If S_START
   Add S_START,4 : C_LENGTH=Leek(S_START) : Add S_START,4
   If C_LENGTH<0 or C_LENGTH>H_LENGTH-H_START : Rem check again
      Goto G
   End If 
   T$=Peek$(S_START,C_LENGTH)
   If Not _FULLCHUNK
      Repeat 
         Exit If Peek(Varptr(T$)+C_LENGTH-1)<>CHR_NULL
         Dec C_LENGTH
      Until C_LENGTH<0
      T$=Left$(T$,C_LENGTH)
   End If 
Else 
   T$=_$
   S_START=H_POS
End If 
_FULLCHUNK=False
Return 
'
_CLEARMETA:
_NAME$=_$ : _CPYR$=_$ : _AUTH$=_$ : _TXT$=_$ : _ANNO$=_$
_TAG=0 : _UNTY=0
'
SETMETA:
NAME$(B)=_NAME$
CPYR$(B)=_CPYR$
AUTH$(B)=_AUTH$
TXT$(B)=_TXT$
ANNO$(B)=_ANNO$
COMP(B)=_TAG
Return 
'
MPEGA:
Pof(1)=Lof(1)-128
If Input$(1,3)="TAG"
   Pof(1)=Lof(1)-125 : Rem title
   _NAME$=Input$(1,30)-_NULL$
   Pof(1)=Lof(1)-95 : Rem artist 
   _AUTH$=Input$(1,30)-_NULL$
   Pof(1)=Lof(1)-65 : Rem album
   _TXT$=Input$(1,30)-_NULL$
   Pof(1)=Lof(1)-35 : Rem date 
   _CPYR$=Input$(1,4)-_NULL$
   Pof(1)=Lof(1)-31
   S$=Input$(1,30)-_NULL$
   If S$<>_$ and _TXT$<>_$
      _TXT$=_TXT$+_SPACE$+S$
   Else If S$<>_$
      _TXT$=S$
   End If 
End If 
_ANNO$="mpega.library"
Gosub SETMETA
Close 1
If Not MPEG
   TXT1$=_ANNO$
   Trap Lib Open 4,TXT1$,0
   If Errtrap
      TXT2$=_NOTAVAILABLE$ : Goto _ERROR
   Else 
      MPEG=True
   End If 
End If 
_TOAST$="Mpeg " : Gosub T0AST
Gosub ROOT
T$=String$(_NULL$,46) : Rem STRUCTURE MPEGA_CTRL 
CN=Varptr(T$) : Add CN,4
'layer 1/2 mono  
Doke CN,0 : Add CN,2 : Rem force mono 
Doke CN,1 : Add CN,2 : Rem freq div 
Doke CN,2 : Add CN,2 : Rem high quality 
Loke CN,48000 : Add CN,4 : Rem max frequency
'layer 1/2 stereo
Doke CN,1 : Add CN,2 : Rem freq div 
Doke CN,2 : Add CN,2 : Rem high quality 
Loke CN,48000 : Add CN,4 : Rem max frequency
'layer 3 mono  
Doke CN,0 : Add CN,2 : Rem force mono 
Doke CN,1 : Add CN,2 : Rem freq div 
Doke CN,2 : Add CN,2 : Rem high quality 
Loke CN,48000 : Add CN,4 : Rem max frequency
'layer 3 stereo
Doke CN,1 : Add CN,2 : Rem freq div 
Doke CN,2 : Add CN,2 : Rem high quality 
Loke CN,48000 : Add CN,4 : Rem max frequency
'
Doke CN,0 : Add CN,2 : Rem check mpeg 
Loke CN,1152 : Rem decode buffer size 
Areg(0)=Varptr(S$)
Areg(1)=Varptr(T$)
CN=Lib Call(4,-30) : Rem _LVOMPEGA_open 
If CN<=0
   TXT1$="Cannot decode" : TXT2$=S$ : Goto _ERROR
End If 
_RATE=Leek(CN+8) : Rem frequency
_CHANNELS=Deek(CN+12) : Rem channels   
SZ=((Leek(CN+14)/10)*((_RATE/100)*4))+M_BUF*2 : Rem ms duration
FX_LENGTH2=M_BUF*2 : Rem stereo 
Gosub _WORKSET
Trap Reserve As Work PBANK,SZ
If Errtrap Then Goto NOMEMORY
FX_START=Start(PBANK)
FX_START2=Start(WBANK)
FX_LENGTH=Length(PBANK)/2
FX=FX_START
FXE=FX+FX_LENGTH
TSIZE=8 : Gosub SETTEMP
A0=Start(TBANK)
Loke A0,FX_START2
Loke A0+4,FX_START2+M_BUF
Repeat 
   Areg(0)=CN
   Areg(1)=A0
   SZ=Lib Call(4,-42) : Rem _LVOMPEGA_decode 
   Exit If SZ<=0
   Add SZ,SZ
   Exit If FX+SZ>=FXE
   Copy FX_START2,FX_START2+SZ To FX
   Copy FX_START2+M_BUF,FX_START2+M_BUF+SZ To FX+(FX_LENGTH)
   Add FX,SZ
   Gosub KEY
Until Fn KEY_ESC
Areg(0)=CN
CN=Lib Call(4,-36) : Rem _LVOMPEGA_close
Gosub CLRTEMP
Goto _CLEARWORK
'
POWERPACKER:
If Not PP20
   TXT1$="powerpacker.library"
   Trap Lib Open 3,TXT1$,0
   If Errtrap
      TXT2$=_NOTAVAILABLE$ : Goto _ERROR
   Else 
      PP20=True
   End If 
End If 
Close 1
_TOAST$="Power Packer " : Gosub T0AST
Gosub ROOT
'**************************************************************************
'   procedure originally by Marcin Szumiela
'   powerpacker.library (C) Copright 1991-1993 Nico François 
'  
Areg(0)=Varptr(S$)
Areg(1)=Varptr(S_START)
Areg(2)=Varptr(S_LENGTH)
Areg(3)=0
Dreg(0)=3 : Rem effect 
Dreg(1)=0
CN=Lib Call(3,-30) : Rem _LVOppLoadData 
If CN=-1
   TXT1$="Power Packer" : TXT2$="decompression failed!" : Goto _NOTICE
End If 
Dir$="T:"
Open Out 1,D$
Ssave 1,S_START To S_START+S_LENGTH
Close 1
Areg(1)=S_START
Dreg(0)=S_LENGTH
CN=Execall(-210) : Rem _LVOFreeMem
'
'**************************************************************************
_PPCOMPRESSED=True
Return 
'
ROOT:
PPROGDIR$=Dir$
If Instr(F$,PROGDIR$)>0
   S$=F$+_NULL$
   I=Len(F$)
   Repeat 
      Exit If Peek(Varptr(F$)+I)=CHR_SLASH
      Dec I
   Until I<0
   F$=Right$(F$,Len(F$)-I-1)
   D$=F$
Else 
   D$=F$
   S$=Dir$+F$+_NULL$
End If 
Return 
'
SETFILENAMELENGTH:
Set Dir 105,_$
Return 
'
SETFILENAME:
FB$(B)=F$
If F$<>_UNNAMED$ Then FPATH$(B)=Dir$ Else FPATH$(B)=_$
If B<11
   Mid$(MENB$(B),7)=Space$(16)
   If F$<>_$
      Mid$(MENB$(B),7)=Left$(FB$(B),8)
   End If 
End If 
Return 
'
SETUNNAMED:
If F$=_$
   F$=_UNNAMED$ : Goto SETFILENAME
End If 
Return 
'
CLEANFILENAME:
I=Len(F$)
Repeat 
   Exit If Peek(Varptr(F$)+I-1)-CHR_SPACE
   Dec I
Until I<0
F$=Left$(F$,I)
Return 
'
SETFILEPOS:
TCOUNT=0
TPOS=FTOTAL-1
Repeat 
   TXT1$=FILES$(TCOUNT)
   CCOUNT=0
   If Peek(Varptr(TXT1$))<>CHR_STAR
      CN=Peek(Varptr(F$)+CCOUNT)
      If Fn KEY_UPPER(CN)
         CN=CN+32
      End If 
      CN2=Peek(Varptr(TXT1$)+1+CCOUNT)
      If Fn KEY_UPPER(CN2)
         CN2=CN2+32
      End If 
      If CN=CN2
         CCOUNT=1 : CSAME=1
         Repeat 
            CN=Peek(Varptr(F$)+CCOUNT)
            If Fn KEY_UPPER(CN)
               CN=CN+32
            End If 
            CN2=Peek(Varptr(TXT1$)+1+CCOUNT)
            If Fn KEY_UPPER(CN2)
               CN2=CN2+32
            End If 
            If CN=CN2
               Inc CSAME
            Else If CN>CN2 : Rem try next position  
               Dec CSAME
               Exit 
            Else If CN<CN2 : Rem this position
               Dec CSAME
               TPOS=TCOUNT
               TCOUNT=-1
               Exit 
            End If 
            Inc CCOUNT
         Until CCOUNT=>Len(TXT1$) or CCOUNT=>Len(F$)
         If CCOUNT=CSAME : Rem update size only 
            FILEL(TCOUNT)=S_LENGTH
            Return 
         End If 
      Else If CN<CN2 : Rem this position
         TPOS=TCOUNT
         TCOUNT=-1
         Exit 
      End If 
   End If 
   Inc TCOUNT
Until TCOUNT>FTOTAL or TCOUNT=0
TCOUNT=FTOTAL-1
While TPOS<TCOUNT
   Swap FILES$(TCOUNT),FILES$(TCOUNT-1)
   Swap FILEL(TCOUNT),FILEL(TCOUNT-1)
   Dec TCOUNT
Wend 
FILES$(TPOS)=_SPACE$+F$
FILEL(TPOS)=S_LENGTH
Inc FTOTAL
Return 
'
MUTEOPEN:
If PLYING
   C=-1
   If Fn MONOORSTEREOORQUAD
      Gosub CHECKMUTE
   Else If Fn INVIEW and MUTE(B)=False
      C=0
   End If 
   If C=0
      _MUTED=True
      Gosub _MUTE
   End If 
End If 
Return 
'
'
'
'***************************************************************************** 
'*edit************************************************************************ 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   .,::::::::::::-.   :::  :::::::::: 
'   ;;;;'''';;,   `';, ;;;  ;;;;;;;''' 
'    [[cccc `[[     [[ [[[      [[     
'    $$""""  $$,    $$ $$$,     $$     
'    888oo,_ 888_,o8P'o88888    88,    
'    """"YUM"MMMMP"`  MMM"MM    MMM  
'
'
'  
_CUT:
If RL=0 or P_LENGTH=0 Then Goto FLSHSCR
Gosub _UNDOSET
Gosub _COPYSET
If RL=1 or RL=P_LENGTH
   Gosub _CLEARCOPY
   Bank Swap CBANK,PBANK
   If Fn MULTI
      Gosub CLRPLY
   Else 
      Gosub _STOP
   End If 
   Gosub SETPBANK
   If Fn INVIEW
      ADVPOS#(B)=0
   End If 
Else 
   FX_LENGTH2=Length(PBANK)-CLENGTHN
   Gosub _WORKSET
   Trap Reserve As Work CBANK,CLENGTHN
   If Errtrap
      Goto NOMEMORY
   End If 
   S_START=Start(CBANK)
   CCOUNT=0 : CLENGTH=0
   Repeat 
      Copy P_START+CLENGTH+RST,P_START+CLENGTH+RST+RL To S_START+(RL*CCOUNT)
      CLENGTH=CLENGTH+P_LENGTH
      Inc CCOUNT
   Until CCOUNT>CCOUNTN
   S_START=Start(WBANK)
   CCOUNT=0 : CLENGTH=0
   Repeat 
      If RST+CLENGTH>CLENGTH
         Copy P_START+CLENGTH,P_START+CLENGTH+RST To S_START+CLENGTH-(RL*CCOUNT)
      End If 
      If P_LENGTH>RST+RL
         Copy P_START+CLENGTH+RST+RL,P_START+CLENGTH+P_LENGTH To S_START+CLENGTH+RST-(RL*CCOUNT)
      End If 
      CLENGTH=CLENGTH+P_LENGTH
      Inc CCOUNT
   Until CCOUNT>CCOUNTN
   Gosub _WORKSWAP
   Gosub _RESIZED
End If 
_CBYPS=QUAL(B)
Gosub _RANGENONE
Goto _DRAWALL
'
_CROP:
If RL<2 or RL=P_LENGTH Then Goto FLSHSCR
Gosub _UNDOSET
Gosub _COPYSET
FX_LENGTH2=CLENGTHN
Gosub _WORKSET
S_START=Start(WBANK)
CCOUNT=0 : CLENGTH=0
Repeat 
   Copy P_START+CLENGTH+RST,P_START+CLENGTH+RST+RL To S_START+(RL*CCOUNT)
   CLENGTH=CLENGTH+P_LENGTH
   Inc CCOUNT
Until CCOUNT>CCOUNTN
Gosub _WORKSWAP
Gosub POSCAL
Gosub _RANGENONE
Goto _SHOWALL
'
_COPY:
If P_LENGTH=0 Then Goto FLSHSCR
If RL<2
   Gosub _RANGEALL
   If MACRO
      _CHOICE=3 : Rem after the macro clear the range  
   End If 
End If 
Gosub _COPYSET
Trap Reserve As Work CBANK,CLENGTHN
If Errtrap Then Goto NOMEMORY
_CBYPS=QUAL(B)
S_START=Start(CBANK)
CCOUNT=0 : CLENGTH=0
Repeat 
   Copy P_START+CLENGTH+RST,P_START+CLENGTH+RST+RL To S_START+(RL*CCOUNT)
   CLENGTH=CLENGTH+P_LENGTH
   Inc CCOUNT
Until CCOUNT>CCOUNTN
Return 
'
_PASTE:
If Length(CBANK)=0 Then Goto NOCOPY
If Length(PBANK)=0
   S_START=Start(CBANK)
   S_LENGTH=Length(CBANK)
   Trap Reserve As Work PBANK,S_LENGTH
   If Errtrap
      Goto NOMEMORY
   End If 
   Copy S_START,S_START+S_LENGTH To Start(PBANK)
   RST=0 : RL=S_LENGTH : STA=RST : FI=RL
   QUAL(B)=_CBYPS
   Gosub SETUNNAMED
   Gosub SETPBANK
   Gosub SETCORDS
   If Fn MONOORSTEREOORQUAD or Fn MULTIINVIEW
      Goto _SHOWALL
   End If 
Else 
   If _CBYPS-QUAL(B)
      TXT1$= Fn BPSPROP$+" waveform Vs" : TXT2$= Fn QPROP$+"bit copy buffer" : Goto _ERROR
   End If 
   Gosub _COPYSET
   Gosub _UNDOSET
   If Fn STEREO
      RL=Length(CBANK)/2
   Else If Fn QUAD
      RL=Length(CBANK)/4
   Else 
      RL=Length(CBANK)
   End If 
   FX_LENGTH2=Length(PBANK)+Length(CBANK)
   Gosub _WORKSET
   CCOUNT=0
   Repeat 
      If RST>0
         Copy Start(PBANK)+(P_LENGTH*CCOUNT),Start(PBANK)+(P_LENGTH*CCOUNT)+RST To Start(WBANK)+(P_LENGTH*CCOUNT)+(RL*CCOUNT)
      End If 
      Copy Start(CBANK)+(RL*CCOUNT),Start(CBANK)+(RL*CCOUNT)+RL To Start(WBANK)+(P_LENGTH*CCOUNT)+RST+(RL*CCOUNT)
      If RST<P_LENGTH
         Copy Start(PBANK)+(P_LENGTH*CCOUNT)+RST,Start(PBANK)+(P_LENGTH*CCOUNT)+P_LENGTH To Start(WBANK)+RST+(P_LENGTH*CCOUNT)+(RL*CCOUNT)+RL
      End If 
      Inc CCOUNT
   Until CCOUNT>CCOUNTN
   Gosub _WORKSWAP
   Gosub _RESIZED
   If Fn MONOORSTEREOORQUAD or Fn MULTIINVIEW
      RENDERING=True
      Goto AFTERWAND
   End If 
End If 
Goto HEADER
'
_SIZE:
Gosub _OPENFXTEXTWIN
TXT1$=_FROM$+Str$(P_LENGTH/_BYPS)+_COLON$
T$=_$ : Gosub _RUNFXTEXTWIN
If T$=_$ Then REQ=False
If REQ
   CN=Int(Val(T$)*_BYPS)
   T$=Str$(CN)
   Gosub _UNDOSET
   MACRO=True
   Gosub ¯SIZE
   MACRO=False
   Gosub _DRAWALL
End If 
Return 
'
_TIME:
Gosub _OPENFXTEXTWIN
DIV#=FREQ
TXT1$=_FROM$+Str$((P_LENGTH/_BYPS)/DIV#)+"s"+_COLON$
T$=_$ : Gosub _RUNFXTEXTWIN
If T$=_$ Then REQ=False
If REQ
   CN=Int((Val(T$)*_BYPS)*DIV#)
   T$=Str$(CN)
   Gosub _UNDOSET
   MACRO=True
   Gosub ¯SIZE
   MACRO=False
   Gosub _DRAWALL
End If 
Return 
'
_SWAP:
Gosub _OPENFXTEXTWIN
TXT1$="Swap"+Str$(B)+" with:"
T$=_$ : Gosub _RUNFXTEXTWIN
If T$=_$ Then REQ=False
If REQ
   Gosub _RANGENONE
   If MACRO
      Gosub ¯SWAP
   Else 
      MACRO=True : Gosub ¯SWAP : MACRO=False
   End If 
End If 
Return 
'
_SWAPLAST:
XB=B
Gosub _FINDEMPTY
If B=-1 Then B=_FL
If B<0
   B=XB
   Return 
End If 
SC=B-1
B=XB
If B=>SC Then Return 
RENDERING=True
Repeat 
   Gosub _SWAPNEXT
Until SC=B
RENDERING=False
PB=B : B=XB
Goto SW
'
_SWAPPREVIOUS:
If B=1 Then Return 
PBANK=B+JB : T$=Str$(B-1)
Gosub ¯SWAP
Dec B
Goto SW
'
_SWAPNEXT:
If B=_FL Then Return 
PBANK=B+JB : T$=Str$(B+1)
Gosub ¯SWAP
Inc B
'
SW:
If RENDERING Then Return 
If _MENUDO Then Return 
Gosub SETBANK
Goto _SHOWALL
'
SWPMENU:
If B=_M3SEL-2 Then Goto FLSHSCR
T$=Str$(_M3SEL-2)
MACRO=True : Gosub ¯SWAP : MACRO=False
Return 
'
_COPYSET:
Gosub SETPBANK
Gosub SETCORDS
If Fn STEREO
   CLENGTHN=RL*2
   CCOUNTN=1
Else If Fn QUAD
   CLENGTHN=RL*4
   CCOUNTN=3
Else 
   CLENGTHN=RL
   CCOUNTN=0
End If 
Return 
'
_COPYSWAP:
Bank Swap PBANK,CBANK
XR=0 : XR2=0 : XD=0 : XD2=SCR_W : L=0 : ST=0 : FIN=0
Gosub RNGC
REQ=True
Gosub PBANKLEN
Gosub POSCAL
Goto _SHOWALL
'
_COPYCOPY:
Bank Swap CBANK,CCBANK
Return 
'  
_CLEARCOPY:
Erase CBANK
REQ=True
Return 
'
_UNDO:
If Length(UBANK)=0 Then Goto NOUNDO
If UB-B Then Goto WRONGUNDO
Bank Swap PBANK,UBANK
Gosub SETPBANK
QUAL(B)=_UBYPS
If Length(PBANK)-Length(UBANK)
   Gosub _RANGENONE
   Gosub _RESIZED
End If 
Gosub _DRAWALL
If Instr(_UNDID$,"_ENCODE")
   COMP(B)=0
Else If Instr(_UNDID$,"_DECODEFIB")
   COMP(B)=1
Else If Instr(_UNDID$,"_DECODEEXP")
   COMP(B)=2
Else 
End If 
_TOAST$=G$ : Gosub T0AST
Goto CAL_BCK
'
_UNDOSET:
If REALTIME or MACRO or PASS>0 Then Return 
REQ=True
If P_LENGTH=0 Then Return 
_UNDID$=G$ : _UBYPS=QUAL(B)
S_LENGTH=Length(PBANK)
Trap Reserve As Work UBANK,S_LENGTH
If Errtrap Then Return : Rem ignore errors  
Copy Start(PBANK),Start(PBANK)+S_LENGTH To Start(UBANK)
UB=B
Return 
'
_CLEARUNDO:
Erase UBANK
Return 
'
_WORKSET:
Trap Reserve As Work WBANK,FX_LENGTH2
If Errtrap
   Pop : Goto NOMEMORY
End If 
Return 
'
_WORKSWAP:
Bank Swap PBANK,WBANK
Return 
'
_CLEARWORK:
Erase WBANK
Return 
'
_RESIZED:
Gosub _CLEARWORK
Gosub PBANKLEN
If Fn MULTIINVIEW
   D_LENGTH(B)=Length(PBANK)
   If D_LENGTH(B)>0
      ADV#(B)=(D_LENGTH(B)-ST-FIN)/SCR_W#
      D_START(B)=Start(PBANK)+ST
   Else 
      ADV#(B)=0
   End If 
End If 
Gosub SETSELV
RFIN=P_LENGTH-RST-RL
Gosub SETCORDS
Gosub HEADER
Goto DRWTIME
'
'
'
'***************************************************************************** 
'*mix************************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .        :   :::  :.,::      .:.
'    ;;,.    ;;;  ;;;   `;;;,  .,;;
'    [[[[, ,[[[[, [[[      '[[,,[['
'    $$$$$$$$"$$$ $$$,      Y$$$P
'   888 Y88" 888oo88888   oP"``"Yo,
'   MM  M'  "MMMMMMM"MM,m"       "Mm,
'
'
'
_MIX: If _BYPS<3 : _SEL=1 : Goto MIXER : End If : Rem 24bit overflow 
_ADD: _SEL=2 : Goto MIXER
_SUBTRACT: _SEL=3 : Goto MIXER
_AMPLITUDE: Rem _SEL=4 
Gosub _MIXSET
FX_START2=Start(CBANK)+(FX_LENGTH2*PASS)
FX2=FX_START2
_RMS=BSIZE*2 : SUMA#=0 : _READY=False
Repeat 
   If FX2>_RMS+FX_START2
      _READY=True
      FX3=FX2-_RMS
   Else 
      FX3=FX2
   End If 
   On _BYPS Gosub ¯FLOAT3B,¯FLOAT3D,¯FLOAT3T
   SUMA#=SUMA#+(CN2#*CN2#)
   If _READY Then SUMA#=SUMA#-(CN3#*CN3#)
   If SUMA#<0 Then SUMA#=-SUMA#
   _RMS#=Sqr(SUMA#/_RMS)*(_BYPS+1)
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN=Int(CN*_RMS#)
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
   Add FX2,_BYPS
   If FX2>FX_START2+FX_LENGTH2 Then FX2=FX_START2
Until FX>FXE
Return 
'
_MODULATE: _SEL=5 : Goto MIXER
_XOR: _SEL=6
'
MIXER:
Gosub _MIXSET
FX_START2=Start(CBANK)+(FX_LENGTH2*PASS)
If _PPMIX
   FX2=FX_START2+FX_LENGTH2
Else 
   FX2=FX_START2 : CN3=_BYPS
End If 
Repeat 
   On _BYPS Gosub ¯SIGNED2B,¯SIGNED2D,¯SIGNED2T
   On _SEL Gosub ¯MIX,¯ADD,¯SUB,_NOP,¯MOD,¯XOR
   If _PPMIX and _LPMIX
      If FX2=FX_START2+FX_LENGTH2
         CN3=-_BYPS
      Else If FX2=FX_START2
         CN3=_BYPS
      End If 
   Else 
      If FX2=FX_START2+FX_LENGTH2
         If _LPMIX
            FX2=FX_START2
         Else 
            FX=FXE
         End If 
      End If 
   End If 
   Add FX2,CN3
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
_PPMIX=False
Return 
'
_TGLPINGPONG:
If _PPMIX Then _PPMIX=False Else _PPMIX=True
Return 
'
¯MIX: If _BYPS<3 : If CN<0 : If CN2<0 : CN=(CN+CN2)-((CN*CN2)/MIXLO) : Else : Add CN,CN2 : End If : Else : If CN2>0 : CN=(CN+CN2)-((CN*CN2)/MIXHI) : Else : Add CN,CN2 : End If : End If : Return : End If : Rem 24bit overflow 
¯ADD: Add CN,CN2 : Return 
¯SUB: Add CN,-CN2 : Return 
¯MOD: If CN2<0 : CN#=MIXLO : Else CN#=MIXHI : End If : CN=Int(CN*(CN2/CN#)) : Return 
¯XOR: CN=CN xor CN2 : Return 
'
_MIXSET:
Gosub SETPBANK
If FX_LENGTH<2
   Pop : Goto FLSHSCR
End If 
If Fn STEREO
   FX_LENGTH2=Length(CBANK)/2
Else If Fn QUAD
   FX_LENGTH2=Length(CBANK)/4
Else 
   FX_LENGTH2=Length(CBANK)
End If 
If FX_LENGTH2=0
   Pop : Goto NOCOPY
End If 
If Fn STEREOORQUAD and Length(CBANK)>Length(PBANK)
   Gosub FLSHSCR
   _TOAST$="multi buffer overload" : Pop : Goto T0AST
End If 
BPS=_CBYPS
BPSSET:
If BPS=0 Then BPS=_BYPS
If _BYPS=1
   MIXUN=256
   MIXLO=-128
   MIXHI=127
Else If _BYPS=2
   MIXUN=65536
   MIXLO=-32768
   MIXHI=32767
Else If _BYPS=3
   MIXUN=16777216
   MIXLO=-8388608
   MIXHI=8388607
End If 
Goto _UNDOSET
'
'
'
'***************************************************************************** 
'*frame*********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .-:::::':::::::..    :::.      .        :  .,:::::: 
'    ;;;'''',;;;;``;;;;   ;;`;;     ;;,.    ;;; ;;;;'''' 
'    [[[,,==[\[[[,/[[['  ,[[ '[[,   [[[[, ,[[[[, [[cccc
'    `$$$"``""$$$$$$c   c$$$cc$$$c  $$$$$$$$"$$$ $$""""
'   _ 888    ,888b "88bo 888   888,888 Y88" 888o 888oo,_ 
'   MM"MM,   "MMMM   "W" YMM   ""` MM  M'  "MMMM """"YUM 
'
'
'
_SAMPLELEFT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
FX_LENGTH2=_BYPS
'
LEFT:
If RL>1 and RL<FX_LENGTH2 Then Goto FLSHSCR
Gosub _WORKSET
Gosub _UNDOSET
Copy FX,FX+FX_LENGTH2 To Start(WBANK)
Copy FX+FX_LENGTH2,FXE To FX
Copy Start(WBANK),Start(WBANK)+FX_LENGTH2 To FXE-FX_LENGTH2
Goto _CLEARWORK
'
_SAMPLERIGHT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
FX_LENGTH2=_BYPS
'
RIGHT:
If RL>1 and RL<FX_LENGTH2 Then Goto FLSHSCR
Gosub _WORKSET
Gosub _UNDOSET
Copy FXE-FX_LENGTH2,FXE To Start(WBANK)
Copy FX,FXE-FX_LENGTH2 To FX+FX_LENGTH2
Copy Start(WBANK),Start(WBANK)+FX_LENGTH2 To FX
Goto _CLEARWORK
'
_BEATLEFT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
FX_LENGTH2= Fn BPSALIGN(P_LENGTH/_TIMEDIV#)
Goto LEFT
'
_BEATRIGHT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
FX_LENGTH2= Fn BPSALIGN(P_LENGTH/_TIMEDIV#)
Goto RIGHT
'
_TIMEDIVISION:
Gosub HIGHDIV
Gosub _OPENFXTEXTWIN
TXT1$=_FROM$+Str$(_TIMEDIV#)+_COLON$
T$=_$ : Gosub _RUNFXTEXTWIN
_TEXT=True
If T$=_$ Then REQ=False
If REQ
   TIMEDIV:
   CN#=Val(T$)
   If CN#<2 or CN#>SCR_W
      Goto FLSHSCR
   End If 
   BPS=_BYPS
   _TIMEDIV#=CN#
   _TIMEBEAT#=SCR_W/_TIMEDIV#
   If Not MACRO
      Gosub _DRAWALL
   End If 
Else 
   RENDERING=True
   Gosub DRWDIV
   RENDERING=False
End If 
Return 
'
'
'
'***************************************************************************** 
'*volume********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'   :::      .::.    ...       :::     ...    ::: .        :  .,:::::: 
'   ';;,   ,;;;'  .;;;;;;;.    ;;;    ';;     ;;; ;;,.    ;;; ;;;;'''' 
'    \[[  .[[/   ,[[     \[[,  [[[    [['     [[[ [[[[, ,[[[[, [[cccc  
'     Y$c.$$"    $$$,     $$$  $$'    $$      $$$ $$$$$$$$"$$$ $$""""  
'      Y88P      "888,_ _,88Po88oo,.__88    .d888888 Y88" 888o 888oo,_ 
'       MP         "YMMMMMP" """YUMMMM "YmmMMMM""MM  M'  "MMMM """"YUM 
'  
'
'
_VOLUME:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_VOLUMEP"
      Gosub _OPENFXWIN
      FXN=VOLN : FXSN=VOLN : FXS$=_PERCENT$ : Gosub FXDRW
      Gosub VODRW
      FXRUN$="VODRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_VOLUMEP:
If VA#=1 Then Return 
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _UNDOSET
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN=Int(CN*VA#)
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'
VODRW:
VOLN=FXN
VA#=VOLN*0.01
FXSN=VOLN
Return 
'
_FADEIN:
CN2=_BYPS : FX2=0
Goto A
_FADEOUT:
CN2=-_BYPS
A:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If CN2=-_BYPS Then FX2=FX_LENGTH
DIV#=FX_LENGTH/100.0 : If DIV#<1 Then DIV#=1
Gosub _UNDOSET
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN#=(FX2/DIV#)/100.0
   CN=Int(CN*CN#)
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
   Add FX2,CN2
Until FX=>FXE
Return 
'
_HALF:
VA#=0.5
Goto _VOLUMEP
'
_DOUBLE:
VA#=2.0
Goto _VOLUMEP
'
_SILENCE:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _UNDOSET
Repeat 
   FX_LENGTH2=Min(FX_LENGTH-(FX-FX_START),_MEGABYTE)
   Fill FX To FX+FX_LENGTH2,0
   FX=FX+FX_LENGTH2
Until FX=>FXE
Return 
'
_MAXIMIZE:
If PASS=0
   Gosub SETPBANK
   If FX_LENGTH<2
      Goto FLSHSCR
   End If 
   CN2=0
   Repeat 
      On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
      If CN>CN2
         CN2=CN
      Else If CN<0 and CN<-CN2
         CN2=-CN
      End If 
      Add FX,_BYPS
   Until FX>FXE
   If CN2=0
      Return 
   End If 
   CN#=CN2
   If _BYPS=1
      VA#=127/CN#
   Else If _BYPS=2
      VA#=32767/CN#
   Else If _BYPS=3
      VA#=8388607/CN#
   End If 
End If 
Goto _VOLUMEP
'
_DCOFFSET:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      Gosub _OPENFXTEXTWIN
      BTXT1$="Auto" : BX=267 : BY=71 : BZN=ZN_AUTO : Gosub BTN
      TXT1$="-100% to 100%:"
      _EXIT=False : _TEXT=True
      TXT_X=332 : TXT_Y=68 : N=0 : T$=_$ : _MAX=9
      Repeat 
         Gosub _TEXTINPUT
         Repeat 
            Gosub GVAL
            If Z=ZN_AUTO and Fn MOUSEDOWN
               PZN=Z : BX=267 : BY=71 : Gosub PRESS
               If _ON
                  Gosub _CLOSEFXWIN
                  Gosub WINC
                  Reset Zone ZN_AUTO
                  REQ=True
                  Goto _DCSCAN
               End If 
            Else If Z=ZN_OK and Fn MOUSEDOWN or Fn KEY_RETURN
               PZN=Z : BX=RX : BY=87 : Gosub PRESS
               If _ON
                  REQ=True
                  _EXIT=True
               End If 
            Else If Z=ZN_CANCEL and Fn MOUSEDOWN or Fn KEY_ESC
               PZN=Z : BX=RX+107 : BY=87 : Gosub PRESS
               If _ON
                  REQ=False
                  _EXIT=True
               End If 
            End If 
         Until _EXIT or C
      Until _EXIT
      Gosub _CLOSEFXWIN
      Gosub WINC
      Reset Zone ZN_AUTO
      TVAL=Val(T$)
      If(T$=_$ or TVAL=0) and REQ
         REQ=False
         Goto FLSHSCR
      End If 
      If Not REQ
         Return 
      End If 
      TVAL=Min(100,TVAL)
      TVAL=Max(-100,TVAL)
      '
      DCSETP:
      CN#=TVAL*0.01
      If _BYPS=1
         _DCOFFSETN=Int(CN#*127)
      Else If _BYPS=2
         _DCOFFSETN=Int(CN#*32767)
      Else If _BYPS=3
         _DCOFFSETN=Int(CN#*8388607)
      End If 
   End If 
   If Not REQ
      Return 
   End If 
End If 
_DCOFFSETP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _UNDOSET
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN=CN+_DCOFFSETN
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'
_DCSCAN:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
CN2=0 : CN3=0
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   If CN>0
      If CN>CN2
         CN2=CN
      End If 
   Else If CN<0
      If CN<CN3
         CN3=CN
      End If 
   End If 
   Inc FX
Until FX>FXE
_DCOFFSETN=(-CN3-CN2)/2
Goto _DCOFFSETP
'
_DCHALVE:
Gosub _UNDOSET
MACRO=True
TVAL=100 : Gosub DCSETP
TVAL=-100 : Gosub DCSETP
MACRO=False
Return 
'
'
'
'***************************************************************************** 
'*resample******************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   :::::::..  .,:::::: .::::::.   :::.      .        :  ::::::::.   :::    .,:::: 
'   ;;;;``;;;; ;;;;'''';;;`    `;  ;;`;;     ;;,.    ;;; `;;```.;;;  ;;;    ;;;;'' 
'   \[[[,/[[['  [[cccc '[==/[[[[, ,[[ '[[,   [[[[, ,[[[[,`]]nnn]]'   [[[     [[ccc 
'   "$$$$$$c    $$""""   '''    $c$$$cc$$$c  $$$$$$$$"$$$ $$$""      $$'     $$""" 
'   ,888b "88bo 888oo,_,88b    dP 888   888,888 Y88" 888o 888o     o88oo,.__ 888oo 
'   "MMMM   "W" """"YUM  "YMmMY"  YMM   ""` MM  M'  "MMMM YMMMb    """YUMMMM """"Y 
'  
'
'
_RERESAMPLE:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Goto S
_RESAMPLE:
If _SWAP
   Swap N#,N2#
   _SWAP=False
End If 
N#=N2#/N#
S:
BPS=_BYPS
FX_LENGTH2= Fn BPSALIGN(FX_LENGTH/N#)
If FX_LENGTH2<2 Then Goto FLSHSCR
If RL<2 Then _SCALEMIX=False Else _SCALEMIX=True
Gosub _WORKSET
Gosub _UNDOSET
FX_START2=Start(WBANK)
FX2=0
FX3=FX_START2
FXE2=FX_START2+FX_LENGTH2
CN#=N#
If _INTERPOLATE
   If FREQ>N2#
      FMAX#=((N2#/2.0)-1)/BPS
   Else 
      FMAX#=((FREQ/2.0)-1)/BPS
   End If 
   WNWDTH=14*BPS
End If 
Repeat 
   CN=Int(CN#)
   CN#= Fn BPSALIGN(FX2*N#)
   FX=FX_START+CN
   If _INTERPOLATE
      Gosub WINSINC
      On _BYPS Gosub ¯UNIPB,¯UNIPD,¯UNIPT
   Else 
      On _BYPS Gosub ¯POKEPEEKFX3,¯DOKEDEEKFX3,¯TOKETEEKFX3
   End If 
   Add FX2,_BYPS
Until FX3>=FXE2 or FX=FXE
FX=FXE
If _SCALEMIX
   If FX_LENGTH2>=FX_LENGTH
      FX_LENGTH3=FX_LENGTH
   Else 
      FX_LENGTH3=FX_LENGTH2
   End If 
   If MACRO
      Gosub _SILENCE
   Else 
      MACRO=True : Gosub _SILENCE : MACRO=False
   End If 
   Copy FX_START2,FX_START2+FX_LENGTH3 To FX_START
Else 
   Gosub _WORKSWAP
   Gosub _RESIZED
End If 
If Instr(_REPEAT$,_MACRO$)=0
   _REPEAT$="_RERESAMPLE"
End If 
Return 
'
WINSINC:
'***************************************************************************** 
'   Windowed-Sinc Resampling by Ronald H. Nicholson Jr.  
'
X=FX-FX_START
R_G#=2*(FMAX#/(FREQ/BPS)) : Rem Calc gain correction factor
R_Y#=0
For I=-WNWDTH/2 To(WNWDTH/2)-BPS Step BPS : Rem For 1 window width 
   J=Int(X+I) : Rem Calc input sample index
   Rem calculate von Hann Window. Scale and calculate Sinc
   R_W#=0.5-0.5*Cos(_2PI#*(0.5+(J-X)/(WNWDTH/BPS)))
   R_A#=_2PI#*(J-X)*FMAX#/(FREQ/BPS)
   R_SNC#=1
   If(R_A#<>0) Then R_SNC#=Sin(R_A#)/R_A#
   If(J>0) and(J<FX_LENGTH)
      On BPS Gosub ¯IPB,¯IPD,¯IPT
      R_Y#=R_Y#+R_G#*R_W#*R_SNC#*CN
   End If 
Next I
CN=Int(R_Y#) : Rem Return new filtered sample 
Return 
'
'***************************************************************************** 
'
_RENDER:
N#=FREQ
N2#=KEYF
N#=N2#/N#
Gosub _MIXSET
FX_START2=P_START+(P_LENGTH*PASS)+OFFSET
FXE2=P_START+(P_LENGTH*PASS)+P_LENGTH-_BYPS
FX_START=Start(CBANK)+FX_LENGTH2*PASS
FX_LENGTH=FX_LENGTH2
FXE=FX_START+FX_LENGTH2-_BYPS
FX2=0
FX3=FX_START2
CN#=0
If _INTERPOLATE
   If FREQ>N2#
      FMAX#=((N2#/2.0)-1)/BPS
   Else 
      FMAX#=((FREQ/2.0)-1)/BPS
   End If 
   WNWDTH=14*BPS
End If 
If _POLY
   Repeat 
      CN=Int(CN#)
      FX=FX_START+CN
      CN#= Fn BPSALIGN(FX2*N#)
      If _INTERPOLATE
         Gosub WINSINC
         On _BYPS Gosub ¯UNSIGNB,¯UNSIGND,¯UNSIGNT
      Else 
         On _BYPS Gosub ¯PEEK,¯DEEK,¯TEEK
      End If 
      On _BYPS Gosub ¯PEEK3,¯DEEK3,¯TEEK3
      If _BYPS<3
         If CN>MIXHI : Rem SIGN _MIX CHECKCLIP  
            Add CN,-MIXUN
            CN=CN*_AMP#
            If CN3>MIXHI
               Add CN3,-MIXUN
               CN=Min(MIXHI,(CN+CN3)-((CN*CN3)/MIXLO))+MIXUN
            Else 
               Add CN,CN3
               If CN<0 : Rem UNSIGN   
                  CN=CN+MIXUN
               End If 
            End If 
         Else 
            CN=CN*_AMP#
            If CN3<-MIXLO
               CN=Max(MIXLO,(CN+CN3)-((CN*CN3)/MIXHI))
            Else 
               Add CN,CN3-MIXUN
               If CN<0 : Rem UNSIGN   
                  CN=CN+MIXUN
               End If 
            End If 
         End If 
      Else : Rem 24bit overflow 
         If CN>MIXHI : Rem SIGN _ADD CHECKCLIP  
            Add CN,-MIXUN
            CN=CN*_AMP#
            If CN3>MIXHI
               CN=Min(MIXHI,CN+(CN3-MIXUN))
               CN=Max(MIXLO,CN)
               Add CN,MIXUN
            Else 
               Add CN,CN3
               CN=Max(MIXLO,CN) : CN=Min(MIXHI,CN)
               If C<0
                  Add CN,MIXUN
               End If 
            End If 
         Else 
            CN=CN*_AMP#
            If CN3<-MIXLO
               CN=Max(MIXLO,CN+CN3) : CN=Min(MIXHI,CN)
            Else 
               Add CN,CN3-MIXUN
               CN=Max(MIXLO,CN) : CN=Min(MIXHI,CN)
               If C<0
                  Add CN,MIXUN
               End If 
            End If 
         End If 
      End If 
      On _BYPS Gosub ¯POKEFX3,¯DOKEFX3,¯TOKEFX3
      Add FX2,_BYPS
      If FX3>=FXE2
         If PIANO
            FX3=FX_START2+(P_LENGTH*PASS)
         Else 
            FX=FXE
         End If 
      End If 
   Until FX>=FXE
Else 
   Repeat 
      CN=Int(CN#)
      FX=FX_START+CN
      CN#= Fn BPSALIGN(FX2*N#)
      If _AMP#=0
         CN=0
         On _BYPS Gosub ¯POKEFX3,¯DOKEFX3,¯TOKEFX3
      Else 
         If _INTERPOLATE
            Gosub WINSINC
         Else 
            On _BYPS Gosub ¯PEEK,¯DEEK,¯TEEK
         End If 
         If _AMP#<1
            If CN>MIXHI : Rem SIGN   
               CN=Int((CN-MIXUN)*_AMP#)
            Else 
               CN=Int(CN*_AMP#)
            End If 
         End If 
      End If 
      If _INTERPOLATE
         On _BYPS Gosub ¯UNIPB,¯UNIPD,¯UNIPT
      Else 
         On _BYPS Gosub ¯POKEFX3,¯DOKEFX3,¯TOKEFX3
      End If 
      Add FX2,_BYPS
      If FX3>=FXE2
         If PIANO
            FX3=FX_START2+(P_LENGTH*PASS)
         Else 
            FX=FXE
         End If 
      End If 
   Until FX>=FXE
End If 
_AMP#=1
Return 
'
_BYRATE:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If PASS=0
   Gosub _OPENFXTEXTWIN
   BTXT1$=_$ : BX=267 : BY=71 : BZN=ZN_PIANO : Gosub BTN
   Gosub PIANOBTN
   TXT1$=_FROM$+Str$(FREQ)+_COLON$
   _EXIT=False : _TEXT=True : KDOWN=False
   TXT_X=340 : TXT_Y=68 : N=0 : T$=_$ : _MAX=9
   Repeat 
      Gosub _TEXTINPUT
      Repeat 
         Gosub GVAL
         If Z=ZN_PIANO and M
            Repeat 
               Gosub GVAL
               If Z=ZN_PIANO and KDOWN=False
                  PZN=Z : BX=267 : BY=71
                  Gosub PIANOBTNHIGH
                  N=0 : T$=_$
                  KDOWN=True
               End If 
               If Fn KEY_PRESS and KDOWN
                  Gosub PIANO
                  If KEYC<>-1
                     _TOAST$=KEYS$
                     N=Len(T$) : T$=Str$(KEYF)-_SPACE$
                     C=0
                     Gosub _TEXTINPUT
                  Else 
                     Gosub FLSHSCR
                  End If 
               End If 
               If KDOWN and( Fn MOUSEUP or PZN<>Z)
                  BZN=Z : BX=267 : BY=71 : Gosub BTN
                  Gosub PIANOBTN
                  KDOWN=False
               End If 
            Until Fn MOUSEUP
         Else If Z=ZN_OK and Fn MOUSEDOWN or Fn KEY_RETURN
            PZN=Z : BX=RX : BY=RY+28 : Gosub PRESS
            If _ON
               REQ=True
               _EXIT=True
            End If 
         Else If Z=ZN_CANCEL and Fn MOUSEDOWN or Fn KEY_ESC
            PZN=Z : BX=RX+107 : BY=RY+28 : Gosub PRESS
            If _ON
               REQ=False
               _EXIT=True
            End If 
         End If 
      Until _EXIT or C
   Until _EXIT
   If FXOSCILLO
      Gosub _TGLOSCILLOSCOPE
   End If 
   Gosub _CLOSEFXWIN
   Gosub WINC
   Reset Zone ZN_PIANO
   If Not REQ
      Return 
   End If 
   _SWAP=True
   '
   _BYRATEP:
   _TEXT=True
   Gosub SETPBANK
   If FX_LENGTH<2
      Goto FLSHSCR
   End If 
   _TEXT=False
End If 
N2#=Val(T$)
If N2#<500 Then Goto FLSHSCR
N#=FREQ
Goto _RESAMPLE
'
_BYTIME:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
DIV#=FREQ
N2#=(FX_LENGTH/_BYPS)/DIV#
If Fn STEREO
   N2#=N2#/2
Else If Fn QUAD
   N2#=N2#/4
End If 
TXT1$=_FROM$+Str$(N2#)+"s"+_COLON$
Goto BYWIN
'
_BYSIZE:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
N2#=FX_LENGTH/_BYPS
If Fn STEREO
   N2#=N2#/2
Else If Fn QUAD
   N2#=N2#/4
End If 
TXT1$=_FROM$+Str$(N2#)+_COLON$
Goto BYWIN
'  
_BYBPM:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
DIV#=FREQ
N2#=((DIV#/(FX_LENGTH/_BYPS))*60)*4
If Fn STEREO
   N2#=N2#*2
Else If Fn QUAD
   N2#=N2#*4
End If 
_SWAP=True
TXT1$=_FROM$+Str$(N2#)+_COLON$
'
BYWIN:
If PASS=0
   Gosub _OPENFXTEXTWIN
   T$=_$ : Gosub _RUNFXTEXTWIN
   If Not REQ
      Return 
   End If 
   _TEXT=True
   Gosub SETPBANK
   If FX_LENGTH<2
      Goto FLSHSCR
   End If 
   _TEXT=False
End If 
N#=Val(T$)
If N#<2 Then Goto FLSHSCR
Goto _RESAMPLE
'
_OCTAVEUP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _UNDOSET
If RL<2 Then _SCALEMIX=False Else _SCALEMIX=True
FX_LENGTH2= Fn BPSALIGN(FX_LENGTH/2)
Gosub _WORKSET
FX_START2=Start(WBANK)
FX3=FX_START2
Repeat 
   On _BYPS Gosub ¯OCB,¯OCD,¯OCT
   A0=CNR-CN2-CNL+CN
   A1=CNL-CN-A0
   A2=CN2-CNL
   A3=CN
   CN=A0+A1+A2+A3
   If FX_START2+FX_LENGTH2>FX3
      On _BYPS Gosub ¯POKEFX3,¯DOKEFX3,¯TOKEFX3
   End If 
   Add FX,_BYPS
Until FX>FXE
If _SCALEMIX
   If MACRO
      Gosub _SILENCE
   Else 
      MACRO=True : Gosub _SILENCE : MACRO=False
   End If 
   Copy FX_START2,FX_START2+FX_LENGTH2/2 To FX_START
Else 
   Gosub _WORKSWAP
   Gosub _RESIZED
   RST=RST/2
   Gosub HEADERCORDS
   If PLYING
      If Fn MULTIINVIEW
         If OFFSET(B)>P_LENGTH
            OFFSET(B)=OFFSET(B)-P_LENGTH
         End If 
      Else If Fn MONOORSTEREOORQUAD and OFFSET(1)>P_LENGTH
         OFFSET(1)=OFFSET(1)-P_LENGTH
      End If 
   End If 
End If 
Return 
'
_OCTAVEDOWN:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _UNDOSET
If RL<2 Then _SCALEMIX=False Else _SCALEMIX=True
FX_LENGTH2=FX_LENGTH*2
Gosub _WORKSET
FX_START2=Start(WBANK)
FX3=FX_START2
Repeat 
   On _BYPS Gosub ¯OCB,¯OCD,¯OCT
   A0=CNR-CN2-CNL+CN
   A1=CNL-CN-A0
   A2=CN2-CNL
   A3=CN
   CN2=A0+A1+A2+A3
   On _BYPS Gosub ¯UNOCB,¯UNOCD,¯UNOCT
Until FX>FXE
If _SCALEMIX
   If MACRO
      Gosub _SILENCE
   Else 
      MACRO=True : Gosub _SILENCE : MACRO=False
   End If 
   Copy FX_START2,FX_START2+FX_LENGTH2 To FX_START
Else 
   Gosub _WORKSWAP
   Goto _RESIZED
End If 
Return 
'
¯OCB: If FX>FX_START Then CNL=Peek(FX-1)
CN=Peek(FX)
If FX<FXE Then CN2=Peek(FX+1)
If FX<FXE-1 Then CNR=Peek(FX+2)
Inc FX
Return 
'
¯OCD: If FX>FX_START Then CNL=Deek(FX-2)
CN=Deek(FX)
If FX<FXE Then CN2=Deek(FX+2)
If FX<FXE-2 Then CNR=Deek(FX+4)
Add FX,2
Return 
'
¯OCT: If FX>FX_START : FX2=FX-3 : Gosub T24 : CNL=CN : End If : If FX<FXE : FX2=FX+3 : Gosub T24 : CN2=CN : End If : If FX<FXE-3 : FX2=FX+6 : Gosub T24 : CNR=CN : End If : FX2=FX : Gosub T24 : Add FX,3 : Return 
'
T24: VN=Varptr(CN) : Poke VN,0 : Poke VN+1,Peek(FX2) : Poke VN+2,Peek(FX2+1) : Poke VN+3,Peek(FX2+2) : Return 
'
¯UNOCB: Poke FX3,CN : Inc FX3 : Poke FX3,CN2 : Inc FX3 : Return 
¯UNOCD: Doke FX3,CN : Add FX3,2 : Doke FX3,CN2 : Add FX3,2 : Return 
¯UNOCT: VN=Varptr(CN) : Poke FX3,Peek(VN+1) : Inc FX3 : Poke FX3,Peek(VN+2) : Inc FX3 : Poke FX3,Peek(VN+3) : Inc FX3 : VN=Varptr(CN2) : Poke FX3,Peek(VN+1) : Inc FX3 : Poke FX3,Peek(VN+2) : Inc FX3 : Poke FX3,Peek(VN+3) : Inc FX3 : Return 
'
_NOTEUP:
PFREQ=FREQ
FREQ=16730
T$="17734"
Goto UD
'
_NOTEDOWN:
PFREQ=FREQ
FREQ=17734
T$="16730"
'
UD:
Gosub _BYRATEP
T$=Str$(PFREQ)
MACRO=True : Gosub ¯FREQ : MACRO=False
Return 
'
_FINEUP:
T$=Str$(FREQ+50)
Goto _BYRATEP
'  
_FINEDOWN:
T$=Str$(FREQ-50)
Goto _BYRATEP
'
'
'
'***************************************************************************** 
'*convert********************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'     .,-::::::    ...     ::.    :::.:::      .::..,:::::::::::::..  :::::::::: 
'   ,;;;'````'  .;;;;;;;.  ;;;;,  `;;;';;,   ,;;;' ;;;;'''';;;;``;;;; ;;;;;;;''' 
'   [[[        ,[[     \[[, [[[[[. '[[ \[[  .[[/    [[cccc \[[[,/[[['     [['    
'   $$$        $$$,     $$$ $$$ "Y$c$$  Y$c.$$"     $$"""" "$$$$$$c       $$ 
'   `88bo,__,o,"888,_ _,88P888    Y88    Y88P       888oo,_,888b "88bo    88,
'     "YUMMMMMP  "YMMMMMP" MM     YM      MP        """"YUM"MMMM   "W"    MMM
'
'
'
_8BITUNSIGNEDTO8BIT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _UNDOSET
Repeat 
   Poke FX,Peek(FX)-128
   Inc FX
Until FX>FXE
Return 
'
UPSAMPLE:
If _BITS=8
   If _BYPS=2
      Goto _8BITTO16BIT
   Else If _BYPS=3
      Goto _8BITTO24BIT
   End If 
Else If _BITS=16 and _BYPS=3
   Goto _16BITTO24BIT
End If 
Return 
'
_8BITTO16BIT: _BITS=16 : Gosub SETQUAL : BPS=2 : Goto P8BIT
'
_8BITTO24BIT: _BITS=24 : Gosub SETQUAL : BPS=3
'
P8BIT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
FX_LENGTH2=FX_LENGTH*BPS
Gosub _WORKSET
Gosub _UNDOSET
FX2=Start(WBANK)
Repeat 
   Poke FX2,Peek(FX) : Inc FX
   Add FX2,BPS
Until FX>FXE
Gosub _WORKSWAP
Goto _RESIZED
'  
_16BITTO8BIT: _FLIP=0 : Goto P16BIT
'
_16BITTO8BITFLIP: _FLIP=1
'
P16BIT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If Fn ODD(FX_LENGTH) Then Goto BAD16BIT
FX_LENGTH2=FX_LENGTH/2
Gosub _WORKSET
Gosub _UNDOSET
FX2=Start(WBANK)
Repeat 
   Poke FX2,Peek(FX+_FLIP) : Add FX,2
   Inc FX2
Until FX>FXE
_BITS=8 : Gosub SETQUAL
Gosub _WORKSWAP
Goto _RESIZED
'
_16BITFLIP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If Fn ODD(FX_LENGTH) Then Goto BAD16BIT
Gosub _UNDOSET
CN=0
Repeat 
   CN=Peek(FX)
   Poke FX,Peek(FX+1) : Inc FX
   Poke FX,CN : Inc FX
Until FX>FXE
Return 
'
_16BITTO24BIT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If Fn ODD(FX_LENGTH) Then Goto BAD16BIT
FX_LENGTH2=FX_LENGTH+(FX_LENGTH/2)
Gosub _WORKSET
Gosub _UNDOSET
FX2=Start(WBANK)
Repeat 
   Poke FX2,Peek(FX) : Inc FX2 : Inc FX
   Poke FX2,Peek(FX) : Inc FX2 : Inc FX
   Inc FX2
Until FX>FXE
_BITS=24 : Gosub SETQUAL
Gosub _WORKSWAP
Goto _RESIZED
'
_24BITTO8BIT: _FLIP=1 : BPS=1 : Goto P24BIT8
'
_24BITTO8BITFLIP: _FLIP=2 : BPS=1
'  
P24BIT8:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
FX_LENGTH2=FX_LENGTH/3
Gosub _UNDOSET
_BITS=8 : Gosub SETQUAL
Goto P24BIT
'
_24BITTO16BIT: _FLIP=1 : BPS=2 : Goto P24BIT16
'
_24BITTO16BITFLIP: _FLIP=2 : BPS=2
'
P24BIT16:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
FX_LENGTH2=FX_LENGTH-(FX_LENGTH/3)
Gosub _UNDOSET
_BITS=16 : Gosub SETQUAL
'
P24BIT:
Gosub _WORKSET
FX2=Start(WBANK)
Randomize Timer
Repeat 
   CN3=Varptr(CN)
   On _FLIP Gosub ¯TEEKER,¯TEEKFLIP
   Gosub DITHER24
   On BPS Gosub ¯POKE,¯DOKE
Until FX>FXE
Gosub _WORKSWAP
Goto _RESIZED
'
¯TEEKER: Poke CN3,0 : Poke CN3+1,Peek(FX) : Inc FX : Poke CN3+2,Peek(FX) : Inc FX : Poke CN3+3,Peek(FX) : Inc FX : Return 
¯TEEKFLIP: Poke CN3+3,Peek(FX) : Inc FX : Poke CN3+2,Peek(FX) : Inc FX : Poke CN3+1,Peek(FX) : Inc FX : Poke CN3,0 : Return 
¯POKE: Poke FX2,CN/65536-CN2 : Inc FX2 : Return 
¯DOKE: Doke FX2,CN/256-CN2 : Add FX2,2 : Return 
'
_24BITFLIP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _UNDOSET
Repeat 
   CN=Peek(FX)
   Poke FX,Peek(FX+2)
   Poke FX+2,CN
   Add FX,3
Until FX>FXE
Return 
'
_32BITTO8BIT: _FLIP=1 : Goto P32BIT8
'
_32BITTO8BITFLIP: _FLIP=2 : Goto P32BIT8
'
_32BITTO8BITMAX: _FLIP=3
'
P32BIT8:
Gosub MATH
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If FX_LENGTH mod 4>0 Then Goto BAD32BIT
FX_LENGTH2=FX_LENGTH/4
Gosub _WORKSET
Gosub _UNDOSET
CN=0 : CN#=0 : CN2#=0
FX2=Start(WBANK)
If _FLIP=3 : Rem MAX
   Repeat 
      CN3=Varptr(CN)
      CN2=Varptr(CN#)
      Gosub P32FLIP
      Loke CN2,Leek(CN3)
      If CN#>CN2#
         CN2#=CN#
      Else If CN#<0 and CN#<-CN2#
         CN2#=-CN#
      End If 
   Until FX>FXE
   CN2#=1/CN2#
   Gosub SETPBANK
   Repeat 
      CN3=Varptr(CN)
      CN2=Varptr(CN#)
      Gosub P32FLIP
      Loke CN2,Leek(CN3)
      Gosub FLOATCLIP
      If CN#<0
         CN=Int((CN#*128)*CN2#)
      Else 
         CN=Int((CN#*127)*CN2#)
      End If 
      Poke FX2,CN
      Inc FX2
   Until FX>FXE
Else 
   Repeat 
      CN3=Varptr(CN)
      CN2=Varptr(CN#)
      On _FLIP Gosub P32,P32FLIP
      Loke CN2,Leek(CN3)
      Gosub FLOATCLIP
      If CN#<0
         CN=Int(CN#*128)
      Else 
         CN=Int(CN#*127)
      End If 
      Poke FX2,CN
      Inc FX2
   Until FX>FXE
End If 
_BITS=8 : Gosub SETQUAL
Gosub _WORKSWAP
Goto _RESIZED
'
_32BITTO16BIT: _FLIP=1 : Goto P32BIT16
'
_32BITTO16BITFLIP: _FLIP=2
'
P32BIT16:
Gosub MATH
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If FX_LENGTH mod 4>0 Then Goto BAD32BIT
FX_LENGTH2=FX_LENGTH/2
Gosub _WORKSET
Gosub _UNDOSET
CN=0 : CN#=0
FX2=Start(WBANK)
Repeat 
   CN3=Varptr(CN)
   CN2=Varptr(CN#)
   On _FLIP Gosub P32,P32FLIP
   Loke CN2,Leek(CN3)
   Gosub FLOATCLIP
   If CN#<0
      CN=Int(CN#*32768)
   Else 
      CN=Int(CN#*32767)
   End If 
   Doke FX2,CN
   Add FX2,2
Until FX>FXE
_BITS=16 : Gosub SETQUAL
Gosub _WORKSWAP
Goto _RESIZED
'
_32BITTO24BIT: _FLIP=1 : Goto P32BIT24
'
_32BITTO24BITFLIP: _FLIP=2
'
P32BIT24:
Gosub MATH
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If FX_LENGTH mod 4>0 Then Goto BAD32BIT
FX_LENGTH2=FX_LENGTH-(FX_LENGTH/4)
Gosub _WORKSET
Gosub _UNDOSET
CN=0 : CN#=0
FX2=Start(WBANK)
Repeat 
   CN3=Varptr(CN)
   CN2=Varptr(CN#)
   On _FLIP Gosub P32,P32FLIP
   Loke CN2,Leek(CN3)
   Gosub FLOATCLIP
   If CN#<0
      CN=Int(CN#*8388608)
   Else 
      CN=Int(CN#*8388607)
   End If 
   Poke FX2,Peek(Varptr(CN)+1) : Inc FX2
   Poke FX2,Peek(Varptr(CN)+2) : Inc FX2
   Poke FX2,Peek(Varptr(CN)+3) : Inc FX2
Until FX>FXE
_BITS=24 : Gosub SETQUAL
Gosub _WORKSWAP
Goto _RESIZED
'
P32:
Poke CN3,Peek(FX) : Inc FX
Poke CN3+1,Peek(FX) : Inc FX
Poke CN3+2,Peek(FX) : Inc FX
Poke CN3+3,Peek(FX) : Inc FX
Dreg(0)=CN
CN=Lib Call(1,-108) : Rem _LVOIEEESPFiee   
Return 
'
P32FLIP:
Poke CN3+3,Peek(FX) : Inc FX
Poke CN3+2,Peek(FX) : Inc FX
Poke CN3+1,Peek(FX) : Inc FX
Poke CN3,Peek(FX) : Inc FX
Dreg(0)=CN
CN=Lib Call(1,-108) : Rem _LVOIEEESPFiee   
Return 
'
'
'
'***************************************************************************** 
'*filter********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .-:::::' :::    :::    ::::::::::.,:::::::::::::..  
'    ;;;'''', ;;;    ;;;    ;;;;;;;''';;;;'''';;;;``;;;; 
'    [[[,,==[ [[[    [[[        [[     [[cccc \[[[,/[[[' 
'    `$$$"``" $$$,   $$'        $$     $$"""" "$$$$$$c 
'   _ 888    o88888o88oo,.__    88,    888oo,_,888b "88bo  
'   MM"MM,   MMM"MM"""YUMMMM    MMM    """"YUM"MMMM   "W"  
'  
'
'
_HIGHPASS:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      FXBC=0
      Repeat 
         HBUF(FXBC)=0
         Inc FXBC
      Until FXBC=_CH
      CHAIN$(1)="_HIGHPASSP"
      Gosub _OPENFXWIN
      Gosub HISET
      FXN=HIGHN : FXS$=_HZ$ : Gosub FXDRW
      FXRUN$="HIDRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_HIGHPASSP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub HISET
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN2=HBUF(_CHANNEL)
   CN2=-CN2
   CN=Int(CN2+(HIGHALPHA#*(CN-CN2))*(HIGHALPHA#*2))
   HBUF(_CHANNEL)=CN
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'
HIDRW:
HIGHN=FXN
If HIGHN<1 Then HIGHN=1
HISET:
HIGHF=Int(HIGHN*(FREQ/400.0))
RC#=1.0/(HIGHF*_2PI#)
DT#=1.0/FREQ
HIGHALPHA#=DT#/(RC#+DT#)
FXSN=HIGHF
Return 
'  
_LOWPASS:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      FXBC=0
      Repeat 
         LBUF(FXBC)=0
         Inc FXBC
      Until FXBC=_CH
      CHAIN$(1)="_LOWPASSP"
      Gosub _OPENFXWIN
      Gosub LOSET
      FXN=LOWN : FXS$=_HZ$ : Gosub FXDRW
      FXRUN$="LODRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_LOWPASSP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub LOSET
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN2=LBUF(_CHANNEL)
   CN=Int(CN2+(LOWALPHA#*(CN-CN2)))
   LBUF(_CHANNEL)=CN
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
If Not REALTIME
   If MACRO
      Gosub _DCSCAN
   Else 
      MACRO=True : Gosub _DCSCAN : MACRO=False
      _REPEAT$="_LOWPASSP"
      G$=_REPEAT$
   End If 
End If 
Return 
'  
LODRW:
LOWN=FXN
If LOWN>199 Then LOWN=199
LOSET:
LOWF=Int(((FREQ/2)/(200-LOWN)))
RC#=1.0/(LOWF*_2PI#)
DT#=1.0/FREQ
LOWALPHA#=DT#/(RC#+DT#)
FXSN=LOWF
Return 
'  
_BANDPASS:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      FXBC=0
      Repeat 
         BBUF0(FXBC)=0
         BBUF1(FXBC)=0
         Inc FXBC
      Until FXBC=_CH
      CHAIN$(1)="_BANDPASSP"
      Gosub _OPENFXWIN
      Gosub BPSET
      FXN=BANDN : FXS$=_HZ$ : Gosub FXDRW
      FXRUN$="BPDRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_BANDPASSP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub BPSET
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN2=BBUF0(_CHANNEL)
   CN3=BBUF1(_CHANNEL)
   CN3=-CN3
   CN#=CN2+(BANDALPHA#*(CN-CN2))
   CN2#=CN3+(BANDALPHA#*(CN2-CN3))*BANDALPHA#
   CN=Int(CN#+CN2#)
   BBUF0(_CHANNEL)=CN
   BBUF1(_CHANNEL)=CN2
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'
BPDRW:
BANDN=FXN
If BANDN<1 Then BANDN=1
BPSET:
BANDF=Int(BANDN*(FREQ/400.0))
RC#=1.0/(BANDF*_2PI#)
DT#=1.0/FREQ
BANDALPHA#=DT#/(RC#+DT#)
FXSN=BANDF
Return 
'
_RESONANT:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      FXBC=0
      Repeat 
         RBUF0#(FXBC)=0.0
         Inc FXBC
      Until FXBC=_CH
      CHAIN$(1)="_RESONANTP"
      Gosub _OPENFXWIN
      Gosub DIALRES
      FXRUN$=_$
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_RESONANTP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub RESET
Repeat 
   On _BYPS Gosub ¯FLOATB,¯FLOATD,¯FLOATT
   CN2#=RBUF0#(_CHANNEL)
   CN3#=RBUF1#(_CHANNEL)
   '**************************************************************************
   '  Paul Kellett      
   '
   CN2#=CN2#+_RF#*(CN#-CN2#+_RFB#*(CN2#-CN3#))
   CN3#=CN3#+_RF#*(CN2#-CN3#)
   '
   '**************************************************************************
   RBUF0#(_CHANNEL)=CN2#
   RBUF1#(_CHANNEL)=CN3#
   CN#=CN3#
   On _BYPS Gosub ¯UNFLOATB,¯UNFLOATD,¯UNFLOATT
Until FX>FXE
Return 
'  
RESET:
_RF#=RESN/200.0
_RFB#=_RQ#+_RQ#/(1.01-_RF#)
Return 
'  
_SMOOTH:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      FXBC=0
      Repeat 
         SMOBUF(FXBC)=0
         Inc FXBC
      Until FXBC=_CH
      CHAIN$(1)="_SMOOTHP"
      Gosub _OPENFXSMALLWIN
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_SMOOTHP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN2=SMOBUF(_CHANNEL)
   CN=(CN+CN2)/2
   SMOBUF(_CHANNEL)=CN
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'
_WAVESHAPER:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_WAVESHAPERP"
      Gosub _OPENFXSMALLWIN
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_WAVESHAPERP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯FLOATB,¯FLOATD,¯FLOATT
   CN#=Sin(CN#)
   CN#=CN#*CN#*CN#
   On _BYPS Gosub ¯UNFLOATB,¯UNFLOATD,¯UNFLOATT
Until FX>FXE
Return 
'
_PARABOLIC:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_PARABOLICP"
      Gosub _OPENFXSMALLWIN
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_PARABOLICP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯PEEK,¯DEEK,¯TEEK
   On _BYPS Gosub ¯FLOATUNB,¯FLOATUND,¯FLOATUNT
   SQ#=CN#*CN#
   CN#=SQ#/(2.0*(SQ#-CN#)+1.0)
   On _BYPS Gosub ¯UNFLOATUNB,¯UNFLOATUND,¯UNFLOATUNT
   On _BYPS Gosub ¯POKEFX,¯DOKEFX,¯TOKEFX
Until FX>FXE
Return 
'
_BEZIER:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_BEZIERP"
      Gosub _OPENFXSMALLWIN
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_BEZIERP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯PEEK,¯DEEK,¯TEEK
   On _BYPS Gosub ¯FLOATUNB,¯FLOATUND,¯FLOATUNT
   CN#=(CN#*CN#)*(3.0-(2.0*CN#))
   On _BYPS Gosub ¯UNFLOATUNB,¯UNFLOATUND,¯UNFLOATUNT
   On _BYPS Gosub ¯POKEFX,¯DOKEFX,¯TOKEFX
Until FX>FXE
Return 
'  
_EXPAND:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_EXPANDP"
      Gosub _OPENFXSMALLWIN
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_EXPANDP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   If CN>0
      Inc CN
   Else If CN<0
      Dec CN
   End If 
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'  
_CONTRACT:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_CONTRACTP"
      Gosub _OPENFXSMALLWIN
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_CONTRACTP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   If CN>0
      Dec CN
   Else If CN<0
      Inc CN
   End If 
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'  
'
