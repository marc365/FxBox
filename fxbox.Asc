Data "Scroller",_$,215,63,"_NOP"
Data "VST","VST On",320,63,"SETVST"
Data "Quantizer",_$,5,79,"SETQUANTIZER"
Data "Always Draw",_$,110,79,"SETALWAYSDRAW"
Data "Magic","More Magic",215,79,"SETTASKPRI"
Data "-0.2Hz",_$,320,79,"SETPOINT2"
Data "Quality",_$,5,95,"_TGLQUALITY"
Data "Dither",_$,5,111,"_TGLDITHER"
Data "Interpolate",_$,5,127,"_TGLINTERPOLATE"
Data _OK$,_$,320,127,"OPTOK"
'
CUT:
Data 19,,"Keyboard Shortcuts:"
Data "F1-F10 and Numpad         Set bank, hold Shift to swap"
Data "Numpad +\-                Next/Previous bank"
Data "Amiga Key 1 2 3 4         Mono Stereo Quad Multi"
Data "Amiga Key a               Amos switcher to Workbench and back"
Data "Esc                       No Close Cancel Dismiss"
Data "Cursor Up/Down            Tone frequency +\- 1Hz, 0.1Hz with Shift"
Data "Cursor Left/Right         Range resize by pixel"
Data "Cursor Left/Right         Slider decrease/increase"
Data "Shift Range               Time division chunk select"
Data "Shift/Ctrl Dials          Fine move"
Data "Shift Magic Wand          Fine move"
Data "Shift Play All            Unpause or Replay"
Data "Shift Play Range          Range Play off"
Data "Shift Play Display        Display Play off"
Data "Caps Lock                 Realtime preview all channels"
Data "Caps Lock                 Piano low octave",
'
HLP:
Data 8,,"HELP CUT                  Keyboard Shortcuts"
Data "HELP SUB                  Subroutine Names"
Data "HELP COM                  Command Usage"
Data "HELP OPT                  Options"
Data "HELP DITHER               Dither Options"
Data "HELP PIANO                Piano Functionality",
'
D24:
Data 7,,"Help >> Options has a Dither button to cycle through the types:"
Data "No Dither, Dither (Default), HP-Tri Dither, LP Dither",
Data "Process >> Convert >> ... downsampling uses dither",
Data "Utilities >> Noise >> Dither",
'
PIA:
Data 12,,"Utilities >> Piano has options for resampling and mixing from the copy buffer into the current waveform using the piano keyboard",
Data "    Normal will set the frequency and start 'normal' play"
Data "    Portamento will only set the frequency and play if necessary"
Data "    Polyphonic mixes into the waveform while playing"
Data "    Single pastes into the waveform while playing",
Data "Process >> Resample & Utilities >> Tone >> ... have a Piano Button which when held, the piano keyboard is used for setting the frequency",
Data "The sequencer plays the piano by using the subroutine _RENDER and the commands F=, N=, A= etc. it will use Polyphonic or Single for processing and a generated sequence can be viewed using the SEQ command with no options",
'
COM:
Data 41,,"HELP                      Show help menu options"
Data "M=1..6                    Set mono stereo quad 4ch 8ch 16ch"
Data "D=1.."+Str$(SCR_W)-_SPACE$+"                  Set time division"
Data "R=1..D                    Select range segment by time division"
Data "RANGE <start> <length>    Select range by samples"
Data "FREQ=1.."+Str$(MFREQ*_BYPS)-_SPACE$+"             Set main frequency"
Data "VOL=0..64                 Set main volume"
Data "TFREQ=1.."+Str$(TFREQ)-_SPACE$+"            Set tone generator frequency"
Data "TAMP=0..1                 Set tone generator amplitude"
Data "B=1.."+Str$(_FL)-_SPACE$+"                  Set bank"
Data "S=1.."+Str$(_FL)-_SPACE$+"                  Swap bank"
Data "A=0..1                    Set note amplitude"
Data "F=-8..7                   Set note finetune"
Data "N=C-1..B-6 or 1..72       Set note by note-octave or key number"
Data "SIZE 1..<max>             Set size by samples"
Data "CALC <bank>               Calculate ratio from <bank> for _RESAMPLE"
Data "OFFSET <bank>             Set playing offset from <bank>"
Data "OPEN <filename>           Open file"
Data "MACRO <name>              Run macro"
Data "SEQ <filename>            Load sequence"
Data "SKIN <filename>           Replace background with an iff image"
Data ,"NAME=<text>               Set iff header Name"
Data "(c)=<text>                Set iff header Copyright"
Data "AUTH=<text>               Set iff header Author"
Data "TEXT=<text>               Set iff header Comment"
Data "ANNO=<text>               Set iff header Annotation"
Data ,"CD, MD, DIR, DEL, RENAME, ED, RX, CLS, ENDCLI, EXIT, QUIT"
Data ,'RX "address '+FXBOX_REXX$+' <subroutine or command>"'
Data ,"Keyboard Shortcuts: (use Options >> Debug to see chr codes)"
Data "KEY <chr code> <script>"
Data "SHIFT <chr code> <script>"
Data "CTRL <chr code> <script>"
Data "AMIGA <chr code> <script>"
Data "ALT <chr code> <script>"
Data "e.g. CTRL 69 FLSHSCR,QUIT, (end comma required)",
'
OPT:
Data 24,,"Filter:           hardware low pass filter"
Data "50Hz:             50Hz/60Hz PAL/NTSC"
Data "Light Mode:       light/dark mode palette"
Data "Debug:            toast underruns, character codes and other debug messages"
Data "Net Sync:         network bpm synchronization"
Data "Hires:            hires/lowres"
Data "Position:         show the play position marker"
Data "Level Meter:      show the level meter"
Data "Metronome:        show the metronome"
Data "Realtime:         realtime mixing and effects processing"
Data "Zoom Draw:        draw the graph while using zoom or wait until release"
Data "Graph:            low graph is faster but lower resolution"
Data "Wheel Zoom:       use the mouse wheel for zooming"
Data "Arexx Sync:       Octamed Arexx play trigger"
Data "Scroller:         scroll the toast messages, can also click the scroller"
Data "VST:              network audio with the VST plugin"
Data "Quantizer:        schedule actions on the sequencer, delaying the trigger"
Data "Always Draw:      always draw the waveform when swapping and editing"
Data "Magic:            set the task priority to -1 for smooth multi tasking"
Data "-0.2Hz:           experimental for slightly undercutting the frame rate"
Data "Dither:           dither type for downsampling"
Data "Interpolation:    interpolation type for resampling",
'
