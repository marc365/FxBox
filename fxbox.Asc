'***************************************************************************** 
'*distort********************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   ::::::-.   :::   .::::::. ::::::::::    ...     :::::::..  ::::::::::  
'   ;;,   `';, ;;;  ;;;`    `;;;;;;;;''' .;;;;;;;.  ;;;;``;;;; ;;;;;;;'''  
'   `[[     [[ [[[  '[==/[[[[,    [[    ,[[     \[[,\[[[,/[[['     [[  
'    $$,    $$ $$$,   '''    $    $$    $$$,     $$$"$$$$$$c       $$  
'    888_,o8P'o88888,88b    dP    88,   "888,_ _,88P,888b "88bo    88, 
'   "MMMMP"`  MMM"MM  "YMmMY"     MMM     "YMMMMMP" "MMMM   "W"    MMM 
'
'
'
_TUBE:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_TUBEP"
      Gosub _OPENFXWIN
      FXN=TUBEN : FXSN=TUBEN : FXS$=_PERCENT$ : Gosub FXDRW
      FXRUN$="TUDRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_TUBEP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯FLOATB,¯FLOATD,¯FLOATT
   If CN#>0 and TUBEV#-CN#<>0
      CN#=CN#/(TUBEV#-CN#)
   Else If CN#<0 and TUBEV#+CN#<>0
      CN#=CN#/(TUBEV#+CN#)
   End If 
   On _BYPS Gosub ¯UNFLOATB,¯UNFLOATD,¯UNFLOATT
Until FX>FXE
Return 
'
TUDRW:
TUBEN=FXN
TUBEV#=(200-TUBEN)/100.0
FXSN=TUBEN
Return 
'
_SATURATION:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_SATURATIONP"
      Gosub _OPENFXWIN
      FXN=SATN : FXSN=SATN : FXS$=_PERCENT$ : Gosub FXDRW
      FXRUN$="SADRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_SATURATIONP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯FLOATB,¯FLOATD,¯FLOATT
   CN#=((1.1+SATV#)*CN#)-(0.2+SATV#*CN#)*CN#*CN#*CN#
   On _BYPS Gosub ¯UNFLOATB,¯UNFLOATD,¯UNFLOATT
Until FX>FXE
Return 
'
SADRW:
SATN=FXN
SATV#=SATN/100.0
FXSN=SATN
Return 
'
_OVERDRIVE:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_OVERDRIVEP"
      Gosub _OPENFXSMALLWIN
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_OVERDRIVEP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯FLOATB,¯FLOATD,¯FLOATT
   If CN#<0 Then CN#=1-Exp(-CN#) Else CN#=-1+Exp(CN#)
   On _BYPS Gosub ¯UNFLOATB,¯UNFLOATD,¯UNFLOATT
Until FX>FXE
Return 
'
_ALIAS:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_ALIASP"
      Gosub _OPENFXWIN
      FXN=ALIN*2 : FXSN=ALIN : FXS$=_BYTE$ : Gosub FXDRW
      FXRUN$="ALDRW"
      ALIN2=0
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_ALIASP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   If ALIN2<=0
      If ALIN>0
         ALIN2=ALIN
      End If 
      On _BYPS Gosub ¯PEEK,¯DEEK,¯TEEK
      ALIBUF(_CHANNEL)=CN
   End If 
   Dec ALIN2
   CN=ALIBUF(_CHANNEL)
   On _BYPS Gosub ¯POKEFX,¯DOKEFX,¯TOKEFX
Until FX>FXE
Return 
'
ALDRW:
ALIN=FXN/2
FXSN=ALIN
Return 
'
_FOLD:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_FOLDP"
      Gosub _OPENFXWIN
      FXN=FOLDN : FXSN=FOLDN : FXS$=_PERCENT$ : Gosub FXDRW
      FXRUN$="FODRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_FOLDP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯FLOATB,¯FLOATD,¯FLOATT
   If CN#>FOLDV# Then CN#=FOLDV#-(CN#-FOLDV#)
   If CN#<-FOLDV# Then CN#=-FOLDV#+(-FOLDV#-CN#)
   On _BYPS Gosub ¯UNFLOATB,¯UNFLOATD,¯UNFLOATT
Until FX>FXE
Return 
'
FODRW:
FOLDN=FXN
FOLDV#=(200-FOLDN)/256.0
FXSN=FOLDN
Return 
'
_RINGMODULATOR:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      FXBC=0
      Repeat 
         RMBUF(FXBC)=0
         Inc FXBC
      Until FXBC=_CH
      CHAIN$(1)="_RINGMODULATORP"
      Gosub _OPENFXWIN
      FXN=RINGN : Gosub RIDRW : FXS$=_PERCENT$ : Gosub FXDRW
      FXRUN$="RIDRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
Else 
   FXN=RINGN : Gosub RIDRW
End If 
_RINGMODULATORP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   If CN#>0 Then CN=Int(CN*Sin(CN#*(RMBUF(_CHANNEL))))
   Inc RMBUF(_CHANNEL)
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
   If RMBUF(_CHANNEL)>757120 Then RMBUF(_CHANNEL)=0
Until FX>FXE
Return 
'
RIDRW:
RINGN=FXN
RINGN#=RINGN/16.0
CN#=Sin((_2PI#*RINGN#)/FREQ)*360
FXSN=RINGN
Return 
'
_2BIT:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_2BITP"
      Gosub _OPENFXSMALLWIN
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_2BITP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   CN=Peek(FX)
   Rol.b 8,CN
   Bclr 7,CN
   Bclr 5,CN
   Bclr 4,CN
   Bclr 3,CN
   Bclr 2,CN
   Bclr 1,CN
   Bclr 0,CN
   Poke FX,CN-32
   Add FX,_BYPS
Until FX>FXE
Return 
'  
'
