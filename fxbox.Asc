'***************************************************************************** 
'*effects********************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   .,:::::: .-:::::' .-:::::'.,::::::  .,-:::::::::::::::: .::::::.     
'   ;;;;'''' ;;;'''', ;;;'''',;;;;'''',;;;'````' ;;;;;;;''';;;`    `;    
'    [[cccc  [[[,,==[ [[[,,==[ [[cccc [[[            [[    '[==/[[[[,  
'    $$""""  `$$$"``" `$$$"``" $$"""" $$$            $$      '''    $  
'    888oo,__ 888    _ 888     888oo,_`88bo,__,o,    88,   ,88b    dP  
'    """"YUMMM"MM,   MM"MM,    """"YUM  "YUMMMMMP    MMM     "YMmMY"   
'
'                                                              
'
_PHASE:
If FXSHOW or MACRO
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      Gosub PHBUF
      If Not MACRO
         CHAIN$(1)="_PHASEP"
         Gosub _OPENFXWIN
         FXN=PHAN*2 : FXSN=PHAN : FXS$=_PERCENT$ : Gosub FXDRW
         FXRUN$="PHDRW"
         Gosub _RUNFXWIN
      End If 
   End If 
   If Not MACRO
      If Not REQ
         Goto FXBUFFERC
      End If 
   End If 
End If 
_PHASEP:
Gosub SETPBANK
Gosub BPSSET
If FX_LENGTH<2 Then Goto FLSHSCR
If _REPEATING and G$="_PHASEP" Then Gosub PHBUF
Repeat 
   FX2=PHBUF0(_CHANNEL)
   On _BYPS Gosub ¯SIGNED2B,¯SIGNED2D,¯SIGNED2T
   CN#=(CN2*0.6)+PHBUF#(_CHANNEL)
   CN2=Int(CN#)
   PHBUF#(_CHANNEL)=CN#-CN2
   Gosub ¯MIX
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
   On _BYPS Gosub ¯POKEFX2,¯DOKEFX2,¯TOKEFX2
   Add PHBUF0(_CHANNEL),_BYPS
   If PHBUF0(_CHANNEL)>PHBUF1(_CHANNEL)+(PHAN*_BYPS) Then PHBUF0(_CHANNEL)=PHBUF1(_CHANNEL)
Until FX>FXE
If CHAIN$(1)=_$ Then Goto FXBUFFERC
Return 
'
PHDRW:
PHAN=FXN/2
FXSN=PHAN
Return 
'
PHBUF:
Gosub FXBUFFER
Repeat 
   PHBUF#(FXBC)=0.0
   PHBUF0(FXBC)=Start(TBANK-FXBC)
   PHBUF1(FXBC)=PHBUF0(FXBC)
   Inc FXBC
Until FXBC=_CH
Return 
'
_DELAY:
If FXSHOW or MACRO
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      Gosub DEBUF
      If Not MACRO
         CHAIN$(1)="_DELAYP"
         Gosub _OPENFXWIN
         Gosub DIALDE
         FXRUN$=_$
         Gosub _RUNFXWIN
      End If 
   End If 
   If Not MACRO
      If Not REQ
         Goto FXBUFFERC
      End If 
   End If 
End If 
_DELAYP:
Gosub SETPBANK
Gosub BPSSET
If FX_LENGTH<2 Then Goto FLSHSCR
If _REPEATING and G$="_DELAYP" Then Gosub DEBUF
Repeat 
   FX2=DEBUF0(_CHANNEL)
   On _BYPS Gosub ¯SIGNED2B,¯SIGNED2D,¯SIGNED2T
   CN#=CN2*DEV#
   CN2=Int(CN#)
   Gosub ¯MIX
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
   On _BYPS Gosub ¯POKEFX2,¯DOKEFX2,¯TOKEFX2
   Add DEBUF0(_CHANNEL),_BYPS
   If DEBUF0(_CHANNEL)>DEBUF1(_CHANNEL)+((DEN*_BYPS)*100) Then DEBUF0(_CHANNEL)=DEBUF1(_CHANNEL)
Until FX>FXE
If CHAIN$(1)=_$ Then Goto FXBUFFERC
Return 
'
DEBUF:
Gosub FXBUFFER
Repeat 
   DEBUF0(FXBC)=Start(TBANK-FXBC)
   DEBUF1(FXBC)=DEBUF0(FXBC)
   Inc FXBC
Until FXBC=_CH
Return 
'
_REVERB:
If FXSHOW or MACRO
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      Gosub REBUF
      If Not MACRO
         CHAIN$(1)="_REVERBP"
         Gosub _OPENFXWIN
         Gosub DIALRV
         FXRUN$=_$
         Gosub _RUNFXWIN
      End If 
   End If 
   If Not MACRO
      If Not REQ
         Goto FXBUFFERC
      End If 
   End If 
End If 
_REVERBP:
Gosub SETPBANK
Gosub BPSSET
If FX_LENGTH<2 Then Goto FLSHSCR
If _REPEATING and G$="_REVERBP" Then Gosub REBUF
CN2=0
Repeat 
   FX2=RVBUF0(_CHANNEL)
   On _BYPS Gosub ¯SIGNED2B,¯SIGNED2D,¯SIGNED2T
   CN#=CN2*RVV#
   CN2=Int(CN#)
   Gosub ¯MIX
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
   On _BYPS Gosub ¯POKEFX2,¯DOKEFX2,¯TOKEFX2
   Add RVBUF0(_CHANNEL),_BYPS
   If RVBUF0(_CHANNEL)>RVBUF1(_CHANNEL)+((FX_BUF*_BYPS)/(RVN/2+1)) Then RVBUF0(_CHANNEL)=RVBUF1(_CHANNEL)
Until FX>FXE
If CHAIN$(1)=_$ Then Goto FXBUFFERC
Return 
'
REBUF:
Gosub FXBUFFER
Repeat 
   RVBUF0(FXBC)=Start(TBANK-FXBC)
   RVBUF1(FXBC)=RVBUF0(FXBC)
   Inc FXBC
Until FXBC=_CH
Return 
'
_TREMOLO:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      FXBC=0
      Repeat 
         TBUF(FXBC)=0
         Inc FXBC
      Until FXBC=_CH
      CHAIN$(1)="_TREMOLOP"
      Gosub _OPENFXWIN
      FXN=TREMN : Gosub TRDRW : FXS$="ms" : Gosub FXDRW
      FXRUN$="TRDRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
Else 
   FXN=TREMN : Gosub TRDRW
End If 
_TREMOLOP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN=Int(CN*Sin(CN#*(TBUF(_CHANNEL))))
   Inc TBUF(_CHANNEL)
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'
TRDRW:
TREMN=FXN
TREMN#=TREMN/16.0
DIV#=FREQ
CN#=Sin((_2PI#*TREMN#)/DIV#)
If CN#=0 Then FX_LENGTH2=FREQ Else FX_LENGTH2=Int((DIV#/CN#)/_2PI#)
FXSN=FX_LENGTH2/DIV#
Return 
'
_COMPRESSOR:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      FXBC=0
      Repeat 
         CBUFENV#(FXBC)=0
         CBUFSUMM#(FXBC)=0
         Inc FXBC
      Until FXBC=_CH
      Gosub CPSET
      FX2=P_START
      CHAIN$(1)="_COMPRESSORP"
      Gosub _OPENFXBIGWIN
      Gosub DIALCOMP
      FXRUN$=_$
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_COMPRESSORP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub CPSET
If _RMS<22 Then _RMS=22
Repeat 
   If FX2+_OFFSET<P_START+P_LENGTH
      CN=Peek(FX2+_OFFSET)
      CN2=Peek(FX2+_OFFSET-_RMS)
      If CN2>127 : Rem FLOAT2 
         CN2=CN2-256
      End If 
      If CN2<0
         CN2#=128
      Else 
         CN2#=127
      End If 
      CN2#=CN2/CN2#
      If CN>127
         CN=CN-256
      End If 
      If CN<0
         CN#=128
      Else 
         CN#=127
      End If 
      CN#=CN/CN#
   Else 
      FX2=P_START
      CN#=0 : CN2#=0
   End If 
   CBUFSUMM#(_CHANNEL)=CBUFSUMM#(_CHANNEL)+(CN#*CN#)
   If FX2>_RMS+FX_START2 Then CBUFSUMM#(_CHANNEL)=CBUFSUMM#(_CHANNEL)-(CN2#*CN2#)
   If CBUFSUMM#(_CHANNEL)<0 Then CBUFSUMM#(_CHANNEL)=-CBUFSUMM#(_CHANNEL)
   _RMS#=Sqr(CBUFSUMM#(_CHANNEL)/_RMS)
   If _RMS#>CBUFENV#(_CHANNEL) Then _THETA#=_ATT# Else _THETA#=_REL#
   CBUFENV#(_CHANNEL)=(1.0-_THETA#)*_RMS#+_THETA#*CBUFENV#(_CHANNEL)
   _GAIN#=1.0
   If(CBUFENV#(_CHANNEL)>_THRESHOLD#) Then _GAIN#=_GAIN#-(CBUFENV#(_CHANNEL)-_THRESHOLD#)*_SLOPE#
   On _BYPS Gosub ¯FLOATB,¯FLOATD,¯FLOATT
   CN#=CN#*_GAIN#
   On _BYPS Gosub ¯UNFLOATB,¯UNFLOATD,¯UNFLOATT
   Add FX2,_BYPS
Until FX>FXE
Return 
'  
CPSET:
_THRESHOLD#=_THRESHOLDN#*0.01
_SLOPE#=_SLOPEN#*0.1
_LOOKAHEAD#=_LOOKAHEADN#*0.001
_WINDOW#=_WINDOWN#*0.1
If _WINDOW#<=0 Then _WINDOW#=0.1
_ATTACK#=_ATTACKN#*0.001
If _ATTACK#<=0 Then _ATTACK#=0.001
_RELEASE#=_RELEASEN#*0.001
If _RELEASE#<=0 Then _RELEASE#=0.001
_ATT#=Exp(-1.0/(FREQ*_ATTACK#))
_REL#=Exp(-1.0/(FREQ*_RELEASE#))
_OFFSET=Int(FREQ*_LOOKAHEAD#)
_RMS=Int(FREQ*_WINDOW#)
Return 
'  
'
'
'***************************************************************************** 
'*repair********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    :::::::..  .,::::::::::::::.   :::.      :::  :::::::.. 
'    ;;;;``;;;; ;;;;''''`;;```.;;;  ;;`;;     ;;;  ;;;;``;;;;
'    \[[[,/[[['  [[cccc `]]nnn]]'  ,[[ '[[,   [[[  \[[[,/[[['
'    "$$$$$$c    $$""""  $$$""    c$$$cc$$$c  $$$, "$$$$$$c
'    ,888b "88bo 888oo,_ 888o      888   888,o88888,888b "88bo 
'    "MMMM   "W" """"YUM YMMMb     YMM   ""` MMM"MM"MMMM   "W" 
'
'
'
_LIMITNOISE:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)="_LIMITNOISEP"
      Gosub _OPENFXSMALLWIN
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
End If 
_LIMITNOISEP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   If CN>0 and CN<2
      Dec CN
   Else If CN<0 and CN>-2
      Inc CN
   End If 
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'
_REMOVEZEROSPACE:
If FXSHOW
   If PASS=0
      Gosub SETPBANK
      If FX_LENGTH<2
         Goto FLSHSCR
      End If 
      CHAIN$(1)=_$
      Gosub _OPENFXWIN
      FXN=ZERON : Gosub ZEDRW : FXS$="b" : Gosub FXDRW
      FXRUN$="ZEDRW"
      Gosub _RUNFXWIN
   End If 
   If Not REQ
      Return 
   End If 
   _REPEAT$="_REMOVEZEROSPACEP"
Else 
   FXN=TREMN : Gosub TRDRW
End If 
_REMOVEZEROSPACEP:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _UNDOSET
If RL<P_LENGTH or _CHOICE=3 Then _SCALEMIX=False Else _SCALEMIX=True
FX2=0 : FX3=0
Inc FX
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   If CN=0 and FX2=False
      FX2=FX
   Else If CN<>0 and FX2
      CN2=FX-FX2
      If CN2>ZERON
         Add FX3,CN2
         Copy FX,FX+FX_LENGTH-(FX-FX_START) To FX2
      End If 
      FX=FX2
      FX2=False
   End If 
   Add FX,_BYPS
Until FX>FXE
If _SCALEMIX
   If FX2
      Add FX3,FX-FX2
   End If 
   FX_LENGTH2=FX_LENGTH-FX3 : Gosub _WORKSET
   Copy FX_START,FX_START+FX_LENGTH2 To Start(WBANK)
   Gosub _WORKSWAP
   Gosub _CLEARWORK
   Goto _RESIZED
Else 
   Fill FX_START+FX_LENGTH-FX3 To FX_START+FX_LENGTH,0
End If 
Return 
'
ZEDRW:
ZERON=FXN
FXSN=ZERON
Return 
'  
'
'
'***************************************************************************** 
'*bitwise********************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   :::::::.   :::  ::::::::::.::    .   .:: :::   .::::::. .,:::::: 
'    ;;;'';;'  ;;;  ;;;;;;;'''';;,  ;;  ;;;' ;;;  ;;;`    `;;;;;'''' 
'    [[[__[[\. [[[      [[     '[[, [[, [['  [[[  '[==/[[[[, [[cccc
'    $$""""Y$$ $$$,     $$       Y$c$$$c$P   $$$,   '''    $ $$""""
'   _88o,,od8Po88888    88,       "88"888   o88888,88b    dP 888oo,_ 
'   ""YUMMMP" MMM"MM    MMM        "M "M"   MMM"MM  "YMmMY"  """"YUM 
'
'
'
_ROTATELEFT: _SEL=1 : Goto BIT
_ROTATERIGHT: _SEL=2 : Goto BIT
_SHIFTLEFT: _SEL=3 : Goto BIT
_SHIFTRIGHT: _SEL=4 : Goto BIT
_LOGICALSHIFTRIGHT: _SEL=5
BIT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _UNDOSET
Repeat 
   Dreg(0)=Peek(FX)
   Dreg(1)=1 : Rem shift 1 bit
   On _SEL Gosub ¯ROL,¯ROR,¯ASL,¯ASR,¯LSR
   Poke FX,Dreg(0)
   Inc FX
Until FX>FXE
Return 
'
¯ROL: Call(Varptr(MC_ROL_B)) : Return 
¯ROR: Call(Varptr(MC_ROR_B)) : Return 
¯ASL: Call(Varptr(MC_ASL_B)) : Return 
¯ASR: Call(Varptr(MC_ASR_B)) : Return 
¯LSR: Call(Varptr(MC_LSR_B)) : Return 
'  
'
'
'***************************************************************************** 
'***encoding****************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   .,::::::::.    :::.  .,-::::::    ...     ::::::-.   :::  ::.    :::. .,-::::: 
'   ;;;;'''';;;;,  `;;;,;;;'````'  .;;;;;;;.  ;;,   `';, ;;;  ;;;;,  `;;;;;-'````' 
'    [[cccc  [[[[[. '[[[[[        ,[[     \[[,`[[     [[ [[[   [[[[[. '[[[[   [[[[ 
'    $$""""  $$$ "Y$c$$$$$        $$$,     $$$ $$,    $$ $$$,  $$$ "Y$c$$$$c.    " 
'    888oo,_888    Y88 `88bo,__,o,"888,_ _,88P 888_,o8P'o88888888    Y88 `Y8bo,,,o 
'    """"YUMMM     YM    "YUMMMMMP  "YMMMMMP" "MMMMP"`  MMM"MMMM     YM    `'YMUP" 
'  
'
'
_INTERLEAVE16: _PBYPS=_BYPS : _BYPS=2 : Goto I2TERLEAVE
_INTERLEAVE24: _PBYPS=_BYPS : _BYPS=3 : Goto I2TERLEAVE
_INTERLEAVE:
_PBYPS=_BYPS
I2TERLEAVE:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If _BYPS=2 and Fn ODD(FX_LENGTH) Then Goto BAD16BIT
FX_LENGTH2=FX_LENGTH
Gosub _WORKSET
Gosub _UNDOSET
FX_START2=Start(WBANK)
Copy FX_START,FX_START+FX_LENGTH To FX_START2
FX_LENGTH3=FX_LENGTH2/2
FX2=FX_START2
If _BYPS=1 and Fn ODD(FX_LENGTH)
   Add FXE,-1
Else If _BYPS=2 and Fn ODD(FX_LENGTH3)
   Add FXE,-2
   Dec FX_LENGTH3
Else If _BYPS=3 and Fn THREE(FX_LENGTH)
   If Fn ODD(FX_LENGTH)
      Add FXE,-3
      Dec FX_LENGTH3
   End If 
Else 
   Goto BAD24BIT
End If 
If _BYPS=1
   Repeat 
      Poke FX,Peek(FX2) : Inc FX
      Poke FX,Peek(FX2+FX_LENGTH3) : Inc FX
      Inc FX2
   Until FX>FXE
Else If _BYPS=2
   Repeat 
      Doke FX,Deek(FX2) : Add FX,2
      Doke FX,Deek(FX2+FX_LENGTH3) : Add FX,2
      Add FX2,2
   Until FX>FXE
Else If _BYPS=3
   Repeat 
      Poke FX,Peek(FX2) : Inc FX
      Poke FX,Peek(FX2+1) : Inc FX
      Poke FX,Peek(FX2+2) : Inc FX
      Poke FX,Peek(FX2+FX_LENGTH3) : Inc FX
      Poke FX,Peek(FX2+1+FX_LENGTH3) : Inc FX
      Poke FX,Peek(FX2+2+FX_LENGTH3) : Inc FX
      Add FX2,3
   Until FX>FXE
End If 
_BYPS=_PBYPS
Goto _CLEARWORK
'
_DEINTERLEAVE16BIT: _PBYPS=_BYPS : _BYPS=2 : Goto DEINTERLEAVE
_DEINTERLEAVE24BIT: _PBYPS=_BYPS : _BYPS=3 : Goto DEINTERLEAVE
_DEINTERLEAVE: _PBYPS=_BYPS
DEINTERLEAVE:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If _BYPS=2 and Fn ODD(FX_LENGTH) Then Goto BAD16BIT
FX_LENGTH2=FX_LENGTH/2
If _BYPS=3
   If Fn THREE(FX_LENGTH)
      If Fn ODD(FX_LENGTH)
         Add FXE,-3
         Dec FX_LENGTH2
      End If 
   Else 
      Goto BAD24BIT
   End If 
End If 
Gosub _WORKSET
Gosub _UNDOSET
FX_START2=Start(WBANK)
FX2=0
If _BYPS=1 and Fn ODD(FX_LENGTH)
   Add FXE,-1
End If 
If _BYPS=1
   Repeat 
      Poke FX_START+FX2,Peek(FX)
      Inc FX
      Poke FX_START2+FX2,Peek(FX)
      Inc FX
      Inc FX2
   Until FX>FXE
Else If _BYPS=2
   Repeat 
      Doke FX_START+FX2,Deek(FX)
      Add FX,2
      Doke FX_START2+FX2,Deek(FX)
      Add FX,2
      Add FX2,2
   Until FX>FXE
Else If _BYPS=3
   Repeat 
      Poke FX_START+FX2,Peek(FX) : Inc FX
      Poke FX_START+1+FX2,Peek(FX) : Inc FX
      Poke FX_START+2+FX2,Peek(FX) : Inc FX
      Poke FX_START2+FX2,Peek(FX) : Inc FX
      Poke FX_START2+1+FX2,Peek(FX) : Inc FX
      Poke FX_START2+2+FX2,Peek(FX) : Inc FX
      Add FX2,3
   Until FX>FXE
End If 
Copy FX_START2,FX_START2+FX_LENGTH2 To FX_START+FX_LENGTH2
_BYPS=_PBYPS
Goto _CLEARWORK
'  
'**************************************************************************
'  Steve Hayes Fibonacci Delta sound compression technique         
'
_DECODEFIBONACCIDELTA:
Restore FIB
Goto DEDEL
_DECODEEXPONENTIALDELTA:
Restore XPO
DEDEL:
I=0
Repeat 
   Read DELTA(I)
   Inc I
Until I>15
Gosub SETPBANK
RST=0 : RL=P_LENGTH
T$=G$
G$="DELDE"
Gosub G$
Gosub STEREOQUADX2
Gosub RNGC
COMP(B)=0
Goto _RESIZED
'
DELDE:
Gosub SETPBANK
FX_LENGTH2=((FX_LENGTH-2)*2)
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _WORKSET
Gosub _UNDOSET
_UNDID$=T$
FX2=Start(WBANK)
Inc FX : CN3=Peek(FX) : Inc FX : Rem a pad byte, an 8bit initial value  
Repeat 
   CN=Peek(FX)
   If FX2 and 1 : Rem select low or high nybble? 
      CN=CN and $F
      Inc FX
   Else 
      Dreg(0)=CN
      Dreg(1)=4 : Rem shift 4 bits 
      Call(Varptr(MC_LSR_B))
      CN=Dreg(0)
   End If 
   Add CN3,DELTA(CN)
   CN3=Min(127,Max(-128,CN3)) : Rem CHECKCLIP
   Poke FX2,CN3
   Inc FX2
Until FX>FXE
If _CHANNELS<2
   Gosub _WORKSWAP
   Goto _CLEARWORK
End If 
Return 
'
'**************************************************************************
'
_ENCODEFIBONACCIDELTA:
Restore FIB : COMP=1
Goto ENCDEL
_ENCODEEXPONENTIALDELTA:
Restore XPO : COMP=2
ENCDEL:
I=0
Repeat 
   Read DELTA(I)
   Inc I
Until I>15
Gosub SETPBANK
RST=0 : RL=P_LENGTH
T$=G$
G$="DELENC"
Gosub G$
Gosub STEREOQUADX2
Gosub RNGC
COMP(B)=COMP
Goto _RESIZED
'
DELENC:
Gosub SETPBANK
FX_LENGTH2=(FX_LENGTH/2)+2
If FX_LENGTH<2 Then Goto FLSHSCR
Gosub _WORKSET
Gosub _UNDOSET
_UNDID$=T$
FX2=Start(WBANK)
CN2=Peek(FX)
If CN2>127 Then CN2=CN2-256 : Rem SIGN 
Inc FX2 : Poke FX2,CN2 : Inc FX2 : Rem a pad byte, an 8bit initial value
Repeat 
   Gosub ¯SIGNEDB : Inc FX
   FX3=0 : DELTAHISTORY=256
   Repeat 
      CN3=CN2+DELTA(FX3)
      If CN>CN3
         DELTA=CN-CN3
      Else 
         DELTA=CN3-CN
      End If 
      If DELTA<DELTAHISTORY
         DELTAHISTORY=DELTA
      Else 
         Exit 
      End If 
      Inc FX3
   Until FX3>14
   Add CN2,DELTA(FX3)
   If FX and 1 : Rem select low or high nybble
      Dreg(0)=FX3
      Dreg(1)=4 : Rem shift 4 bits 
      Call(Varptr(MC_ASL_B))
      _BYTE=Dreg(0)
   Else 
      Add _BYTE,FX3
      Poke FX2,_BYTE
      Inc FX2
   End If 
Until FX>FXE
If _CHANNELS<2
   Gosub _WORKSWAP
   Goto _CLEARWORK
End If 
Return 
'
'
'  
'***************************************************************************** 
'*process********************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   ::::::::. :::::::..      ...       .,-::::::.,:::::: .::::::.  .::::::.
'   `;;```.;;;;;;;``;;;;  .;;;;;;;.  ,;;;'````' ;;;;'''';;;`    `;;;;`    `; 
'   `]]nnn]]' \[[[,/[[[' ,[[     \[[,[[[         [[cccc '[==/[[[[,'[==/[[[[, 
'    $$$""    "$$$$$$c   $$$,     $$$$$$         $$""""   '''    $  '''    $ 
'    888o     ,888b "88bo"888,_ _,88P`88bo,__,o, 888oo,_,88b    dP,88b    dP 
'    YMMMb    "MMMM   "W"  "YMMMMMP"   "YUMMMMMP """"YUM  "YMmMY"   "YMmMY"
'
'
'
_REVERSE:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If _BYPS=2 and Fn ODD(FX_LENGTH) Then Goto BAD16BIT
FX_LENGTH2=FX_LENGTH
If _BYPS=3
   If Fn THREE(FX_LENGTH)
      If Fn ODD(FX_LENGTH)
         Add FXE,-3
         Dec FX_LENGTH2
      End If 
   Else 
      Goto BAD24BIT
   End If 
End If 
Gosub _WORKSET
Gosub _UNDOSET
FX_START2=Start(WBANK)-FX_START
FX2=FX_START+FX_LENGTH
Repeat 
   Add FX2,-_BYPS
   On _BYPS Gosub ¯RB,¯RD,¯RT
   Add FX,_BYPS
Until FX>FXE
Copy Start(WBANK),Start(WBANK)+FX_LENGTH To FX_START
Goto _CLEARWORK
'
¯RB: Poke FX_START2+FX,Peek(FX2) : Return 
¯RD: Doke FX_START2+FX,Deek(FX2) : Return 
¯RT: Poke FX_START2+FX,Peek(FX2) : Poke FX_START2+1+FX,Peek(FX2+1) : Poke FX_START2+2+FX,Peek(FX2+2) : Return 
'
_INVERT:
Gosub SETPBANK
If FX_LENGTH<2 Then Goto FLSHSCR
If _BYPS=2 and Fn ODD(FX_LENGTH) Then Goto BAD16BIT
If BYPS=3
   If Fn THREE(FX_LENGTH)
      If Fn ODD(FX_LENGTH)
         Add FXE,-3
      End If 
   Else 
      Goto BAD24BIT
   End If 
End If 
Gosub _UNDOSET
Repeat 
   On _BYPS Gosub ¯SIGNEDB,¯SIGNEDD,¯SIGNEDT
   CN=-CN
   On _BYPS Gosub ¯UNSIGNEDB,¯UNSIGNEDD,¯UNSIGNEDT
Until FX>FXE
Return 
'
'
'
'***************************************************************************** 
'*utils*********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    ...    ::::::::::::: :::    :::     .::::::.  
'   ';;     ;;;;;;;;;;''' ;;;    ;;;    ;;;`    `; 
'   [['     [[[    [[     [[[    [[[    '[==/[[[[, 
'   $$      $$$    $$     $$$,   $$'      '''    $ 
'   88    .d888    88,   o88888o88oo,.__,88b    dP 
'    "YmmMMMM""    MMM   MMM"MM"""YUMMMM  "YMmMY"  
'
'  
'
_SINTONE: _SEL=1 : Goto T0NE
_COSTONE: _SEL=2 : Goto T0NE
_TRITONE: _SEL=3 : Goto T0NE
_RAMPTONE: _SEL=4 : Goto T0NE
_SAWTONE: _SEL=5 : Goto T0NE
_SQRTONE: _SEL=6 : Goto T0NE
_PLS50TONE: _SEL=7 : Goto T0NE
_PLS25TONE: _SEL=8 : Goto T0NE
_BELLTONE: _SEL=9 : Goto T0NE
_HORNTONE: _SEL=10
T0NE:
If _DIRECT or Fn KEY_SHIFT Then Goto T0NEP
If FXSHOW
   If PASS=0
      _TEXT=True : _T0NE=True
      RX=215 : RY=39
      WTXT$=S$ : WX=RX-5 : WY=RY-15 : WX2=RX+215 : WY2=RY+64 : _COL=_WHITE : Gosub WIN
      BTXT1$=_OK$ : BX=RX : BY=RY+47 : BZN=ZN_OK : Gosub BTN
      BTXT1$=_CANCEL$ : BX=RX+107 : BZN=ZN_CANCEL : Gosub BTN
      TXT1$="Freq:"
      TXT_X=308 : TXT_Y=57 : _MAX=7
      Gosub T0DIAL
      Do 
         Gosub _TEXTINPUT
         If Right$(T$,1)<>_DOT$ and T$<>_$
            Gosub ¯TFREQ
         End If 
         Repeat 
            Gosub GVAL
            If Fn KEY_ESC
               REQ=False
               Goto T0NEC
            End If 
            If Z=ZN_PIANO and Fn MOUSEDOWN
               Repeat 
                  Gosub GVAL
                  If Z=ZN_PIANO and KDOWN=False
                     BX=RX : BY=RY+28
                     Gosub PIANOBTNHIGH
                     KDOWN=True
                  End If 
                  If Fn KEY_PRESS and Z=ZN_PIANO
                     Gosub PIANO : C=0
                     If KEYC<>-1
                        _TOAST$=KEYS$
                        T0NEV#=KEYF/100.0
                        Gosub T0DIAL
                     End If 
                  End If 
               Until Fn MOUSEUP
               If KDOWN
                  BZN=ZN_PIANO : BX=RX : BY=RY+28 : Gosub BTN
                  Gosub PIANOBTN
                  KDOWN=False
               End If 
            Else If Z=ZN_OK and Fn MOUSEDOWN or Fn KEY_RETURN
               Gosub ¯TFREQ
               PZN=Z : BX=RX : BY=RY+47 : Gosub PRESS
               If _ON
                  REQ=True
                  Gosub T0NEC
                  Gosub T0NEP
                  Gosub SETCORDS
                  Goto _DRAWALL
               End If 
            Else If Z=ZN_CANCEL and Fn MOUSEDOWN or Fn KEY_ESC
               PZN=Z : BX=RX+107 : BY=RY+47 : Gosub PRESS
               If _ON
                  REQ=False
                  Goto T0NEC
               End If 
            Else If Fn MOUSEWHEELDOWN
               T0NEV#=T0NEV#-100
               Gosub T0DIAL
            Else If Fn MOUSEWHEELUP
               If T0NEV#>0 and T0NEV#<100
                  T0NEV#=100
               Else 
                  T0NEV#=T0NEV#+100
               End If 
               Gosub T0DIAL
            Else If Fn KEY_CURSOR
               If Fn KEY_SHIFT
                  CN#=0.1
               Else 
                  CN#=1
               End If 
               If Fn KEY_UP
                  T0NEV#=T0NEV#+CN#
               Else If Fn KEY_DOWN
                  T0NEV#=T0NEV#-CN#
               End If 
               Gosub T0DIAL
            Else If Fn KEY_PRESS : Rem text gadget
               Gosub T0DIAL
            Else If Fn MOUSEDOWN
               Gosub DRWDIALS
               Gosub T0SET
               Gosub MUP
            End If 
         Until C
      Loop 
   End If 
   If Not REQ
      Return 
   End If 
End If 
T0NEP:
Gosub SETDEFBANK
If _SEL=4 : Rem ramp 
   N#=(_2PI#*T0NEV#)/(FREQ*2)
Else If _SEL=10 : Rem horn 
   N#=(_2PI#*T0NEV#)/(FREQ/2)
Else 
   N#= Fn T0NE#
End If 
N#=N#/_BYPS
If _BYPS=1
   A0=T0NEA
Else If _BYPS=2
   A0=T0NEA*256
Else If _BYPS=3
   A0=T0NEA*65536
End If 
Repeat 
   On _SEL Gosub ¯SIN,¯COS,¯TRI,¯RAMP,¯SAW,¯SQR,¯PLS50,¯PLS25,¯BELL,¯HORN
   On _BYPS Gosub ¯POKEFX,¯DOKEFX,¯TOKEFX
Until FX>FXE
If RL<2 Then QUAL(B)=_BYPS
Gosub SETUNNAMED
Goto HEADER
'
¯SIN: CN#=Sin(N#*(FX-FX_START)) : Goto T
¯COS: CN#=Cos(N#*(FX-FX_START)) : Goto T
¯TRI: CN#=Asin(Sin(N#*(FX-FX_START)))*_PI2# : Goto T
¯RAMP: CN#=Asin(Cos(N#*(FX-FX_START)))*_PI2# : If Sin(N#*(FX-FX_START))<0 : CN2=-(A0+1) : Else : CN2=A0 : End If : CN=Int(CN2*CN#) : Return 
¯SAW: CN2#=1.0 : CN#=0 : Repeat : CN#=CN#+Sin(CN2#*(N#*(FX-FX_START)))/CN2# : CN2#=CN2#+1 : Until CN2#>16 : CN#=CN#*_PI2# : Goto T
¯SQR: CN2#=1.0 : CN#=0 : Repeat : CN#=CN#+Sin(CN2#*(N#*(FX-FX_START)))/CN2# : CN2#=CN2#+2 : Until CN2#>16 : Goto T
¯PLS50: If Cos(N#*(FX-FX_START))<0 : CN=-(A0+1) : Else : CN=A0 : End If : Return 
¯PLS25: CN#=Cos(N#*(FX-FX_START)) : If CN#<0 : If CN#<-0.75 : CN=-(A0+1) : Else : CN=0 : End If : Else : If CN#>0.75 : CN=A0 : Else : CN=0 : End If : End If : Return 
¯BELL: CN2#=1.0 : CN#=0 : Repeat : CN#=CN#+Sin(CN2#*(N#*(FX-FX_START)))/CN2# : CN2#=CN2#+4 : Until CN2#>16 : CN#=CN#*_PI2# : Goto T
¯HORN: CN2#=1.0 : CN#=0 : Repeat : CN#=CN#+Sin(CN2#*(N#*(FX-FX_START)))/CN2# : CN2#=CN2#+0.5 : Until CN2#>4 : CN#=(CN#*_PI2#)*_PI2#
T: If CN#<0 : CN=Int((A0+2)*CN#) : Else : CN=Int(A0*CN#) : End If : Return 
'
T0NEC:
I=ZN_PIANO : N=ZN_T0NECANCEL : Gosub RESETZN
_T0NE=False
Goto WINC
'
T0DIAL:
ROT#(10)= Fn ROT_TFREQ_SET
Gosub DIALT0NE
'
T0SET:
If T$<>_$
   If T0NEV#<1
      T0NEV#=1 : Gosub CLRKEY
   Else If T0NEV#>FREQ
      T0NEV#=FREQ : Gosub CLRKEY
   End If 
   If Right$(T$,1)<>_DOT$
      T$=Str$(T0NEV#)-_SPACE$
      N=Len(T$)
      Gosub _TEXT
   End If 
End If 
If Not KDOWN
   BTXT1$=_$ : BX=RX : BY=RY+28 : BZN=ZN_PIANO : Gosub BTN : Goto PIANOBTN
End If 
Return 
'
_WHITENOISE:
Gosub SETRND
Repeat 
   CN=Rnd(A0)-A1
   On _BYPS Gosub ¯POKEFX,¯DOKEFX,¯TOKEFX
Until FX>FXE
If RL<2 Then QUAL(B)=_BYPS
Goto SETUNNAMED
'
_DITHER:
Gosub SETDEFBANK
If PASS=0 Then Randomize Timer
CN2=0
Repeat 
   On _DITHER Gosub DI,TH,ER
   Poke FX,CN2
   Add FX,_BYPS
Until FX>FXE
If RL<2 Then QUAL(B)=_BYPS
Goto SETUNNAMED
'
DI: CN2=Rnd(2)-1 : Return 
TH: R2=R1 : R1=Rnd(2)-1 : CN2=(R1-R2) : Return 
ER: R2=R1 : R1=Rnd(2)-1 : CN2=(R2+R1)/2 : Return 
'
DITHER16:
If _DITHER=0 Then Return 
On _DITHER Gosub DI,TH,ER
If CN>32767 Then CN2=-CN2
CN=CN+CN2
Return 
'
DITHER24:
If _DITHER=0 Then Return 
On _DITHER Gosub DI,TH,ER
If CN>8388607 Then CN2=-CN2
CN=CN+CN2
Return 
'
_CRYPTONOISE:
Trap Dim RANDRSL(255),MM(255)
If Errtrap Then Rem clear trap 
If PASS=0
   AA=0 : BB=0 : CC=0
   ISA=$9E3779B9 : ISB=ISA : ISC=ISA : ISD=ISA : ISE=ISA : ISF=ISA : ISG=ISA : ISH=ISA
   Gosub _OPENFXTEXTWIN
   TXT1$="Passphrase:"
   _TEXT=True : _EXIT=False
   CR$=_SCORE$ : ITX_X=340 : ITX_Y=72 : ITX_L=9 : TXT_X=0 : N=0 : T$=_$ : _MAX=256
   Repeat 
      Gosub _TEXTINPUT
      Gosub DRWTEXT
      Repeat 
         Gosub GVAL
         If Z=ZN_OK and Fn MOUSEDOWN or Fn KEY_RETURN
            PZN=Z : BX=RX : Gosub PRESS
            If _ON
               REQ=True
               _EXIT=True
            End If 
         Else If Z=ZN_CANCEL and Fn MOUSEDOWN or Fn KEY_ESC
            PZN=Z : BX=RX+107 : Gosub PRESS
            If _ON
               REQ=False
               _EXIT=True
            End If 
         End If 
      Until _EXIT or C
   Until _EXIT
   Gosub _CLOSEFXWIN
   Gosub WINC
   If T$=_$
      REQ=False
   End If 
End If 
If REQ
   Gosub SETDEFBANK
   Gosub ISET
   Gosub ISAAC
   ISI=0
   Repeat 
      ISN=RANDRSL(ISI)
      Inc ISI
      If ISI>255
         Gosub ISAAC
         ISI=0
      End If 
      ISN=(ISN mod 255)
      Poke FX,ISN
      Inc FX
   Until FX>FXE
   Gosub SETUNNAMED
End If 
If RL<2
   _BITS=8 : Gosub SETQUAL
End If 
_TEXT=False
Return 
'
ISET:
ISI=0 : ISN=0
Repeat 
   MM(ISI)=0
   If ISN>Len(T$)
      ISN=0
   End If 
   RANDRSL(ISI)=Asc(Mid$(T$,ISN,1))
   Inc ISI : Inc ISN
Until ISI>255
ISI=0
Repeat 
   Gosub IMIX
   Inc ISI
Until ISI>3
ISI=0
Repeat 
   ISA=ISA+RANDRSL(ISI) : ISB=ISB+RANDRSL(ISI+1) : ISC=ISC+RANDRSL(ISI+2) : ISD=ISD+RANDRSL(ISI+3)
   ISE=ISE+RANDRSL(ISI+4) : ISF=ISF+RANDRSL(ISI+5) : ISG=ISG+RANDRSL(ISI+6) : ISH=ISH+RANDRSL(ISI+7)
   Gosub IMIX
   MM(ISI)=ISA : MM(ISI+1)=ISB : MM(ISI+2)=ISC : MM(ISI+3)=ISD
   MM(ISI+4)=ISE : MM(ISI+5)=ISF : MM(ISI+6)=ISG : MM(ISI+7)=ISH
   Add ISI,8
Until ISI>255
Return 
'
ISAAC:
Inc CC
Add BB,CC
IV=0
Repeat 
   XV=MM(IV)
   Dreg(0)=AA : Dreg(1)=13 : Call(Varptr(MC_ASL_L)) : TAA13=Dreg(0)
   Dreg(0)=AA : Dreg(1)=6 : Call(Varptr(MC_ASR_L)) : TAA6=Dreg(0)
   Dreg(0)=AA : Dreg(1)=2 : Call(Varptr(MC_ASL_L)) : TAA2=Dreg(0)
   Dreg(0)=AA : Dreg(1)=16 : Call(Varptr(MC_ASR_L)) : TAA16=Dreg(0)
   Dreg(0)=IV : Dreg(1)=3 : Call(Varptr(MC_AND_L))
   On Dreg(0) Goto I0,I1,I2,I3
   I0: AA=AA xor TAA13 : Goto IS
   I1: AA=AA xor TAA6 : Goto IS
   I2: AA=AA xor TAA2 : Goto IS
   I3: AA=AA xor TAA16
   IS:
   Dreg(0)=IV+128 : Dreg(1)=255 : Call(Varptr(MC_AND_L))
   TAA=AA
   AA=MM(Dreg(0)) : Add AA,TAA
   Dreg(0)=XV : Dreg(1)=2 : Call(Varptr(MC_ASR_L))
   Dreg(1)=255 : Call(Varptr(MC_AND_L))
   YV=MM(Dreg(0)) : Add YV,AA : Add YV,BB
   Dreg(0)=YV : Dreg(1)=10 : Call(Varptr(MC_ASL_L))
   MM(IV)=Dreg(0)
   Dreg(1)=255 : Call(Varptr(MC_AND_L))
   BB=MM(Dreg(0)) : Add BB,XV
   RANDRSL(IV)=BB
   Inc IV
Until IV>255
Return 
'
IMIX:
Dreg(0)=ISA xor ISB : Dreg(1)=11 : Call(Varptr(MC_ASL_L)) : ISA=Dreg(0) : Add ISD,ISA : Add ISB,ISC
Dreg(0)=ISB xor ISC : Dreg(1)=2 : Call(Varptr(MC_ASR_L)) : ISB=Dreg(0) : Add ISE,ISB : Add ISC,ISD
Dreg(0)=ISC xor ISD : Dreg(1)=8 : Call(Varptr(MC_ASL_L)) : ISC=Dreg(0) : Add ISF,ISC : Add ISF,ISC
Dreg(0)=ISD xor ISE : Dreg(1)=16 : Call(Varptr(MC_ASR_L)) : ISD=Dreg(0) : Add ISG,ISD : Add ISE,ISF
Dreg(0)=ISE xor ISE : Dreg(1)=10 : Call(Varptr(MC_ASL_L)) : ISE=Dreg(0) : Add ISH,ISE : Add ISF,ISG
Dreg(0)=ISF xor ISG : Dreg(1)=4 : Call(Varptr(MC_ASR_L)) : ISF=Dreg(0) : Add ISA,ISF : Add ISG,ISH
Dreg(0)=ISG xor ISH : Dreg(1)=8 : Call(Varptr(MC_ASL_L)) : ISG=Dreg(0) : Add ISB,ISG : Add ISH,ISA
Dreg(0)=ISH xor ISA : Dreg(1)=9 : Call(Varptr(MC_ASR_L)) : ISH=Dreg(0) : Add ISC,ISH : Add ISA,ISB
Return 
'  
_SINNOISE:
Gosub SETDEFBANK
CN=Rnd(_GIGABYTE)+_GIGABYTE : CN#=0
Repeat 
   CN#=Sin(CN*CN#+1)
   Inc CN
   On _BYPS Gosub ¯SINB,¯SIND,¯SINT
Until FX>FXE
If RL<2 Then QUAL(B)=_BYPS
Goto SETUNNAMED
'
¯SINB: Poke FX,Int(CN#*127) : Inc FX : Return 
¯SIND: Doke FX,Int(CN#*32767) : Add FX,2 : Return 
¯SINT: CN2=Int(CN#*8388607) : VN=Varptr(CN2) : Poke FX,Peek(VN+1) : Inc FX : Poke FX,Peek(VN+2) : Inc FX : Poke FX,Peek(VN+3) : Inc FX : Return 
'
_FILLNOISE:
Gosub SETRND
Repeat 
   CN=Rnd(A0)-A1
   CN2=Rnd(BSIZE/_BYPS)*_BYPS : Inc CN2
   If FX+CN2>FXE Then CN2=FXE-FX
   FX2=FX
   FX_LENGTH2=FX2 : Add FX_LENGTH2,CN2
   Repeat 
      On _BYPS Gosub ¯POKEFX2,¯DOKEFX2,¯TOKEFX2
   Until FX2>FX_LENGTH2
   Add FX,CN2
Until FX=FXE
If RL<2 Then QUAL(B)=_BYPS
Goto SETUNNAMED
'
_RECORDCHANNEL:
If Not Fn MULTI Then Goto FLSHSCR
_RECB=B
'
_TGLRECORD:
If _REC
   _REC=False
   Gosub SETREC
   _RECB=0 : _RECN=0
   Repeat 
      Close SBCOUNT
      Inc SBCOUNT
   Until SBCOUNT>Min(9,SB) : Rem max 9 file channels
   _RECORD$=RECMENU$
   Colour _HIGHLIGHT,_COLP
   T_LENGTH=RECTOTAL
   Gosub TIME_ALL
   _TOAST$=Str$(DIV#)-_SPACE$+T$
   Gosub DRWTIMENOW
   _REPEAT$=_$ : Dec T_MODE
Else If _16CH
   TXT1$="Can't record 16" : TXT2$="channels concurrently" : Goto _NOTICE
Else If Length(PBANK)=0
   Goto FLSHSCR
Else 
   PF$=F$
   If _RECB>0
      If _RECB>_CH
         _RECB=0
         Goto FLSHSCR
      End If 
      WTXT$="Channel "+Str$(_RECB)-_SPACE$
   Else If Fn STEREO
      WTXT$="as Stereo"
   Else If Fn QUAD
      WTXT$="as Quad"
   Else If Fn MULTI
      WTXT$="as"+Str$(_CH)+" Channel"
   Else 
      WTXT$=_$
   End If 
   WTXT$="Record "+WTXT$+": raw"
   Gosub FREQUEST
   S$=F$
   If Not FRQ
      _RECB=0
      Return 
   End If 
   If Exist(F$)
      Gosub OVERWRITE
      If Not REQ
         Return 
      End If 
   End If 
   If Fn MONO or _RECB>0
      Open Out 2,F$ : Gosub SETFILEPOS
   Else If Fn STEREO
      F$=S$+"-L" : Gosub SETFILEPOS
      Open Out 2,F$
      F$=S$+"-R" : Gosub SETFILEPOS
      Open Out 3,F$
   Else If Fn QUAD
      F$=S$+"-L1" : Gosub SETFILEPOS
      Open Out 2,F$
      F$=S$+"-R1" : Gosub SETFILEPOS
      Open Out 3,F$
      F$=S$+"-R2" : Gosub SETFILEPOS
      Open Out 4,F$
      F$=S$+"-L2" : Gosub SETFILEPOS
      Open Out 5,F$
   Else 
      SB=2
      Repeat 
         F$=S$+_MINUS$+Str$(SB-1)-_SPACE$ : Gosub SETFILEPOS
         Open Out SB,F$
         Inc SB
      Until SB>Min(9,_CH+1) : Rem max 9 file channels    
   End If 
   F$=PF$
   _RECORD$="Stop Recording"
   _REC=True : _RECN=_RECB
   _COLP=Colour(_HIGHLIGHT)
   Colour _HIGHLIGHT,$E22 : Rem _RED 
   Inc T_MODE
End If 
RECTOTAL=-1
If Fn MULTI Then Goto R4INSET
Return 
'
REC:
If RECTOTAL=-1
   Inc RECTOTAL
   Return 
End If 
If _RECB>0
   BBUFF=BSIZE*(_RECB-1)
   Ssave 2,P_BUF+BBUFF To P_BUF+BBUFF+BSIZE
Else 
   BBUFF=0
   Gosub SETREC
   Repeat 
      Ssave SBCOUNT,P_BUF+BBUFF To P_BUF+BBUFF+BSIZE
      BBUFF=BBUFF+BSIZE
      Inc SBCOUNT
   Until SBCOUNT>Min(9,SB) : Rem max 9 file channels
End If 
'
DRWREC:
RECTOTAL=RECTOTAL+BSIZE
If TGL
   If Not RENDERING
      Gosub GFXSET
      Ink _HIGHLIGHT,_PANE
      T_LENGTH=RECTOTAL
      Gosub TIME_ALL
      T$=Str$(DIV#)-_SPACE$+T$
      If Len(T$)<16
         T$=Space$(5)+T$
      Else If Len(T$)<22
         T$=_SPACE$+T$
      End If 
      Text 600-Text Length(T$),WVE_H+24+16,T$
      Goto GFXRESTORE
   End If 
End If 
Return 
'
SETREC:
SBCOUNT=2
If Fn MONO or _RECB>0
   SB=1
Else If Fn STEREO
   SB=2
Else If Fn QUAD
   SB=4
Else 
   SB=_CH+1
End If 
SB=SB+1
Return 
'
_NORMALPIANO:
PIANO=False
_POLY=False
_PORTA=False
REQ=True
Goto _DRAWALL
'
_PORTAMENTOPIANO:
PIANO=False
_POLY=False
_PORTA=True
REQ=True
Goto _DRAWALL
'
_POLYPHONICPIANO:
PIANO=True
_POLY=True
REQ=True
Goto HIGHPIANO
'
_SINGLEPIANO:
PIANO=True
_POLY=False
REQ=True
Goto HIGHPIANO
'
_OPENASSEQUENCE:
PF$=F$ : F$=_$
WTXT$="Open As: sequence"
PPROGDIR$=Dir$
If Dir$<>SEQDIR$ and Exist(SEQDIR$)
   Dir$=SEQDIR$
   Gosub RSTFILES
End If 
Gosub FREQUEST
If Not FRQ
   Dir$=PPROGDIR$
   Goto RSTFILES
End If 
SEQDIR$=Dir$
If Dir$<>PROGDIR$
   Dir$=PPROGDIR$
   Gosub RSTFILES
End If 
If Not Exist(SEQDIR$+F$)
   Gosub CANTFIND
   F$=PF$
   Return 
End If 
_TEXT=True
T$="SEQ "+F$
MACRO=True : Gosub CMD : MACRO=False
F$=PF$
_TEXT=False
Return 
'
'
'
'***************************************************************************** 
'*direct********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'   ::::::-.   :::  :::::::..  .,::::::  .,-:::::::::::::::: 
'   ;;,   `';, ;;;  ;;;;``;;;; ;;;;'''',;;;'````' ;;;;;;;''' 
'   `[[     [[ [[[  \[[[,/[[['  [[cccc [[[            [[ 
'    $$,    $$ $$$, "$$$$$$c    $$"""" $$$            $$ 
'    888_,o8P'o88888,888b "88bo 888oo,_`88bo,__,o,    88,
'   "MMMMP"`  MMM"MM"MMMM   "W" """"YUM  "YUMMMMMP    MMM
'
'
'
NEWCLI:
Inc _DIRECT : _TEXT=True
Gosub NUDGEPOS
RENDERING=True
Gosub CLISHW
MACRO=False : SEQUENCE=False : ACTION=False : Rem started from the dispatch queue
¯LOOP:
TXT_X=0 : N=0 : T$=Str$(_DIRECT)-_SPACE$
Locate ,(CLI_H/8)-1
Print T$+_DOT$+Dir$;"> ";_SCORE$;
_LOC=Len(Dir$)+Len(T$)+1
If _LOC>CLI_W
   Add _LOC,-CLI_W
End If 
_MAX=156-_LOC
T$=_$
Repeat 
   Gosub GVAL
   If Fn KEY_PRESS
      If Fn KEY_UP and S=0
         N=Len(_REPEAT$) : T$=_REPEAT$
      Else 
         Gosub _TEXTINPUT
      End If 
      If Fn KEY_ESC
         Goto CLIEND
      End If 
      S$="> "+T$
      Locate _LOC,
      If _NEXTLINE
         Cup 
      Else If Fn KEY_BACKSPACE
         If Len(S$)+_LOC=CLI_W-1
            Cup 
         End If 
      Else 
         If Len(S$)>CLI_W-_LOC
            If Fn KEY_UP
               Print Left$(S$,CLI_W);
            End If 
            Locate 0,
            S$=Mid$(S$,(CLI_W-_LOC)+1)
         End If 
         Print S$;
      End If 
      _NEXTLINE=False
      If _LOC=Len(S$)>CLI_W
         Add _LOC,-CLI_W
      End If 
      If Fn KEY_BACKSPACE or Fn KEY_DEL
         If _LOC+Len(S$)<CLI_W
            Locate _LOC+Len(S$),
            If _LOC+Len(S$)<CLI_W-2
               Print _SPACER$;
            Else If _LOC+Len(S$)=CLI_W-2
               Print _SPACER$;
               Cup 
            Else If _LOC+Len(S$)=CLI_W-1
               Print _SPACE$;
               Locate 0, : Print _SPACE$ : Cup 
               Cup 
            End If 
         Else If _LOC+Len(S$)=CLI_W
            Locate 0,
            Print "_ ";
         Else If _LOC+Len(S$)>CLI_W
            Locate(Len(S$)-CLI_W)+_LOC,
            Print "_ ";
         End If 
      End If 
      If N=Len(T$)-1
         Print _SPACE$;
      End If 
      If Not _NEXTLINE
         If Not Fn KEY_ESC
            Writing 2,2
            If _LOC+N+2<CLI_W
               Locate _LOC+N+2, : Print _SCORE$;
               If _LOC+N+2=CLI_W-1
                  Cup 
               End If 
            Else If _LOC+N=CLI_W and C-65 : Rem backspace
               Print _SCORE$;
            Else If _LOC+N+2>CLI_W
               Locate _LOC+N+2-CLI_W,
               If C-65 and C-70 : Rem backspace del
                  Print _SCORE$;
               End If 
            End If 
            Writing 0,0
         Else 
            Print _SPACE$
         End If 
      End If 
   End If 
Until Fn KEY_RETURN
Print 
DCN=0
Repeat 
   Exit If Peek(Varptr(T$)+DCN)<>CHR_SPACE
   Inc DCN
Until DCN>N
T$=Mid$(T$,DCN+1,Len(T$)-DCN)
_REPEAT$=T$
CMD:
S$=T$
DCN=0
Repeat 
   CMDL=Len(CMD$(DCN))
   If Upper$(Left$(T$,CMDL))=CMD$(DCN)
      If Peek(Varptr(T$)+CMDL)=CHR_SPACE
         Inc CMDL
      End If 
      Inc CMDL
      T$=Mid$(S$,CMDL)
      Gosub CMDG$(DCN)
      CMDL=True
      Exit 
   End If 
   Inc DCN
Until DCN>_CM
If Not CMDL
   Gosub SETREALTIME
   If MACRO
      If Upper$(T$)="NEWCLI"
         Goto NEWCLI
      End If 
      G$=T$
      Trap Gosub G$
      T$=G$
      If Errtrap
         Gosub MACROERROR
      Else 
         Gosub CHECKFX
         If Not MENFX
            T$=Left$(G$,Len(G$)-1) : Rem subroutineP
            Gosub CHECKFX
         End If 
         If MENFX
            MENFX=False
            If RL>1
               Goto STEREOQUAD
            End If 
         End If 
      End If 
      Return 
   Else 
      _REPEAT$=T$
      Gosub MACROSET
      Trap Gosub T$
      If Errtrap
         Gosub MACRORESTORE
         If T$<>_$
            Print "Unknown command or subroutine "; Fn QUOTE$(T$)
         End If 
      Else 
         If Upper$(_REPEAT$)="_INIT"
            Return 
         End If 
         Gosub CHECKFX
         If Not MENFX
            T$=Left$(T$,Len(T$)-1) : Rem subroutineP  
            Gosub CHECKFX
         End If 
         If MENFX
            MENFX=False
            G$=T$
            If RL>1
               Gosub STEREOQUAD
            End If 
            'from MCHOOSE
            Gosub CLRPOS
            RENDERING=True
            Gosub _DRAW
            Gosub FRSHSEL
            Gosub HEADER
         End If 
         Gosub MACRORESTORE
         If _TOAST$<>_$ and _TOAST$<>_TOPSCORE$
            Print _TOAST$
            _TOAST$=_$
         End If 
      End If 
   End If 
End If 
If MACRO=False and SEQUENCE=False and ACTION=False
   If Not _REPEATING
      Goto ¯LOOP
   End If 
End If 
Return 
'
¯EXIT:
Pop 
CLIEND:
I#=CLI_Y : DD#=1.5
Repeat 
   Screen Display 2,SCR_L,Int(I#),SCR_L+(SCR_W/2),CLI_H
   Gosub GTASK
   I#=I#-DD#
   DD#=DD#+3.25
Until I#<-90
Screen Hide 2 : Screen 0
If Fn MULTI Then Gosub R4INSET
Dec _DIRECT
If _DIRECT>0 Then Goto CLISHW
RENDERING=False : _TEXT=False : REQ=False
Goto CLRPOS
'
¯BANK:
If Upper$(T$)="PB" Then B=LB Else B=Min(_FL,Max(1,Val(T$)))
Gosub MACROSET
Gosub SETBANK
Goto MACRORESTORE
'
¯SWAP:
N=Val(T$)
If T$=_$ or N>_FL or N<1 Then Goto ¯BADARGS
If B=N Then Return 
Gosub MACROSET
Bank Swap PBANK,N+JB
Swap FB$(B),FB$(N)
Swap FPATH$(B),FPATH$(N)
If Fn MULTI
   If Fn INVIEW
      If N<=_CH
         Swap D_START(B),D_START(N)
         Swap D_LENGTH(B),D_LENGTH(N)
         Swap OFFSET(B),OFFSET(N)
      Else 
         D_LENGTH(B)=Length(N+JB)
         If D_LENGTH(B)>0
            D_START(B)=Start(N+JB)
         End If 
      End If 
   Else If N<=_CH
      D_LENGTH(N)=Length(N+JB)
      If D_LENGTH(N)>0
         D_START(N)=Start(N+JB)
      End If 
   End If 
End If 
If B<11
   F$=Right$(MENB$(B),8)
   If N<11
      Right$(MENB$(B),8)=Right$(MENB$(N),8)
   Else 
      Right$(MENB$(B),7)=Left$(FB$(B),7)
   End If 
Else 
   F$=Space$(8)
   Right$(F$,7)=Left$(FB$(N),7)
End If 
If N<11
   Right$(MENB$(N),8)=F$
End If 
Swap QUAL(B),QUAL(N)
Swap NAME$(B),NAME$(N)
Swap CPYR$(B),CPYR$(N)
Swap AUTH$(B),AUTH$(N)
Swap TXT$(B),TXT$(N)
Swap ANNO$(B),ANNO$(N)
Swap COMP(B),COMP(N)
F$=FB$(B)
If Fn MULTI Then Gosub CLREMPTY
Gosub POSCAL
Gosub MAGICWAND
If SETTING$(27)<>_FALSE$ : Rem always draw
   If RENDERING=False
      Gosub CLRPOS
      RENDERING=True
      Gosub _DRAW
      If RST>P_LENGTH
         Gosub _RANGENONE
      Else 
         Gosub SETSELCORDS
         Gosub AFTERWAND
      End If 
      Gosub HEADER
      RENDERING=False
   End If 
End If 
Goto MACRORESTORE
'
¯DIV:
If T$=_$
   Print _TIMEDIV#
Else 
   Gosub MACROSET
   Gosub TIMEDIV
   Goto MACRORESTORE
End If 
Return 
'
¯RNG:
TVAL=Val(T$)
If TVAL<1 or TVAL>Int(_TIMEDIV#) Then Goto FLSHSCR
RL=Int(P_LENGTH/_TIMEDIV#) : RST= Fn BPSALIGN((TVAL*(P_LENGTH/_TIMEDIV#))-RL)
Goto ¯R
'
¯NOTE:
If T$=_$ Then Goto ¯BADARGS
If Fn MULTIINVIEW Then I=B Else I=1
OFFSET=Int(_TIMEBEAT#*Int(Int(OFFSET(I)/CON#)/_TIMEBEAT#))*CON#
OFFSET=OFFSET-OFFSET mod _BYPS
If OFFSET>=P_LENGTH
   OFFSET=0
End If 
If Val(T$)<>0
   FINE$=Str$(_FINETUNE)-_SPACE$-_MINUS$
   If _FINETUNE<0
      FINE$=_SCORE$+FINE$
   End If 
   Restore "PER"+FINE$
   I=Val(T$)
   Repeat 
      Read KEYF
      Dec I
   Until I<0
   KEYF=CLOCK/KEYF
   _FINETUNE=0
Else 
   Restore KAL
   Repeat 
      Read KEYC,KEYS$,KEYF
      If KEYS$=T$
         Return 
      End If 
   Until KEYC=-1
End If 
Return 
'
¯FINE:
_FINETUNE=Val(T$)
If _FINETUNE>7
   _FINETUNE=7
Else If _FINETUNE<-8
   _FINETUNE=-8
End If 
Return 
'
_TGLAMP:
If _DONTAMP Then _DONTAMP=False Else _DONTAMP=True
Return 
'
¯AMP:
If _DONTAMP Then Return 
_AMP#=Val(T$)
If _AMP#>1 or _AMP#<0 Then _AMP#=1
Return 
'
¯MODE:
If T$=_$
   Print _MODE
Else 
   _MODEP=Val(T$)
   Gosub MACROSET
   _M3SEL=_MODEP
   Gosub M0DEMENU
   Goto MACRORESTORE
End If 
Return 
'  
¯FREQ:
If T$=_$
   Print FREQ;_SPACE$;_HZ$
Else 
   TVAL=Val(T$)
   If TVAL>500 : Rem +music.s SAM RAW cmp.l #500,d3 Rble L_IFonc
      Gosub MACROSET
      If TVAL>MFREQ
         TVAL=MFREQ
      End If 
      FREQ=TVAL
      _AMIHZ=False
      RENDERING=False
      Gosub SETHZ : Rem round to CLOCK 
      _DIAL=0 : _ROT(_DIAL)=False : Gosub DIALHIGH
      Gosub DIALMAIN
      FREQ=TVAL : Gosub DRWTIME : Rem redisplay actual chosen frequency  
      RENDERING=True
      Goto MACRORESTORE
   Else 
      Goto ¯BADARGS
   End If 
End If 
Return 
'
¯VOL:
If T$=_$
   Print VOL
Else 
   TVAL=Val(T$)
   If TVAL<0 or TVAL>64
      Goto ¯BADARGS
   End If 
   VOL=TVAL : ROT#(1)= Fn ROT_VOL_SET
   Gosub MACROSET
   Gosub SETVOL
   Goto MACRORESTORE
End If 
Return 
'
¯TFREQ:
If T$=_$
   Print T0NEV#
Else 
   T0NEV#=Val(T$)
   If T0NEV#<1
      T0NEV#=1
   Else If T0NEV#>TFREQ
      T0NEV#=TFREQ
   End If 
   ROT#(10)= Fn ROT_TFREQ_SET
End If 
Return 
'
¯TAMP:
If T$=_$
   Print T0NEA#
Else 
   T0NEA#=Val(T$)
   If _AMP#>1 or _AMP#<0
      _AMP#=1
   End If 
   T0NEA=T0NEA#*127
   ROT#(11)= Fn ROT_TAMP_SET
End If 
Return 
'
¯SIZE:
If T$=_$
   Print P_LENGTH
Else 
   If P_LENGTH=0
      QUAL(B)=_BYPS
   End If 
   S_LENGTH=Val(T$)
   Gosub MACROSET
   If S_LENGTH=0
      Gosub _NEW
      Goto MACRORESTORE
   End If 
   If Fn STEREO
      FX_LENGTH=S_LENGTH*2
      CCOUNTN=1
   Else If Fn QUAD
      FX_LENGTH=S_LENGTH*4
      CCOUNTN=3
   Else 
      FX_LENGTH=S_LENGTH
      CCOUNTN=0
   End If 
   Trap Reserve As Work WBANK,FX_LENGTH
   If Errtrap
      Gosub NOMEMORY
      Goto MACRORESTORE
   End If 
   If P_LENGTH>0
      CCOUNT=0
      Repeat 
         If S_LENGTH>P_LENGTH
            Copy P_START+(P_LENGTH*CCOUNT),P_START+(P_LENGTH*CCOUNT)+P_LENGTH To Start(WBANK)+(S_LENGTH*CCOUNT)
         Else 
            Copy P_START+(P_LENGTH*CCOUNT),P_START+(P_LENGTH*CCOUNT)+S_LENGTH To Start(WBANK)+(S_LENGTH*CCOUNT)
         End If 
         Inc CCOUNT
      Until CCOUNT>CCOUNTN
   Else 
      Gosub SETUNNAMED
   End If 
   Gosub _WORKSWAP
   If P_LENGTH>Length(PBANK)
      Gosub _RANGENONE
   End If 
   Gosub _RESIZED
   Goto MACRORESTORE
End If 
Return 
'
¯RANGE:
I=0 : N=Len(T$)
Repeat 
   Exit If Peek(Varptr(T$)+I)=CHR_SPACE
   Inc I
Until I>N
If I>N Then Goto ¯BADARGS
TVAL=Val(Mid$(T$,0,I))
TVAL=TVAL*_BYPS
TVAL=Min(P_LENGTH,Max(0,TVAL))
If TVAL>P_LENGTH or TVAL<0 Then Goto ¯BADARGS
BPS=_BYPS
RST=TVAL-TVAL mod _BYPS
TVAL=Val(Mid$(T$,I+2,N-I))
TVAL=TVAL*_BYPS
If TVAL=0 Then TVAL=P_LENGTH-RST
If TVAL>P_LENGTH or TVAL-RST>P_LENGTH or TVAL<0 Then Goto ¯BADARGS
RL=TVAL
'
¯R:
RFIN=P_LENGTH-RST-RL
Gosub MACROSET
Gosub SETCORDS
Gosub _SHOWCOPY
Gosub SETZN
Gosub HEADERCORDS
Goto MACRORESTORE
'  
¯CALC:
TVAL=Val(T$)
If TVAL<1 or TVAL>_FL Then Goto ¯BADARGS
N2#=P_LENGTH
N#=Length(TVAL+JB)
Return 
'
¯OFFSET:
TVAL=Val(T$)
If TVAL<1 or TVAL>_CH or B>_CH Then Goto ¯BADARGS
OFFSET(B)=OFFSET(TVAL)
Return 
'
¯NAME: If T$=_$ : Print NAME$(B) : Else : NAME$(B)=T$ : End If : Return 
¯CPYR: If T$=_$ : Print CPYR$(B) : Else : CPYR$(B)=T$ : End If : Return 
¯AUTH: If T$=_$ : Print AUTH$(B) : Else : AUTH$(B)=T$ : End If : Return 
¯TXT: If T$=_$ : Print TXT$(B) : Else : TXT$(B)=T$ : End If : Return 
¯ANNO: If T$=_$ : Print ANNO$(B) : Else : ANNO$(B)=T$ : End If : Return 
'
¯WAND:
XD2=Val(T$)
XD=XD2-(640/_TIMEDIV#)
If XD<0 Then XD=0
WXD=XD
Goto ¯W
'
¯ZOOML:
XD=Val(T$)
Goto ¯W
'
¯ZOOMR:
XD2=Val(T$)
'
¯W:
Gosub MACROSET
Gosub MAGICWAND
If SETTING$(27)<>_FALSE$ : Rem always draw
   If RENDERING=False and _MENUDO=False and OSCILLO=False
      Gosub WREFRSH
   End If 
End If 
Goto MACRORESTORE
'
¯CDDD:
T$=_SLASH$
'
¯CD:
If T$=_$
   Print Dir$
Else If T$=".."
   Goto ¯CDDD
Else If Exist(T$)
   Dir$=T$
   Goto RSTFILES
Else 
   Goto ¯CANTFIND
End If 
Return 
'
¯MD:
If T$=_$
   Goto ¯BADARGS
Else If Exist(T$)
   Print T$;" exists"
Else 
   Mkdir T$
End If 
Return 
'
¯DIR:
If T$=_$
   Goto ¯D
Else If Exist(T$)
   PPROGDIR$=Dir$
   Trap Dir$=T$
   If Errtrap
      Goto ¯CANTFIND
   End If 
   Gosub ¯D
   Dir$=PPROGDIR$
Else 
   Goto ¯CANTFIND
End If 
Return 
'
¯D:
Gosub SETFILENAMELENGTH
D$=Dir First$(_$)
NN=1
Repeat 
   Print Left$(D$,30)
   D$=Dir Next$
   Gosub PAGECLI
Until D$=_$ or Fn KEY_ESC
Return 
'
¯DEL:
If T$=_$
   Goto ¯BADARGS
Else If Exist(T$)
   Kill T$
Else 
   Goto ¯CANTFIND
End If 
Return 
'
¯MV: Rem RENAME 
If T$=_$ Then Goto ¯BADARGS
I=0 : N=Len(T$)
Repeat 
   Exit If Peek(Varptr(T$)+I)=CHR_SPACE
   Inc I
Until I>N
Trap Rename Mid$(T$,0,I) To Mid$(T$,I+2,N-I)
If Errtrap Then Goto ¯BADARGS
Return 
'
¯CLS:
Cls 
Return 
'
¯ED:
If T$=_$ Then Goto ¯BADARGS
Gosub _STOP
Amos To Back 
Exec "ed "+ Fn QUOTE$(Dir$+T$-_QUOTE$)
Amos To Front 
Return 
'
¯OPEN:
If T$=_$ Then Goto ¯BADARGS
Gosub MACROSET
If Instr(T$,_COLON$)=0 and Instr(T$,_SLASH$)>0
   F$=PROGDIR$+T$
Else 
   F$=T$
End If 
_APPEND=B-1
If MACRO
   Gosub _OPENF
Else 
   MACRO=True : Gosub _OPENF : MACRO=False
End If 
Goto MACRORESTORE
'
¯MACRO:
Gosub MACROSET
S$=T$
Gosub MACROP
Goto MACRORESTORE
'
¯SEQ:
CN=Q_START
If T$=_$
   I=0 : NN=1
   Repeat 
      N=I : Inc N
      I=Hunt(CN To Q_END,_NEWLINE$)
      If I
         Print _SPACE$;Peek$(CN,I-CN)
         Add NN,(I-CN)/CLI_W : Rem more than one line 
         Gosub PAGECLI
         CN=I+1
      End If 
   Until I=0 or Fn KEY_ESC
Else If T$=QF$
   Q_START=Q_END-Q_LENGTH
   If _DIRECT=0
      _TOAST$=T$
   Else 
      Print T$
   End If 
Else If Exist(SEQDIR$+T$)
   Gosub MACROSET
   Trap Open In 1,SEQDIR$+T$
   If Errtrap
      F$=T$ : Gosub FILEERROR
   Else 
      SZ=Lof(1)
      If SZ>Q_BUF
         Q_BUF=SZ
      End If 
      Trap Reserve As Work QQBANK,Q_BUF
      If Errtrap
         Gosub NOMEMORY
         Goto MACRORESTORE
      End If 
      Sload 1 To Start(QQBANK),SZ
      If Hunt(Start(QQBANK) To Start(QQBANK)+SZ,_COMMANEWLINE$)=0
         TXT1$="Not a" : TXT2$="sequence"
         If _DIRECT=0
            Gosub _NOTICE
         Else 
            Print TXT1$;_SPACE$;TXT2$
         End If 
      Else 
         QF$=T$
         Swap QQBANK,QBANK
         Erase QQBANK
         Q_START=Start(QBANK)
         Q_LENGTH=SZ
         Q_END=Q_START+Q_LENGTH
         If _DIRECT=0
            _TOAST$=T$
         End If 
      End If 
   End If 
   Close 1
   Goto MACRORESTORE
Else 
   Goto ¯CANTFIND
End If 
Return 
'
¯RX:
If Not REXX
   Print "Arexx: ";_NOTACTIVE$
Else If T$=_$
   Goto ¯BADARGS
Else If Exist(RXDIR$)
   Gosub MACROSET
   Exec "run "+RXDIR$+_SPACE$+T$
   Gosub SPIN
   Goto MACRORESTORE
Else 
   T$=RXDIR$
   Goto ¯CANTFIND
End If 
Return 
'
¯SKIN:
If T$=_$ Then Goto ¯BADARGS
Gosub MACROSET
Trap Load Iff T$
If Errtrap
   Gosub ¯CANTFIND
End If 
Gosub MCOL
Goto MACRORESTORE
'
¯KEY: S=0 : Goto ¯K
¯SHIFT: S=1 : Goto ¯K
¯CTRL: S=8 : Goto ¯K
¯AMIGA: S=64 : Goto ¯K
¯ALT: S=16
'
¯K:
If PK=_PK Then Goto ¯BADARGS
I=0 : N=Len(T$)
Repeat 
   Exit If Peek(Varptr(T$)+I)=CHR_SPACE
   Inc I
Until I>N
PKS(PK)=S
PKC(PK)=Val(Mid$(T$,0,I))
If( Fn KEY_LEFTAMIGA and PKC(PK)=32) or( Fn KEY_ALT and(PKC(PK)=83 or PKC(PK)=66)) : Rem amiga a, alt f4, alt tab   
   Print "reserved"
Else 
   PK$(PK)=Mid$(T$,I+2,N-I)
   Inc PK
End If 
Return 
'
¯HELP:
Restore HLP
'
¯H:
Read N
I=1 : NN=1
Repeat 
   Read T$
   Print _SPACER$;T$
   Inc I
   Gosub PAGECLI
Until I>N or Fn KEY_ESC
Return 
'
¯HELPCUT:
If _DIRECT=0
   T$="HELP CUT"
   Goto INITCLI
End If 
Restore CUT
Gosub ¯H
Add NN,3
Print _SPACER$;"Programmed Keys";_COLON$
I=0
While Not Fn KEY_ESC
   Exit If I=PK
   Print _SPACER$;
   S=PKS(I)
   If Fn KEY_LEFTAMIGA
      Print "AMIGA";
   Else If Fn KEY_SHIFT
      Print "SHIFT";
   Else If Fn KEY_ALT
      Print "ALT";
   Else If Fn KEY_CTRL
      Print "CTRL";
   End If 
   If S>0 Then Print _SPACE$;
   Print "Chr(";Str$(PKC(I))-_SPACE$;") ";PK$(I)
   Inc I
   Gosub PAGECLI
Wend 
Print 
Return 
'  
¯HELPSUB:
If _DIRECT=0
   T$="HELP SUB"
   Goto INITCLI
End If 
Print 
TXT1$=_$
M1=1 : NN=1
Repeat 
   M2=1
   Repeat 
      Restore Val(Str$(M1)+Str$(M2))
      Read S$
      If Peek(Varptr(S$)+Len(S$)-3)=CHR_» : Rem no RMENU 
         M3=1
         Repeat 
            Restore Val(Str$(M1)+Str$(M2)+Str$(M3))
            Read S$
            If Len(S$)=0 : Rem hidden items 
               Gosub ¯S
            Else 
               M=Peek(Varptr(S$))
               If M<>CHR_MINUS and M<>CHR_NULL
                  Gosub ¯S
               End If 
            End If 
            Inc M3
         Until M=CHR_NULL or Fn KEY_ESC
         Inc M
      Else 
         M=Peek(Varptr(S$))
         If M<>CHR_MINUS and M<>CHR_NULL
            Gosub ¯S
         End If 
      End If 
      Inc M2
   Until M=CHR_NULL or(M1=3 and M2=12) or(M1=4 and M2=11) or Fn KEY_ESC : Rem menu collision   
   Inc M1
Until M1>_M1 or Fn KEY_ESC
If Not Fn KEY_ESC
   Print "_14BIT_RANGESET_RANGERESTORE_TGLQUALITY_TGLDITHER_TGLINTERPOLATE_TGLLOOP_TGLMIXLOOP_TGLPINGPONG_RENDER_PLAY_PLAYRANGE_PLAYDISPLAY_FASTFORWARD_REWIND_MUTE_UNMUTEALL_STOP";
   Print "_FINDEMPTY_FLUSHLIBS_CLEARMETA_TOASTFREE_TOASTTIME_TOASTDIR_TOASTMODE_NOP";_NDPQ$;_NEWLINE$
End If 
Return 
'
¯S:
Read MENFX,G$
If Len(TXT1$)>CLI_W
   Gosub PAGECLI
   TXT1$=_$
End If 
TXT1$=TXT1$+G$
If Fn KEY_ESC
   Print _NEWLINE$
Else If Left$(G$,5)<>_MACRO$ and Right$(G$,4)<>_MENU$
   Print G$;
End If 
Return 
'
¯HELPCOM:
If _DIRECT=0
   T$="HELP COM"
   Goto INITCLI
End If 
Restore COM
Goto ¯H
'
¯HELPOPT:
If _DIRECT=0
   T$="HELP OPT"
   Goto INITCLI
End If 
Restore OPT
Goto ¯H
'
¯HELPDITHER:
If _DIRECT=0
   T$="HELP DITHER"
   Goto INITCLI
End If 
Restore D24
Goto ¯H
'
¯HELPPIANO:
If _DIRECT=0
   T$="HELP PIANO"
   Goto INITCLI
End If 
Restore PIA
Goto ¯H
'
¯CANTFIND:
_TOAST$="Can't find "+ Fn QUOTE$(T$)
If SEQUENCE
   SETTING$(24)=_FALSE$ : Rem scroller 
Else If MACRO
   F$=T$
   Goto CANTFIND
Else 
   Print _TOAST$
End If 
Return 
'
¯BADARGS:
_TOAST$="Bad args"
If MACRO Then Return 
Print _TOAST$
Return 
'
INITCLI:
Inc _DIRECT : _TEXT=True
Gosub NUDGEPOS
RENDERING=True
CLI_Y=92
Gosub CLISHW
Goto CMD
'
CLISHW:
Gosub R4INBOW
Trap Screen Show 2
If Errtrap
   Screen Open 2,SCR_W,CLI_H,2,SCR_R
   Palette ,,,,,,,,,,,,,,,,,$444,$500,$111
   Flash Off : Curs Off 
Else 
   Screen 2 : Screen To Front 2
   Gosub ¯CLS
End If 
If _LIGHTMODE Then Palette $0,$DDD Else Palette $0,$888
I#=-90 : DD#=1.5
Repeat 
   Screen Display 2,SCR_L,Int(I#),SCR_L+(SCR_W/2),CLI_H
   Gosub GTASK
   I#=I#+DD#
   DD#=DD#+3.25
Until I#>CLI_Y
CLISCR:
Screen Display 2,SCR_L,CLI_Y,SCR_L+(SCR_W/2),CLI_H
Return 
'
PAGECLI:
Inc NN
If NN>14
   NN=1
   X=X Curs : Y=Y Curs : Print "[press SPACE to continue - ESC to cancel]";
   Repeat 
      Gosub GVAL
   Until Fn KEY_ESC or Fn KEY_SPACE
   Locate X,Y : Print Space$(41); : Locate X,Y
End If 
Return 
'
'
'
'***************************************************************************** 
'*sequence******************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .::::::. .,:::::: .::::::.   ...    :::.,::::::::.    :::.  .,-::::::.,:::::: 
'   ;;;`    `;;;;;'''',;;'```';;,';;     ;;;;;;;'''';;;;,  `;;;,;;;'````' ;;;;'''' 
'   '[==/[[[[, [[cccc [[[     [[[[['     [[[ [[cccc  [[[[[. '[[[[[         [[cccc
'     '''    $ $$"""" "$$c  cc$$$$$      $$$ $$""""  $$$ "Y$c$$$$$         $$""""
'   ,88b    dP 888oo,_ "*8bo,Y88b88    .d888 888oo,_888    Y88 `88bo,__,o, 888oo,_ 
'     "YMmMY"  """"YUM   "*YP" "M "YmmMMMM"" """"YUMMM     YM    "YUMMMMMP """"YUM 
'
'
'
DISPATCH:
If REXX
   If Arexx
      DISPATCH$=DISPATCH$+Upper$(Arexx$(0))+_COMMA$
      Arexx Answer 0,Lower$(_OK$)
   End If 
End If 
If DISPATCH$=_$ Then Return 
Swap P$,DISPATCH$
SEQUENCE=True : MACRO=True
If Fn A1200 : SET$=SETTING$(27) : SETTING$(27)=_FALSE$ : End If : Rem always draw
PT$=T$ : PREALTIME=REALTIME : REALTIME=False
DL=0
Repeat 
   DP=DL+1
   DL=Instr(P$,_COMMA$,DP)
   If DL>0
      T$=Mid$(P$,DP,DL-DP)
      Gosub CMD
   End If 
Until DL=0
T$=PT$ : REALTIME=PREALTIME
If Fn A1200 Then SETTING$(27)=SET$ : Rem always draw
SEQUENCE=False : MACRO=False
P$=_$
Return 
'
'
'  
'***************************************************************************** 
'*memory********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .        :  .,:::::: .        :      ...     :::::::..  -:.     ::-.: 
'    ;;,.    ;;; ;;;;'''' ;;,.    ;;;  .;;;;;;;.  ;;;;``;;;; ';;.   ;;;;'' 
'    [[[[, ,[[[[, [[cccc  [[[[, ,[[[[,,[[     \[[,\[[[,/[[['    '[[,[[[' 
'    $$$$$$$$"$$$ $$""""  $$$$$$$$"$$$$$$,     $$$"$$$$$$c        c$$" 
'   888 Y88" 888o 888oo,_888 Y88" 888o"888,_ _,88P,888b "88bo   ,8P"`
'   MM  M'  "MMMM """"YUMMM  M'  "MMMM  "YMMMMMP" "MMMM   "W"  mM" 
'
'
'
'  
FKEY:
N=C-79
If Fn KEY_SHIFT Then T$="S=" Else T$="B="
T$=T$+Str$(N)-_SPACE$+_COMMA$
If PLYING and CON#>0 and SETTING$(26)<>_FALSE$ : Rem quantizer
   _TOAST$=_$
   T$=T$+_NEWLINE$
   Goto ACTION : Rem on the sequencer 
Else 
   DISPATCH$=DISPATCH$+T$
End If 
Return 
'
BANKMENU:
B=_M2SEL
Goto SETBANK
'
_LAST:
XB=B
Gosub _FINDEMPTY
If B=-1
   B=_FL
Else 
   If B=1 or B=XB
      B=XB
      Return 
   End If 
   Dec B
End If 
Goto SETBANK
'
_PREVIOUS:
If B=1 Then Return 
Dec B
KMUL=(B/10)*10
REQ=True
Goto SETBANK
'
_NEXT:
If B=_FL Then Return 
Inc B
KMUL=(B/10)*10
REQ=True
'  
SETBANK:
Gosub CLRRNG
Gosub RNGSET
If PB=B Then Return 
LB=PB
XR=0 : XR2=0 : LXR=0 : LXR2=0
Gosub RNGC
Gosub SETZN
PB=B : PBANK=B+JB
F$=FB$(B)
Gosub SETPBANK
Gosub SETCORDS
If P_LENGTH=0 and( Fn MONOORSTEREOORQUAD or Fn INVIEW)
   If Fn MULTI
      Gosub CLREMPTY
   Else 
      Gosub CLRPLY
   End If 
End If 
Gosub PBANKLEN
If RENDERING=False
   If SETTING$(27)<>_FALSE$ or STPPED : Rem always draw
      If Fn MULTI
         Gosub R4INSET
      Else 
         Gosub CLRPOS
         RENDERING=True
         Gosub _DRAW
         RENDERING=False
      End If 
   End If 
End If 
Gosub HEADER
Gosub DRWTIME
Goto MAGICWAND
'
_FINDEMPTY:
B=_FL
Repeat 
   SZ=Length(B+JB)
   If SZ>0
      If B=_FL
         B=-1
      Else 
         Inc B
      End If 
      Exit 
   End If 
   Dec B
Until B=0
If B=0 Then Inc B
Return 
'
_FLUSHBUFFERS:
BTXT1$=_CLEAR$ : TXT1$="This will clear" : TXT2$="the variable buffers?" : Gosub _REQUEST
If Not REQ Then Return 
Goto E
'
_INSERT:
XB=B
Gosub _FINDEMPTY
If B=-1
   B=XB
   Goto NOEMPTY
End If 
RENDERING=True
Repeat 
   Gosub _SWAPPREVIOUS
Until B<=XB
RENDERING=False
PB=-1 : Gosub SETBANK
If Fn MULTI Then Gosub CLREMPTY Else Gosub CLRPLY
Goto CLR
'
_REMOVE:
If MACRO
   Gosub _NEW
Else 
   If Not Fn KEY_SHIFT
      BTXT1$="Remove" : TXT1$="Remove the current" : TXT2$="waveform?" : Gosub _REQUEST
      If Not REQ
         Return 
      End If 
   End If 
   MACRO=True : Gosub _NEW : MACRO=False
End If 
Goto _SWAPLAST
'
_ERASEALL:
BTXT1$=_CLEAR$ : TXT1$="This will clear all" : TXT2$="samples and buffers?" : Gosub _REQUEST
If Not REQ Then Return 
Gosub _STOP
Gosub _UNMUTEALL
F$=_$
B=1
Repeat 
   CHAIN$(B)=_$
   Inc B
Until B>_XC
While TBANK>32767
   Dec TBANK
   Erase TBANK
Wend 
B=1
Repeat 
   FB$(B)=_$ : FPATH$(B)=_$
   Gosub _CLEARMETA
   Erase B+JB
   Inc B
Until B>_FL
B=1
Repeat 
   Mid$(MENB$(B),7)=Space$(7)
   Inc B
Until B>10
B=1
Gosub _NORMALPIANO
E:
Gosub _FLUSHLIBS
Gosub _CLEARUNDO
Gosub _CLEARCOPY : Erase CCBANK
Gosub _CLEARWORK
Gosub CLRFILES
BANKNAME$=_$ : PF$=_$ : LF$=_$
Gosub _CLEARSEQUENCE
T$=_$ : S$=_$ : D$=_$
XD=0 : XD2=SCR_W
Gosub RNGC
Gosub SETBANK
Gosub MAGICWAND
If STPPED
   PLYTIME=0 : STPTIME=0
End If 
Gosub _SHOWALL
Goto _TOASTFREE
'
_TOASTFREE:
_TOAST$="Buffer:"+Str$( Fn BUFFER/1000)+_KILO$+_SPACE$ : Goto T0AST
'
_CLEARSEQUENCE:
QF$=_$
Erase(QBANK) : Q_BUF=1024 : Q_START=0 : Q_LENGTH=0 : Q_END=0 : DISPATCH$=_$
Return 
'
SETPBANK:
If Length(PBANK)=0
   FX_LENGTH=0
   P_LENGTH=0
   Return 
End If 
If REALTIME
   FX=P_SWP
   FX_START=FX
   FX_LENGTH=BSIZE
   FXE=FX+BSIZE-_BYPS
Else 
   FX_START=Start(PBANK)+RST
   If RL>Length(PBANK)-RST or RST+RL=0
      FX_LENGTH=Length(PBANK)-RST
   Else If RL<2
      FX_START=Start(PBANK)
      FX_LENGTH=Length(PBANK)
   Else 
      FX_LENGTH=RL
   End If 
   FX=FX_START
   FXE=FX_START+FX_LENGTH-_BYPS
End If 
P_START=Start(PBANK)
P_LENGTH=Length(PBANK)
If Fn STEREO
   P_LENGTH=P_LENGTH/2
Else If Fn QUAD
   P_LENGTH=P_LENGTH/4
End If 
Return 
'
PBANKLEN:
FI=Length(PBANK)
If Fn STEREO
   FI=FI/2
Else If Fn QUAD
   FI=FI/4
End If 
Return 
'
STEREOQUAD:
If Fn STEREO
   RN=0
Else If Fn QUAD
   RN=2
Else 
   Return 
End If 
Gosub _RANGESET
RI=0
If Not _STOP
   Repeat 
      Inc PASS
      RST=RST+P_LENGTH : RFIN=RFIN+P_LENGTH
      Gosub G$
      Inc RI
   Until RI>RN or _STOP
End If 
PASS=0 : _STOP=False
Goto _RANGERESTORE
'
STEREOQUADX2:
If _CHANNELS=2
   RN=1
   TSIZE=Length(WBANK)*2 : Gosub SETTEMP
Else If _CHANNELS=4
   RN=3
   TSIZE=Length(WBANK)*4 : Gosub SETTEMP
Else 
   Return 
End If 
If Errtrap Then Goto NOMEMORY
Copy Start(WBANK),Start(WBANK)+Length(WBANK) To Start(TBANK)
Gosub _RANGESET
RI=1
If Not _STOP
   Repeat 
      Inc PASS
      RST=RST+P_LENGTH : RFIN=RFIN+P_LENGTH
      Gosub G$
      Copy Start(WBANK),Start(WBANK)+Length(WBANK) To Start(TBANK)+(Length(WBANK)*RI)
      Erase WBANK
      Inc RI
   Until RI>RN or _STOP
   Bank Swap TBANK,PBANK
   Erase TBANK
   Dec TBANK
End If 
PASS=0 : _STOP=False
Goto _RANGERESTORE
'
FXBUFFER:
FXBC=0 : TSIZE=FX_BUF*_BYPS
Repeat 
   Gosub SETTEMP
   If Errtrap
      Pop : Goto NOMEMORY
   End If 
   Inc FXBC
Until FXBC=_CH
FXBC=0
Return 
'
FXBUFFERC:
FXBC=_CH
Repeat 
   Dec FXBC
   Gosub CLRTEMP
Until FXBC=0
Return 
'
SETTEMP:
Inc TBANK
Trap Reserve As Work TBANK,TSIZE
Return 
'
CLRTEMP:
Erase(TBANK)
Dec TBANK
Return 
'
SETDEFBANK:
If Length(PBANK)=0
   S_LENGTH=(FREQ*2)*_BYPS
   Trap Reserve As Work PBANK,S_LENGTH
   If Errtrap
      Pop : Goto NOMEMORY
   End If 
   Gosub SETCORDS
End If 
Gosub SETPBANK
If FX_LENGTH<2
   Pop : Goto FLSHSCR
End If 
Goto _UNDOSET
'
