'*macros********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .        :    :::.       .,-:::::::::::::..      ...      .::::::.
'    ;;,.    ;;;   ;;`;;    ,;;;'````' ;;;;``;;;;  .;;;;;;;.  ;;;`    `; 
'    [[[[, ,[[[[, ,[[ '[[,  [[[        \[[[,/[[[' ,[[     \[[,'[==/[[[[, 
'    $$$$$$$$"$$$c$$$cc$$$c $$$        "$$$$$$c   $$$,     $$$  '''    $ 
'   888 Y88" 888o 888   888,`88bo,__,o,,888b "88bo"888,_ _,88P,88b    dP 
'   MM  M'  "MMMM YMM   ""`   "YUMMMMMP"MMMM   "W"  "YMMMMMP"   "YMmMY"
'
'
'
CHECKFX:
C1=1
Repeat 
   C2=1
   Repeat 
      Restore Val(Str$(C1)+Str$(C2))
      Read X$
      If Peek(Varptr(X$)+Len(X$)-3)=CHR_» : Rem no RMENU 
         C3=1
         Repeat 
            Restore Val(Str$(C1)+Str$(C2)+Str$(C3))
            Read X$
            If Len(X$)=0 : Rem hidden items 
               Goto X
            Else 
               C=Peek(Varptr(X$))
               If C<>CHR_MINUS and C<>CHR_NULL
                  X:
                  Read MENFX,C$
                  If C$=T$
                     Return 
                  End If 
               End If 
            End If 
            Inc C3
         Until C=CHR_NULL
         Inc C
      Else 
         C=Peek(Varptr(X$))
         If C<>CHR_MINUS and C<>CHR_NULL
            Read MENFX,C$
            If C$=T$
               Return 
            End If 
         End If 
      End If 
      Inc C2
   Until C=CHR_NULL
   Inc C1
Until C1>_M1
MENFX=False
Return 
'
MACROSET:
If MACRO or _DIRECT=0 Then Return 
Screen Hide 2 : Screen 0
Return 
'
MACRORESTORE:
If MACRO or _DIRECT=0 Then Return 
Screen Show 2 : Screen 2
Return 
'
MACRO:
S$=FMACRO$(_M2SEL-1+MOFF)
MACROP:
If S$<>AUTOEXEC$
   _TOAST$=S$ : Gosub T0AST
End If 
D$=MACRODIR$+S$+".asc"
If Not Exist(D$)
   T$=D$
   If S$=AUTOEXEC$
      Return 
   Else 
      Goto MACROERROR
   End If 
End If 
Gosub _UNDOSET
MACRO=True : _TEXT=True
_MODEP=_MODE
Trap Open In 1,D$
If Errtrap
   F$=D$ : Goto FILEERROR
End If 
If Not _REPEATING
   If Instr(_REPEAT$,S$)=False and MI=-1
      _REPEAT$=_REPEAT$+_SPACE$+S$
   End If 
End If 
I=Lof(1)
If I> Fn BUFFER Then Goto NOSPACE
Inc MI
MN(MI)=I
MACROT$(MI)=Space$(MN(MI))
Sload 1 To Varptr(MACROT$(MI)),MN(MI) : Close 1 : MP(MI)=1
Gosub _COPYCOPY
Repeat 
   MA(MI)=Instr(MACROT$(MI),_NEWLINE$,MP(MI))
   If MA(MI)
      T$=Mid$(MACROT$(MI),MP(MI),MA(MI)-MP(MI))
      _TOAST$=T$
      Gosub CMD
      Gosub T0AST
   End If 
   MP(MI)=MA(MI)+1
   Gosub GVAL
Until Fn KEY_ESC or MA(MI)=False or MP(MI)>=MN(MI)
_MODE=_MODEP
Dec MI
If MI=-1
   Gosub _CLEARCOPY
   Gosub _COPYCOPY
   If Not _REPEATING
      MACRO=False
   End If 
   If _CHOICE=3
      RL=0 : XR=0 : XR2=0
      _CHOICE=False
      Gosub POSCAL
      Gosub HEADERCORDS
   End If 
   _TEXT=False
End If 
Return 
'
_MACROMENU:
MOFF=0
If Exist(MACRODIR$)
   PPROGDIR$=Dir$
   Dir$=MACRODIR$
   MACRODIR$=Dir$
   D$=Dir First$(_$)
   TCOUNT=1
   If D$<>_$
      Repeat 
         I=Len(D$)-9
         Repeat 
            Exit If Peek(Varptr(D$)+I)-CHR_SPACE
            Dec I
         Until I<0
         D$=Upper$(Mid$(D$,2,1))+Mid$(D$,3,I-5)
         If Lower$(D$)<>AUTOEXEC$
            FMACRO$(TCOUNT)=D$
            Inc TCOUNT
         End If 
         D$=Dir Next$
      Until D$=_$ or TCOUNT>_MR : Rem max macros 
      _MRC=TCOUNT
   End If 
   TCOUNT=0
   Dir$=PPROGDIR$
End If 
M:
I=0
Repeat 
   MENM$(I)=Space$(18)
   Mid$(MENM$(I),1)=FMACRO$(I+MOFF)
   Inc I
Until I>_M2-2
Return 
'
MACRODOWN:
If MOFF=_MRC-19 Then Return 
Inc MOFF
Goto M
'
MACROUP:
If MOFF=0 Then Return 
Dec MOFF
Goto M
'  
'
'
'***************************************************************************** 
'*sys************************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .::::::. -:.     ::-.: .::::::. 
'   ;;;`    `;';;.   ;;;;'';;;`    `;
'   '[==/[[[[,   '[[,[[['  '[==/[[[[,
'     '''    $     c$$"      '''    $
'   ,88b    dP   ,8P"`     ,88b    dP
'     "YMmMY"   mM"          "YMmMY" 
'
'
'
'
'
BUILDSTRING:
If Q_POS-Start(QBANK)+Len(T$)>Q_BUF
   Close 1
   Pop : Pop : Goto NOMEMORY
End If 
Poke$ Q_POS,T$ : Add Q_POS,Len(T$)
Return 
'
KEY:
K$=Inkey$
C=Scancode
Return 
'
CLRKEY:
Repeat 
   Gosub KEY
Until C=0
Return 
'
GVAL:
K$=Inkey$
C=Scancode
If C=0 and(Z<ZN_PLAY or Z>ZN_PLAYDISPLAY) Then Gosub TASK
Gosub MKEY
Gosub MPOS
Z=Zone(CX,CY)
If SCR_R=Lowres
   Screen Offset 0,X Mouse-128,
   If _DIRECT
      Trap Screen Offset 2,X Mouse-128,
      If Errtrap
         Rem clear trap 
      End If 
   End If 
End If 
If _DIRECT
   If Fn MOUSEDOWN and((CY>0 and CY<HDR_H) or _DIRECTMOVE)
      CLI_Y=Y Mouse-5
      _DIRECTMOVE=True
      Goto CLISCR
   Else If Fn MOUSEDOWN and((CY>CLI_H-HDR_H and CY<CLI_H) or _DIRECTMOVE2)
      CLI_Y=Y Mouse-(CLI_H-5)
      _DIRECTMOVE2=True
      Goto CLISCR
   Else 
      _DIRECTMOVE=False
      _DIRECTMOVE2=False
   End If 
End If 
Gosub T0AST
S=Key Shift
If S=0 Then _CAPSLOCK=False
'If C=95 : Rem page down / help
'   TXT1$="Screen saved to" : TXT2$="RAM:screen_"+Str$(_GRAB)-_SPACE$+".iff" 
'   Save Iff TXT2$ 
'   Inc _GRAB
'   If _DIRECT 
'      Cleft : Print _SPACE$ : Print TXT1$;_SPACE$;TXT2$ 
'      Pop : Goto ¯LOOP
'   Else 
'      Gosub _NOTICE 
'   End If 
'End If  
Return 
'
MATH:
If Not MATH
   TXT1$="mathtrans.library"
   Trap Lib Open 1,TXT1$,0
   If Errtrap
      TXT2$=_NOTAVAILABLE$ : Goto _ERROR
   Else 
      MATH=True
   End If 
End If 
Return 
'  
BSD:
TXT1$="bsdsocket.library"
Trap Lib Open 2,TXT1$,0
If Errtrap
   If _INIT and Not ABOUT
      TXT2$=_NOTAVAILABLE$ : Gosub _ERROR
      SETTING$(NN)=_FALSE$ : Rem net sync or vst
      Pop : Pop : Goto _OPTIONS
   End If 
Else 
   BSD=True
End If 
Return 
'
_FLUSHLIBS:
If MATH Then Lib Close 1 : MATH=False
If BSD and(NETSYNC or NETVST)=False
   Lib Close 2
   BSD=False
End If 
If PP20 Then Lib Close 3 : PP20=False
If MPEG Then Lib Close 4 : MPEG=False
Return 
'
SETQUAL:
QUAL(B)=_BITS/8 : Rem bytes per sample 
BPS=_BYPS
Return 
'
¯FLOATUNB: CN#=CN : CN#=CN#/256 : Return 
¯FLOATUND: CN#=CN : CN#=CN#/65536 : Return 
¯FLOATUNT: CN#=CN : CN#=CN#/16777216 : Return 
'
¯UNFLOATUNB: CN=Int(CN#*256) : Return 
¯UNFLOATUND: CN=Int(CN#*65536) : Return 
¯UNFLOATUNT: CN=Int(CN#*16777216) : Return 
'
¯PEEK3: CN3=Peek(FX3) : Return 
¯DEEK3: CN3=Deek(FX3) : Return 
¯TEEK3: VN=Varptr(CN3) : Poke VN,0 : Poke VN+1,Peek(FX3) : Poke VN+2,Peek(FX3+1) : Poke VN+3,Peek(FX3+2) : Return 
'
¯PEEK: CN=Peek(FX) : Return 
¯DEEK: CN=Deek(FX) : Return 
¯TEEK: VN=Varptr(CN) : Poke VN,0 : Poke VN+1,Peek(FX) : Poke VN+2,Peek(FX+1) : Poke VN+3,Peek(FX+2) : Return 
'
¯IPB: CN=Peek(FX_START+J) : If CN>127 Then CN=CN-256
CN=CN*255
Return 
¯IPD: CN=Deek(FX_START+J) : If CN>32767 Then CN=CN-65536
Return 
¯IPT: VN=Varptr(CN) : Poke VN,0 : Poke VN+1,Peek(FX_START+J) : Poke VN+2,Peek(FX_START+J+1) : Poke VN+3,Peek(FX_START+J+2) : If CN>8388607 Then CN=CN-16777216
Return 
'
¯SIGNED2B: CN2=Peek(FX2) : If CN2>127 Then Add CN2,-256
¯SIGNEDB: CN=Peek(FX) : If CN>127 Then Add CN,-256
Return 
¯SIGNED2D: CN2=Deek(FX2) : If CN2>32767 Then Add CN2,-65536
¯SIGNEDD: CN=Deek(FX) : If CN>32767 Then Add CN,-65536
Return 
¯SIGNED2T: VN=Varptr(CN2) : Poke VN,0 : Poke VN+1,Peek(FX2) : Poke VN+2,Peek(FX2+1) : Poke VN+3,Peek(FX2+2) : If CN2>8388607 Then Add CN2,-16777216
¯SIGNEDT: VN=Varptr(CN) : Poke VN,0 : Poke VN+1,Peek(FX) : Poke VN+2,Peek(FX+1) : Poke VN+3,Peek(FX+2) : If CN>8388607 Then Add CN,-16777216
Return 
'
¯UNSIGNEDB: CN=Min(127,CN) : CN=Max(-128,CN) : If CN<0 Then Add CN,256
¯POKEFX: Poke FX,CN : Inc FX
Return 
¯UNSIGNEDD: CN=Min(32767,CN) : CN=Max(-32768,CN) : If CN<0 Then Add CN,65536
¯DOKEFX: Doke FX,CN : Add FX,2
Return 
¯UNSIGNEDT: CN=Min(8388607,CN) : CN=Max(-8388608,CN) : If CN<0 Then Add CN,16777216
¯TOKEFX: VN=Varptr(CN) : Poke FX,Peek(VN+1) : Inc FX : Poke FX,Peek(VN+2) : Inc FX : Poke FX,Peek(VN+3) : Inc FX
Return 
'
¯POKEFX2: Poke FX2,CN : Inc FX2 : Return 
¯DOKEFX2: Doke FX2,CN : Add FX2,2 : Return 
¯TOKEFX2: VN=Varptr(CN) : Poke FX2,Peek(VN+1) : Inc FX2 : Poke FX2,Peek(VN+2) : Inc FX2 : Poke FX2,Peek(VN+3) : Inc FX2 : Return 
'
¯UNIPB: CN=CN/255 : CN=Min(127,CN) : CN=Max(-128,CN) : If CN<0 Then CN=CN+256
¯POKEFX3: Poke FX3,CN : Inc FX3
Return 
¯UNIPD: CN=Min(32767,CN) : CN=Max(-32768,CN) : If CN<0 Then CN=CN+65536
¯DOKEFX3: Doke FX3,CN : Add FX3,2
Return 
¯UNIPT: CN=Min(8388607,CN) : CN=Max(-8388608,CN) : If CN<0 Then CN=CN+16777216
¯TOKEFX3: VN=Varptr(CN) : Poke FX3,Peek(VN+1) : Inc FX3 : Poke FX3,Peek(VN+2) : Inc FX3 : Poke FX3,Peek(VN+3) : Inc FX3
Return 
'
¯UNSIGNB: CN=CN/255 : CN=Min(127,CN) : CN=Max(-128,CN) : If CN<0 Then CN=CN+256
Return 
¯UNSIGND: CN=Min(32767,CN) : CN=Max(-32768,CN) : If CN<0 Then CN=CN+65536
Return 
¯UNSIGNT: CN=Min(8388607,CN) : CN=Max(-8388608,CN) : If CN<0 Then CN=CN+16777216
Return 
'
¯POKEPEEKFX3: Poke FX3,Peek(FX) : Inc FX3 : Return 
¯DOKEDEEKFX3: Doke FX3,Deek(FX) : Add FX3,2 : Return 
¯TOKETEEKFX3: Poke FX3,Peek(FX) : Inc FX3 : Poke FX3,Peek(FX+1) : Inc FX3 : Poke FX3,Peek(FX+2) : Inc FX3 : Return 
'
¯FLOAT3B: CN3=Peek(FX3)
If CN3>127 Then CN3=CN3-256
If CN3<0 Then CN3#=128 Else CN3#=127
CN3#=CN3/CN3#
CN2=Peek(FX2)
If CN2>127 Then CN2=CN2-256
If CN2<0 Then CN2#=128 Else CN2#=127
CN2#=CN2/CN2#
Return 
¯FLOAT3D: CN3=Deek(FX3)
If CN3>32767 Then CN3=CN3-65536
If CN3<0 Then CN3#=32768 Else CN3#=32767
CN3#=CN3/CN3#
CN2=Deek(FX2)
If CN2>32767 Then CN2=CN2-65536
If CN2<0 Then CN2#=32768 Else CN2#=32767
CN2#=CN2/CN2#
Return 
¯FLOAT3T: VN=Varptr(CN3) : Poke VN,0 : Poke VN+1,Peek(FX3) : Poke VN+2,Peek(FX3+1) : Poke VN+3,Peek(FX3+2)
If CN3>8388607 Then CN3=CN3-16777216
If CN3<0 Then CN3#=8388608 Else CN3#=8388607
CN3#=CN3/CN3#
VN=Varptr(CN2) : Poke VN,0 : Poke VN+1,Peek(FX2) : Poke VN+2,Peek(FX2+1) : Poke VN+3,Peek(FX2+2)
If CN2>8388607 Then CN2=CN2-16777216
If CN2<0 Then CN2#=8388608 Else CN2#=8388607
CN2#=CN2/CN2#
Return 
'
¯FLOATB: CN=Peek(FX)
If CN>127 Then CN=CN-256
If CN<0 Then CN#=128 Else CN#=127
CN#=CN/CN#
Return 
¯FLOATD: CN=Deek(FX)
If CN>32767 Then CN=CN-65536
If CN<0 Then CN#=32768 Else CN#=32767
CN#=CN/CN#
Return 
¯FLOATT: VN=Varptr(CN) : Poke VN,0 : Poke VN+1,Peek(FX) : Poke VN+2,Peek(FX+1) : Poke VN+3,Peek(FX+2)
If CN>8388607 Then CN=CN-16777216
If CN<0 Then CN#=8388608 Else CN#=8388607
CN#=CN/CN#
Return 
'
¯UNFLOATB: If CN#<0 Then CN=128 Else CN=127
CN=Int(CN#*CN) : CN=Min(127,CN) : CN=Max(-128,CN) : Rem CHECKCLIP
If CN<0 Then CN=CN+256 : Rem UNSIGN 
Poke FX,CN : Inc FX
Return 
¯UNFLOATD: If CN#<0 Then CN=32768 Else CN=32767
CN=Int(CN#*CN) : CN=Min(32767,CN) : CN=Max(-32768,CN) : Rem CHECKCLIP
If CN<0 Then CN=CN+65536 : Rem UNSIGN 
Doke FX,CN : Add FX,2
Return 
¯UNFLOATT: If CN#<0 Then CN=8388608 Else CN=8388607
CN=Int(CN#*CN) : CN=Min(8388607,CN) : CN=Max(-8388608,CN) : Rem CHECKCLIP
If CN<0 Then CN=CN+16777216 : Rem UNSIGN 
VN=Varptr(CN) : Poke FX,Peek(VN+1) : Inc FX : Poke FX,Peek(VN+2) : Inc FX : Poke FX,Peek(VN+3) : Inc FX
Return 
'
FLOATCLIP:
If CN#>1
   CN#=1
Else If CN#<-1
   CN#=-1
End If 
Return 
'
GFXSET:
GFXX=Xgr : GFXY=Ygr
Return 
'
GFXRESTORE:
Gr Locate GFXX,GFXY
Return 
'
MEMORY:
Trap MEMORY=Fast Free+Chip Free
If Errtrap or MEMORY<0 Then MEMORY=Fast Free
Return 
'  
GTASK:
If PLYING
   PTGL=TGL
   Repeat 
   Until TGL<>PTGL
   PTGL=TGL
   Repeat 
   Until TGL<>PTGL
End If 
TASK:
If STPPED Then Multi Wait 
Return 
'
SPIN:
_SPIN=Timer+4 : Repeat : Gosub DISPATCH : Until Timer>_SPIN
Return 
'
TIME_ALL:
If T_LENGTH>0
   DIV#=FREQ
   DIV#=((DIV#/T_LENGTH)*60)*4
   If DIV#<32 or T_MODE>0
      DIV#=FREQ
      DIV#=T_LENGTH/DIV#
      T$=" Secs"
      If DIV#>60
         ADV#=DIV#
         DIV#=DIV#/60
         DIV#=Int(DIV#)
         T$=" Mins"+Str$(Int(ADV#-(DIV#*60)))+T$
      End If 
      If DIV#>60
         ADV#=DIV#
         DIV#=DIV#/60
         DIV#=Int(DIV#)
         T$=" Hrs"+Str$(Int(ADV#-(DIV#*60)))+T$
      End If 
   Else If DIV#>320
      DIV#=FREQ
      DIV#=(T_LENGTH/DIV#)*1000
      T$=" Ms"
   Else 
      T$=_BPM$
   End If 
Else 
   DIV#=0
End If 
Return 
'
TIME_PLY:
If PLYING
   DIV#=(Timer-PLYTIME)/MONHZ#
Else 
   DIV#=(STPTIME-PLYTIME)/MONHZ#
End If 
ADV#=DIV#
DIV#=Int(DIV#/60)
ADV#=ADV#-(DIV#*60)
TIME$=Str$(ADV#)-_SPACE$
If ADV#<10
   TIME$=_FALSE$+TIME$
End If 
ADV#=DIV#
DIV#=Int(DIV#/60)
ADV#=ADV#-(DIV#*60)
TIME$=Str$(ADV#)-_SPACE$+_COLON$+TIME$
If ADV#<10
   TIME$=_FALSE$+TIME$
End If 
TIME$=Str$(DIV#)-_SPACE$+_COLON$+TIME$
If DIV#<10
   TIME$=_FALSE$+TIME$
End If 
Ink _BLACK,_WHITE
Text 320,104,Left$(TIME$,11)
Return 
'
_TOASTTIME:
TSIZE=12 : Gosub SETTEMP
Dreg(1)=Start(TBANK)
N=Doscall(-192) : Rem _LVODateStamp
I=Leek(Dreg(1)+4)
N=I/60 : S$=Mid$(Str$(N),2) : Rem hours
If Len(S$)<2 Then S$="0"+S$
T$=S$
N=I mod 60 : S$=Mid$(Str$(N),2) : Rem minutes
If Len(S$)<2 Then S$="0"+S$
T$=T$+_COLON$+S$
I=Leek(Dreg(1)+8)
N=I/50 : S$=Mid$(Str$(N),2) : Rem seconds
If Len(S$)<2 Then S$="0"+S$
T$=T$+_COLON$+S$
Gosub CLRTEMP
_TOAST$=Space$(15)+T$+_SPACE$ : Gosub T0AST
Return 
'
SETRND:
Gosub SETDEFBANK
If PASS=0 Then Randomize Timer
A0=1
I=1
Repeat 
   A0=A0*256
   Inc I
Until I>_BYPS
A1=A0/2
Return 
'
'
'
'***************************************************************************** 
'*mouse*********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .        :      ...      ...    ::: .::::::. .,:::::: 
'    ;;,.    ;;;  .;;;;;;;.  ';;     ;;;;;;`    `;;;;;'''' 
'    [[[[, ,[[[[,,[[     \[[,[['     [[['[==/[[[[, [[cccc  
'    $$$$$$$$"$$$$$$,     $$$$$      $$$  '''    $ $$""""  
'   888 Y88" 888o"888,_ _,88P88    .d888,88b    dP 888oo,_ 
'   MM  M'  "MMMM  "YMMMMMP"  "YmmMMMM""  "YMmMY"  """"YUM 
'
'
'
SETZN:
If RL<2
   Set Zone ZN_LEFTRANGESPACE,0,HDR_H To SCR_W,POS_B
   I=ZN_LEFTRANGE : N=ZN_RIGHTRANGESPACE : Goto RESETZN
Else If XR>1 and XR2>0
   Set Zone ZN_LEFTRANGESPACE,0,HDR_H To XR-1,POS_B
   Set Zone ZN_LEFTRANGE,XR,RNG_T+HDR_H To XR+12,RNG_B+HDR_H-1
   If XR+24<XR2
      Set Zone ZN_MIDDLERANGESPACE,XR+12,HDR_H To XR2-12,POS_B
   Else 
      Reset Zone ZN_MIDDLERANGESPACE
   End If 
   If XR2>12 and XR2<SCR_W
      Set Zone ZN_RIGHTRANGE,XR2-12,RNG_T+HDR_H To XR2+1,RNG_B+HDR_H-1
   Else 
      If RFIN-FIN=0
         If XR<614
            Set Zone ZN_MIDDLERANGESPACE,XR+12,HDR_H To 626,POS_B
         Else 
            Reset Zone ZN_MIDDLERANGESPACE
         End If 
         Set Zone ZN_RIGHTRANGE,627,RNG_T+HDR_H To SCR_W,RNG_B+HDR_H-1
      Else 
         Reset Zone ZN_RIGHTRANGE
      End If 
   End If 
   Set Zone ZN_RIGHTRANGESPACE,0,HDR_H To SCR_W,POS_B
Else If XR=0 and XR2>0 and XR2<25
   Reset Zone ZN_LEFTRANGESPACE
   Set Zone ZN_LEFTRANGE,0,RNG_T+HDR_H To 6,RNG_B+HDR_H-1
   Reset Zone ZN_MIDDLERANGESPACE
   Set Zone ZN_RIGHTRANGE,6,RNG_T+HDR_H To 12,RNG_B+HDR_H-1
   Set Zone ZN_RIGHTRANGESPACE,0,HDR_H To SCR_W,POS_B
Else If XR=0 and XR2>24 and XR2<SCR_W-2
   Reset Zone ZN_LEFTRANGESPACE
   If RST-ST=0
      Set Zone ZN_LEFTRANGE,0,RNG_T+HDR_H To 12,RNG_B+HDR_H-1
      Set Zone ZN_MIDDLERANGESPACE,12,HDR_H To XR2-12,POS_B
   Else 
      Reset Zone ZN_LEFTRANGE
      Set Zone ZN_MIDDLERANGESPACE,0,HDR_H To XR2-12,POS_B
   End If 
   Set Zone ZN_RIGHTRANGE,XR2-12,RNG_T+HDR_H To XR2+1,RNG_B+HDR_H-1
   Set Zone ZN_RIGHTRANGESPACE,0,HDR_H To SCR_W,POS_B
Else If XR2>0
   Reset Zone ZN_LEFTRANGESPACE
   Set Zone ZN_LEFTRANGE,0,RNG_T+HDR_H To 12,RNG_B+HDR_H-1
   Set Zone ZN_MIDDLERANGESPACE,13,HDR_H To 628,POS_B
   If((RFIN/CON#)-(FIN/CON#))<1
      Set Zone ZN_RIGHTRANGE,628,RNG_T+HDR_H To SCR_W,RNG_B+HDR_H-1
   Else 
      Reset Zone ZN_RIGHTRANGE
      If RST-ST=0
         Set Zone ZN_MIDDLERANGESPACE,13,HDR_H To SCR_W,POS_B
      Else 
         Set Zone ZN_MIDDLERANGESPACE,0,HDR_H To SCR_W,POS_B
      End If 
   End If 
   Set Zone ZN_RIGHTRANGESPACE,0,HDR_H To SCR_W,POS_B
End If 
Return 
'
RESETZN:
Repeat 
   Reset Zone I
   Inc I
Until I>N
Return 
'
TESTMOVE:
Gosub MPOS : PX=CX : PY=CY
Gosub MKEY : MK=M
Repeat 
   Gosub DISPATCH
   Gosub GVAL
Until Fn KEY_PRESS or MK-M or CY-PY or CX-PX
Return 
'
MUP:
Repeat 
   Gosub TASK
   Gosub MKEY
Until Fn MOUSEUP
Return 
'
MKEY:
M=Mouse Key
If M=4
   M=0 : Rem mouseup
Else If M=5 or Fn KEY_LEFTAMIGAALT : Rem emulate standard amiga keyboard mouse
   M=1 : Rem mousedown
Else If Fn KEY_RIGHTAMIGAALT : Rem emulate standard amiga keyboard mouse
   M=2 : Rem mousemenu
End If 
Return 
'
MPOS:
If S>0
   If C>75 and C<80 : Rem emulate standard amiga keyboard mouse
      If( Fn KEY_LEFTAMIGA or Fn KEY_RIGHTAMIGA or Fn KEY_LEFTAMIGAALT or Fn KEY_RIGHTAMIGAALT)
         If Fn KEY_UP
            Y Mouse=Y Mouse-1
         Else If Fn KEY_DOWN
            Y Mouse=Y Mouse+1
         Else If Fn KEY_RIGHT
            X Mouse=X Mouse+1
         Else If Fn KEY_LEFT
            X Mouse=X Mouse-1
         End If 
      End If 
   End If 
End If 
CX=X Screen(X Mouse)
CY=Y Screen(Y Mouse)
Return 
'
MCOL:
Palette ,,,,,,,,,,,,,,,,,$DDD,$E11,$111
Return 
'
SLOW:
If CX<PX Then X Mouse=X Mouse+1 Else X Mouse=X Mouse-1
Return 
'
STICKY:
If CY<PY Then Y Mouse=Y Mouse+(PY-CY) Else Y Mouse=Y Mouse-(CY-PY)
If CX<PX Then X Mouse=X Mouse+((PX-CX)/2) Else X Mouse=X Mouse-((CX-PX)/2)
Return 
'
'
'
'***************************************************************************** 
'*choice********************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'     .,-::::::  ::   .:     ...      :::    .,-::::::.,:::::: 
'   ,;;;'````'  ,;;   ;;, .;;;;;;;.   ;;;  ,;;;'````' ;;;;'''' 
'   [[[        ,[[[,,,[[[,[[     \[[, [[[  [[[         [[cccc  
'   $$$        "$$$"""$$$$$$,     $$$ $$$, $$$         $$""""  
'   `88bo,__,o, 888   "88"888,_ _,88Po88888`88bo,__,o, 888oo,_ 
'     "YUMMMMMP MMM    YM  "YMMMMMP" MMM"MM  "YUMMMMMP """"YUM 
'
'
'
MCHOOSE:
_CHOICE=False
If G$=_$ Then Return 
If MENFX
   If Fn KEY_SHIFT
      Trap Restore G$+"P"
      If Errtrap=41 : Rem no data after label error means the named subroutineP exists 
         _SHIFTSELECT=True
         Gosub _UNDOSET
         MACRO=True
      End If 
   End If 
   If RL=0
      If MENFX=1 : Rem process as mono (resample, convert etc.) 
      Else If MENFX=-1 : Rem split and process stereo quad
         RL=P_LENGTH
         _CHOICE=3
      End If 
   End If 
End If 
_REPEATP$=_REPEAT$
S$=M$
If G$="_UNDO"
   _REPEAT$=_REPEATP$
Else If Peek(Varptr(G$))=CHR_TOPSCORE
   _REPEAT$=_$
Else 
   _REPEAT$=G$
End If 
_REDRAW=_REPEAT$=_MACRO$
If MENFX Then Gosub SETREALTIME
Gosub G$
If _REDRAW
   MENFX=True : REQ=True
Else If MENFX and RL>1
   Gosub STEREOQUAD
End If 
If MENFX
   If _CHOICE=3
      RL=0 : XR=0 : XR2=0
      _CHOICE=False
      Gosub POSCAL
      Gosub HEADERCORDS
   End If 
   If REQ or FX=>FXE
      Gosub _DRAWALL
      Gosub HIGHPIANO
   End If 
End If 
If Right$(_REPEAT$,4)<>_MENU$ and REQ
   _TOAST$=_TOAST$+_REPEAT$
End If 
If _SHIFTSELECT
   MACRO=False
   _SHIFTSELECT=False
End If 
If _M0=0 Then Goto CAL_BCK
Return 
'
BCHOOSE:
On Z Goto _START,_RANGE
If CX=SCR_W : Rem mouse zone does not allow 640  
   If CY>HDR_H and CY<CTL_Y
      If XR2=SCR_W
         Z=ZN_RIGHTRANGE
      Else 
         Z=ZN_RIGHTRANGESPACE
      End If 
   End If 
End If 
If Z=ZN_OSCCLOSE
   Goto _TGLOSCILLOSCOPE
Else If Z=ZN_OSCMODE
   Goto _TGLOSCILLOMODE
Else If Z=ZN_CALCLOSE
   Goto _TGLCALCULATOR
End If 
If CALC
   If CX>CAL_X and CX<CAL_W and CY>CAL_Y and CY<CAL_Y+CAL_H
      Goto CAL_DRW : Rem protect range beneath  
   End If 
End If 
If RENDERING Then Goto DRWDIALS
If Z>=ZN_PLAY and Z<ZN_PLAY+_AB+1
   PZN=Z : Gosub PRESSBTN
   If Not _ON
      Return 
   End If 
End If 
If Z=ZN_PLAY and PLYING and CX>BUTX(0)+(BUT_W/2) : Rem half button
   _TOAST$="_STOP"
   Goto _STOP
Else If Z=ZN_TOAST
   N=24 : Gosub SETSET : Gosub MUP
Else If Z=ZN_TIME
   If Not _REC
      If T_MODE=0
         T_MODE=1
      Else 
         T_MODE=0
      End If 
   End If 
   Gosub MUP
   _TIMEONLY=True : Goto DRWTIMENOW
Else If Z>0
   If P_LENGTH=0 and Fn MONOORSTEREOORQUAD and Z<>ZN_PASTE
      Goto FLSHSCR
   End If 
End If 
If Z>0
   On Z-(ZN_LEFTWAND-1) Goto LEFTWAND,RIGHTWAND,MOVEWAND,RANGE,SELLEFT,RANGE,SELRIGHT,RANGE
   If Z<ZN_PLAY+_AB+1
      G$=BUTG$(Z-ZN_PLAY)
      If Z=ZN_MIX and RL=0 : Rem stereo quad
         _CHOICE=3
         RL=P_LENGTH
      End If 
      Gosub G$
      If Z=ZN_MIX
         Gosub STEREOQUAD
         If _CHOICE=3
            RL=0
            _CHOICE=False
         End If 
      End If 
      If Z=ZN_MIX or Z=ZN_REPEAT
         Gosub _DRAWALL
      End If 
      _TOAST$=G$
   End If 
End If 
Goto DRWDIALS
'
KCHOOSE:
If _DEBUG and Fn KEY_PRESS
   _TOAST$=_TOAST$+"Chr("+Str$(C)-_SPACE$+")" : Gosub T0AST
End If 
If PK>0
   KI=PK-1
   Repeat 
      If C=PKC(KI)
         If S=PKS(KI) or S=PKS(KI)+1 or S=PKS(KI)+4 : Rem KEY_SHIFT KEY_CAPSLOCK     
            If Fn KEY_LEFTAMIGA and REALTIME
               Return 
            End If 
            DL=0
            Repeat : Rem dont merge in dispatch as can cause stack overflow 
               DP=DL+1
               DL=Instr(PK$(KI),_COMMA$,DP)
               If DL>0
                  DCN=0
                  T$=Upper$(Mid$(PK$(KI),DP,DL-DP))
                  ACTION=True
                  MACRO=True
                  Gosub CMD
                  MACRO=False
                  ACTION=False
               End If 
            Until DL=0
            Return 
         End If 
      End If 
      Dec KI
   Until KI<0
End If 
If C<7 and Fn KEY_LEFTAMIGA : Rem 1 2 3 4 5 6  
   If Not RENDERING
      _M3SEL=C
      Gosub M0DEMENU
   End If 
Else If C=74 : Rem numpad - 
   Goto _PREVIOUS
Else If C=94 : Rem numpad + 
   Goto _NEXT
Else If C=15 : Rem numpad 0 
   If B>10
      C=C+64+KMUL
      Goto FKEY
   End If 
Else If C>28 and C<32 : Rem numpad 1 2 3 
   C=C+51+KMUL
   Goto FKEY
Else If C>44 and C<48 : Rem numpad 4 5 6 
   C=C+38+KMUL
   Goto FKEY
Else If C>60 and C<64 : Rem numpad 7 8 9 
   C=C+25+KMUL
   Goto FKEY
Else If C>79 and C<90 : Rem function keys
   Goto FKEY
Else If Fn MOUSEWHEELUP or Fn MOUSEWHEELDOWN
   Goto WHEELZOOM
Else If Fn KEY_PRESS and Not Fn KEY_LEFTAMIGA
   If Not Fn KEY_CURSOR
      If P_LENGTH=0
         Goto FLSHSCR
      End If 
   End If 
   Gosub PIANO
   If KEYC<>-1
      _TOAST$=KEYS$
      If PIANO
         If PLYING
            If Fn MULTIINVIEW
               I=B
            Else 
               I=1
            End If 
            OFFSET=OFFSET(I)
            If OFFSET>=P_LENGTH
               OFFSET=0
            End If 
         Else 
            OFFSET=RST
         End If 
         G$="_RENDER"
         If PLYING and CON#>0 and SETTING$(26)<>_FALSE$ : Rem quantizer
            T$="N="+KEYS$+_COMMA$+G$+_COMMANEWLINE$
            Goto ACTION
         Else 
            Gosub G$
            Goto STEREOQUAD
         End If 
      Else 
         If FREQ<>KEYF
            FREQ=KEYF
            Gosub SETHZ
            Gosub DIALMAIN
            If RENDERING
               Gosub DRWTIMENOW
            End If 
         End If 
         If _PORTA=False or PLYING=False
            If RL>0 and RNGEPLY
               Goto _PLAYRANGE
            Else If DISPPLY
               Goto _PLAYDISPLAY
            Else 
               Goto _PLAY
            End If 
         End If 
      End If 
   End If 
End If 
Return 
'
ACTION:
SZ=Len(T$)
If Q_START<Q_END
   N=Hunt(Q_START To Q_END,_NEWLINE$)
   If N=0
      Q_START=Start(QBANK)
      Poke$ Q_START,T$
      Q_LENGTH=SZ
      Q_END=Q_START+Q_LENGTH
   Else If N=Q_END
      Poke$ Q_END,T$
      Add Q_END,SZ
      Add Q_LENGTH,SZ
   Else 
      Copy N,Q_END To N+SZ
      Poke$ N,T$
      Add Q_END,SZ-1
      Add Q_LENGTH,SZ-1
   End If 
Else 
   Q_START=Start(QBANK)
   Poke$ Q_START,T$
   Q_LENGTH=SZ
   Q_END=Q_START+Q_LENGTH
End If 
SBEAT=Int(POS#/(SCR_W/_TIMEDIV#))
Return 
'
PIANO:
If Fn KEY_CAPSLOCK Then Restore KLO Else Restore KHI
Repeat 
   Read KEYC,KEYS$,KEYF
   If KEYC=C
      Return 
   End If 
Until KEYC=-1
Return 
'
ZCHOOSE:
If PZ=ZN_LEFTRANGE
   Gosub UNR0LLLEFT
   PZ=0
Else If PZ=ZN_RIGHTRANGE
   Gosub UNR0LLRIGHT
   PZ=0
Else If Z=ZN_LEFTRANGE
   Gosub R0LLLEFT
   PZ=Z
Else If Z=ZN_RIGHTRANGE
   Gosub R0LLRIGHT
   PZ=Z
End If 
Return 
'
'
'
'***************************************************************************** 
'*menu************************************************************************ 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'    .        :  .,::::::::.    :::. ...    :::  
'    ;;,.    ;;; ;;;;'''';;;;,  `;;;';;     ;;;  
'    [[[[, ,[[[[, [[cccc  [[[[[. '[[[['     [[[  
'    $$$$$$$$"$$$ $$""""  $$$ "Y$c$$$$      $$$  
'   888 Y88" 888o 888oo,_888    Y88 88    .d888    
'   MM  M'  "MMMM """"YUMMM     YM   "YmmMMMM""    
'
'
'  
INITMENU:
_BAR$=String$(_MINUS$,14)
_OTHERBAR$=String$(Chr$(CHR_OTHERMINUS),19) : Mid$(_OTHERBAR$,9,3)=Space$(3)
_MACRO$="MACRO" : _MENU$="MENU"
BANKMENU$="BANK"+_MENU$
M0DEMENU$="M0DE"+_MENU$
RATEMENU$="RATE"+_MENU$
SWPMENU$="SWP"+_MENU$
RECMENU$="Record     »  "
_RECORD$=RECMENU$
If Not Fn A1200
   _OSCILLOSCOPE$="Oscilloscope  "
   _8CH$="8ch   "
   _16CH$="16ch  "
Else 
   _OSCILLOSCOPE$=_NULL$
   _8CH$=_NULL$
   _16CH$=_NULL$
End If 
M2=1 : I=9
Repeat 
   MENB$(M2)="F"+Str$(M2)-_SPACE$+" -"+Space$(I)
   Inc M2
   If M2=10
      Dec I
   End If 
Until M2>10
Return 
'
DRWMENU:
If CX=0 Then Return 
If Not _MENUDO
   _MENUDO=True
   _M1SEL=0 : _M2SEL=0 : _M3SEL=0
   If Not RENDERING
      Gosub NUDGEPOS
   End If 
   Gosub CLRPOS
End If 
If _MENUSUB
   Restore Val(Str$(_M0+M1)+Str$(M2-2))
   Gosub RMENU
   If _M1SEL=0 or CY<HDR_H+1 or CX<MENX(_M1SEL-1) or(CX>MENX(_M1SEL-1)-8 and CX<MENX(_M1SEL-1)+Text Length(_BAR$)-16 and((CY-5)/8)-_M2SEL)
      _MENUSUB=False
      _M3SEL=0
      If CY<HDR_H+1
         _MENUDRW=True
      Else 
         MENH=0
         _MENUDRW=False
      End If 
      _MENUBOX=True
      Gosub CLRMENU
      Goto M0
   End If 
   If _MENUSUB
      _PM3SEL=_M3SEL
      If CX<SUBX or CX>SUBX+SUBW or CY>SUBY+SUBH
         _M3SEL=0
      Else 
         _M3SEL=(CY-8)/8-_M2SEL+1
      End If 
      Restore Val(Str$(_M0+M1)+Str$(_M2SEL))
      Gosub RMENU
      _L2=(MENX(M1-1)/8+Len(M$))-4
      SUBX=(_L2*8)
      SUBY=(_M2SEL*8)-3
      M3=1
      SZ=1
      Repeat 
         Restore Val(Str$(_M1SEL)+Str$(_M2SEL)+Str$(M3))
         Gosub RMENU
         If M3=1
            SUBW=Text Length(M$)+4
         End If 
         V=Peek(Varptr(M$)+1)
         If V<>CHR_NULL and V-CHR_MINUS
            If _M3SEL=M3
               If _PM3SEL-_M3SEL
                  If _LIGHTMODE
                     Ink _BLACK,_PANE
                  Else 
                     Ink _WHITE,_BLACK
                  End If 
                  Goto M1
               End If 
            Else If _PM3SEL=M3
               If _LIGHTMODE
                  Ink _BLACK,_SHADOW
               Else 
                  Ink _BLACK,_WHITE
               End If 
               Goto M1
            End If 
         End If 
         If SUBH=0
            If _M3SEL-M3
               If _LIGHTMODE
                  Ink _BLACK,_SHADOW
               Else 
                  Ink _BLACK,_WHITE
               End If 
            Else 
               If _LIGHTMODE
                  Ink _BLACK,_PANE
               Else 
                  Ink _WHITE,_BLACK
               End If 
            End If 
            If Len(M$)>1
               M1:
               Inc SZ
               Text _L2*8+2,(_M2SEL+M3-1)*8+14,M$
            End If 
         End If 
         Inc M3
      Until V=CHR_NULL
   End If 
   If SUBH=0
      SUBH=SZ*8
   End If 
   Ink _BLACK
   Box SUBX,SUBY+9 To SUBX+SUBW-1,SUBY+SUBH+4
   If _LIGHTMODE
      Ink _SHADOW
   Else 
      Ink _WHITE
   End If 
   Box SUBX+1,SUBY+10 To SUBX+SUBW-2,SUBY+SUBH+3
   Goto TESTMOVE
End If 
M0:
If _MENUON and _MENUDO
   If CY<HDR_H
      If _M0>0
         M1=1
      Else 
         M1=_M1
      End If 
      While M1
         Exit If CX>=MENX(M1-1) and CX<=MENX(M1)
         Dec M1
      Wend 
      _M1SEL=M1
   Else If _M1SEL=0
      M1=0
   End If 
   If M1>_M1 or M1=0
      Return 
   End If 
   If _PM1SEL>0 and _PM1SEL-_M1SEL
      Gosub CLRMENU
   End If 
   _PM1SEL=_M1SEL
   _PM2SEL=_M2SEL
   _M2SEL=(CY-5)/8
   Restore _M0+M1
   Read M$
   If CY<HDR_H+2 or _M2SEL>M2-2 or CX<MENX(M1-1) or CX>(MENX(M1-1)+(Len(_BAR$)*8))
      _M2SEL=0
      _MENUDRW=False
   End If 
   _L1=(MENX(M1)/8)-Len(M$)
   MENX=(_L1*8)+2
   MENY=2
   M2=1
   SZ=1
   Repeat 
      If M1=3 and M2>10 : Rem menu collision 
         If M2=11
            M$=_SPACE$+_BAR$+_SPACE$
         Else If M2=12
            M$=" Reverse        "
         Else If M2=13
            M$=" Invert         "
         Else 
            M$=_NULL$
         End If 
      Else If M1=4 and M2>10 : Rem menu collision 
         M$=_NULL$
      Else 
         Restore Val(Str$(_M0+M1)+Str$(M2))
         Gosub RMENU
         If M2=1
            MENW=Text Length(M$)+4
            If _LIGHTMODE
               Ink _SHADOW
            Else 
               Ink _WHITE
            End If 
            Draw MENX+1,MENY+9 To MENX+MENW-2,MENY+9
            Draw MENX+1,MENY+10 To MENX+MENW-2,MENY+10
         End If 
      End If 
      V=Peek(Varptr(M$)+1)
      If _M2SEL=M2 and V-CHR_MINUS
         If _PM2SEL-_M2SEL
            If _LIGHTMODE
               Ink _BLACK,_PANE
            Else 
               Ink _WHITE,_BLACK
            End If 
            _SPIN=0
            Text MENX+2,(M2*8)+MENY+9,M$
         End If 
         If Peek(Varptr(M$)+Len(M$)-5)=CHR_» : Rem RMENU
            _MENUSUB=True
         End If 
         If V=CHR_OTHERMINUS
            Read MENFX,G$
            If _SPIN>0
               Gosub G$
               Repeat 
                  Gosub TASK
                  Gosub MKEY
                  Gosub DISPATCH
               Until Timer>_SPIN or Fn MOUSEUP
            End If 
            Gosub DRWMENUGFX
            Gosub SPIN
            _SPIN=Timer+8
            _MENUDRW=True
         Else 
            _MENUDRW=False
            _SPIN=0
         End If 
      Else If _PM2SEL=M2
         If _LIGHTMODE
            Ink _BLACK,_SHADOW
         Else 
            Ink _BLACK,_WHITE
         End If 
         _SPIN=0
         Text MENX+2,(M2*8)+MENY+9,M$
         Gosub DRWMENUGFX
      End If 
      If MENH=0 or _MENUDRW
         If _M2SEL-M2 or C=CHR_MINUS
            If _LIGHTMODE
               Ink _BLACK,_SHADOW
            Else 
               Ink _BLACK,_WHITE
            End If 
         Else 
            If _LIGHTMODE
               Ink _BLACK,_PANE
            Else 
               Ink _WHITE,_BLACK
            End If 
         End If 
         If Len(M$)>1
            Inc SZ
            Text MENX+2,(M2*8)+MENY+9,M$
         End If 
         Gosub DRWMENUGFX
      End If 
      Inc M2
   Until Peek(Varptr(M$))=CHR_NULL
   If MENH=0
      _MENUBOX=True
   Else 
      _MENUBOX=False
   End If 
   If MENH=0
      MENH=SZ*8
   End If 
   If _MENUBOX
      If _LIGHTMODE
         Ink _SHADOW
      Else 
         Ink _WHITE
      End If 
      Gr Locate MENX+MENW-2,MENY+11
      Draw To MENX+MENW-2,MENY+MENH+3 : Draw To MENX+1,MENY+MENH+3 : Draw To MENX+1,MENY+11
      Ink _BLACK
      Gr Locate MENX+MENW-1,MENY+9
      Draw To MENX+MENW-1,MENY+MENH+4 : Draw To MENX,MENY+MENH+4 : Draw To MENX,MENY+9
   End If 
   If _MENUSUB=False and _MENUDRW=False and _M0=0
      Gosub TESTMOVE
   End If 
End If 
If Not _MENUON
   Gosub R4INRESTORE
   If OSCILLO and RENDERING=False
      Gosub _SHOWCOPY
   End If 
   If _LIGHTMODE
      Ink _SHADOW
   Else 
      Ink _WHITE
   End If 
   Bar 0,0 To SCR_W,10
   If _LIGHTMODE
      Ink _BLACK,_SHADOW
   Else 
      Ink _BLACK,_WHITE
   End If 
   M1=1
   Repeat 
      Restore _M0+M1
      Read M$
      C=Peek(Varptr(M$))
      If C<>CHR_NULL
         MENX(M1)=Text Length(M$)+MENX(M1-1)
         Text MENX(M1-1)+7,8,M$
         Inc M1
      End If 
   Until C=CHR_NULL
   _MENUON=True
End If 
Return 
'
DRWMENUGFX:
If Peek(Varptr(M$)+1)=CHR_OTHERMINUS
   If M2>1
      _BOB=6
   Else 
      _BOB=5
   End If 
   If Not _LIGHTMODE
      If _M2SEL=M2
         Add _BOB,2
      End If 
   End If 
   Paste Bob MENX-8+MENW/2,M2*8+5,_BOB
End If 
Return 
'
RMENU:
Read M$
If Len(M$)>1
   C=Peek(Varptr(M$))
   If C=CHR_MINUS or C=CHR_OTHERMINUS
      M$=_SPACE$+M$+_SPACE$
   Else 
      M$=_SPACE$+M$+_SPACER$
   End If 
End If 
Return 
'  
DRWMENUC:
If _M1SEL>0
   M$=Str$(_M0+_M1SEL)+Str$(_M2SEL)
   If _M3SEL>0
      M$=M$+Str$(_M3SEL)
   End If 
   If _M2SEL>0
      Restore Val(M$)
      Read M$
      C=Peek(Varptr(M$))
      If C=CHR_MINUS or Peek(Varptr(M$)+Len(M$)-3)=CHR_»
         MENFX=False : G$=_$
      Else If _M1SEL=3 and _M2SEL=12 : Rem menu collision 
         MENFX=True
         G$="_REVERSE"
      Else If _M1SEL=3 and _M2SEL=13 : Rem menu collision 
         MENFX=True
         G$="_INVERT"
      Else If _M1SEL=4 and _M2SEL=11 : Rem menu collision 
         MENFX=False
         G$=_NULL$
      Else If C<>CHR_NULL
         Read MENFX,G$
      End If 
   Else 
      M$=_$ : MENFX=False : G$=_$
   End If 
   _CHOICE=True
End If 
If Fn MULTI and _M0=0 Then Gosub R4INSET
Gosub CLRMENU
_MENUON=False : _MENUDO=False : _MENUSUB=False
Goto HEADER
'
CLRMENU:
If MENH>8
   SCRX=MENX : SCRY=MENY
   SCRW=MENW : SCRH=MENH
   Gosub BACKCOPY
End If 
MENH=0
If SUBH>0
   SCRX=SUBX : SCRY=SUBY
   SCRW=SUBW : SCRH=SUBH
   Gosub BACKCOPY
End If 
SUBH=0
Goto HIGHPIANO
'
M0DEMENU:
If _8CH or _16CH
   If(_M3SEL=5 and _8CH) or(_M3SEL=6 and _16CH)
      Goto _TOASTMODE
   End If 
Else If _M3SEL=_MODE and _TEXT=False
   Goto _TOASTMODE
End If 
If _REC Then Gosub _TGLRECORD
Gosub SETVOL
If _M3SEL<4 and Fn MONOORSTEREOORQUAD
   Gosub _RANGENONE
Else If _M3SEL>3 and Fn MONOORSTEREOORQUAD
   If Fn STEREOORQUAD
      Gosub _RANGENONE
   Else If Not Fn INVIEW
      Gosub _RANGENONE
   End If 
   Gosub CLRPLY
   Gosub R4INSET
   If Fn INVIEW and P_LENGTH>0
      Swap ADVPOS#(B),ADVPOS#(1)
      Swap XP(B),XP(1)
      Swap XP2(B),XP2(1)
      Swap OFFSET(B),OFFSET(1)
   End If 
Else If Fn MULTI and _M3SEL<4
   If _M3SEL>1 : Rem STEREO QUAD  
      Gosub _RANGENONE
   End If 
   Gosub CLRPLY
   Gosub R4INRESTORE
   Gosub CHECKMUTE
   If C and B>_CH
      Goto U
   Else If C=0 and B>_CH
      Goto V
   Else If C and MUTE(B)=False
      V:
      I=0
      Repeat 
         MUTE(I)=0
         Inc I
      Until I>_CH
      Volume PAULA(_AP),VOL
      _DIAL=1 : _ROT(_DIAL)=0 : Gosub DIALHIGH
   Else If C<>0
      U:
      I=0
      Repeat 
         MUTE(I)=-1
         Inc I
      Until I>_CH
      Volume PAULA(_AP),0
   End If 
   _ROT(_DIAL)=C<>0
End If 
_MODE=_M3SEL
If(_8CH or _16CH) and _M3SEL<5
   _8CH=False : _16CH=False : _INIT=False : TGLINIT=True
   If NETVST and PLYING
      Gosub SOCK_SENDVSTUP
   End If 
   N=0 : Gosub SETMUTE
   DISPATCH$="CLRPLY,"
   If _DIRECT
      Pop 
   End If 
   Pop : Goto _INIT
End If 
If _M3SEL>4
   _MODE=4 : Rem multi      
   If _M3SEL=5 : Rem 8 channel
      _8CH=True : _16CH=False
   Else If _M3SEL=6 : Rem 16 channel 
      _16CH=True : _8CH=False
   End If 
   _INIT=False : TGLINIT=True
   If NETVST and PLYING
      Gosub SOCK_SENDVSTUP
   End If 
   N=VOL : Gosub SETMUTE : Rem digital mute 
   If _DIRECT
      Pop 
   End If 
   Pop : Goto _INIT
End If 
Gosub _TOASTMODE
If NETVST and PLYING Then Gosub SOCK_SENDVSTUP
Gosub PBANKLEN
Gosub SETPBANK
Gosub RNGSET
Gosub _DRAWALL
Gosub SETCORDS
Gosub DRWTIME
Goto HEADERCORDS
'
_14BIT:
_14BITMENU:
Volume PAULA(_AP-1),1
_TOAST$="14bit"
Return 
'
_TOASTMODE:
If Fn MONO
   _TOAST$=_TOAST$+"Mono"
   _CHANNELS=1
Else If Fn STEREO
   _TOAST$=_TOAST$+"Stereo"
   _CHANNELS=2
Else If Fn QUAD
   _TOAST$=_TOAST$+"Quad"
   _CHANNELS=4
Else If _8CH
   _TOAST$=_TOAST$+"8 Channel"
   _CHANNELS=8
Else If _16CH
   _TOAST$=_TOAST$+"16 Channel"
   _CHANNELS=16
Else 
   _TOAST$=_TOAST$+"4 Channel"
   _CHANNELS=1
End If 
Goto T0AST
'
RATEMENU:
T$=M$
Gosub ¯FREQ
RENDERING=False
Return 
'
'
'
'***************************************************************************** 
'*windows********************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'.::    .   .:: :::  ::.    :::.::::::-.      ...     .::    .   .:: .::::::.  
'';;,  ;;  ;;;' ;;;  ;;;;,  `;;;;;,   `';, .;;;;;;;.  ';;,  ;;  ;;;';;;`    `; 
' '[[, [[, [['  [[[   [[[[[. '[[`[[     [[,[[     \[[, '[[, [[, [[' '[==/[[[[, 
'   Y$c$$$c$P   $$$,  $$$ "Y$c$$ $$,    $$$$$,     $$$   Y$c$$$c$P    '''    $ 
'    "88"888   o88888888    Y88  888_,o8P'"888,_ _,88P    "88"888   ,88b    dP 
'     "M "M"   MMM"MMMM     YM  "MMMMP"`    "YMMMMMP"      "M "M"     "YMmMY"  
'
'
'
FREQUEST:
If Fn A500 Then Gosub _STOP
FRQ=False : _TEXT=True
WX=100 : WY=21 : WX2=540 : WY2=174 : _COL=_WHITE : Gosub WIN
Gosub _TOASTDIR
Ink _SHADOW
Draw 104,156 To 420,156
Set Zone ZN_FILESTEXT,110,157 To 420,173
BX=432
BTXT1$=_OK$ : BY=39 : BZN=ZN_FILESOK : Gosub GRAYBTN
BTXT1$="Parent" : Add BY,BUT_H : BZN=ZN_FILESPARENT : Gosub GRAYBTN
BTXT1$="Volumes" : Add BY,BUT_H : BZN=ZN_FILESVOLUMES : Gosub GRAYBTN
Gosub DEVBUT
BTXT1$=_CANCEL$ : Add BY,BUT_H+6 : BZN=ZN_FILESCANCEL : Gosub GRAYBTN
If FTOTAL=0
   Gosub GDR
   FPOS=0
End If 
Gosub DRWDR
Gosub DRWSLI
Paste Bob 408,40,5
Paste Bob 408,144,6
TXT1$=_$ : CR$=_$ : ITX_X=120 : ITX_Y=167 : ITX_L=37 : TXT_X=0 : _MAX=128
T$=F$ : Gosub DRWTEXT
Repeat 
   Gosub TESTMOVE
   If Fn MOUSEMENU : _M0=8 : Gosub DRWMENU
   Else If _MENUON : Gosub DRWMENUC : If _CHOICE : Gosub MCHOOSE : End If 
   End If 
   J:
   If( Fn MOUSEWHEELUP or Fn KEY_UP or(Z=ZN_FILESUP and Fn MOUSEDOWN)) and FTOTAL>15
      PZN=Z
      Repeat 
         Dec FPOS
         If Fn MOUSEWHEELUP
            Add FPOS,-2
         End If 
         If FPOS<0
            FPOS=0
         End If 
         Gosub DRWDR
         Gosub DRWSLI
         If Fn MOUSEDOWN
            Gosub SPIN
         End If 
         If FPOS=0
            Gosub CLRKEY : Rem mouse wheel scancode buffer
         End If 
         Gosub GVAL
      Until Fn MOUSEUP or PZN<>Z
   Else If( Fn MOUSEWHEELDOWN or Fn KEY_DOWN or(Z=ZN_FILESDOWN and Fn MOUSEDOWN)) and FTOTAL>15
      PZN=Z
      Repeat 
         Inc FPOS
         If Fn MOUSEWHEELDOWN
            Add FPOS,2
         End If 
         If FPOS>FTOTAL-16
            FPOS=FTOTAL-16
         End If 
         Gosub DRWDR
         Gosub DRWSLI
         If Fn MOUSEDOWN
            Gosub SPIN
         End If 
         If FPOS=FTOTAL-16
            Gosub CLRKEY : Rem mouse wheel scancode buffer
         End If 
         Gosub GVAL
      Until Fn MOUSEUP or Z<>PZN
   Else If((Z>ZN_FILESCANCEL and Z<ZN_FILESLISTEND+1) or(Z>=ZN_LEFTRANGESPACE and Z<=ZN_RIGHTRANGESPACE)) and PZN-Z
      Gosub HIGHDR : Rem filename rollover rollout
      PZN=Z
   Else If Fn KEY_RETURN
      FRQ=True
      Exit 
   Else If Fn MOUSEDOWN
      PZN=Z
      If Z=ZN_FILESOK : Rem ok 
         PZN=Z : BY=39 : Gosub PRESS
         If _ON
            FRQ=True
            Exit 
         End If 
      Else If Z=ZN_FILESTEXT : Rem text input 
         I:
         N=Len(F$)
         N=N-(N-((CX/8)-15))+FOFF : Rem mouse position cursor
         If N>Len(F$)
            N=Len(F$)
         End If 
         Repeat 
            T$=F$
            Gosub _TEXTINPUT
            F$=T$
            Ink _BLACK
            CR$=_SCORE$
            Gosub DRWTEXT
            Gosub TESTMOVE
            If Z=ZN_FILESTEXT and Fn MOUSEDOWN : Rem click again inside the text gadget 
               Goto I
            End If 
         Until Fn KEY_RETURN or Fn KEY_ESC or Fn MOUSEDOWN
         If Fn KEY_ESC
            Exit 
         End If 
         CR$=_$
         Gosub DRWTEXT
         If Z<>ZN_FILESTEXT or Fn KEY_RETURN : Rem another button was selected
            Goto J
         End If 
      Else If Z=ZN_FILESBAR and FTOTAL>15 : Rem scroll bar 
         MY=CY-((FPOS*SLISIZE#)/14)
         Repeat 
            Gosub TESTMOVE
            FPOS=((CY-MY)/SLISIZE#)*14
            If FPOS<0
               FPOS=0
            End If 
            If FPOS>FTOTAL-16
               FPOS=FTOTAL-16
            End If 
            Gosub DRWDR
            Gosub DRWSLI
         Until Fn MOUSEUP
      Else If Z=ZN_FILESPARENT : Rem parent 
         PZN=Z : BY=53 : Gosub PRESS
         If _ON
            Parent 
            Gosub GDR : FPOS=0
            Gosub DRWDR
            Gosub DRWSLI
         End If 
      Else If Z=ZN_FILESVOLUMES : Rem volumes
         PZN=Z : BY=67 : Gosub PRESS
         If _ON
            Gosub VLUMES : FPOS=0
            Gosub DRWDR
            Gosub DRWSLI
         End If 
      Else If Z>ZN_FILESVOLUMES and Z<ZN_FILESCANCEL : Rem devices  
         PZN=Z : BY=67+((Z-ZN_FILESVOLUMES)*BUT_H) : Gosub PRESS
         If _ON
            Trap Dir$=DEVS$(Z-ZN_FILESVOLUMES)
            If Errtrap
               Gosub FLSHSCR
            Else 
               Gosub GDR : FPOS=0
               Gosub DRWDR
               Gosub _TOASTDIR
               Gosub DRWSLI
            End If 
         End If 
      Else If Z=ZN_FILESCANCEL : Rem cancel 
         PZN=Z : BY=157 : Gosub PRESS
         If _ON
            Exit 
         End If 
      Else If Z>ZN_FILESCANCEL and Z<ZN_FILESLISTEND+1 : Rem select file
         PZN=Z
         Gosub MUP
         Gosub GVAL
         If PZN=Z
            Gosub CHOFN
         End If 
      End If 
   Else If Fn KEY_ESC
      Exit 
   End If 
Until FRQ
I=ZN_FILESUP : N=ZN_FILESLISTEND : Gosub RESETZN
Gosub MAGICWAND
If FRQ and F$=_$
   FRQ=False
   Gosub FLSHSCR
Else 
   LF$=F$
End If 
REQ=FRQ
Goto WINC
'
DEVBUT:
BY=67
I=1
Repeat 
   Add BY,BUT_H : Inc BZN
   BTXT1$=DEVS$(I) : Gosub GRAYBTN
   Inc I
Until I>5
Return 
'  
CHOFN:
Paper _WHITE : Pen _GRAY
FILES$=FILES$(FPOS+Z-ZN_FILESLIST)
I=Len(FILES$)
Repeat 
   Exit If Peek(Varptr(FILES$)+I-1)-CHR_SPACE
   Dec I
Until I<0
If I
   D$=Mid$(FILES$,2,I-1)
Else 
   D$=Mid$(FILES$,2,Len(FILES$))
End If 
I=Peek(Varptr(FILES$))
If I=CHR_STAR or I=CHR_QUESTIONMARK or I=CHR_HASH
   If I=CHR_QUESTIONMARK
      DEVS$(5)=D$
      BZN=ZN_FILESVOLUMES : Gosub DEVBUT
   End If 
   Trap Dir$=D$
   If Errtrap
      S$=WTXT$
      TXT1$="Error opening" : TXT2$= Fn QUOTE$(D$) : Gosub _ERROR
      WTXT$=S$
      Dir$=PROGDIR$
      Pop : Goto FREQUEST
   Else 
      Gosub GDR : FPOS=0
      Gosub DRWDR
      PZN=0 : Gosub HIGHDR : PZN=Z
      Gosub _TOASTDIR
      Goto DRWSLI
   End If 
Else 
   F$=D$
   If S$=F$ : Rem double click 
      FRQ=True
   Else 
      S$=F$
      T$=F$ : Goto DRWTEXT
   End If 
End If 
Return 
'
REFRESH:
Gosub GDR : FPOS=0
Gosub DRWDR
Gosub DRWSLI
_TOASTDIR:
Trap _TOAST$=Dir$+_SPACE$ : Gosub T0AST : Rem show current folder
If Errtrap
   Pop : Pop : Pop : Goto NOSPACE
End If 
Return 
'  
GDR:
Gosub CLRFILES
Gosub SETFILENAMELENGTH
D$=Dir First$(_$)
While D$<>_$ and TCOUNT<_FR
   If Peek(Varptr(D$))-CHR_STAR
      FILEL(TCOUNT)=Val(Right$(D$,8))
      I=Len(D$)-8
      Repeat 
         Exit If Peek(Varptr(D$)+(I-1))-CHR_SPACE
         Dec I
      Until I<0
      If FILEL(TCOUNT)=0 or FILEL(TCOUNT)>999999
         Trap Open In 1,Mid$(D$,2,I-1)
         If Not Errtrap
            Trap FILEL(TCOUNT)=Lof(1)
            Trap Close 1
            If Errtrap
               Rem clear trap 
            End If 
         End If 
      End If 
   Else 
      I=Len(D$)
   End If 
   FILES$(TCOUNT)=Mid$(D$,0,I)
   Trap D$=Dir Next$
   If Errtrap
      Gosub NOSPACE
      FTOTAL=TCOUNT : Inc FTOTAL
      Pop : Goto FREQUEST
   End If 
   Inc TCOUNT
   If TCOUNT=_FR
      Gosub FLSHSCR
      _TOAST$="Error: Over"+Str$(_FR)+" Files" : Gosub T0AST
   End If 
Wend 
FTOTAL=TCOUNT : Inc FTOTAL
Return 
'  
CLRFILES:
I=1
Repeat 
   FILES$(I)=_$
   FILEL(I)=0
   Inc I
Until I>_FR
RSTFILES:
FTOTAL=0
TCOUNT=1
Return 
'
VLUMES:
Gosub CLRFILES
D$=Dev First$("d:") : I=CHR_QUESTIONMARK : Gosub VTYPE
D$=Dev First$("a:") : I=CHR_HASH
VTYPE:
Repeat 
   FILES$(TCOUNT)=Chr$(I)+D$-_SPACE$
   Inc TCOUNT
   D$=Dev Next$
Until D$=_$
FTOTAL=TCOUNT
Return 
'
DRWDR:
Pen _BLACK
TCOUNT=FPOS : N=ZN_FILESLIST+1
Locate ,5
Repeat 
   Inc TCOUNT : Gosub SETDR
   Paper _WHITE
   Locate 13,
   If Len(S$)>6 Then Print S$ Else Print Space$(38) : Rem no empty Zone$ 
   Inc N
Until N-ZN_FILESLIST>14
Return 
'
HIGHDR:
Pen _BLACK
If Z>ZN_FILESLIST and Z<ZN_FILESLIST+15
   N=Z
   Paper _GRAY
   Gosub DRHIGH
End If 
Pen _BLACK
If PZN>ZN_FILESLIST and PZN<ZN_FILESLIST+15
   N=PZN
   Paper _WHITE
   Gosub DRHIGH
End If 
Return 
'
DRHIGH:
TCOUNT=FPOS+N-ZN_FILESLIST : Gosub SETDR
Locate 13,N-ZN_FILESLIST+4 : Print S$
Return 
'
SETDR:
SZ=FILEL(TCOUNT)
FILES$=Space$(34)
Mid$(FILES$,0)=FILES$(TCOUNT)
I=Peek(Varptr(FILES$))
If I=CHR_STAR
   Trap S$=Zone$("(Dir)"+Mid$(FILES$,2),N)
Else If I=CHR_QUESTIONMARK
   Trap S$=Zone$("(Dev)"+Mid$(FILES$,2)+Space$(34-Len(FILES$)),N)
Else If I=CHR_HASH
   Trap S$=Zone$(_SPACE$+Mid$(FILES$,2)+Space$(38-Len(FILES$)),N)
Else 
   If SZ=0 and FILES$-_SPACE$=_$
      Trap S$=Zone$(_$,N)
   Else 
      Gosub SETSIZE
      Trap S$=Zone$(FILES$+Space$(4-Len(S$))+S$,N)
   End If 
End If 
If Errtrap
   Pop : Pop : Goto NOSPACE
End If 
Return 
'
SETSIZE:
If SZ<0
   S$=">2"+_GIGA$
Else If SZ<1000
   S$=Str$(SZ)-_SPACE$+_BYTE$
Else If SZ<10000
   S$=Left$(Str$(SZ/_KILOBYTE#)-_SPACE$,3)+_KILO$
Else If SZ<1000000
   S$=Str$(SZ/1000)-_SPACE$+_KILO$
Else If SZ<_MEGABYTE*10
   S$=Left$(Str$(SZ/_MEGABYTE#)-_SPACE$,3)+_MEGA$
Else If SZ<_GIGABYTE
   S$=Str$(SZ/_MEGABYTE)-_SPACE$+_MEGA$
Else 
   S$=Left$(Str$(SZ/_GIGABYTE#)-_SPACE$,3)+_GIGA$
End If 
Return 
'
DRWSLI:
If FTOTAL<16
   SLISIZE#=1.0
Else 
   SLISIZE#=(FTOTAL-2)/14.0
End If 
SLISIZE#=96/SLISIZE#
SLIPOS#=(SLISIZE#*FPOS)/14.0
Ink _BG
Bar 408,48 To 423,143
Ink _GRAY
Bar 410,Int(48+SLIPOS#) To 421,Int(48+SLIPOS#+SLISIZE#)
Set Zone ZN_FILESBAR,410,Int(48+SLIPOS#) To 421,Int(48+SLIPOS#+SLISIZE#)
Set Zone ZN_FILESUP,410,40 To 421,Int(48+SLIPOS#)
Set Zone ZN_FILESDOWN,410,Int(48+SLIPOS#+SLISIZE#) To 421,154
Return 
'
_REQUEST:
RX=200 : RY=59
WTXT$="Request" : WX=RX : WY=RY-14 : WX2=RX+239 : WY2=104 : _COL=_WHITE : Gosub WIN
Ink _BG,_WHITE
Text RX+120-(Text Length(TXT1$)/2),RY+11,TXT1$
Text RX+120-(Text Length(TXT2$)/2),RY+21,TXT2$
_COL=_WHITE
BX=RX+12 : BY=RY+28 : BZN=ZN_OK : Gosub GRAYBTN
KT$=Lower$(Left$(BTXT1$,1))
BTXT1$=_CANCEL$ : BX=RX+125 : BZN=ZN_CANCEL : Gosub GRAYBTN
Do 
   Gosub TESTMOVE
   PZN=Z
   If( Fn MOUSEDOWN and Z=ZN_OK) or Lower$(K$)=KT$ or Fn KEY_RETURN
      PZN=Z : BX=RX+12 : Gosub PRESS
      If _ON
         REQ=True
         Exit 
      End If 
   Else If( Fn MOUSEDOWN and Z=ZN_CANCEL) or Lower$(K$)="c" or Fn KEY_ESC
      PZN=Z : BX=RX+125 : Gosub PRESS
      If _ON
         REQ=False
         Exit 
      End If 
   End If 
Loop 
I=ZN_OK : N=ZN_CANCEL : Gosub RESETZN
Goto WINC
'
_NOTICE:
If Not _INIT
   Amos To Front : View 
End If 
RENDERING=True : _TEXT=True
RX=216 : RY=59
WTXT$="Notice" : WX=RX-5 : WY=RY-14 : WX2=429 : WY2=104 : _COL=_WHITE : Gosub WIN
Ink _BG,_WHITE
Text RX+104-(Text Length(TXT1$)/2),RY+11,TXT1$
If Len(TXT2$)>25
   TXT2$= Fn QUOTE$(_DOTS$+Right$(TXT2$,20))
End If 
Text RX+104-(Text Length(TXT2$)/2),RY+21,TXT2$
Goto WINWAITC
'
WIN:
Gosub R4INBOW : View 
Gosub NUDGEPOS
Gosub CLRPOS
RENDERING=True
If _COL=_PANE Then Ink _SHADOW Else Ink _COL-1
Bar WX-4,WY-3 To WX-1,WY2+3
Bar WX2+1,WY-3 To WX2+4,WY2+3
Bar WX,WY-3 To WX2,WY-1
Bar WX,WY2+1 To WX2,WY2+3
Ink _BLACK
Box WX-5,WY-4 To WX2+5,WY2+4
Ink _COL
Bar WX,WY To WX2,WY2
If SCR_D=4 and _COL<>_PANE Then Ink _PANE Else Ink _SHADOW
Bar WX+1,WY+1 To WX2-1,WY+13
Ink _COL-1
Box WX+1,WY+1 To WX2-1,WY2-1
If SCR_D=4 and _COL<>_PANE Then Ink _WHITE,_PANE Else Ink _WHITE,_SHADOW
Text WX+4,WY+10,WTXT$
Return 
'
WINWAITC:
_COL=_WHITE
PTGL=1 : Rem show play time 
BTXT1$=_OK$ : BX=267 : BY=WY2-BUT_H-4 : BZN=ZN_OK : Gosub GRAYBTN
Repeat 
   Gosub GVAL
   If ABOUT and _AMIVER>3
      If STPPED or PTGL<>TGL
         Gosub _TOASTTIME
      End If 
      If PLYTIME>0 and PTGL<>TGL
         PTGL=TGL
         Gosub TIME_PLY
      End If 
   End If 
   If Z=ZN_OK and Fn MOUSEDOWN
      PZN=Z : Gosub PRESS
      If _ON
         REQ=True
         Exit 
      End If 
   End If 
Until Fn KEY_RETURN or Fn KEY_ESC
WINC:
I=ZN_OK : N=ZN_CANCEL : Gosub RESETZN
If _INIT Then Gosub SH0WWAVE
If _CHOICE-3 Then Gosub FRSHSEL
If Fn MULTI Then Gosub R4INSET
If WY2>CTL_Y Then Gosub CONTROLS
RENDERING=False
_TEXT=False
ABOUT=False
Goto CLRPOS
'
_OPENFXBIGWIN:
REALTIME=True
_REPEAT$=CHAIN$(1)
Gosub REOSCILLOSCOPE
RX=215 : RY=59 : BTN_Y=RY+77
WTXT$=S$ : WX=RX-5 : WY=RY-15 : WX2=RX+215 : WY2=RY+94 : _COL=_WHITE : Gosub WIN
BTXT1$=_OK$ : BX=RX : BY=BTN_Y : BZN=ZN_OK : Gosub BTN
BTXT1$=_CANCEL$ : BX=RX+107 : BZN=ZN_CANCEL : Goto BTN
'
_OPENFXSMALLWIN:
REALTIME=True
_REPEAT$=CHAIN$(1)
Gosub REOSCILLOSCOPE
FXRUN$=_$
RX=215 : RY=59 : BTN_Y=RY+8
WTXT$=S$ : WX=RX-5 : WY=RY-15 : WX2=RX+215 : WY2=RY+25 : _COL=_WHITE : Gosub WIN
BTXT1$=_OK$ : BX=RX : BY=BTN_Y : BZN=ZN_OK : Gosub BTN
BTXT1$=_CANCEL$ : BX=RX+107 : BZN=ZN_CANCEL : Goto BTN
'
_OPENFXWIN:
REALTIME=True
_REPEAT$=CHAIN$(1)
_OPENFXTEXTWIN:
_MENUDO=True : Rem hack 
Gosub REOSCILLOSCOPE
RX=215 : RY=59 : BTN_Y=RY+28
WTXT$=S$ : WX=RX-5 : WY=RY-15 : WX2=RX+215 : WY2=RY+45 : _COL=_WHITE : Gosub WIN
BTXT1$=_OK$ : BX=RX : BY=BTN_Y : BZN=ZN_OK : Gosub BTN
BTXT1$=_CANCEL$ : BX=RX+107 : BZN=ZN_CANCEL : Goto BTN
'
_CLOSEFXWIN:
If Not REQ Then _REPEAT$=_REPEATP$
If FXOSCILLO Then Gosub _TGLOSCILLOSCOPE
_MENUDO=False : Rem hack 
I=ZN_OK : N=ZN_PIANO : Gosub RESETZN
I=ZN_AUTO : N=ZN_FXBAR : Gosub RESETZN
Goto DIALMAIN
'
_RUNFXWIN:
_EXIT=False
Repeat 
   Gosub GVAL
   If Z=ZN_OK and Fn MOUSEDOWN or Fn KEY_RETURN
      PZN=Z : BY=BTN_Y : BX=RX : Gosub PRESS
      If _ON
         REQ=True
         _EXIT=True
      End If 
   Else If Z=ZN_CANCEL and Fn MOUSEDOWN or Fn KEY_ESC
      PZN=Z : BY=BTN_Y : BX=RX+107 : Gosub PRESS
      If _ON
         REQ=False
         _EXIT=True
      End If 
   Else If Fn KEY_LEFT or Z=ZN_FXLEFT and FXRUN$<>_$ and Fn MOUSEDOWN
      If FXN>0
         Dec FXN
         Gosub FXKEY
         Gosub SPIN
      End If 
   Else If Fn KEY_RIGHT or Z=ZN_FXRIGHT and FXRUN$<>_$ and Fn MOUSEDOWN
      If FXN<200
         Inc FXN
         Gosub FXKEY
         Gosub SPIN
      End If 
   Else If Z=ZN_FXBAR and Fn MOUSEDOWN and FXRUN$<>_$
      Repeat 
         Gosub FXSET
         Gosub FXKEY
      Until Fn MOUSEUP
   Else If Fn MOUSEDOWN
      Gosub DRWDIALS
   Else If Fn KEY_PRESS
      Gosub KCHOOSE
   End If 
   Gosub DISPATCH
Until _EXIT
Gosub MUP
Gosub _CLOSEFXWIN
Gosub WINC
REALTIME=False : CHAIN$(1)=_$
If REQ Then Goto _UNDOSET
Return 
'
_TEXTINPUT:
If(( Fn KEY_PRESS and C<59) or Fn KEY_SPACE) and N<_MAX
   If N=-1
      N=0
   End If 
   T$=Left$(T$,N)+K$+Right$(T$,Len(T$)-N)
   Inc N
End If 
If Fn KEY_LEFT and N>0
   Dec N
Else If Fn KEY_BACKSPACE and N>0
   Dec N
   T$=Left$(T$,N)+Right$(T$,(Len(T$)-1)-N)
Else If Fn KEY_DEL and N<Len(T$)-1
   T$=Left$(T$,N)+Right$(T$,(Len(T$))-N-1)
Else If Fn KEY_DEL and N<Len(T$)
   T$=Left$(T$,N)
Else If Fn KEY_RIGHT and N<Len(T$)
   Inc N
End If 
If TXT_X=0 Then Return 
_TEXT:
Ink _BG,_WHITE
If TXT1$=_$
   TXT_X=320-(Text Length(T$)/2)
   Text TXT_X-Text Length(TXT1$)-8,TXT_Y,_SPACE$
End If 
Text TXT_X-Text Length(TXT1$),TXT_Y,TXT1$+T$+_SPACER$
Gr Writing %10
Text TXT_X+(N*8),TXT_Y,_SCORE$
Gr Writing %1
Return 
'
DRWTEXT:
FOFF=Len(T$)-ITX_L
Ink _BLACK,_WHITE
Text ITX_X,ITX_Y,Space$(ITX_L)
If FOFF<0 Then FOFF=0
Text ITX_X-Text Length(TXT1$),ITX_Y,TXT1$+Mid$(T$,FOFF+1,Min(Len(T$)-FOFF,ITX_L))
Gr Writing %10
If N-FOFF>0 Then Text ITX_X+((N-FOFF)*8),ITX_Y,CR$+_SPACE$ Else Text ITX_X,ITX_Y,CR$+_SPACE$
Gr Writing %1
Return 
'
_RUNFXTEXTWIN:
_TEXT=True : _EXIT=False
N=Len(T$) : TXT_X=348 : TXT_Y=72 : _MAX=9
Repeat 
   Gosub _TEXTINPUT
   Repeat 
      Gosub GVAL
      If Z=ZN_OK and Fn MOUSEDOWN or Fn KEY_RETURN
         PZN=Z : BY=RY+28 : BX=RX : Gosub PRESS
         If _ON
            REQ=True
            _EXIT=True
         End If 
      Else If Z=ZN_CANCEL and Fn MOUSEDOWN or Fn KEY_ESC
         PZN=Z : BY=RY+28 : BX=RX+107 : Gosub PRESS
         If _ON
            REQ=False
            _EXIT=True
         End If 
      End If 
   Until _EXIT or C
Until _EXIT
Gosub _CLOSEFXWIN
Goto WINC
'
FXKEY:
Gosub FXRUN$
Gosub FXDRW
If Fn KEY_CURSOR Then Goto CLRKEY
Goto KCHOOSE
'
FXDRW:
If SCR_D=4 Then Ink _WHITE,_PANE Else Ink _WHITE,_SHADOW
N=Text Length(Str$(FXSN)-_SPACE$)+Text Length(FXS$)
Text RX+156-N,RY-5,Space$(8)
Text RX+212-N,RY-5,Str$(FXSN)-_SPACE$+FXS$
Ink _BG
Bar RX+1,RY+6 To RX+209,RY+6+BUT_H
Ink _GRAY
Bar RX+1+FXN,RY+6 To RX+1+FXN+8,RY+6+BUT_H
Set Zone ZN_FXBAR,RX+FXN,RY+6 To RX+FXN+10,RY+6+BUT_H
Set Zone ZN_FXLEFT,RX-1,RY+6 To RX+FXN,RY+6+BUT_H
Set Zone ZN_FXRIGHT,RX+FXN+9,RY+6 To RX+210,RY+6+BUT_H
Return 
'
FXSET:
Gosub TESTMOVE
FXN=CX-224
If FXN=<0
   FXN=0
Else If FXN>199
   FXN=200
End If 
Return 
'  
SETREALTIME:
If REALTIME or MACRO
   FXSHOW=False
Else 
   FXSHOW=True
End If 
Return 
'
FBLIT:
If Not Exist("C:FBlit")
   TXT1$="FBlit accelerated" : TXT2$="graphics not found" : Goto _NOTICE
End If 
Return 
'  
'
'
