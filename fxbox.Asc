Data "Lowres","Hires",110,31,"SETHIRES"
Data "Position",_$,215,31,"SETPOSITION"
Data "Level Meter",_$,320,31,"SETLEVELMETER"
Data "Metronome",_$,5,47,"SETMETRONOME"
Data "Realtime",_$,110,47,"SETPREVIEW"
