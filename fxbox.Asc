'*buttons********************************************************************* 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
' :::::::.   ...    :::::::::::::::::::::::    ...     ::.    :::. .::::::.  
'  ;;;'';;' ';;     ;;;;;;;;;;''';;;;;;;''' .;;;;;;;.  ;;;;,  `;;;;;;`    `; 
'  [[[__[[\.[['     [[[    [[        [[    ,[[     \[[, [[[[[. '[['[==/[[[[, 
'  $$""""Y$$$$      $$$    $$        $$    $$$,     $$$ $$$ "Y$c$$  '''    $ 
' _88o,,od8P88    .d888    88,       88,   "888,_ _,88P888    Y88 ,88b    dP 
' ""YUMMMP"  "YmmMMMM""    MMM       MMM     "YMMMMMP" MM     YM    "YMmMY"  
'
'
'
ALLBTN:
Ink _PANE
Bar 0,CTL_Y To SCR_W,SCR_H
BZN=ZN_PLAY
Repeat 
   _COL=_PANE
   Gosub ZBTN
   Inc BZN
Until BZN>ZN_PLAY+_AB-2
Gosub LPBTN
Goto LPMIXBTN
'
PLYBTN:
If _CONTROLSOFF Then Return 
Gosub GFXSET
If PLYING
   _COL=_WHITE
   If RNGEPLY
      BZN=ZN_PLAYRANGE : Gosub ZBTN
   End If 
   If DISPPLY
      BZN=ZN_PLAYDISPLAY : Gosub ZBTN
   End If 
   BTXT1$="Play|Stop" : BZN=ZN_PLAY : BX=BUTX(BZN-ZN_PLAY) : BY=BUTY(BZN-ZN_PLAY) : Gosub BTN
Else 
   _COL=_PANE
   BZN=ZN_PLAY : Gosub ZBTN
   BZN=ZN_PLAYRANGE : Gosub ZBTN
   BZN=ZN_PLAYDISPLAY : Gosub ZBTN
End If 
Goto GFXRESTORE
'
_TGLLOOP:
If _LP Then _LP=False Else _LP=True
LPBTN:
If _LP Then _COL=_WHITE Else _COL=_PANE
BZN=ZN_LOOP : Goto ZBTN
'
_TGLMIXLOOP:
If _LPMIX Then _LPMIX=False Else _LPMIX=True
LPMIXBTN:
If _LPMIX Then _COL=_WHITE Else _COL=_PANE
BZN=ZN_MIXLOOP : Goto ZBTN
'
_REPEAT:
If _REPEAT$=_$
   TXT1$="No subroutine to" : TXT2$="repeat" : Goto _ERROR
End If 
Gosub _UNDOSET
T$=_REPEAT$
_TOAST$=T$
MACRO=True
_REPEATING=True
Gosub CMD
_REPEATING=False
MACRO=False
Return 
'
GRAYBTN:
Ink _GRAY
Goto B
'
ZBTN:
BTXT1$=BUTS$(BZN-ZN_PLAY) : BX=BUTX(BZN-ZN_PLAY) : BY=BUTY(BZN-ZN_PLAY)
'
BTN:
Ink _BLACK
B:
Box BX,BY To BX+BUT_W,BY+BUT_H
Ink _COL+4
Box BX+1,BY+1 To BX+BUT_W-1,BY+BUT_H-1
Ink _COL,-1
Bar BX+2,BY+2 To BX+BUT_W-2,BY+BUT_H-2
Ink _BLACK,_COL
Text BX+((BUT_W-(Text Length(BTXT1$)))/2)+1,BY+BUT_H-4,BTXT1$
Set Zone BZN,BX,BY To BX+BUT_W,BY+BUT_H
Return 
'
PIANOBTNHIGH:
Ink _WHITE
Draw BX+9,BY+2 To BX+93,BY+2
Gosub HIGHBTN
Inc BY
PIANOBTN:
Ink _BLACK
Bar BX+9,BY+2 To BX+93,BY+11
Paste Bob BX+9,BY+2,3
Return 
'
PRESSBTN:
BX=BUTX(PZN-ZN_PLAY) : BY=BUTY(PZN-ZN_PLAY)
PRESS:
_ON=True
Gosub HIGHBTN
Repeat 
   If C=0 Then Gosub TESTMOVE Else Gosub MKEY
   If PZN<>Z and _ON
      _ON=False
      Gosub HIGHBTN
   Else If PZN=Z and _ON=False
      _ON=True
      Gosub HIGHBTN
   End If 
Until Fn MOUSEUP
If Not _ON Then Return 
HIGHBTN:
Gr Writing %10
Ink _HIGHLIGHT
Bar BX+1,BY+1 To BX+BUT_W-1,BY+BUT_H-1
Gr Writing %1
Return 
'
TAB:
Ink _COL
Bar TAB_X,TAB_Y To TAB_X+22,TAB_Y+14
Ink _GRAY,_COL
Text TAB_X+8,TAB_Y+10,CR$
Set Zone N,TAB_X,TAB_Y To TAB_X+23,TAB_Y+15
Return 
'  
'
'
