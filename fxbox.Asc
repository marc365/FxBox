'***************************************************************************** 
'*help************************************************************************ 
'***************************************************************************** 
'***************************************************************************** 
'***************************************************************************** 
'
'     ::   .: .,::::::  :::    ::::::::. 
'    ,;;   ;;,;;;;''''  ;;;    `;;```.;;;
'   ,[[[,,,[[[ [[cccc   [[[    `]]nnn]]' 
'   "$$$"""$$$ $$""""   $$'     $$$""
'    888   "88 888oo,_o88oo,.__ 888o 
'    MMM    YM """"YUM"""YUMMMM YMMMb
'
'
'
_OPTIONS:
_TEXT=True
RX=105 : RY=20
WTXT$=S$ : WX=106 : WY=RY : WX2=532 : WY2=164 : _COL=_PANE : Gosub WIN
Gosub OPTBTN
Repeat 
   Gosub GVAL
   E$=_$
   If Fn MOUSEDOWN and Z>=ZN_OPTIONS and Z<ZN_OPTIONSOK
      Restore OPB
      BZN=ZN_OPTIONS
      Repeat 
         Read BTXT1$,BTXT2$,BX,BY,E$
         If Z=BZN
            PZN=Z : Add BX,RX : Add BY,RY : Gosub PRESS
            If _ON
               If BZN<ZN_OPTIONSOK-3
                  N=BZN-ZN_OPTIONS+10
                  Gosub SETSET
               End If 
               Gosub E$
               Gosub OPTBTN
            End If 
            Exit 
         End If 
         Inc BZN
      Until BZN=ZN_OPTIONSOK
      If E$=_$
         Exit 
      End If 
   End If 
Until Fn KEY_RETURN or Fn KEY_ESC
Goto OPTC
'
OPTOK:
REQ=True
Pop 
OPTC:
I=ZN_OPTIONS : N=ZN_OPTIONSOK : Gosub RESETZN
Gosub MAGICWAND
Gosub WINC
Goto NUDGEPOS
'  
OPTBTN:
Restore OPB
BZN=ZN_OPTIONS
Repeat 
   Read BTXT1$,BTXT2$,BX,BY,E$
   If BZN<ZN_OPTIONSOK-4
      If SETTING$(BZN-ZN_OPTIONS+10)<>_FALSE$
         If BTXT2$<>_$
            Swap BTXT1$,BTXT2$
         End If 
         _COL=_WHITE
      Else 
         _COL=_PANE
      End If 
   Else 
      If BZN=ZN_OPTIONSOK-4 and _BYPS=1
         _COL=_PANE
      Else If BZN=ZN_OPTIONSOK-4 and _BYPS=3
         _COL=_HIGHLIGHT
      Else If BZN=ZN_OPTIONSOK-3 and _DITHER=0
         _COL=_PANE
      Else If BZN=ZN_OPTIONSOK-2 and _INTERPOLATE=0
         _COL=_PANE
      Else 
         _COL=_WHITE
      End If 
   End If 
   Add BX,RX : Add BY,RY : Gosub BTN
   Inc BZN
Until BZN=ZN_OPTIONSOK
Ink _SHADOW,_PANE
Text RX+112,RY+105,Space$(6)
Text RX+112,RY+105, Fn QPROP$
If SCR_H-XTR_H>200 Then Gosub DRWBITS
If _DITHER=1
   T$="Dither"
Else If _DITHER=2
   T$="HP-Tri"
Else If _DITHER=3
   T$="LP"
Else 
   T$=_NONE$
End If 
Ink _SHADOW,_PANE
Text RX+112,RY+121,Space$(6)
Text RX+112,RY+121,T$
If _INTERPOLATE=1
   T$="W-Sinc"
Else 
   T$=_NONE$
End If 
Ink _SHADOW,_PANE
Text RX+112,RY+137,Space$(6)
Text RX+112,RY+137,T$
Return 
'
SETSET:
If SETTING$(N)<>_FALSE$
   SETTING$(N)=_FALSE$
Else 
   SETTING$(N)=_TRUE$
End If 
Return 
'  
SETFILTER:
If SETTING$(10)=_FALSE$ Then Led Off Else Led On 
Return 
'
SETMON:
If SETTING$(11)<>_FALSE$
   MONHZ#=50 : CLOCK=3546895 : C=32 : Rem pal
   SCR_H=256+XTR_H
Else 
   MONHZ#=60.0 : CLOCK=3579545 : C=0 : Rem ntsc 
   SCR_H=200+XTR_H
End If 
Gosub PLYBUF
If _INIT
   Doke $DFF1DC,C
   SETTING$(29)=_FALSE$ : Rem -0.2hz     
   _AMIHZ=False : Gosub SETHZ
   TGLINIT=True
   DISPATCH$="_OPTIONS,"
   If _DIRECT
      Pop : _DIRECT=False
   End If 
   _INIT=False
   Pop : Goto _INIT
End If 
Return 
'
BUF:
List Bank 
Return 
'
PLYBUF:
If Fn A500
   Gosub _STOP
   SZ=((MFREQ*_BYPS)/MONHZ#*_CH)
   Goto _CHIP
Else If _INIT=False or TGLVST
   SZ=((MFREQ*3)/MONHZ#*16)
   TGLVST=False
   If NETVST
      Goto _FAST
   Else 
      Goto _CHIP
   End If 
End If 
Return 
'  
_CHIP:
Reserve As Chip Work 3,SZ
Reserve As Chip Work 4,SZ
P_STARTB1=Start(3) : P_STARTB2=Start(4)
Return 
'
_FAST:
Reserve As Work 3,SZ
Reserve As Work 4,SZ
P_STARTB1=Start(3) : P_STARTB2=Start(4)
Return 
'
SETLIGHTMODE:
If SETTING$(12)=_FALSE$
   Palette $0,$344,$888,$555,$111,$222,$999,$940,,,,,,,,,,$DDD,$A33,$111
   _LIGHTMODE=False
Else 
   Palette $0,$599,$DDD,$566,$111,$377,$FFF,$E70
   _LIGHTMODE=True
   Gosub MCOL
End If 
If _REC Then 
If _INIT Then Goto R4INRESTORE
Return 
'
SETDEBUG:
If SETTING$(13)=_FALSE$ Then _DEBUG=False Else _DEBUG=True
If _INIT Then Goto _TOASTFREE
Return 
'  
SETNETSYNC:
If BSD=False and SETTING$(14)<>_FALSE$
   NN=14 : Gosub BSD
Else If BSD and SETTING$(14)=_FALSE$
   NETSYNC=False
   If _INIT
      Gosub _STOP
   End If 
   Goto SOCK_CLOSESYNC
End If 
If BSD
   If _INIT
      Gosub _STOP
   End If 
   Gosub SOCK_OPENSYNC
   If CONNECT=-1
      TXT1$="Failed sync socket" : TXT2$=_$ : Gosub _NOTICE
      Gosub SOCK_CLOSESYNC
      SOCKSYNC=-1
      NETSYNC=False
      SETTING$(14)=_FALSE$
      If _INIT
         Pop : Goto _OPTIONS
      End If 
   Else 
      NETSYNC=True
   End If 
Else 
   NETSYNC=False
End If 
Return 
'
SETHIRES:
SB=Screen Base
If SETTING$(15)=_FALSE$
   If _INIT
      Doke SB+72,Deek(SB+72) xor Hires
   End If 
   Trap Screen Close 2
   SCR_R=Lowres
Else 
   If _INIT
      Doke SB+72,Deek(SB+72) or Hires
      Screen Offset 0,0,0
      Trap Screen Offset 2,0,0
   End If 
   Trap Screen Close 2
   SCR_R=Hires
End If 
If Errtrap Then Rem clear trap 
Return 
'  
SETPOSITION:
If SETTING$(16)=_FALSE$ Then _POSITIONOFF=True Else _POSITIONOFF=False
Return 
'
SETLEVELMETER:
If SETTING$(17)=_FALSE$ Then _LEVEL=False Else _LEVEL=True
Return 
'  
SETMETRONOME:
If SETTING$(18)=_FALSE$
   _METRO=False
   If _INIT
      Goto METROC
   End If 
Else 
   _METRO=True
End If 
Return 
'
SETPREVIEW:
If SETTING$(19)=_FALSE$ Then _PREVIEW=False Else _PREVIEW=True
Return 
'
'ZOOMDRAW  
'
SETGRAPH:
If SETTING$(21)<>_FALSE$ Then _STEP=2 Else _STEP=1
Return 
'
'WHEELZOOM 
'
SETAREXXSYNC:
If REXX=False and SETTING$(23)<>_FALSE$
   SETTING$(23)=_FALSE$
   TXT1$="Arexx server" : TXT2$=_NOTAVAILABLE$ : Gosub _ERROR
   If _INIT
      Pop : Goto _OPTIONS
   End If 
Else If REXX and Arexx Exist(OCTAMED_REXX$)
   OCTAMED=True
Else If SETTING$(23)<>_FALSE$
   OCTAMED=False
   SETTING$(23)=_FALSE$
   TXT1$="Octamed arexx port" : TXT2$=_NOTAVAILABLE$ : Gosub _ERROR
   If _INIT
      Pop : Goto _OPTIONS
   End If 
Else 
   OCTAMED=False
End If 
Return 
'
'SCROLLER  
'
SETVST:
If BSD=False and SETTING$(25)<>_FALSE$
   NN=25 : Gosub BSD
Else If BSD and SETTING$(25)=_FALSE$
   DIALMAX#=443.726 : Rem 28836
   NETVST=False
   If _INIT
      Gosub _STOP
      TGLVST=True : Gosub PLYBUF
   End If 
   Gosub SOCK_CLOSEVST
   Goto DIALVST
End If 
If BSD
   If _INIT
      Gosub _STOP
   End If 
   Gosub SOCK_OPENVST
   If CONNECT=-1
      TXT1$="Failed vst socket" : TXT2$=_$ : Gosub _NOTICE
      Gosub SOCK_CLOSEVST
      SOCKVST=-1
      NETVST=False
      SETTING$(25)=_FALSE$
   Else 
      DIALMAX#=1495.93 : Rem 96000
      NETVST=True
      If _INIT
         TGLVST=True : Gosub PLYBUF
      End If 
   End If 
Else 
   DIALMAX#=443.726 : Rem 28836
   NETVST=False
   If _INIT
      TGLVST=True : Gosub PLYBUF
   End If 
End If 
Goto DIALVST
'
SETQUANTIZER:
If SETTING$(26)<>_FALSE$ and Length(QBANK)=0
   Trap Reserve As Work QBANK,Q_BUF
   If Errtrap
      SETTING$(26)=_FALSE$
      If _INIT
         Goto NOMEMORY
      End If 
   End If 
End If 
Return 
'
SETALWAYSDRAW:
If SETTING$(27)=_FALSE$ Then SETTING$(20)=_FALSE$ : Rem zoom draw
Return 
'  
SETTASKPRI:
Areg(1)=CHR_NULL
Areg(1)=Execall(-294) : Rem _LVOFindTask 
If SETTING$(28)=_FALSE$ : Rem magic
   Dreg(0)=0
Else 
   Dreg(0)=-1
End If 
N=Execall(-300) : Rem _LVOSetTaskPri 
Return 
'
SETPOINT2:
If SETTING$(29)=_FALSE$
   If _INIT
      MONHZ#=0.2+MONHZ#
      _TOAST$=Str$(MONHZ#)+_HZ$
   End If 
Else 
   MONHZ#=-0.2+MONHZ#
   _TOAST$=Str$(MONHZ#)+_HZ$
End If 
If _INIT
   _AMIHZ=False
   Gosub SETHZ
   Goto DRWTIMENOW
End If 
Return 
'
_TGLDITHER:
Inc _DITHER
If _DITHER>3
   _DITHER=0
End If 
Return 
'
_TGLINTERPOLATE:
Inc _INTERPOLATE
If _INTERPOLATE>1
   _INTERPOLATE=0
End If 
Return 
'
_TGLQUALITY:
If _BYPS=3
   _BYPS=1
Else 
   Inc _BYPS
End If 
If NETVST and PLYING Then Gosub SOCK_SENDVSTUP
Gosub SETHZ
Gosub HEADERCORDS
_TIMEONLY=True : Goto DRWTIMENOW
'
_ABOUT: Data $F30,$E70,$FF0,$9F0,$B0,$BF
_TEXT=True : ABOUT=True
WTXT$=_FXBOX$ : WX=149 : WY=29 : WX2=490 : WY2=127 : _COL=_WHITE : Gosub WIN
Set Rainbow 1,_HIGHLIGHT,18,_$,_$,_$
Restore _ABOUT
I=0
Repeat 
   Read N
   If Not _LIGHTMODE
      N=N-(N/3)
   End If 
   Rain(1,I)=N : Inc I
   Rain(1,I)=N : Inc I
   Rain(1,I)=N : Inc I
Until I=18
If SCR_D=4 Then Rain(1,5)=Colour(_SHADOW)
Rainbow 1,0,SCR_T+WY-1,18 : View 
Set Text 4 : Text WX+4+48,WY+10,"powered by" : Set Text 0 : Paste Bob WX+145,WY-1,2
If Fn MULTI Then SZ=0 Else SZ=Length(PBANK)
Add SZ,Length(CBANK)+Length(UBANK)
N=1
Repeat 
   Add SZ,Length(N+JB)
   Inc N
Until N>_FL
Gosub SETSIZE
T$="Used:"+S$
Text WX2-Text Length(T$)-3,WY+10,T$
Gosub HEADER
Gosub _TOASTTIME
Ink _BLACK,_WHITE
Text 168,56,Mid$("$VER: Version 1.25 © 1991-2026 Marc Williams",7)
Text 232,64,"Benchmark:"
If REXX
   T$=FXBOX_REXX$
Else 
   T$=_NOTAVAILABLE$
End If 
Text 224,72,"Arexx Port: "+T$
If OCTAMED
   If SETTING$(23)<>_FALSE$ : Rem arexx sync 
      T$=OCTAMED_REXX$
   Else 
      T$=_NOTACTIVE$
   End If 
Else 
   T$=_NOTAVAILABLE$
End If 
Text 208,80,"Octamed Sync: "+T$
If Not BSD Then Gosub BSD
If NETSYNC
   T$=_ADDRSYNC$+_COLON$+Str$(_PORTSYNC)-_SPACE$
Else If BSD
   T$=_NOTACTIVE$
Else 
   T$=_NOTAVAILABLE$
End If 
Text 240,88,"Net Sync: "+T$
If NETVST
   T$=_ADDRVST$+_COLON$+Str$(_PORTVST)-_SPACE$
Else If BSD
   T$=_NOTACTIVE$
Else 
   T$=_NOTAVAILABLE$
End If 
Text 248,96,"VST Out: "+T$
If P_LENGTH=0 Then TIME$="not playing" Else TIME$=_$
Text 232,104,"Play Time: "+TIME$
Paste Bob WX2-178,WY2-BUT_H,4
BX=0 : BY=Int(Timer+MONHZ#)
Repeat 
   Inc BX
Until Timer>BY
Text 312,64,Str$(BX/1E+06)+" DSP MIPS"
Gosub WINWAITC
Rainbow Del 1 : View 
Return 
